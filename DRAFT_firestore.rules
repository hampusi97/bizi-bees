rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'hampusi97@gmail.com'
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.createdAt is timestamp;
    }

    function isValidStoreAudit(data) {
      return data.keys().hasAll(['ownerId', 'storeSlug', 'storeName', 'auditScore', 'status', 'summary', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'storeSlug', 'storeName', 'auditScore', 'status', 'summary', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.storeSlug is string && data.storeSlug.size() >= 1 && data.storeSlug.size() <= 64 &&
        data.storeSlug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120 &&
        data.auditScore is number && data.auditScore >= 0 && data.auditScore <= 100 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 32 &&
        (data.status == 'pending' || data.status == 'verified' || data.status == 'archived') &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreOrder(data) {
      return data.keys().hasAll(['ownerId', 'orderNumber', 'storeSlug', 'tierLabel', 'totalAmount', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'orderNumber', 'storeSlug', 'tierLabel', 'totalAmount', 'status', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 64 &&
        data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.storeSlug is string && data.storeSlug.size() >= 1 && data.storeSlug.size() <= 64 &&
        data.storeSlug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.tierLabel is string && data.tierLabel.size() >= 1 && data.tierLabel.size() <= 120 &&
        data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 100000 &&
        data.status is string && data.status.size() >= 1 && data.status.size() <= 32 &&
        (data.status == 'processing' || data.status == 'dispatched' || data.status == 'completed') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Admins lookup collection (read-only from client, managed server-side)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Collection 1: /users/{userId} (PII Isolated to Owner or Admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Collection 2: /storeAudits/{auditId}
    match /storeAudits/{auditId} {
      allow get: if isSignedIn() && isValidId(auditId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(auditId) &&
        isValidStoreAudit(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(auditId) &&
        isValidStoreAudit(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().storeSlug == existing().storeSlug &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['auditScore', 'status', 'summary', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(auditId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection 3: /storeOrders/{orderId}
    match /storeOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidStoreOrder(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidStoreOrder(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().storeSlug == existing().storeSlug &&
        incoming().totalAmount == existing().totalAmount &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(orderId) && isAdmin();
    }
  }
}
