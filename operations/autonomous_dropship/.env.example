# ==============================================================================
# BIZIBEES AUTONOMOUS DROPSHIPPING & MULTI-CHANNEL CATALOG BOT
# Environment Configuration & Security Controls
# ==============================================================================

# --- Shopify Admin GraphQL API Configuration ---
SHOPIFY_SHOP_DOMAIN=bizibees-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# --- Autopilot Safety Controls ---
# Safe Mode Toggle:
# false = Staged as DRAFT awaiting 1-click merchant approval in Shopify Admin
# true  = Fully autonomous mode: products are set to ACTIVE and published to sales channels immediately
AUTOPILOT_AUTO_PUBLISH=false

# --- Inventory & Multi-Channel Locations ---
SUPPLIER_DOMESTIC_LOCATION_NAME=Supplier Warehouse
PRIMARY_BASE_LOCATION_NAME=Utah Base

# --- Multi-Channel Publishing Targets ---
# Comma-separated channel names (Online Store, TikTok Shop, eBay, Shop app, Facebook & Instagram)
ENABLED_SALES_CHANNELS=Online Store,TikTok,eBay,Point of Sale,Shop

# --- LLM AI Engines (Gemini & OpenAI Dual Fallback) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PRIMARY_LLM_PROVIDER=gemini # gemini or openai

# --- Trend & Advertising Intelligence APIs ---
TIKTOK_BUSINESS_API_KEY=tb_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_MARKETING_API_KEY=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_AD_ACCOUNT_ID=act_xxxxxxxxxxxxxxxxx

# --- Supplier Feeds (US Domestic Warehouse APIs) ---
CJ_DROPSHIPPING_API_KEY=cj_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZENDROP_API_KEY=zd_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIEXPRESS_AFFILIATE_APP_KEY=ae_xxxxxxxxxxxxxxxxxxxxxxx
ALIEXPRESS_AFFILIATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Autonomous Alerting & Executive Briefings ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# --- Autonomous Lifecycle & Prune Thresholds ---
TREND_SCORE_MIN_THRESHOLD=80.0
DAILY_PRODUCT_LAUNCH_TARGET=2
PRUNE_INACTIVE_DAYS_THRESHOLD=21
PRUNE_MAX_CTR_THRESHOLD=0.012 # 1.2% CTR threshold

# --- Database & Storage ---
DATABASE_PATH=data/autonomous_dropship.db
LOG_LEVEL=INFO
