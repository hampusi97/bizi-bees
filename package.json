{
  "name": "bizi-bees-os-x",
  "version": "1.0.0",
  "description": "Multi-Store E-Commerce Operating System (OS-X) & Autonomous Fleet Engine",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "deploy:theme": "shopify theme push --path . --ignore config/settings_data.json --live --allow-live",
    "deploy:theme:development": "shopify theme push --path . --ignore config/settings_data.json --development",
    "autopilot": ".venv/bin/python core/master_autopilot.py",
    "sourcing": ".venv/bin/python core/autonomous_sourcing_engine.py",
    "resale": ".venv/bin/python core/resale_arbitrage_scanner.py",
    "ebay:sync": ".venv/bin/python scripts/ebay_marketplace_exporter.py",
    "seo:generate": ".venv/bin/python scripts/seo_blog_generator.py",
    "harvest": ".venv/bin/python core/shopify_competitor_harvester.py",
    "books:curate": ".venv/bin/python core/open_library_curator.py",
    "suppliers:verify": ".venv/bin/python core/supplier_api_connector.py",
    "test": "node --import tsx --test lib/*.test.ts dropper-os/tests/*.test.ts firestore.rules.test.ts && npm run test:e2e",
    "test:unit": "node --import tsx --test lib/*.test.ts dropper-os/tests/*.test.ts firestore.rules.test.ts tests/api-auth.test.ts",
    "test:e2e": "playwright test tests/e2e_storefront.spec.ts",
    "test:e2e:headed": "playwright test tests/e2e_storefront.spec.ts --headed",
    "test:report": "playwright show-report",
    "test:security": "node --import tsx --test tests/api-auth.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "next": "^14.2.0",
    "pg": "^8.23.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
