{
  "name": "bizi-bees-os-x",
  "version": "1.0.0",
  "description": "Multi-Store E-Commerce Operating System (OS-X) & Autonomous Fleet Engine",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy:theme": "shopify theme push --path . --ignore config/settings_data.json --live --allow-live",
    "deploy:theme:development": "shopify theme push --path . --ignore config/settings_data.json --development",
    "test:e2e": "playwright test tests/e2e_storefront.spec.ts",
    "test:e2e:headed": "playwright test tests/e2e_storefront.spec.ts --headed",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
