{% comment %}
  Universal Dynamic Policy Generator
  File: snippets/universal-policies.liquid
  Purpose: Injects transparent, payment-processor-compliant shipping, return, and legal terms
           to eliminate Stripe/Shopify Payments holds and customer disputes.
{% endcomment %}

{%- assign company_name = shop.name | default: "Luma Clinical LLC" -%}
{%- assign company_email = shop.email | default: "support@lumaclinical.com" -%}
{%- assign company_location = "Domestic US Logistics Facilities" -%}

<div class="universal-policies-wrapper">
  <div class="universal-policies-tabs">
    <button type="button" class="policy-tab-btn active" onclick="openPolicyTab(event, 'tab-shipping')">Shipping & Dispatch</button>
    <button type="button" class="policy-tab-btn" onclick="openPolicyTab(event, 'tab-returns')">60-Day Guarantee</button>
    <button type="button" class="policy-tab-btn" onclick="openPolicyTab(event, 'tab-security')">Payment Security</button>
    <button type="button" class="policy-tab-btn" onclick="openPolicyTab(event, 'tab-contact')">Merchant Support</button>
  </div>

  <div class="universal-policy-content active" id="tab-shipping">
    <h4>Domestic & Fast US Priority Shipping</h4>
    <p>All orders are processed automatically and dispatched within <strong>24 to 48 business hours</strong> from our domestic US logistics facilities. Tracking information from USPS or UPS is transmitted automatically via email and SMS the moment your carrier label is generated.</p>
    <ul>
      <li><strong>Standard US Priority (USPS Ground Advantage):</strong> 3–5 business days ($4.95 or FREE on orders $40+).</li>
      <li><strong>Express 2-Day Priority:</strong> 1–2 business days with expedited fulfillment ($9.95).</li>
      <li><strong>Tracking Guarantee:</strong> Real-time carrier tracking link with automated SMS milestone notifications provided on every shipment.</li>
    </ul>
  </div>

  <div class="universal-policy-content" id="tab-returns">
    <h4>60-Day Risk-Free Clinical Trial</h4>
    <p>We stand firmly behind the clinical efficacy of our devices. If you do not experience visible skin firming, contouring, or tension relief within <strong>60 days</strong> of receiving your device, return it for a full refund of your purchase price.</p>
    <ul>
      <li>No restocking fees on trial returns.</li>
      <li>Prepaid return labels available upon contacting support.</li>
      <li>To initiate a trial refund or replacement, email <strong>{{ company_email }}</strong> with your order number.</li>
    </ul>
  </div>

  <div class="universal-policy-content" id="tab-security">
    <h4>Bank-Grade 256-Bit SSL Encryption</h4>
    <p>Your transaction is processed directly through PCI-DSS Level 1 certified gateways including <strong>Shop Pay, Apple Pay, Google Pay, Visa, Mastercard, and American Express</strong>.</p>
    <p>We never store, inspect, or retain raw payment credentials. All sensitive checkout data is tokenized through secure end-to-end encryption.</p>
  </div>

  <div class="universal-policy-content" id="tab-contact">
    <h4>Registered Business Entity & Contact</h4>
    <p>We believe in 100% transparency. Our customer care and operations desk is based in Utah, USA.</p>
    <p><strong>Entity:</strong> {{ company_name }}<br>
    <strong>Headquarters:</strong> {{ company_location }}<br>
    <strong>Direct Concierge Desk:</strong> <a href="mailto:{{ company_email }}">{{ company_email }}</a><br>
    <strong>Response Window:</strong> Under 4 hours during Monday–Friday business hours.</p>
  </div>
</div>

<style>
  .universal-policies-wrapper { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 24px; margin: 30px 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 13px; color: #334155; }
  .universal-policies-tabs { display: flex; gap: 8px; border-bottom: 1px solid #E2E8F0; padding-bottom: 12px; margin-bottom: 16px; overflow-x: auto; }
  .policy-tab-btn { background: #F8FAFC; border: 1px solid #E2E8F0; color: #64748B; padding: 8px 16px; border-radius: 30px; font-size: 12px; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all 0.2s ease; }
  .policy-tab-btn:hover { background: #F1F5F9; color: #0F172A; }
  .policy-tab-btn.active { background: #0F172A; color: #FFFFFF; border-color: #0F172A; }
  .universal-policy-content { display: none; line-height: 1.6; }
  .universal-policy-content.active { display: block; animation: policyFadeIn 0.2s ease; }
  .universal-policy-content h4 { font-size: 14px; font-weight: 800; color: #0F172A; margin: 0 0 8px; }
  .universal-policy-content ul { padding-left: 20px; margin: 10px 0; }
  .universal-policy-content li { margin-bottom: 6px; }
  @keyframes policyFadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  function openPolicyTab(evt, tabId) {
    const parent = evt.target.closest('.universal-policies-wrapper');
    parent.querySelectorAll('.universal-policy-content').forEach(c => c.classList.remove('active'));
    parent.querySelectorAll('.policy-tab-btn').forEach(b => b.classList.remove('active'));
    parent.querySelector('#' + tabId).classList.add('active');
    evt.target.classList.add('active');
  }
</script>
