{% comment %}
  Universal Automated Policies & Regulatory Compliance Engine
  Repo: bizi-bees /snippets/universal-policies.liquid
  Dynamic Liquid compliance documentation with interactive DTC aesthetic
{% endcomment %}

<div class="universal-policies-wrapper" id="universal-policies-root">
  <div class="policies-header">
    <div class="policies-badge-row">
      <span class="policy-pill pill-teal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        VERIFIED STORE POLICIES &amp; COMPLIANCE
      </span>
      <span class="policy-pill pill-amber">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        60-DAY CLINICAL GUARANTEE ACTIVE
      </span>
    </div>
    <h2 class="policies-headline">{{ shop.name }} Universal Policies &amp; Trust Architecture</h2>
    <p class="policies-subhead">
      Transparent fulfillment standards, clinical-grade return guarantees, and FDA cosmetic device compliance for all orders dispatched from our Provo domestic studio and specialized logistics hubs.
    </p>

    <!-- Navigation Tabs -->
    <div class="policy-nav-tabs" role="tablist">
      <button type="button" class="policy-tab active" data-target="tab-guarantee" role="tab" aria-selected="true">
        <span class="tab-icon">🛡️</span>
        <span>60-Day Guarantee</span>
      </button>
      <button type="button" class="policy-tab" data-target="tab-shipping" role="tab" aria-selected="false">
        <span class="tab-icon">📦</span>
        <span>Shipping &amp; SLAs</span>
      </button>
      <button type="button" class="policy-tab" data-target="tab-fda" role="tab" aria-selected="false">
        <span class="tab-icon">⚖️</span>
        <span>FDA Disclaimers</span>
      </button>
      <button type="button" class="policy-tab" data-target="tab-contact" role="tab" aria-selected="false">
        <span class="tab-icon">💬</span>
        <span>RMA &amp; Support</span>
      </button>
    </div>
  </div>

  <!-- Tab Content Panels -->
  <div class="policies-body">
    <!-- PANEL 1: 60-DAY GUARANTEE -->
    <div class="policy-panel active" id="tab-guarantee" role="tabpanel">
      <div class="policy-card highlight-card">
        <div class="policy-card-icon teal-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div class="policy-card-content">
          <div class="card-eyebrow">RISK-FREE CLINICAL SATISFACTION PROTOCOL</div>
          <h3>The {{ shop.name }} 60-Day Risk-Free Trial Guarantee</h3>
          <p class="lead-text">
            We hold our products to the highest standard of efficacy and craftsmanship. Every purchase through <strong>{{ shop.name }}</strong> (including all Luma Wellness&trade; devices and curated catalog finds) is automatically safeguarded by our comprehensive <strong>60-Day Money-Back Guarantee</strong>.
          </p>

          <div class="policy-points-grid">
            <div class="point-box">
              <div class="point-header">
                <span class="check-bullet">✓</span>
                <strong>60 Calendar Days to Test</strong>
              </div>
              <p>Your 60-day trial clock begins the day your package is marked as delivered by the carrier (USPS, UPS, or FedEx), not the purchase date.</p>
            </div>

            <div class="point-box">
              <div class="point-header">
                <span class="check-bullet">✓</span>
                <strong>100% Full Refund Guarantee</strong>
              </div>
              <p>If you do not see visible improvements in skin radiance, texture, contouring, or are unsatisfied for any reason, receive a full 100% refund of your purchase price.</p>
            </div>

            <div class="point-box">
              <div class="point-header">
                <span class="check-bullet">✓</span>
                <strong>Zero Restocking Fees</strong>
              </div>
              <p>Unlike traditional retailers, {{ shop.name }} charges $0.00 in hidden restocking or inspection fees on qualified guarantee returns.</p>
            </div>

            <div class="point-box">
              <div class="point-header">
                <span class="check-bullet">✓</span>
                <strong>Instant RMA Authorization</strong>
              </div>
              <p>Simply send your order number to <a href="mailto:{{ shop.email }}" class="policy-link">{{ shop.email }}</a> to receive your prepaid Return Merchandise Authorization within 24 business hours.</p>
            </div>
          </div>

          <div class="policy-callout-box teal-bg">
            <strong>Simple 3-Step RMA Return Process:</strong>
            <ol class="stepper-list">
              <li><strong>Step 1:</strong> Email our support desk at <a href="mailto:{{ shop.email }}">{{ shop.email }}</a> with your Order ID and return request within 60 days of delivery.</li>
              <li><strong>Step 2:</strong> Receive your RMA barcode and domestic return instructions within 24 hours.</li>
              <li><strong>Step 3:</strong> Once received and scanned at our inspection facility, your refund is credited directly to your original payment method (Shop Pay, Apple Pay, Visa, Mastercard, AMEX) within 48 business hours.</li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <!-- PANEL 2: SHIPPING SLAS -->
    <div class="policy-panel" id="tab-shipping" role="tabpanel">
      <div class="policy-card">
        <div class="policy-card-icon amber-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="policy-card-content">
          <div class="card-eyebrow">FULFILLMENT DISPATCH &amp; TRANSIT PROTOCOLS</div>
          <h3>Shipping SLAs &amp; Dual-Facility Logistics Architecture</h3>
          <p class="lead-text">
            {{ shop.name }} utilizes a synchronized dual-hub fulfillment system to guarantee rapid turnaround, pristine quality control, and minimal carbon transit miles across the continental United States and worldwide.
          </p>

          <!-- SLA Table -->
          <div class="sla-table-wrapper">
            <table class="sla-table">
              <thead>
                <tr>
                  <th>Fulfillment Node</th>
                  <th>Inventory Category</th>
                  <th>Handling &amp; Dispatch SLA</th>
                  <th>Transit Window</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>
                    <strong>Provo Domestic Studio</strong><br>
                    <small>Utah County, UT — USA</small>
                  </td>
                  <td>Vintage Finds, Books, Hand-inspected Pre-loved Vault items</td>
                  <td><span class="badge-fast">24 Hours (Same/Next Day)</span></td>
                  <td>2–4 Business Days (USPS Priority / Tracked Ground)</td>
                </tr>
                <tr>
                  <td>
                    <strong>Specialized Logistics Facility</strong><br>
                    <small>Domestic Certified Hub</small>
                  </td>
                  <td>Luma Wellness&trade; Facial Wands, Serums, LED Masks &amp; Bundles</td>
                  <td><span class="badge-fast">24–48 Business Hours</span></td>
                  <td>2–4 Business Days (Tracked Air Express / USPS)</td>
                </tr>
                <tr>
                  <td>
                    <strong>Hybrid / Multi-Item Orders</strong><br>
                    <small>Auto-Split Routing</small>
                  </td>
                  <td>Mixed orders containing both vintage items and clinical wellness tech</td>
                  <td><span class="badge-fast">Simultaneous Dispatch</span></td>
                  <td>Items ship concurrently with independent tracking numbers at no added charge</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="shipping-perks-row">
            <div class="perk-card">
              <span class="perk-icon">⚡</span>
              <h4>Automated Free Shipping Trigger</h4>
              <p>All US orders totaling $50.00 or more, as well as our featured Glow Ritual and Clinical Spa bundles, automatically qualify for 100% Free Tracked Shipping at checkout.</p>
            </div>
            <div class="perk-card">
              <span class="perk-icon">📍</span>
              <h4>End-to-End Carrier Tracking</h4>
              <p>Real-time USPS/carrier tracking links are generated automatically and sent via email/SMS immediately when package manifests are created.</p>
            </div>
            <div class="perk-card">
              <span class="perk-icon">🛡️</span>
              <h4>100% Transit Protection</h4>
              <p>Every shipment is fully insured against theft, loss, or transit damage. If carrier tracking confirms a damaged or lost parcel, {{ shop.name }} dispatches an immediate replacement at zero cost.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PANEL 3: FDA DISCLAIMERS -->
    <div class="policy-panel" id="tab-fda" role="tabpanel">
      <div class="policy-card">
        <div class="policy-card-icon slate-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0F172A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div class="policy-card-content">
          <div class="card-eyebrow">REGULATORY DISCLOSURES &amp; MEDICAL DISCLAIMERS</div>
          <h3>FDA Cosmetic Device Compliance &amp; Consumer Safety Standards</h3>
          <p class="lead-text">
            {{ shop.name }} operates in strict adherence with United States Food and Drug Administration (FDA) guidelines, Federal Trade Commission (FTC) truth-in-advertising regulations, and 21 CFR Section 801 labeling provisions.
          </p>

          <div class="regulatory-alert-box">
            <div class="alert-symbol">⚠️</div>
            <div class="alert-content">
              <strong>MANDATORY FDA REGULATORY DISCLAIMER:</strong>
              <p>
                Statements and cosmetic devices presented on <strong>{{ shop.name }}</strong> (accessible at {{ shop.url }}) have not been evaluated by the United States Food and Drug Administration (FDA). These products are not intended to diagnose, treat, cure, mitigate, or prevent any disease, chronic medical condition, or dermatological illness.
              </p>
            </div>
          </div>

          <div class="compliance-sections">
            <div class="compliance-item">
              <h4>1. Cosmetic Device Classification</h4>
              <p>
                The LumaGlow 4-in-1 Facial Wand, LumaMask, and related wellness items are non-invasive aesthetic cosmetic wellness devices classified under FDA General Wellness Guidance (Class I / 510(k) exempt aesthetic cosmetic stimulators). They are designed solely for topical beauty maintenance, facial massage, superficial thermal warmth (under 107°F / 41.6°C), cosmetic microcurrent skin toning, and 630nm non-ionizing optical photobiomodulation.
              </p>
            </div>

            <div class="compliance-item">
              <h4>2. Health Precautionary Contraindications</h4>
              <p>
                Consult your qualified dermatologist or physician prior to use if you have:
              </p>
              <ul class="contraindication-list">
                <li>An active implanted electrical device (cardiac pacemaker, defibrillator, or neurostimulator).</li>
                <li>Active facial cancer, open skin lesions, severe cystic lesions, or undiagnosed skin rashes.</li>
                <li>Current pregnancy or are currently undergoing active oncological treatments.</li>
                <li>Diagnosed epilepsy, seizures triggered by light, or acute thyroid disorders.</li>
              </ul>
            </div>

            <div class="compliance-item">
              <h4>3. Truth in Results &amp; Individual Variability</h4>
              <p>
                Clinical figures, user testimonials, and before/after comparisons presented on {{ shop.name }} reflect individual customer experiences over a consistent daily 5-to-10 minute protocol. Individual skin physiology, age, dermal hydration, and genetic baseline vary; individual results may differ.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PANEL 4: RMA & CONTACT -->
    <div class="policy-panel" id="tab-contact" role="tabpanel">
      <div class="policy-card">
        <div class="policy-card-icon teal-glow">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="policy-card-content">
          <div class="card-eyebrow">DIRECT CONTACT &amp; RESOLUTION DESK</div>
          <h3>Dedicated Customer Care &amp; Warranty Inquiries</h3>
          <p class="lead-text">
            Have a question regarding an active order, tracking SLA, or requesting a 60-Day Guarantee return authorization? Our dedicated team is ready to assist you.
          </p>

          <div class="contact-channels-grid">
            <div class="channel-card">
              <span class="channel-emoji">✉️</span>
              <h4>Email Support Desk</h4>
              <p>Direct priority email for all RMA, warranty, and order inquiries:</p>
              <a href="mailto:{{ shop.email }}" class="channel-action">{{ shop.email }}</a>
              <small>Response SLA: Under 12 business hours</small>
            </div>

            <div class="channel-card">
              <span class="channel-emoji">🏢</span>
              <h4>Domestic Workshop &amp; Studio</h4>
              <p>Kimberly Harter — {{ shop.name }}</p>
              <div class="channel-address">
                Provo, Utah, United States<br>
                Zip Code: 84601 / 84604
              </div>
              <small>Domestic Returns &amp; Quality Inspection Hub</small>
            </div>

            <div class="channel-card">
              <span class="channel-emoji">⏱️</span>
              <h4>Operating Hours</h4>
              <p>Monday – Friday: 8:00 AM – 6:00 PM MST<br>
              Saturday: 9:00 AM – 2:00 PM MST<br>
              Sunday: Automated system monitoring</p>
              <small>Same-day dispatch cut-off: 5:00 PM MST</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Modern DTC Aesthetic Tokens */
  .universal-policies-wrapper {
    background: #FFFFFF;
    color: #0F172A;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    padding: 40px 24px;
    max-width: 1040px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .policies-header {
    text-align: center;
    margin-bottom: 36px;
  }
  .policies-badge-row {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .policy-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 9999px;
  }
  .pill-teal {
    background: #F0FDFA;
    color: #0D9488;
    border: 1px solid #99F6E4;
  }
  .pill-amber {
    background: #FFFBEB;
    color: #D97706;
    border: 1px solid #FDE68A;
  }
  .policies-headline {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 900;
    color: #0F172A;
    letter-spacing: -0.03em;
    margin: 0 0 12px 0;
  }
  .policies-subhead {
    max-width: 720px;
    margin: 0 auto 28px;
    color: #475569;
    font-size: 15px;
  }
  
  /* Tab Navigation */
  .policy-nav-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    background: #F8FAFC;
    padding: 8px;
    border-radius: 14px;
    border: 1px solid #E2E8F0;
    max-width: 680px;
    margin: 0 auto;
  }
  .policy-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #475569;
    border: none;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 700;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .policy-tab:hover {
    color: #0F172A;
    background: #EDF2F7;
    transform: translateY(-1px) scale(1.02);
  }
  .policy-tab.active {
    background: #FFFFFF;
    color: #0D9488;
    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.12);
  }

  /* Panels */
  .policy-panel {
    display: none;
    animation: fadeInPolicy 0.3s ease;
  }
  .policy-panel.active {
    display: block;
  }
  @keyframes fadeInPolicy {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Cards */
  .policy-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    padding: 36px 32px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }
  .highlight-card {
    background: #FFFFFF;
    border: 2px solid #CCFBF1;
    box-shadow: 0 12px 32px rgba(13, 148, 136, 0.08);
  }
  .policy-card-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .teal-glow {
    background: #F0FDFA;
    border: 1px solid #99F6E4;
  }
  .amber-glow {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
  }
  .slate-glow {
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
  }
  .policy-card-content {
    flex: 1;
  }
  .card-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0D9488;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .policy-card-content h3 {
    font-size: 24px;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }
  .lead-text {
    font-size: 15px;
    color: #334155;
    margin-bottom: 24px;
    line-height: 1.65;
  }

  /* Points Grid */
  .policy-points-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .point-box {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 16px 18px;
  }
  .point-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    color: #0F172A;
  }
  .check-bullet {
    color: #0D9488;
    font-weight: 900;
  }
  .point-box p {
    font-size: 13px;
    color: #64748B;
    margin: 0;
    line-height: 1.5;
  }

  /* Callout & Stepper */
  .policy-callout-box {
    border-radius: 14px;
    padding: 20px 22px;
    margin-top: 20px;
  }
  .teal-bg {
    background: #F0FDFA;
    border: 1px solid #99F6E4;
    color: #0F766E;
  }
  .stepper-list {
    margin: 12px 0 0 0;
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.7;
    color: #134E4A;
  }
  .stepper-list li {
    margin-bottom: 6px;
  }

  /* Shipping SLA Table */
  .sla-table-wrapper {
    overflow-x: auto;
    margin: 20px 0;
    border-radius: 12px;
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
  }
  .sla-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }
  .sla-table th {
    background: #F8FAFC;
    padding: 12px 16px;
    font-weight: 700;
    color: #334155;
    border-bottom: 1px solid #E2E8F0;
  }
  .sla-table td {
    padding: 14px 16px;
    border-bottom: 1px solid #F1F5F9;
    color: #334155;
    vertical-align: top;
  }
  .badge-fast {
    display: inline-block;
    background: #ECFDF5;
    color: #059669;
    border: 1px solid #A7F3D0;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
  }

  /* Shipping Perks */
  .shipping-perks-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }
  .perk-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 18px 16px;
    text-align: left;
  }
  .perk-icon {
    font-size: 22px;
    display: block;
    margin-bottom: 8px;
  }
  .perk-card h4 {
    margin: 0 0 6px 0;
    font-size: 14px;
    font-weight: 800;
    color: #0F172A;
  }
  .perk-card p {
    margin: 0;
    font-size: 12px;
    color: #64748B;
    line-height: 1.5;
  }

  /* Regulatory Alert Box */
  .regulatory-alert-box {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: #FFFBEB;
    border: 2px solid #FCD34D;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 24px;
  }
  .alert-symbol {
    font-size: 24px;
    line-height: 1;
  }
  .alert-content strong {
    display: block;
    font-size: 13px;
    color: #92400E;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .alert-content p {
    margin: 0;
    font-size: 13px;
    color: #78350F;
    line-height: 1.6;
  }
  .compliance-item {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 14px;
  }
  .compliance-item h4 {
    margin: 0 0 8px 0;
    font-size: 15px;
    font-weight: 800;
    color: #0F172A;
  }
  .compliance-item p {
    margin: 0;
    font-size: 13px;
    color: #475569;
    line-height: 1.6;
  }
  .contraindication-list {
    margin: 8px 0 0 0;
    padding-left: 20px;
    font-size: 13px;
    color: #475569;
    line-height: 1.6;
  }
  .contraindication-list li {
    margin-bottom: 4px;
  }

  /* Contact Channels */
  .contact-channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .channel-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 20px 18px;
    text-align: center;
  }
  .channel-emoji {
    font-size: 28px;
    display: block;
    margin-bottom: 8px;
  }
  .channel-card h4 {
    font-size: 15px;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 8px 0;
  }
  .channel-card p {
    font-size: 12px;
    color: #64748B;
