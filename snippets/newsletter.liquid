<section class="wrap block"><div class="story"><div><p class="eyebrow">The weekly buzz</p><h2>Fresh finds.<br>Straight to your inbox.</h2><p>Sign up for weekly emails with new arrivals and selected deals from bizi bees.</p></div><div>{% form 'customer', id: 'WeeklyNewsletter' %}<input type="hidden" name="contact[tags]" value="newsletter,weekly-buzz">{% if form.posted_successfully? %}<p role="status">Thanks for signing up! If you receive a confirmation email, confirm your subscription there.</p>{% else %}{{ form.errors | default_errors }}<label for="NewsletterEmail">Email address</label><input id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com"><button type="submit">Sign me up</button><p class="muted">By signing up, you agree to receive weekly marketing emails from bizi bees. Unsubscribe anytime. <a href="{{ shop.privacy_policy.url }}">Privacy policy</a></p>{% endif %}{% endform %}</div></div></section>
