{% comment %}
  Bizi Bees - Editorial Newsletter Signup
  Matches boutique design system (olive / warm linen / serif headings).
{% endcomment %}

<section class="boutique-newsletter wrap">
  <div class="newsletter-card">
    <div class="newsletter-copy">
      <span class="newsletter-eyebrow">Insider Circle</span>
      <h2 class="newsletter-heading">Quiet updates. Honest finds.</h2>
      <p class="newsletter-text">
        Occasional notes on new shelf arrivals, careful condition guides, and a standing 35% welcome offer with code <strong>PROVOTODAY</strong>. Free standard shipping on US orders over $35.
      </p>
      <ul class="newsletter-perks">
        <li>Instant welcome discount</li>
        <li>No spam — only useful drops</li>
        <li>Unsubscribe anytime</li>
      </ul>
    </div>

    <div class="newsletter-form-wrap">
      {% form 'customer', id: 'WeeklyNewsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter,vip-launch,35-off">
        {% if form.posted_successfully? %}
          <div class="newsletter-success">
            <h3>You're on the list</h3>
            <p>Your welcome code is <strong class="code-pill">PROVOTODAY</strong></p>
            <a href="/discount/PROVOTODAY?redirect=/collections/all" class="boutique-btn-primary">Shop with 35% off</a>
          </div>
        {% else %}
          {{ form.errors | default_errors }}
          <label for="NewsletterEmail" class="newsletter-label">Email address</label>
          <div class="newsletter-row">
            <input
              id="NewsletterEmail"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              placeholder="you@example.com"
              class="newsletter-input"
            >
            <button type="submit" class="boutique-btn-primary newsletter-submit">Join</button>
          </div>
          <p class="newsletter-fineprint">
            By signing up you agree to receive occasional marketing from Bizi Bees. Unsubscribe anytime.
          </p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  .boutique-newsletter {
    padding: 48px 24px 64px;
  }
  .newsletter-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 16px;
    padding: 40px 36px;
    box-shadow: 0 4px 20px rgba(28, 25, 23, 0.04);
  }
  .newsletter-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2D3B2D;
    margin-bottom: 10px;
  }
  .newsletter-heading {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(26px, 3.5vw, 34px);
    font-weight: 700;
    color: #1C1917;
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .newsletter-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: #78716C;
    margin: 0 0 16px;
    max-width: 460px;
  }
  .newsletter-perks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    font-size: 12.5px;
    font-weight: 600;
    color: #2D3B2D;
  }
  .newsletter-perks li::before {
    content: "✓ ";
  }
  .newsletter-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #44403C;
    margin-bottom: 8px;
  }
  .newsletter-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .newsletter-input {
    flex: 1;
    min-width: 200px;
    padding: 13px 14px;
    border: 1px solid #E7E5E4;
    border-radius: 8px;
    background: #FAF7F2;
    color: #1C1917;
    font-size: 14px;
  }
  .newsletter-input:focus {
    outline: 2px solid #2D3B2D;
    outline-offset: 1px;
    border-color: #2D3B2D;
  }
  .newsletter-submit {
    white-space: nowrap;
  }
  .newsletter-fineprint {
    font-size: 11px;
    color: #A8A29E;
    margin: 10px 0 0;
  }
  .newsletter-success {
    background: #EEF2ED;
    border: 1px solid #D6D3D1;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
  }
  .newsletter-success h3 {
    font-family: "Playfair Display", Georgia, serif;
    margin: 0 0 8px;
    color: #1C1917;
  }
  .newsletter-success p {
    margin: 0 0 14px;
    color: #57534E;
    font-size: 14px;
  }
  .code-pill {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: #FFFFFF;
    border: 1px dashed #2D3B2D;
    padding: 2px 8px;
    border-radius: 6px;
    color: #2D3B2D;
  }
  @media (max-width: 768px) {
    .newsletter-card {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 28px 22px;
    }
  }
</style>
