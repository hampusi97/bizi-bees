{% comment %}
  Dynamic Real-Time Free Shipping Threshold Bar — Bizi Bees Boutique
  Repo: bizi-bees /snippets/dynamic-free-shipping-bar.liquid
  Threshold: $35.00 (3500 cents)
{% endcomment %}

{% assign free_shipping_threshold = 3500 %} <!-- Threshold set to $35.00 (in cents) -->
{% assign cart_total = cart.total_price %}
{% assign remaining_amount = free_shipping_threshold | minus: cart_total %}
{% assign progress_pct = cart_total | times: 100.0 | divided_by: free_shipping_threshold %}
{% if progress_pct > 100 %}{% assign progress_pct = 100 %}{% endif %}

<div class="dynamic-shipping-bar-container" id="shippingBarContainer">
  <div class="shipping-bar-text" id="shippingBarText">
    {% if cart_total >= free_shipping_threshold %}
      🎉 <strong style="color: #29231E;">Unlocked! You've qualified for FREE US Tracked Shipping! 📦</strong>
    {% else %}
      🐝 You are only <strong class="shipping-highlight" id="shippingRemaining">${{ remaining_amount | money_without_currency }}</strong> away from <strong>FREE US Tracked Shipping</strong>!
    {% endif %}
  </div>

  <div class="shipping-progress-track">
    <div class="shipping-progress-bar {% if cart_total >= free_shipping_threshold %}completed{% endif %}" id="shippingProgressBar" style="width: {{ progress_pct }}%;">
      <span class="truck-icon">🐝</span>
    </div>
  </div>
</div>

<style>
  .dynamic-shipping-bar-container {
    width: 100%;
    background: #FAF7F2;
    border-bottom: 1px solid #EADBCE;
    padding: 10px 16px 12px;
    box-sizing: border-box;
    text-align: center;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Georgia, serif;
    position: relative;
    z-index: 999;
  }
  .shipping-bar-text {
    font-size: 13px;
    font-weight: 600;
    color: #29231E;
    margin-bottom: 8px;
    letter-spacing: -0.2px;
  }
  .shipping-highlight {
    color: #D9822B;
    font-weight: 800;
    font-size: 14px;
  }
  .shipping-progress-track {
    position: relative;
    max-width: 500px;
    height: 7px;
    background: #EADBCE;
    border-radius: 20px;
    margin: 0 auto;
    overflow: visible;
  }
  .shipping-progress-bar {
    position: relative;
    height: 100%;
    background: linear-gradient(90deg, #D9822B 0%, #B86B1F 100%);
    border-radius: 20px;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shipping-progress-bar.completed {
    background: #4B5842;
    box-shadow: 0 0 10px rgba(75, 88, 66, 0.4);
  }
  .truck-icon {
    position: absolute;
    right: -10px;
    top: -9px;
    font-size: 13px;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
    transition: all 0.3s ease;
  }
  @media (max-width: 600px) {
    .shipping-bar-text { font-size: 12px; }
    .shipping-progress-track { max-width: 100%; }
  }
</style>

<script>
  (function() {
    const THRESHOLD = 3500; // $35.00 in cents

    // Real-Time Interceptor: Listens for any Add to Cart or Quantity Change
    function refreshShippingBar() {
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          const total = cart.total_price;
          const container = document.getElementById('shippingBarContainer');
          const textEl = document.getElementById('shippingBarText');
          const barEl = document.getElementById('shippingProgressBar');

          if (!container || !textEl || !barEl) return;

          let pct = (total / THRESHOLD) * 100;
          if (pct > 100) pct = 100;
          barEl.style.width = pct + '%';

          if (total >= THRESHOLD) {
            barEl.classList.add('completed');
            textEl.innerHTML = `🎉 <strong style="color: #29231E;">Unlocked! You've qualified for FREE US Tracked Shipping! 📦</strong>`;
          } else {
            barEl.classList.remove('completed');
            const diff = ((THRESHOLD - total) / 100).toFixed(2);
            textEl.innerHTML = `🐝 You are only <strong class="shipping-highlight">$${diff}</strong> away from <strong>FREE US Tracked Shipping</strong>!`;
          }
        })
        .catch(err => console.debug('Shipping bar refresh notice:', err));
    }

    // Automatically recalculates when cart drawer opens or items change
    document.addEventListener('cart:updated', refreshShippingBar);
    document.addEventListener('cart:change', refreshShippingBar);

    // Global fetch listener to catch any custom theme AJAX cart updates
    const origFetch = window.fetch;
    window.fetch = function() {
      return origFetch.apply(this, arguments).then(response => {
        if (arguments[0] && typeof arguments[0] === 'string' && (arguments[0].includes('/cart/add') || arguments[0].includes('/cart/change'))) {
          setTimeout(refreshShippingBar, 300);
        }
        return response;
      });
    };
  })();
</script>
