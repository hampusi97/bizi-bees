{% comment %}
  Dynamic free-shipping progress bar
  Threshold: $40.00 USD (4000 cents)
  Updates on cart:updated without full reload when Shopify Cart AJAX is available.
{% endcomment %}

{% assign threshold_cents = 4000 %}
{% assign cart_total = cart.total_price %}
{% assign remaining = threshold_cents | minus: cart_total %}
{% if remaining < 0 %}{% assign remaining = 0 %}{% endif %}
{% assign progress_pct = cart_total | times: 100.0 | divided_by: threshold_cents %}
{% if progress_pct > 100 %}{% assign progress_pct = 100 %}{% endif %}

<div
  id="bizi-ship-bar"
  class="bizi-ship-bar{% if remaining == 0 %} is-unlocked{% endif %}"
  data-threshold="{{ threshold_cents }}"
  data-cart-total="{{ cart_total }}"
  role="status"
  aria-live="polite"
>
  <div class="bizi-ship-bar__inner">
    <div class="bizi-ship-bar__copy" id="bizi-ship-bar-copy">
      {% if remaining == 0 %}
        You've unlocked FREE Priority Shipping
      {% else %}
        You are only <strong id="bizi-ship-remaining">{{ remaining | money }}</strong> away from FREE Priority Shipping
      {% endif %}
    </div>
    <div class="bizi-ship-bar__track" aria-hidden="true">
      <div class="bizi-ship-bar__fill" id="bizi-ship-bar-fill" style="width: {{ progress_pct }}%;"></div>
    </div>
  </div>
</div>

<style>
  .bizi-ship-bar {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #0F172A;
    color: #F8FAFC;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-bottom: 1px solid #1E293B;
  }
  .bizi-ship-bar.is-unlocked {
    background: #0D9488;
    border-bottom-color: #0F766E;
  }
  .bizi-ship-bar__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 10px 20px 12px;
  }
  .bizi-ship-bar__copy {
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    margin-bottom: 8px;
  }
  .bizi-ship-bar__copy strong {
    font-weight: 800;
  }
  .bizi-ship-bar__track {
    height: 6px;
    background: rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    overflow: hidden;
  }
  .bizi-ship-bar__fill {
    height: 100%;
    background: #F8FAFC;
    border-radius: 999px;
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bizi-ship-bar.is-unlocked .bizi-ship-bar__fill {
    background: #CCFBF1;
  }
</style>

<script>
(function () {
  var bar = document.getElementById('bizi-ship-bar');
  if (!bar) return;
  var threshold = parseInt(bar.getAttribute('data-threshold'), 10) || 4000;
  var fill = document.getElementById('bizi-ship-bar-fill');
  var copy = document.getElementById('bizi-ship-bar-copy');

  function money(cents) {
    try {
      return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: '{{ cart.currency.iso_code | default: shop.currency }}' });
    } catch (e) {
      return '$' + (cents / 100).toFixed(2);
    }
  }

  function render(totalCents) {
    var remaining = Math.max(0, threshold - totalCents);
    var pct = Math.min(100, (totalCents / threshold) * 100);
    if (fill) fill.style.width = pct + '%';
    if (remaining === 0) {
      bar.classList.add('is-unlocked');
      if (copy) copy.textContent = "You've unlocked FREE Priority Shipping";
    } else {
      bar.classList.remove('is-unlocked');
      if (copy) {
        copy.innerHTML = 'You are only <strong>' + money(remaining) + '</strong> away from FREE Priority Shipping';
      }
    }
  }

  document.addEventListener('cart:updated', function (event) {
    var detail = event.detail || {};
    var total = detail.total_price != null ? detail.total_price : null;
    if (total == null && detail.cart && detail.cart.total_price != null) total = detail.cart.total_price;
    if (total != null) render(parseInt(total, 10) || 0);
  });

  // Poll Shopify cart.js when theme does not emit cart:updated
  function refreshFromCartJs() {
    fetch('/cart.js', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (cart) { if (cart && typeof cart.total_price === 'number') render(cart.total_price); })
      .catch(function () {});
  }

  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t) return;
    if (t.closest('form[action*="/cart/add"], [name="add"], .ajax-cart, [data-add-to-cart]')) {
      setTimeout(refreshFromCartJs, 600);
    }
  });
})();
</script>
