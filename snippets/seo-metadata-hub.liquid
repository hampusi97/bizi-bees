{% comment %}
  Universal SEO Metadata Hub & Schema.org JSON-LD Engine
  Repo: bizi-bees /snippets/seo-metadata-hub.liquid
{% endcomment %}

{%- capture seo_title -%}
  {%- if request.page_type == 'search' and search.performed == true -%}
    {{ 'general.search.heading' | t: count: search.results_count }}: {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }} &ndash; {{ shop.name }}
  {%- elsif template.name == 'product' -%}
    {{ product.title | escape }} &ndash; {{ shop.name }}
  {%- elsif template.name == 'collection' and collection.title -%}
    {{ collection.title | escape }} &ndash; {{ shop.name }}
  {%- elsif template.name == 'article' -%}
    {{ article.title | escape }} &ndash; {{ shop.name }}
  {%- elsif page_title -%}
    {{ page_title | escape }} &ndash; {{ shop.name }}
  {%- else -%}
    {{ shop.name }} &ndash; Curated Luxury DTC Fleet
  {%- endif -%}
{%- endcapture -%}

{%- capture seo_description -%}
  {%- if page_description -%}
    {{ page_description | escape }}
  {%- elsif template.name == 'product' -%}
    {{ product.description | strip_html | truncatewords: 30 | escape }}
  {%- elsif template.name == 'collection' and collection.description != blank -%}
    {{ collection.description | strip_html | truncatewords: 30 | escape }}
  {%- else -%}
    Discover curated lifestyle essentials, boutique novelties, and clinical formulations with 100% verified fulfillment and fast domestic shipping.
  {%- endif -%}
{%- endcapture -%}

<!-- Canonical URL -->
<link rel="canonical" href="{{ canonical_url | default: shop.url }}">

<!-- OpenGraph Social Graph Protocol -->
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url | default: shop.url }}">
<meta property="og:title" content="{{ seo_title | strip | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% elsif template.name == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ seo_description | strip | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ page_image.width | default: 1200 }}">
  <meta property="og:image:height" content="{{ page_image.height | default: 630 }}">
{%- elsif product.featured_image -%}
  <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- endif -%}

{%- if template.name == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_newlines }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<!-- Twitter Card Metadata -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | strip | escape }}">
<meta name="twitter:description" content="{{ seo_description | strip | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- elsif product.featured_image -%}
  <meta name="twitter:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
{%- endif -%}

<!-- Universal Schema.org JSON-LD Knowledge Graph -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {
        "@type": "ImageObject",
        "@id": "{{ shop.url }}/#logo",
        "url": "{% if settings.logo %}{{ settings.logo | image_url: width: 500 }}{% else %}https://cdn.shopify.com/s/files/1/0778/2465/5527/files/bizibees-logo.png{% endif %}"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+1-801-555-0199",
        "contactType": "Customer Support",
        "areaServed": "US",
        "availableLanguage": ["English"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": {
        "@id": "{{ shop.url }}/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    {%- if template.name == 'product' -%}
    ,{
      "@type": "Product",
      "@id": "{{ canonical_url }}#product",
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ product.description | strip_html | truncatewords: 40 | json }},
      {%- if product.featured_image -%}
      "image": "https:{{ product.featured_image | image_url: width: 1000 }}",
      {%- endif -%}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
      "offers": {
        "@type": "Offer",
        "url": {{ canonical_url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": "{{ product.price | money_without_currency | remove: ',' }}",
        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
        "seller": {
          "@type": "Organization",
          "name": {{ shop.name | json }}
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "184"
      }
    }
    {%- elsif template.name == 'article' -%}
    ,{
      "@type": "Article",
      "@id": "{{ canonical_url }}#article",
      "headline": {{ article.title | json }},
      "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
      "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' }}",
      "author": {
        "@type": "Person",
        "name": {{ article.author | default: shop.name | json }}
      },
      "publisher": {
        "@id": "{{ shop.url }}/#organization"
      }
    }
    {%- endif -%}
  ]
}
</script>
