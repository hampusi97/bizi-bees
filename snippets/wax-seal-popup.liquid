{% comment %}
  Interactive "Break the Wax Seal" VIP Capture Modal
  Replaces the old PROVOTODAY popup with a tactile boutique experience.
{% endcomment %}

<div class="wax-modal-backdrop" id="waxModal" style="display: none;">
  <div class="wax-parchment-card">
    <button class="wax-close" onclick="closeWaxModal()">×</button>
    
    <div id="waxStep1">
      <span class="wax-tag">A SECRET NOTE FROM PROVO</span>
      <h3>You Found a Sealed Invitation</h3>
      <p>Tap the beeswax seal below to break open your mystery boutique gift &amp; first-order discount:</p>
      
      <div class="wax-seal-interactive" onclick="breakWaxSeal()">
        <div class="seal-circle" id="sealCircle">
          <span>🐝</span>
          <small>TAP TO BREAK</small>
        </div>
      </div>
    </div>

    <div id="waxStep2" style="display: none;">
      <span class="wax-tag-unlocked">✨ SEAL BROKEN • GIFT UNLOCKED!</span>
      <h3>15% Off + Free Brass Bee Bookmark</h3>
      <p>Use your secret code at checkout. Valid on all mystery book boxes, planners, and curated gifts today:</p>
      
      <div class="wax-code-box">
        <span>YOUR SECRET VIP CODE:</span>
        <strong>COZY15</strong>
      </div>

      <button class="wax-claim-btn" onclick="applyCozyCode()">Apply 15% Off &amp; Browse Treasures →</button>
    </div>

  </div>
</div>

<style>
  .wax-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(41, 35, 30, 0.65);
    backdrop-filter: blur(6px);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .wax-parchment-card {
    background: #FAF7F2;
    border: 2px solid #D6C2AF;
    border-radius: 22px;
    max-width: 440px;
    width: 100%;
    padding: 36px 28px;
    text-align: center;
    position: relative;
    box-shadow: 0 25px 60px rgba(0,0,0,0.35);
    color: #29231E;
  }
  .wax-close {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    font-size: 26px;
    color: #786C62;
    cursor: pointer;
  }
  .wax-tag, .wax-tag-unlocked {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: #FEF3C7;
    color: #92400E;
    padding: 5px 12px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 12px;
  }
  .wax-parchment-card h3 {
    font-family: Georgia, serif;
    font-size: 26px;
    margin: 0 0 10px;
    color: #29231E;
  }
  .wax-parchment-card p {
    font-size: 14px;
    color: #6E6257;
    line-height: 1.5;
    margin: 0 0 24px;
  }
  .wax-seal-interactive {
    display: flex;
    justify-content: center;
    margin: 20px 0 10px;
  }
  .seal-circle {
    width: 110px;
    height: 110px;
    background: radial-gradient(circle, #B91C1C 0%, #7F1D1D 100%);
    border: 4px double #FCA5A5;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #FEF2F2;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(127, 29, 29, 0.4);
    transition: transform 0.2s ease;
    animation: gentlePulse 2s infinite;
  }
  .seal-circle:hover { transform: scale(1.08); }
  .seal-circle span { font-size: 32px; }
  .seal-circle small { font-size: 9px; font-weight: 800; letter-spacing: 1px; margin-top: 4px; }
  @keyframes gentlePulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(185, 28, 28, 0.4); }
    50% { box-shadow: 0 0 0 12px rgba(185, 28, 28, 0); }
  }
  .wax-code-box {
    background: #FFFFFF;
    border: 2px dashed #D9822B;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 20px;
  }
  .wax-code-box span { display: block; font-size: 10px; color: #786C62; font-weight: 700; }
  .wax-code-box strong { font-size: 24px; color: #D9822B; letter-spacing: 2px; }
  .wax-claim-btn {
    width: 100%;
    background: #29231E;
    color: #FFFFFF;
    border: none;
    padding: 15px;
    border-radius: 50px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
  }
  .wax-claim-btn:hover { background: #D9822B; }
</style>

<script>
  (function() {
    if (!localStorage.getItem('bb_wax_seen')) {
      setTimeout(() => {
        const modal = document.getElementById('waxModal');
        if (modal) modal.style.display = 'flex';
      }, 6000);
    }
  })();

  function breakWaxSeal() {
    document.getElementById('waxStep1').style.display = 'none';
    document.getElementById('waxStep2').style.display = 'block';
    localStorage.setItem('bb_wax_seen', 'true');
  }

  function closeWaxModal() {
    document.getElementById('waxModal').style.display = 'none';
    localStorage.setItem('bb_wax_seen', 'true');
  }

  function applyCozyCode() {
    fetch('/discount/COZY15').then(() => {
      closeWaxModal();
    });
  }
</script>
