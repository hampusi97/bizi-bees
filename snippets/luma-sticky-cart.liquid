{% comment %}
  Luma Clinical - Sticky Mobile 1-Click Buy Bar
  File: snippets/luma-sticky-cart.liquid
{% endcomment %}

<div class="luma-sticky-bar" id="lumaStickyBar">
  <div class="luma-sticky-content">
    <div class="luma-sticky-status">
      <span class="live-dot"></span>
      <div class="status-text">
        <strong>In Stock — Utah Dispatch</strong>
        <small>Dispatches in 24h via USPS Priority</small>
      </div>
    </div>
    <button type="button" class="luma-buy-now-btn" onclick="lumaDirectBuy()">
      <span>CLAIM DEAL — $39.99</span>
      <small>Complimentary US Dispatch</small>
    </button>
  </div>
</div>

<style>
  .luma-sticky-bar { 
    position: fixed; 
    bottom: 0; 
    left: 0; 
    width: 100%; 
    background: #ffffff; 
    box-shadow: 0 -10px 30px rgba(0,0,0,0.12); 
    border-top: 1px solid #e2e8f0; 
    padding: 12px 18px; 
    box-sizing: border-box; 
    z-index: 99999; 
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
  }
  .luma-sticky-content { 
    max-width: 900px; 
    margin: 0 auto; 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    gap: 12px; 
  }
  .luma-sticky-status { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
  }
  .live-dot { 
    width: 10px; 
    height: 10px; 
    background: #10b981; 
    border-radius: 50%; 
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.25); 
    flex-shrink: 0;
  }
  .status-text strong { 
    display: block; 
    font-size: 13px; 
    color: #0f172a; 
    line-height: 1.2;
  }
  .status-text small { 
    font-size: 11px; 
    color: #64748b; 
  }
  .luma-buy-now-btn { 
    background: #0F172A; 
    color: #ffffff; 
    border: none; 
    padding: 10px 24px; 
    border-radius: 50px; 
    cursor: pointer; 
    box-shadow: 0 4px 15px rgba(15, 23, 42, 0.2); 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    transition: all 0.2s ease;
  }
  .luma-buy-now-btn:hover { 
    background: #0D9488; 
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(13, 148, 136, 0.3);
  }
  .luma-buy-now-btn span { 
    font-size: 14px; 
    font-weight: 800; 
  }
  .luma-buy-now-btn small { 
    font-size: 10px; 
    opacity: 0.9; 
  }

  @media(max-width: 480px) {
    .status-text small { display: none; }
    .luma-buy-now-btn { padding: 9px 18px; }
  }
</style>

<script>
  function lumaDirectBuy() {
    const form = document.querySelector('form[action*="/cart/add"]');
    if (form) {
      const idInput = form.querySelector('input[name="id"], select[name="id"]');
      if (idInput && idInput.value) {
        window.location.href = '/cart/' + idInput.value + ':1';
        return;
      }
    }
    window.location.href = '/products/lumaglow-4-in-1-facial-wand';
  }
</script>
