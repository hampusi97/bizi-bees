<a class="card" href="{{ product.url }}"><div class="card-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,400,600', sizes: '(max-width:600px) 45vw, 23vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ product.title | escape }}</h3>{% if product.metafields.custom.condition != blank %}<span class="badge">{{ product.metafields.custom.condition.value | escape }}</span>{% endif %}<p class="price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}{% unless product.available %} · Sold out{% endunless %}</p></a>
