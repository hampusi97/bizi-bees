{% comment %}
  The Direct Advantage Matrix (Anti-Amazon Quality Assurance)
  Repo: bizi-bees /snippets/anti-amazon-badges.liquid
{% endcomment %}

<div class="direct-vs-amazon-box">
  <div class="dva-header">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    <h4>Why Ordering Direct Beats Third-Party Resellers</h4>
  </div>
  <div class="dva-grid">
    <div class="dva-row">
      <span class="dva-feat">Verified Small-Batch Authenticity:</span>
      <span class="dva-direct">✓ Fresh Workshop Batch</span>
      <span class="dva-amazon">✕ Commingled Warehouses</span>
    </div>
    <div class="dva-row">
      <span class="dva-feat">Extended In-Home Guarantee:</span>
      <span class="dva-direct">✓ 60 Days</span>
      <span class="dva-amazon">✕ 30 Days</span>
    </div>
    <div class="dva-row">
      <span class="dva-feat">Curated Complimentary Gifts:</span>
      <span class="dva-direct">✓ Included Free</span>
      <span class="dva-amazon">✕ None</span>
    </div>
    <div class="dva-row">
      <span class="dva-feat">Careful Sustainable Packaging:</span>
      <span class="dva-direct">✓ Gift-Ready Box</span>
      <span class="dva-amazon">✕ Poly Mailer Bag</span>
    </div>
  </div>
</div>

<style>
  .direct-vs-amazon-box {
    background: #FFFFFF;
    border: 1px solid var(--border-subtle, #E7E5E4);
    border-radius: 12px;
    padding: 18px 20px;
    margin: 20px 0;
    font-family: var(--font-sans, -apple-system, sans-serif);
    font-size: 13px;
    box-shadow: 0 2px 8px rgba(28, 25, 23, 0.04);
  }
  .dva-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .direct-vs-amazon-box h4 {
    margin: 0;
    font-family: var(--font-serif, serif);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary, #1C1917);
  }
  .dva-grid { 
    display: flex; 
    flex-direction: column; 
    gap: 10px; 
  }
  .dva-row { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-bottom: 1px solid #F5F3EF; 
    padding-bottom: 8px; 
  }
  .dva-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .dva-feat { 
    color: var(--text-secondary, #78716C); 
    font-weight: 500; 
    font-size: 12.5px; 
  }
  .dva-direct { 
    color: #2D3B2D; 
    font-weight: 600; 
    font-size: 12px; 
    background: #F5F3EF;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .dva-amazon { 
    color: #A8A29E; 
    font-size: 12px; 
    text-decoration: line-through; 
  }
</style>
