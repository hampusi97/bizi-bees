{% comment %}
  The Direct Advantage Matrix (Anti-Amazon Quality Assurance)
  Repo: bizi-bees /snippets/anti-amazon-badges.liquid
{% endcomment %}

<div class="direct-vs-amazon-box">
  <div class="dva-header">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    <h4>Why Ordering Direct Beats Third-Party Marketplaces</h4>
  </div>
  <div class="dva-grid">
    <div class="dva-row">
      <span class="dva-feat">Verified Batch Authenticity:</span>
      <span class="dva-direct">✓ Fresh Workshop Batch</span>
      <span class="dva-amazon">✕ Commingled Warehouses</span>
    </div>
    <div class="dva-row">
      <span class="dva-feat">Extended In-Home Guarantee:</span>
      <span class="dva-direct">✓ 60 Days Risk-Free</span>
      <span class="dva-amazon">✕ 30 Days Limited</span>
    </div>
    <div class="dva-row">
      <span class="dva-feat">Curated Complimentary Gifts:</span>
      <span class="dva-direct">✓ Included Free</span>
      <span class="dva-amazon">✕ None</span>
    </div>
    <div class="dva-row">
      <span class="dva-feat">Premium Domestic Fulfillment:</span>
      <span class="dva-direct">✓ Inspected &amp; Tracked</span>
      <span class="dva-amazon">✕ Unverified Third-Party</span>
    </div>
  </div>
</div>

<style>
  .direct-vs-amazon-box {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 18px 20px;
    margin: 20px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Georgia, serif;
    font-size: 13px;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }
  .dva-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .direct-vs-amazon-box h4 {
    margin: 0;
    font-family: Georgia, "Playfair Display", serif;
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
  }
  .dva-grid { 
    display: flex; 
    flex-direction: column; 
    gap: 10px; 
  }
  .dva-row { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-bottom: 1px solid #F1F5F9; 
    padding-bottom: 8px; 
  }
  .dva-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .dva-feat { 
    color: #64748B; 
    font-weight: 500; 
    font-size: 13px; 
  }
  .dva-direct { 
    color: #0D9488; 
    font-weight: 700; 
    font-size: 12.5px; 
    background: #F0FDFA;
    border: 1px solid #CCFBF1;
    padding: 3px 9px;
    border-radius: 6px;
  }
  .dva-amazon { 
    color: #94A3B8; 
    font-size: 12px; 
    text-decoration: line-through; 
  }
</style>
