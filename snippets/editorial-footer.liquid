{% comment %}
  Dropper OS - Clean 4-Column Editorial Boutique Footer
  File: snippets/editorial-footer.liquid
{% endcomment %}

<footer class="editorial-footer">
  <div class="editorial-footer-inner">
    <div class="editorial-footer-grid">
      <!-- Col 1: Brand Story -->
      <div class="footer-col-brand">
        <div class="footer-brand-title">Bizi Bees Boutique</div>
        <p>Curated literature crates, handcrafted botanical apothecary, and intentional lifestyle goods. Thoughtfully packaged and dispatched across the United States.</p>
        <div style="font-size: 12px; color: var(--text-secondary);">Dispatched from Salt Lake City & Utah Logistics Hub</div>
      </div>

      <!-- Col 2: Shop Links -->
      <div class="footer-col">
        <div class="footer-heading">Shop Collections</div>
        <ul class="footer-links">
          <li><a href="/collections/all">All Curations</a></li>
          <li><a href="/products/mystery-crate">Blind Date Book Crates</a></li>
          <li><a href="/collections/candles">Apothecary & Candles</a></li>
          <li><a href="/collections/puzzles-games">Retro Games & Puzzles</a></li>
          <li><a href="/collections/stationery">Stationery & Bookmarks</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="footer-col">
        <div class="footer-heading">Customer Care</div>
        <ul class="footer-links">
          <li><a href="/pages/track-order">Track Your Shipment</a></li>
          <li><a href="/pages/shipping-policy">Domestic Shipping Rates</a></li>
          <li><a href="/pages/returns-exchanges">30-Day Hassle-Free Returns</a></li>
          <li><a href="/pages/faq">Frequently Asked Questions</a></li>
          <li><a href="mailto:care@bizibees.com">care@bizibees.com</a></li>
        </ul>
      </div>

      <!-- Col 4: Standard Policies -->
      <div class="footer-col">
        <div class="footer-heading">Policies & Trust</div>
        <ul class="footer-links">
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms-of-service">Terms of Service</a></li>
          <li><a href="/pages/refund-policy">Refund & Replacement Policy</a></li>
          <li><a href="/pages/accessibility">Accessibility Statement</a></li>
          <li><a href="/pages/wholesale">Wholesale & Seeding Inquiries</a></li>
        </ul>
      </div>
    </div>

    <!-- Clean Bottom Bar -->
    <div class="editorial-footer-bottom">
      <div>&copy; {{ 'now' | date: "%Y" }} Bizi Bees Boutique LLC. All rights reserved.</div>
      <div class="footer-badges-clean">
        <span>Fast Domestic Dispatch</span>
        <span>•</span>
        <span>Secure 256-Bit SSL Checkout</span>
        <span>•</span>
        <span>30-Day Guarantee</span>
      </div>
    </div>
  </div>
</footer>
