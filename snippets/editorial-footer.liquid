<footer class="editorial-footer">
  <div class="editorial-footer-inner">
    <div class="editorial-footer-grid">
      <!-- Col 1: Brand Story -->
      <div class="footer-col-brand">
        <div class="footer-brand-title">Bizi Bees Boutique &amp; Books</div>
        <p>Curated literature crates, handcrafted botanical soy candles, vintage finds, and intentional lifestyle goods. Thoughtfully packaged and dispatched across the United States from Utah.</p>
        <div style="font-size: 12px; color: #786C62;">Dispatched from Salt Lake City &amp; Utah Logistics Hub</div>
      </div>

      <!-- Col 2: Shop Links -->
      <div class="footer-col">
        <div class="footer-heading">Shop Collections</div>
        <ul class="footer-links">
          <li><a href="/collections/all">All Curations (350 Items)</a></li>
          <li><a href="/#blindDateSection">Blind Date with a Book</a></li>
          <li><a href="/#biziCrateSection">Custom Cozy Gift Crates</a></li>
          <li><a href="/collections/books">Vintage Books &amp; Fiction</a></li>
          <li><a href="/collections/board-games-toys-collectibles">Retro Games &amp; Collectibles</a></li>
          <li><a href="/collections/holiday-gifts-stocking-stuffers">Holiday &amp; Stocking Stuffers</a></li>
          <li><a href="/collections/gifts-25-and-under">Gifts Under $25</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="footer-col">
        <div class="footer-heading">Customer Care</div>
        <ul class="footer-links">
          <li><a href="/pages/shipping">Shipping Rates &amp; Dispatch</a></li>
          <li><a href="/pages/returns">30-Day Hassle-Free Returns</a></li>
          <li><a href="/pages/faq">Frequently Asked Questions</a></li>
          <li><a href="/pages/about">Our Story &amp; Studio</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="mailto:care@bizibees.com">care@bizibees.com</a></li>
        </ul>
      </div>

      <!-- Col 4: Standard Policies -->
      <div class="footer-col">
        <div class="footer-heading">Policies &amp; Trust</div>
        <ul class="footer-links">
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/refund-policy">Refund &amp; Replacement Policy</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="/pages/condition-guide">Vintage Book Condition Guide</a></li>
        </ul>
      </div>
    </div>

    <!-- Clean Bottom Bar -->
    <div class="editorial-footer-bottom">
      <div>&copy; {{ 'now' | date: "%Y" }} Bizi Bees Boutique LLC. All rights reserved.</div>
      <div class="footer-badges-clean">
        <span>Fast Utah Dispatch</span>
        <span>•</span>
        <span>Secure 256-Bit SSL Checkout</span>
        <span>•</span>
        <span>60-Day Guarantee</span>
      </div>
    </div>
