{% comment %}
  Bizi Bees Boutique - Delivery Estimator
  File: snippets/delivery-estimator.liquid
{% endcomment %}

<div class="delivery-estimator-box" id="deliveryEstimator">
  <div class="estimator-header">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
    <span><strong>Standard Domestic Dispatch:</strong> Orders carefully packed within 24–48 hours</span>
  </div>
  <div class="estimator-timeline">
    <div class="timeline-step">
      <div class="step-circle active"></div>
      <span>Order Placed</span>
    </div>
    <div class="timeline-line"></div>
    <div class="timeline-step">
      <div class="step-circle active"></div>
      <span>Workshop Dispatch</span>
    </div>
    <div class="timeline-line"></div>
    <div class="timeline-step">
      <div class="step-circle"></div>
      <span id="dateDelivery" style="color:#2D3B2D; font-weight:600;">Estimated Delivery</span>
    </div>
  </div>
</div>

<style>
  .delivery-estimator-box { 
    background: #FBF9F5; 
    border: 1px solid #E7E5E4; 
    border-radius: 8px; 
    padding: 16px 20px; 
    margin: 20px 0; 
    font-family: var(--font-sans, -apple-system, sans-serif); 
    font-size: 12.5px; 
  }
  .estimator-header { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
    color: #1C1917; 
    margin-bottom: 14px; 
  }
  .estimator-timeline { 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
  }
  .timeline-step { 
    display: flex; 
    flex-direction: column; 
    align-items: center; 
    gap: 6px; 
    text-align: center;
    color: #78716C;
    font-size: 11.5px;
  }
  .step-circle { 
    width: 10px; 
    height: 10px; 
    border-radius: 50%; 
    background: #D6D3D1; 
  }
  .step-circle.active { 
    background: #2D3B2D; 
  }
  .timeline-line { 
    flex: 1; 
    height: 1px; 
    background: #E7E5E4; 
    margin: 0 12px; 
    margin-bottom: 18px; 
  }
</style>

<script>
  (function() {
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const now = new Date();
    const estDate = new Date(now.getTime() + (4 * 24 * 60 * 60 * 1000));
    const targetEl = document.getElementById("dateDelivery");
    if (targetEl) {
      targetEl.textContent = `${months[estDate.getMonth()]} ${estDate.getDate()} - ${months[estDate.getMonth()]} ${estDate.getDate() + 2}`;
    }
  })();
</script>
