<form class="filters" method="get">{% if request.page_type == 'search' %}<input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product">{% endif %}{% for filter in results.filters %}<details><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary><div class="filter-values">{% case filter.type %}{% when 'boolean', 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Minimum price <input name="{{ filter.min_value.param_name }}" type="number" min="0" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>Maximum price <input name="{{ filter.max_value.param_name }}" type="number" min="0" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</div></details>{% endfor %}<label>Sort <select name="sort_by">{% for option in results.sort_options %}<option value="{{ option.value }}" {% assign selected_sort = results.sort_by | default: results.default_sort_by %}{% if option.value == selected_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label><button>Apply</button><a href="{% if request.page_type == 'search' %}{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product{% else %}{{ collection.url }}{% endif %}">Clear filters</a></form>
