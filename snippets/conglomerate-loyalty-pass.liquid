<style>
  .conglomerate-pass-wrap {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    border-radius: 20px;
    padding: 36px 24px;
    color: #FFFFFF;
    margin: 35px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Plus Jakarta Sans", sans-serif;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.25);
    text-align: center;
  }
  .pass-badge {
    display: inline-block;
    background: #0D9488;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 6px 16px;
    border-radius: 30px;
    margin-bottom: 12px;
  }
  .pass-header h3 {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 900;
    margin: 0 0 8px;
    letter-spacing: -0.5px;
  }
  .pass-header p {
    font-size: 14px;
    color: #94A3B8;
    max-width: 620px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }
  .rewards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    text-align: left;
  }
  .reward-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .reward-card:hover {
    transform: translateY(-3px);
    border-color: #0D9488;
    background: rgba(255, 255, 255, 0.08);
  }
  .reward-tag {
    font-size: 10px;
    font-weight: 800;
    color: #5EEAD4;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .reward-icon {
    font-size: 32px;
    margin-bottom: 10px;
  }
  .reward-card h4 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 800;
    color: #FFFFFF;
  }
  .reward-card p {
    font-size: 12.5px;
    color: #CBD5E1;
    line-height: 1.5;
    margin: 0 0 16px;
    flex-grow: 1;
  }
  .btn-claim-reward {
    display: block;
    text-align: center;
    background: #0D9488;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 30px;
    transition: background 0.2s ease;
  }
  .btn-claim-reward:hover {
    background: #14B8A6;
  }
  .code-copy {
    display: block;
    text-align: center;
    font-size: 11px;
    color: #94A3B8;
    margin-top: 8px;
  }
  .code-copy code {
    background: rgba(0,0,0,0.3);
    padding: 2px 6px;
    border-radius: 4px;
    color: #5EEAD4;
  }

  @media(max-width: 768px) {
    .rewards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
