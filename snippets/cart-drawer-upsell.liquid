{% comment %}
  Dynamic In-Cart 1-Click Upsell Module
  Repo: bizi-bees /snippets/cart-drawer-upsell.liquid
{% endcomment %}

<div class="cart-upsell-module" id="cartUpsellModule">
  <div class="upsell-header">
    <span class="sparkle">✨</span>
    <strong>Frequently Added by VIP Customers:</strong>
  </div>

  <div class="upsell-card">
    <img src="https://bizibees-store.myshopify.com/cdn/shop/files/lumaglow.jpg" alt="Companion Product" class="upsell-thumb" onerror="this.src='https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=120&auto=format&fit=crop&q=80'">
    
    <div class="upsell-details">
      <span class="upsell-title">Activating Peptide Conductive Serum</span>
      <div class="upsell-pricing">
        <strong>$14.00</strong>
        <span class="strike">$24.00</span>
        <span class="save-tag">SAVE 42%</span>
      </div>
      <small>Boosts microcurrent conductivity by 300%</small>
    </div>

    <button type="button" class="inline-add-btn" onclick="addInstantUpsell('SERUM-CONDUCTION-50ML', this)">
      + Add
    </button>
  </div>
</div>

<style>
  .cart-upsell-module {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 14px;
    margin: 16px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .upsell-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #0F172A;
    margin-bottom: 10px;
  }
  .upsell-card {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .upsell-thumb {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #E2E8F0;
  }
  .upsell-details { flex-grow: 1; text-align: left; }
  .upsell-title { font-size: 13px; font-weight: 700; color: #0F172A; display: block; }
  .upsell-pricing { display: flex; align-items: center; gap: 6px; margin: 2px 0; }
  .upsell-pricing strong { font-size: 14px; color: #0D9488; }
  .upsell-pricing .strike { font-size: 11px; color: #94A3B8; text-decoration: line-through; }
  .save-tag { font-size: 9px; font-weight: 800; background: #E6FFFA; color: #0F766E; padding: 2px 6px; border-radius: 4px; }
  .upsell-details small { font-size: 10px; color: #64748B; display: block; }

  .inline-add-btn {
    background: #0F172A;
    color: #FFFFFF;
    border: none;
    padding: 8px 16px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 12px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .inline-add-btn:hover { background: #0D9488; transform: scale(1.05); }
  .inline-add-btn.added { background: #10B981; cursor: default; }
</style>

<script>
  function addInstantUpsell(variantId, btn) {
    btn.innerText = 'Adding...';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
    })
    .then(res => res.json())
    .then(data => {
      btn.innerText = '✓ Added';
      btn.classList.add('added');
      // Triggers the Gamified Free Shipping bar & Dynamic Engine to recalculate live!
      document.dispatchEvent(new CustomEvent('cart:updated'));
    })
    .catch(err => {
      btn.innerText = '+ Add';
      btn.disabled = false;
    });
  }
</script>
