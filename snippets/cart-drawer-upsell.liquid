{% comment %}
  Dynamic In-Cart 1-Click Upsell Module — Bizi Bees Boutique
  Repo: bizi-bees /snippets/cart-drawer-upsell.liquid
{% endcomment %}

<div class="cart-upsell-module" id="cartUpsellModule">
  <div class="upsell-header">
    <span class="sparkle">🐝</span>
    <strong>Frequently Paired with Book Orders:</strong>
  </div>

  <div class="upsell-card">
    <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=120&auto=format&fit=crop&q=80" alt="Vintage Brass Honeybee Bookmark" class="upsell-thumb">
    
    <div class="upsell-details">
      <span class="upsell-title">Vintage Brass Honeybee Bookmark Clip</span>
      <div class="upsell-pricing">
        <strong>$8.00</strong>
        <span class="strike">$14.00</span>
        <span class="save-tag">SAVE 43%</span>
      </div>
      <small>Solid antiqued brass clip • Gentle on book spines</small>
    </div>

    <button type="button" class="inline-add-btn" onclick="addInstantUpsell('BEE-BOOKMARK-BRASS', this)">
      + Add
    </button>
  </div>
</div>

<style>
  .cart-upsell-module {
    background: #FAF7F2;
    border: 1px solid #EADBCE;
    border-radius: 14px;
    padding: 14px;
    margin: 16px 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .upsell-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #29231E;
    margin-bottom: 10px;
  }
  .upsell-card {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .upsell-thumb {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #EADBCE;
    background: #FFFFFF;
  }
  .upsell-details { flex-grow: 1; text-align: left; }
  .upsell-title { font-size: 13px; font-weight: 700; color: #29231E; display: block; }
  .upsell-pricing { display: flex; align-items: center; gap: 6px; margin: 2px 0; }
  .upsell-pricing strong { font-size: 14px; color: #D9822B; font-weight: 800; }
  .upsell-pricing .strike { font-size: 11px; color: #9C8E82; text-decoration: line-through; }
  .save-tag { font-size: 9px; font-weight: 800; background: #FEF3C7; color: #92400E; padding: 2px 6px; border-radius: 4px; }
  .upsell-details small { font-size: 10px; color: #786C62; display: block; }

  .inline-add-btn {
    background: #29231E;
    color: #FFFFFF;
    border: none;
    padding: 8px 16px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 12px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .inline-add-btn:hover { background: #D9822B; transform: scale(1.05); }
  .inline-add-btn.added { background: #4B5842; cursor: default; }
</style>

<script>
  function addInstantUpsell(variantId, btn) {
    btn.innerText = 'Adding...';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
    })
    .then(res => res.json())
    .then(data => {
      btn.innerText = '✓ Added';
      btn.classList.add('added');
      // Triggers the Free Shipping bar & Dynamic Engine to recalculate live!
      document.dispatchEvent(new CustomEvent('cart:updated'));
    })
    .catch(err => {
      btn.innerText = '+ Add';
      btn.disabled = false;
    });
  }
</script>
