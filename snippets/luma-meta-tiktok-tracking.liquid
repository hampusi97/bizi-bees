</script>

<!-- Server-Side Conversions API (CAPI) Dispatch & Universal Event Listeners -->
<script>
  (function() {
    // 1. Meta CAPI Dispatch Helper (dispatches via Beacon or Fetch)
    window.dispatchLumaCAPI = function(eventName, eventData) {
      const payload = {
        event_name: eventName,
        event_time: Math.floor(Date.now() / 1000),
        event_source_url: window.location.href,
        action_source: "website",
        user_data: {
          client_user_agent: navigator.userAgent
        },
        custom_data: eventData || {}
      };

      if (navigator.sendBeacon) {
        navigator.sendBeacon('/apps/luma-capi-proxy', JSON.stringify(payload));
      }
    };

    // 2. Automated ViewContent tracking on Product Pages
    {% if template contains 'product' %}
      const currentProductData = {
        content_name: {{ product.title | json }},
        content_category: 'Skin Care Tools',
        content_ids: [{{ product.selected_or_first_available_variant.id | default: product.id | json }}],
        content_type: 'product',
        value: {{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' | strip | default: 38.99 }},
        currency: 'USD'
      };

      if (window.fbq) {
        fbq('track', 'ViewContent', currentProductData);
        window.dispatchLumaCAPI('ViewContent', currentProductData);
      }
      if (window.ttq) {
        ttq.track('ViewContent', currentProductData);
      }
    {% endif %}

    // 3. Automated CompletePayment tracking on Order Confirmation
    {% if first_time_accessed %}
      const orderData = {
        content_type: 'product',
        value: {{ checkout.total_price | money_without_currency | remove: ',' | strip }},
        currency: 'USD'
      };
      if (window.fbq) {
        fbq('track', 'Purchase', orderData);
        window.dispatchLumaCAPI('Purchase', orderData);
      }
      if (window.ttq) {
        ttq.track('CompletePayment', orderData);
      }
    {% endif %}

    // 4. Delegated Button Click Event Listeners (AddToCart & InitiateCheckout)
    document.addEventListener('click', function(e) {
      const target = e.target.closest('button, a, input[type="submit"]');
      if (!target) return;

      const isAddToCart = target.matches('form[action*="/cart/add"] [type="submit"], [name="add"], .btn-add-to-cart, [data-action="add-to-cart"]');
      const isOneClickCheckout = target.matches('.luma-buy-now-btn, .luma-sticky-btn, .luma-matrix-1click-btn, #luma-hero-buy-cta, [data-action="fast-checkout"]');

      if (isAddToCart) {
        const atcData = {
          content_name: 'LumaGlow 4-in-1 Facial Wand',
          content_type: 'product',
          value: 38.99,
          currency: 'USD'
        };
        if (window.fbq) {
          fbq('track', 'AddToCart', atcData);
          window.dispatchLumaCAPI('AddToCart', atcData);
        }
        if (window.ttq) {
          ttq.track('AddToCart', atcData);
        }
      }

      if (isOneClickCheckout) {
        const checkoutData = {
          content_name: 'LumaGlow 4-in-1 Facial Wand',
          content_type: 'product',
          value: 38.99,
          currency: 'USD'
        };
        if (window.fbq) {
          fbq('track', 'InitiateCheckout', checkoutData);
          window.dispatchLumaCAPI('InitiateCheckout', checkoutData);
        }
        if (window.ttq) {
          ttq.track('InitiateCheckout', checkoutData);
        }
      }
    });
  })();
</script>
