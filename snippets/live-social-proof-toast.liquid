{% comment %}
  Ultra-Dynamic Live Social Proof Toast Engine
  Repo: bizi-bees /snippets/live-social-proof-toast.liquid
  Displays real-time simulated recent purchase events to build high-converting FOMO.
{% endcomment %}

<div class="live-social-toast" id="liveSocialToast" style="display: none;">
  <div class="toast-indicator-dot"></div>
  <div class="toast-avatar" id="toastIcon">✨</div>
  <div class="toast-content">
    <div class="toast-buyer-line">
      <span class="buyer-name" id="toastBuyer">Sarah M.</span>
      <span class="buyer-location" id="toastLocation">in Salt Lake City, UT</span>
    </div>
    <div class="toast-action" id="toastAction">
      Purchased <strong>LumaGlow™ QuadWave Pro</strong>
    </div>
    <div class="toast-meta">
      <span class="toast-time" id="toastTime">2 minutes ago</span>
      <span class="toast-verified">✓ Verified Buyer</span>
    </div>
  </div>
  <button type="button" class="toast-close-btn" onclick="dismissToast()">&times;</button>
</div>

<style>
  .live-social-toast {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    z-index: 9999;
    max-width: 340px;
    transform: translateY(100px);
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .live-social-toast.visible {
    transform: translateY(0);
    opacity: 1;
  }
  .toast-indicator-dot {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 6px;
    height: 6px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10B981;
  }
  .toast-avatar {
    font-size: 24px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .toast-content {
    flex: 1;
  }
  .toast-buyer-line {
    font-size: 12px;
    color: #E2E8F0;
    margin-bottom: 2px;
  }
  .buyer-name {
    font-weight: 800;
    color: #FFFFFF;
  }
  .buyer-location {
    color: #94A3B8;
    margin-left: 4px;
  }
  .toast-action {
    font-size: 12px;
    color: #38BDF8;
    line-height: 1.3;
    margin-bottom: 4px;
  }
  .toast-action strong {
    color: #F8FAFC;
  }
  .toast-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: #64748B;
  }
  .toast-verified {
    color: #10B981;
    font-weight: 700;
  }
  .toast-close-btn {
    background: transparent;
    border: none;
    color: #64748B;
    font-size: 18px;
    cursor: pointer;
    padding: 0 4px;
    line-height: 1;
  }
  .toast-close-btn:hover {
    color: #FFFFFF;
  }
  @media (max-width: 600px) {
    .live-social-toast {
      bottom: 80px; /* Leave space for mobile sticky checkout drawer */
      left: 14px;
      right: 14px;
      max-width: calc(100% - 28px);
    }
  }
</style>

<script>
  (function() {
    const events = [
      { name: "Sarah M.", loc: "Salt Lake City, UT", prod: "LumaGlow™ QuadWave Pro 4-in-1", icon: "✨", time: "2 minutes ago" },
      { name: "Tyler B.", loc: "Provo, UT", prod: "At-Home Dirty Soda Bar Starter Kit", icon: "🥤", time: "4 minutes ago" },
      { name: "Elena R.", loc: "Denver, CO", prod: "Blind Date with a Book Gift Box", icon: "📖", time: "6 minutes ago" },
      { name: "Marcus K.", loc: "Austin, TX", prod: "Custom 4-Bar Belgian Tasting Bento", icon: "🍫", time: "1 minute ago" },
      { name: "Brianna W.", loc: "Scottsdale, AZ", prod: "CloudSoft™ 2-Piece Sculpt Set", icon: "🧘‍♀️", time: "3 minutes ago" },
      { name: "David L.", loc: "Seattle, WA", prod: "LumaRelief™ Cold Compression Mask", icon: "🧊", time: "8 minutes ago" },
      { name: "Chloe H.", loc: "Orem, UT", prod: "At-Home Dirty Soda Syrups & Frother", icon: "🥤", time: "5 minutes ago" }
    ];

    let toastIndex = 0;
    let toastTimeout = null;

    function showNextToast() {
      const toast = document.getElementById('liveSocialToast');
      if (!toast) return;

      const evt = events[toastIndex % events.length];
      toastIndex++;

      document.getElementById('toastBuyer').innerText = evt.name;
      document.getElementById('toastLocation').innerText = "in " + evt.loc;
      document.getElementById('toastAction').innerHTML = `Purchased <strong>${evt.prod}</strong>`;
      document.getElementById('toastIcon').innerText = evt.icon;
      document.getElementById('toastTime').innerText = evt.time;

      toast.style.display = "flex";
      setTimeout(() => toast.classList.add('visible'), 50);

      // Hide after 5.5 seconds
      toastTimeout = setTimeout(() => {
        toast.classList.remove('visible');
        setTimeout(() => {
          toast.style.display = "none";
          // Schedule next toast in 8–14 seconds
          setTimeout(showNextToast, 8000 + Math.random() * 6000);
        }, 500);
      }, 5500);
    }

    window.dismissToast = function() {
      const toast = document.getElementById('liveSocialToast');
      if (toast) {
        toast.classList.remove('visible');
        setTimeout(() => toast.style.display = "none", 500);
        if (toastTimeout) clearTimeout(toastTimeout);
      }
    };

    // Initialize first toast after 3 seconds on page
    setTimeout(showNextToast, 3500);
  })();
</script>
