<!-- REPO-OS MASTER GLOBAL SHIELD, DYNAMIC ISLAND & COZY AI QUIZ -->
<style id="repo-os-global-css">
  /* 1. PERMANENTLY SUPPRESS ALL GIANT RED BADGES AND FLASH SPAM */
  .card__badge,
  .product-card__badge,
  .badge--sale,
  .badge,
  [class*="sale-badge"],
  [class*="badge--bottom"],
  [class*="35-off"] {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    width: 0 !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }
  .card__badge::before, .card__badge::after, .badge::before, .badge::after {
    content: none !important;
    display: none !important;
  }

  /* 2. ENSURE 100% UNOBSTRUCTED, CRISP PRODUCT PHOTOGRAPHY */
  .card__media, .card-wrapper .media, .product-card .media, .media--square {
    position: relative !important;
    background: #FFFFFF !important;
    border-radius: 14px !important;
    overflow: hidden !important;
  }
  .card__media img, .card-wrapper .media img, .product-card img, .product__media img {
    opacity: 1 !important;
    visibility: visible !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    position: relative !important;
    z-index: 2 !important;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .card-wrapper:hover .card__media img, .product-card:hover img {
    transform: scale(1.05) !important;
  }

  /* 3. WARM EDITORIAL CARD ELEVATION */
  .card-wrapper, .product-card {
    background: #FFFFFF !important;
    border: 1px solid #E6DDD1 !important;
    border-radius: 18px !important;
    padding: 14px !important;
    box-shadow: 0 4px 16px rgba(41, 35, 30, 0.04) !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease !important;
  }
  .card-wrapper:hover, .product-card:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0 12px 28px rgba(41, 35, 30, 0.10) !important;
    border-color: #D9822B !important;
  }

  /* 4. iOS DYNAMIC ISLAND CART PILL */
  .ro-dynamic-island {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%) translateY(-130px) scale(0.9);
    background: rgba(41, 35, 30, 0.96);
    backdrop-filter: blur(16px);
    color: #FAF7F2;
    border: 1px solid rgba(217, 130, 43, 0.3);
    border-radius: 50px;
    padding: 10px 16px 10px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 9999999;
    box-shadow: 0 20px 45px rgba(0,0,0,0.3);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .ro-dynamic-island.active { transform: translateX(-50%) translateY(0) scale(1); }
  .ro-island-btn { background: #D9822B; color: #FFFFFF !important; text-decoration: none; font-size: 12px; font-weight: 800; padding: 7px 14px; border-radius: 30px; }

  /* 5. INTERACTIVE 3-STEP AI QUIZ MODAL */
  .ro-quiz-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(41, 35, 30, 0.75);
    backdrop-filter: blur(8px);
    z-index: 9999998;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .ro-quiz-modal {
    background: #FAF7F2;
    color: #29231E;
    border: 1px solid #E2D7C8;
    border-radius: 24px;
    max-width: 520px;
    width: 100%;
    padding: 36px 28px;
    position: relative;
    box-shadow: 0 25px 60px rgba(0,0,0,0.3);
    text-align: center;
  }
  .ro-quiz-close { position: absolute; top: 14px; right: 18px; background: none; border: none; font-size: 26px; color: #786C62; cursor: pointer; }
  .ro-q-btn {
    width: 100%;
    background: #FFFFFF;
    border: 1.5px solid #E6DDD1;
    border-radius: 14px;
    padding: 15px 18px;
    font-size: 14px;
    font-weight: 700;
    color: #29231E;
    margin-bottom: 10px;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }
  .ro-q-btn:hover { border-color: #D9822B; background: #FFFDF9; transform: translateY(-2px); }
</style>

<!-- iOS Dynamic Island Notification -->
<div class="ro-dynamic-island" id="roDynamicIsland">
  <span style="font-size:13px;font-weight:700;" id="roIslandMsg">✓ Added to Your Bag!</span>
  <a href="/checkout" class="ro-island-btn">1-Tap Checkout ⚡</a>
</div>

<!-- 3-Step Boutique AI Concierge Quiz Modal -->
<div class="ro-quiz-backdrop" id="roQuizBackdrop">
  <div class="ro-quiz-modal">
    <button type="button" class="ro-quiz-close" onclick="document.getElementById('roQuizBackdrop').style.display='none'">×</button>
    <div id="roQStep1">
      <span style="font-size:11px;font-weight:800;color:#D9822B;letter-spacing:1px;">✨ STEP 1 OF 3 • BOUTIQUE GIFT MATCHER</span>
      <h3 style="font-family: Georgia, serif; font-size:24px;font-weight:900;margin:8px 0 20px;color:#29231E;">What reading &amp; cozy ritual suits your mood?</h3>
      <button class="ro-q-btn" onclick="roNextQ(2, 'Books')">📖 Blind Date with a Mystery Novel ($14.99)</button>
      <button class="ro-q-btn" onclick="roNextQ(2, 'Candles')">🕯️ Hand-Poured Botanical Soy Candle ($14–$37)</button>
      <button class="ro-q-btn" onclick="roNextQ(2, 'Stationery')">✍️ Harry Potter Planner &amp; Washi Tape Stationery Set</button>
      <button class="ro-q-btn" onclick="roNextQ(2, 'Crate')">🎁 Complete 4-Item Cozy Evening Crate ($38.00)</button>
    </div>
    <div id="roQStep2" style="display:none;">
      <span style="font-size:11px;font-weight:800;color:#D9822B;letter-spacing:1px;">✨ STEP 2 OF 3 • EXPERIENCE LEVEL</span>
      <h3 style="font-family: Georgia, serif; font-size:24px;font-weight:900;margin:8px 0 20px;color:#29231E;">Is this a personal treat or a gift?</h3>
      <button class="ro-q-btn" onclick="roNextQ(3, 'Gift')">🎁 Gift Package with Hand-Written Clue Tag &amp; Twine</button>
      <button class="ro-q-btn" onclick="roNextQ(3, 'Personal')">☕ Personal Weekend Reading Sanctuary</button>
    </div>
    <div id="roQStep3" style="display:none;">
      <span style="font-size:11px;font-weight:800;color:#10B981;letter-spacing:1px;">✨ 100% MATCH CERTIFIED</span>
      <h3 style="font-family: Georgia, serif; font-size:22px;font-weight:900;margin:8px 0 16px;color:#29231E;" id="roMatchTitle">Custom Cozy Evening Crate ($38.00)</h3>
      <p style="font-size:13.5px;color:#6E6257;line-height:1.5;margin-bottom:24px;">Hand-packed in signature kraft with wood wool, tied with butcher twine, and sealed with beeswax stamp. Ships fast from Utah.</p>
      <button class="ro-q-btn" style="background:#29231E;color:#FAF7F2;text-align:center;border:none;padding:16px;border-radius:40px;font-weight:800;" onclick="roAddMatchedProduct(this)">
        Add Matched Item to Bag →
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    window.RO_MATCHED_VARIANT = 51838155227303; // Harry Potter Planner default
    window.RO_MATCHED_NAME = "Harry Potter 12-Month Planner";

    document.addEventListener("click", function(e) {
      const target = e.target.closest("a, button");
      if (target) {
        const text = (target.innerText || "").toLowerCase();
        if (text.includes("quiz") || text.includes("30-sec") || text.includes("concierge quiz")) {
          e.preventDefault();
          document.getElementById('roQStep1').style.display = 'block';
          document.getElementById('roQStep2').style.display = 'none';
          document.getElementById('roQStep3').style.display = 'none';
          document.getElementById('roQuizBackdrop').style.display = 'flex';
        }
      }
    });

    window.roNextQ = function(step, choice) {
      if (step === 2) {
        window.RO_QUIZ_GOAL = choice;
        document.getElementById('roQStep1').style.display = 'none';
        document.getElementById('roQStep2').style.display = 'block';
      } else if (step === 3) {
        document.getElementById('roQStep2').style.display = 'none';
        document.getElementById('roQStep3').style.display = 'block';
        const goal = window.RO_QUIZ_GOAL || '';
        
        if (goal.includes('Candles')) {
          window.RO_MATCHED_VARIANT = 51838179311783;
          window.RO_MATCHED_NAME = "Christmas Tree Farm Tin Candle ($14.00)";
        } else if (goal.includes('Stationery')) {
          window.RO_MATCHED_VARIANT = 51838155227303;
          window.RO_MATCHED_NAME = "Harry Potter 12-Month Undated Planner ($24.99)";
        } else if (goal.includes('Crate')) {
          window.RO_MATCHED_VARIANT = 51838155227303;
          window.RO_MATCHED_NAME = "Custom Cozy Evening Crate ($38.00)";
        } else {
          window.RO_MATCHED_VARIANT = 51838164861095;
          window.RO_MATCHED_NAME = "Blind Date with a Book ($14.99)";
        }
        document.getElementById('roMatchTitle').innerText = window.RO_MATCHED_NAME;
      }
    };

    window.roAddMatchedProduct = function(btn) {
      const orig = btn.innerText;
      btn.innerText = 'Adding...';
      btn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: window.RO_MATCHED_VARIANT, quantity: 1 })
      })
      .then(r => r.json())
      .then(() => {
        document.getElementById('roQuizBackdrop').style.display = 'none';
        const island = document.getElementById('roDynamicIsland');
        if (island) {
          document.getElementById('roIslandMsg').innerText = `✓ Added ${window.RO_MATCHED_NAME}!`;
          island.classList.add('active');
          setTimeout(() => island.classList.remove('active'), 5000);
        }
      })
      .catch(() => {
        window.location.href = '/collections/all';
      });
    };
  })();
</script>
