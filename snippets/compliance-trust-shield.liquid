{% comment %}
  Bizi Bees Boutique - Merchant Security & Trust Shield
  File: snippets/compliance-trust-shield.liquid
{% endcomment %}

<div class="bank-compliance-wrapper">
  <div class="bank-compliance-inner">
    <div class="compliance-col">
      <h4>Secure Checkout Verification</h4>
      <p>All transactions processed with 256-Bit SSL encryption. Accelerated checkout supported with <strong>Shop Pay, Apple Pay, Google Pay, and major cards</strong>.</p>
    </div>
    <div class="compliance-col">
      <h4>Careful Domestic Dispatch</h4>
      <p>Orders prepared within 24–48 hours from our US workshop and logistics hub. Fully tracked USPS and UPS delivery updates dispatched via SMS and email.</p>
    </div>
    <div class="compliance-col">
      <h4>30-Day Happiness Guarantee</h4>
      <p>Curations crafted for delight. If you are not delighted with your selection, our team provides prompt replacements or refunds at <strong>care@bizibees.com</strong>.</p>
    </div>
  </div>
  <div class="compliance-legal-bar">
    <span>&copy; {{ 'now' | date: "%Y" }} Bizi Bees Boutique LLC. All rights reserved. • Small Batch Curation Hub</span>
  </div>
</div>

<style>
  .bank-compliance-wrapper { 
    background: #FBF9F5; 
    border-top: 1px solid #E7E5E4; 
    border-bottom: 1px solid #E7E5E4; 
    padding: 36px 20px 24px; 
    font-family: var(--font-sans, -apple-system, sans-serif); 
    color: #44403C; 
    font-size: 13px; 
    line-height: 1.6; 
  }
  .bank-compliance-inner { 
    max-width: 1100px; 
    margin: 0 auto; 
    display: grid; 
    grid-template-columns: repeat(3, 1fr); 
    gap: 32px; 
    text-align: left; 
  }
  .compliance-col h4 { 
    font-family: var(--font-serif, serif);
    font-size: 15px; 
    font-weight: 600; 
    color: #1C1917; 
    margin: 0 0 8px; 
  }
  .compliance-col p { margin: 0; color: #78716C; font-size: 12.5px; }
  .compliance-legal-bar { 
    max-width: 1100px; 
    margin: 24px auto 0; 
    padding-top: 16px; 
    border-top: 1px solid #E7E5E4; 
    text-align: center; 
    font-size: 11.5px; 
    color: #A8A29E; 
  }
  @media(max-width: 768px) { 
    .bank-compliance-inner { grid-template-columns: 1fr; gap: 20px; } 
  }
</style>
