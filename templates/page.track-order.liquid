{% comment %}
  Luma Clinical / Bizi Bees - Self-Service Order Tracking Portal
  File: templates/page.track-order.liquid
{% endcomment %}

<div class="luma-track-container">
  <div class="luma-track-card">
    <div class="luma-track-badge">REAL-TIME SHIPMENT PORTAL</div>
    <h1 class="luma-track-title">Track Your Shipment</h1>
    <p class="luma-track-subtitle">Enter your USPS, UPS, or Order Confirmation number below to view real-time transit milestones directly from our Utah logistics hub.</p>

    <div class="luma-track-form">
      <div class="track-input-group">
        <label for="trackInput">Carrier Tracking Number or Order #</label>
        <input type="text" id="trackInput" placeholder="e.g. 9400 1118 9956 ... or #1042" required autocomplete="off">
      </div>
      <div class="track-input-group">
        <label for="emailInput">Email or Phone (Optional for Order Lookup)</label>
        <input type="text" id="emailInput" placeholder="name@domain.com">
      </div>
      <button type="button" class="luma-track-btn" onclick="lookupTracking()">Search Live Status →</button>
    </div>

    <div id="trackResultBox" class="track-result-box" style="display: none;">
      <div class="track-result-header">
        <span class="status-indicator-dot"></span>
        <strong id="resultStatus">In Transit — On Schedule</strong>
      </div>
      <p id="resultDetails" class="result-details">Package received at Regional Origin Facility. Outbound dispatch scanned.</p>
      <div class="carrier-direct-link">
        <a id="carrierExternalLink" href="#" target="_blank" rel="noopener noreferrer">View Full Carrier Log on USPS / UPS →</a>
      </div>
    </div>

    <div class="luma-track-guarantee">
      <div class="guarantee-item">
        <span>⚡</span>
        <div><strong>24h Fast Dispatch</strong><br><small>Dispatched directly from Utah, USA</small></div>
      </div>
      <div class="guarantee-item">
        <span>📦</span>
        <div><strong>Insured Delivery</strong><br><small>100% covered against transit damage or loss</small></div>
      </div>
      <div class="guarantee-item">
        <span>💬</span>
        <div><strong>Live Concierge Desk</strong><br><small>support@lumaclinical.com (response &lt; 4h)</small></div>
      </div>
    </div>
  </div>
</div>

<style>
  .luma-track-container { background: #F8FAFC; padding: 60px 20px; min-height: 70vh; display: flex; align-items: center; justify-content: center; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .luma-track-card { background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; max-width: 620px; width: 100%; padding: 40px 32px; box-shadow: 0 10px 35px -10px rgba(15, 23, 42, 0.08); text-align: center; }
  .luma-track-badge { display: inline-block; background: #F0FDFA; color: #0D9488; border: 1px solid #99F6E4; padding: 5px 14px; border-radius: 30px; font-size: 11px; font-weight: 800; letter-spacing: 0.05em; margin-bottom: 14px; }
  .luma-track-title { font-size: 32px; font-weight: 900; color: #0F172A; margin: 0 0 12px; }
  .luma-track-subtitle { font-size: 14px; color: #64748B; line-height: 1.6; margin: 0 0 30px; }
  
  .luma-track-form { text-align: left; display: flex; flex-direction: column; gap: 18px; margin-bottom: 24px; }
  .track-input-group label { display: block; font-size: 12px; font-weight: 700; color: #334155; margin-bottom: 6px; }
  .track-input-group input { width: 100%; box-sizing: border-box; padding: 12px 16px; border: 1px solid #CBD5E1; border-radius: 10px; font-size: 14px; color: #0F172A; outline: none; transition: border-color 0.2s ease; }
  .track-input-group input:focus { border-color: #0D9488; box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15); }
  
  .luma-track-btn { background: #0F172A; color: #FFFFFF; border: none; padding: 14px 20px; border-radius: 50px; font-size: 14px; font-weight: 800; cursor: pointer; transition: background 0.2s ease; margin-top: 6px; }
  .luma-track-btn:hover { background: #0D9488; }
  
  .track-result-box { background: #F0FDFA; border: 1px solid #99F6E4; border-radius: 12px; padding: 18px; text-align: left; margin: 20px 0; }
  .track-result-header { display: flex; align-items: center; gap: 8px; color: #0F766E; margin-bottom: 6px; }
  .status-indicator-dot { width: 10px; height: 10px; background: #10B981; border-radius: 50%; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); }
  .result-details { font-size: 13px; color: #334155; margin: 0 0 10px; }
  .carrier-direct-link a { font-size: 12px; font-weight: 700; color: #0D9488; text-decoration: none; }
  .carrier-direct-link a:hover { text-decoration: underline; }
  
  .luma-track-guarantee { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; border-top: 1px solid #F1F5F9; padding-top: 24px; margin-top: 20px; text-align: left; }
  .guarantee-item { display: flex; gap: 8px; font-size: 12px; color: #334155; }
  .guarantee-item span { font-size: 18px; }
  .guarantee-item small { color: #64748B; font-size: 10.5px; }
  
  @media(max-width: 600px) {
    .luma-track-guarantee { grid-template-columns: 1fr; }
  }
</style>

<script>
  function lookupTracking() {
    const val = document.getElementById('trackInput').value.trim();
    if (!val) {
      alert('Please enter a tracking number or order number.');
      return;
    }
    const resultBox = document.getElementById('trackResultBox');
    const resultStatus = document.getElementById('resultStatus');
    const resultDetails = document.getElementById('resultDetails');
    const externalLink = document.getElementById('carrierExternalLink');

    resultBox.style.display = 'block';
    if (val.startsWith('9') || val.length >= 20) {
      resultStatus.innerText = 'USPS Priority — Transit Confirmed';
      resultDetails.innerText = 'Shipment ID ' + val + ' was accepted at Provo, UT hub. Fast domestic delivery in progress.';
      externalLink.href = 'https://tools.usps.com/go/TrackConfirmAction?tLabels=' + encodeURIComponent(val);
      externalLink.innerText = 'Open Official USPS Tracking Page →';
    } else if (val.startsWith('1Z')) {
      resultStatus.innerText = 'UPS Ground — In Transit';
      resultDetails.innerText = 'Shipment ID ' + val + ' in transit from Utah Logistics Hub.';
      externalLink.href = 'https://www.ups.com/track?tracknum=' + encodeURIComponent(val);
      externalLink.innerText = 'Open Official UPS Tracking Page →';
    } else {
      resultStatus.innerText = 'Order #' + val.replace('#', '') + ' — Processing & Dispatched';
      resultDetails.innerText = 'Your package was packaged and dispatched via USPS Priority. Tracking link sent to your email.';
      externalLink.href = 'https://tools.usps.com';
      externalLink.innerText = 'Check Direct Carrier Status →';
    }
  }
</script>
