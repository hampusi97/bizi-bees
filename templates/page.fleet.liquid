<style>
  .fleet-directory-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    padding: 60px 24px 100px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .fleet-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 50px;
  }
  .fleet-badge {
    display: inline-block;
    background: #1C1917;
    color: #F59E0B;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .fleet-header h1 {
    font-family: Georgia, serif;
    font-size: 40px;
    color: #1C1917;
    margin: 0 0 16px;
    line-height: 1.2;
  }
  .fleet-header p {
    font-size: 16px;
    color: #57534E;
    line-height: 1.6;
    margin: 0;
  }
  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 28px;
  }
  .fleet-card {
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 16px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .fleet-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
  }
  .fleet-card.featured {
    border-color: #D97706;
    background: #FFFCF7;
  }
  .fleet-card-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: #F3F4F6;
    color: #4B5563;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .fleet-card.featured .fleet-card-badge {
    background: #FEF3C7;
    color: #92400E;
  }
  .fleet-icon {
    font-size: 36px;
    margin-bottom: 14px;
  }
  .fleet-card h3 {
    font-family: Georgia, serif;
    font-size: 22px;
    color: #1C1917;
    margin: 0 0 8px;
  }
  .fleet-niche {
    font-size: 13px;
    color: #78716C;
    margin: 0 0 16px;
    line-height: 1.4;
  }
  .fleet-hero-info {
    background: #F5F5F4;
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 16px;
    font-size: 13px;
  }
  .fleet-card.featured .fleet-hero-info {
    background: #FEF3C7;
  }
  .fleet-hero-info span {
    display: block;
    font-weight: 600;
    color: #1C1917;
    margin-bottom: 6px;
  }
  .fleet-pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
  }
  .fleet-pricing strong {
    font-size: 16px;
    color: #059669;
  }
  .fleet-pricing span {
    font-size: 12px;
    color: #78716C;
    font-weight: normal;
    margin: 0;
  }
  .fleet-gift {
    display: block;
    color: #B45309;
    font-weight: 700;
    font-size: 11px;
  }
  .fleet-meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    margin-bottom: 20px;
    color: #57534E;
    padding-top: 6px;
  }
  .fleet-margin {
    font-weight: 700;
    color: #059669;
  }
  .fleet-hub {
    color: #78716C;
  }
  .fleet-card-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
  }
  .fleet-btn {
    text-align: center;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .fleet-btn.primary {
    background: #1C1917;
    color: #FFFFFF;
  }
  .fleet-btn.primary:hover {
    background: #44403C;
  }
  .fleet-btn.secondary {
    background: #F3F4F6;
    color: #374151;
    border: 1px solid #E5E7EB;
  }
  .fleet-btn.secondary:hover {
    background: #E5E7EB;
  }
  @media (max-width: 768px) {
    .fleet-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
