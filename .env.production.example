# ==============================================================================
# INTERNAL AUTOMATION SECRETS (required — these endpoints return 401 without them)
# ==============================================================================
# Sent as "Authorization: Bearer <value>" to POST /api/dropper/deploy and
# POST /api/dropper/report, which commit to this repository.
DROPPER_DEPLOY_SECRET="generate-with-openssl-rand-hex-32"

# Sent by Vercel Cron as "Authorization: Bearer <value>" to /api/cron/*.
# Vercel Cron does not send this header by default, so either use a cron
# provider that allows custom headers or call the routes from a workflow.
CRON_SECRET="generate-with-openssl-rand-hex-32"

# TikTok Shop webhook signing secret. The webhook rejects every request when unset.
TIKTOK_SHOP_WEBHOOK_SECRET="tts_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

