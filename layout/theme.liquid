<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0D9488">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if page_title -%}
      <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- else -%}
      <title>{{ shop.name }} &ndash; Dermatology-Grade Phototherapy</title>
    {%- endif -%}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="LUMA CLINICAL™ — Dermatology-Grade Phototherapy & QuadWave™ Microcurrent Sculpting Engineered for Daily Home Rituals. Dispatched from Utah, USA.">
    {%- endif -%}

    {{ content_for_header }}

    <!-- Master DTC Modern Luxury Design System -->
    {{ 'luma-modern-luxury.css' | asset_url | stylesheet_tag }}
    {{ 'ultra-dynamic-luxury.css' | asset_url | stylesheet_tag }}
    {{ 'ultra-dynamic-core.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'ultra-dynamic-core.js' | asset_url }}" defer="defer"></script>

    <!-- Google Position 0 Rich Snippet Schema (Product & Aggregate Review) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": "LumaGlow™ QuadWave Pro 4-in-1 Facial Wand",
      "image": "https://bizibees-store.myshopify.com/cdn/shop/files/lumaglow.jpg",
      "description": "Medical-grade 630nm phototherapy, 330µA microcurrent, and 107°F thermal massage.",
      "brand": { "@type": "Brand", "name": "Luma Clinical" },
      "offers": {
        "@type": "Offer",
        "url": "https://bizibees-store.myshopify.com/products/lumaglow-4-in-1-facial-wand",
        "priceCurrency": "USD",
        "price": "39.99",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "name": "Luma Clinical LLC"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "184"
      }
    }
    </script>

    <!-- Google Position 0 Rich Snippet Schema (WebSite & Breadcrumbs) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Luma Clinical",
      "url": "https://bizibees-store.myshopify.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://bizibees-store.myshopify.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://bizibees-store.myshopify.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Protocols",
          "item": "https://bizibees-store.myshopify.com/collections/all"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "LumaGlow™ QuadWave Pro 4-in-1",
          "item": "https://bizibees-store.myshopify.com/products/lumaglow-4-in-1-facial-wand"
        }
      ]
    }
    </script>
  </head>

  <body class="gradient">
    <!-- Announcement Bar -->
    <div class="luma-announcement-bar">
      <span>⚡ <strong>FAST US PRIORITY DISPATCH:</strong> Free Domestic Shipping on Orders $35+ • HSA/FSA Eligible • 60-Day Trial Guarantee</span>
    </div>

    <!-- Dynamic Real-Time Free Shipping Threshold Bar -->
    {% render 'dynamic-free-shipping-bar' %}

    <!-- Navigation Header -->
    <header class="luma-main-header">
      <div class="luma-header-inner">
        <a href="/" class="luma-brand-logo">
          <img src="{{ 'luma-logo.svg' | asset_url }}" alt="LUMA CLINICAL™" width="220" height="44" style="height: 40px; width: auto; display: block;">
        </a>
        <nav class="luma-nav-menu">
          <a href="/collections/all" class="nav-link">Protocols</a>
          <a href="/products/lumaglow-4-in-1-facial-wand" class="nav-link">LumaGlow™ Pro</a>
          <a href="/products/lumarelief-migraine-cap" class="nav-link">LumaRelief™ Cap</a>
          <a href="/pages/track-order" class="nav-link">Track Shipment</a>
        </nav>
        <div class="luma-header-actions">
          <a href="/cart" class="luma-cart-btn">
            Cart <span class="cart-pill">({{ cart.item_count }})</span>
          </a>
        </div>
      </div>
    </header>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- VIP Conglomerate Pass - Cross-Brand Loyalty Ecosystem -->
    {% render 'conglomerate-loyalty-pass' %}

    <!-- 13-Brand Universal VIP Passport -->
    {% render 'universal-loyalty-passport' %}

    <!-- Bank / Stripe Compliance Trust Shield -->
    {% render 'compliance-trust-shield' %}

    <!-- Sticky Mobile 1-Click Buy Drawer -->
    {% render 'luma-sticky-cart' %}

    <style>
      .luma-announcement-bar { background: #0F172A; color: #FFFFFF; text-align: center; padding: 10px 16px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.03em; }
      .luma-announcement-bar strong { color: #99F6E4; }
      .luma-main-header { background: #FFFFFF; border-bottom: 1px solid #E2E8F0; padding: 16px 24px; position: sticky; top: 0; z-index: 1000; }
      .luma-header-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
      .luma-nav-menu { display: flex; gap: 28px; }
      .nav-link { color: #334155; text-decoration: none; font-size: 13.5px; font-weight: 700; transition: color 0.2s ease; }
      .nav-link:hover { color: #0D9488; }
      .luma-cart-btn { background: #F8FAFC; border: 1px solid #E2E8F0; color: #0F172A; text-decoration: none; padding: 8px 18px; border-radius: 40px; font-size: 13px; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; }
      .cart-pill { color: #0D9488; }
      @media(max-width: 768px) {
        .luma-nav-menu { display: none; }
      }
    </style>
    <!-- Ultra-Dynamic Live Social Proof Toast -->
    {% render 'live-social-proof-toast' %}
  </body>
</html>
