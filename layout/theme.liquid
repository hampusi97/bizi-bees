<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2D3B2D">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {%- if page_title -%}
      <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- else -%}
      <title>Bizi Bees Boutique &ndash; Curated Literature & Botanical Goods</title>
    {%- endif -%}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="Bizi Bees Boutique — Handcrafted blind date book crates, botanical apothecary candles, and intentional home rituals. Dispatched nationwide with care.">
    {%- endif -%}

    {{ content_for_header }}

    <!-- Editorial Boutique Design System -->
    {{ 'dropper-editorial.css' | asset_url | stylesheet_tag }}
    {{ 'ultra-dynamic-core.css' | asset_url | stylesheet_tag }}

    <!-- Scripts -->
    <script src="{{ 'ultra-dynamic-core.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'dropper-cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'dropper-pdp.js' | asset_url }}" defer="defer"></script>

    <!-- Schema.org Microdata -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Bizi Bees Boutique",
      "url": "https://bizibees-store.myshopify.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://bizibees-store.myshopify.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
  </head>

  <body>
    <!-- Clean Editorial Announcement Bar -->
    <div class="editorial-announcement-bar">
      <span>Complimentary Standard US Shipping on Orders Over $50 • Handcrafted in Small Batches</span>
    </div>

    <!-- Editorial Navigation Header -->
    <header class="editorial-header">
      <div class="editorial-header-inner">
        <a href="/" class="editorial-logo">
          Bizi Bees <span>Boutique</span>
        </a>

        <nav class="editorial-nav">
          <a href="/collections/all" class="editorial-nav-link">All Curations</a>
          <a href="/products/mystery-crate" class="editorial-nav-link">Book Crates</a>
          <a href="/collections/candles" class="editorial-nav-link">Apothecary</a>
          <a href="/products/lumaglow-4-in-1-facial-wand" class="editorial-nav-link">Signature Care</a>
          <a href="/pages/track-order" class="editorial-nav-link">Track Order</a>
        </nav>

        <div class="editorial-actions">
          <button type="button" class="editorial-action-btn" data-open-search aria-label="Search catalog">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span style="font-size: 12.5px;">Search</span>
            <span style="font-size: 10px; background: #F5F3EF; padding: 1px 5px; border-radius: 4px; margin-left: 6px; border: 1px solid #E7E5E4;">⌘K</span>
          </button>

          <a href="/cart" class="editorial-cart-btn" data-open-cart aria-label="Open Shopping Bag">
            <span>Bag</span>
            <span class="editorial-cart-count" id="HeaderCartCount">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Clean 4-Column Editorial Footer -->
    {% render 'editorial-footer' %}

    <!-- Dynamic Conversion Systems (Slide-Out Cart Drawer, Predictive Search, Sticky Bar) -->
    {% render 'cart-drawer' %}
    {% render 'predictive-search' %}
    {% render 'sticky-buy-bar' %}

  </body>
</html>
