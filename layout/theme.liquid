<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF7F2">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,900;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {%- if page_title -%}
      <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- else -%}
      <title>Bizi Bees Boutique & Bookshop &ndash; Curated Literature, Vintage Finds & Cozy Mystery Gifts</title>
    {%- endif -%}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="Bizi Bees Boutique & Bookshop — Curated vintage paperbacks, Blind Date with a Book mystery packages, retro family games, and artisan boutique stationery.">
    {%- endif -%}

    <!-- Universal SEO Metadata Hub -->
    {% render 'seo-metadata-hub' %}

    {{ content_for_header }}

    <!-- Bizi Bees Boutique Cozy Editorial Design System -->
    {{ 'bizi-bees-boutique.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'dropper-editorial.css' | asset_url | stylesheet_tag }}

    <!-- Scripts -->
    <script src="{{ 'ultra-dynamic-core.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'dropper-cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'dropper-pdp.js' | asset_url }}" defer="defer"></script>

    <!-- Schema.org Microdata -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Bizi Bees Boutique & Bookshop",
      "url": "https://bizibees-store.myshopify.com",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://bizibees-store.myshopify.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
  </head>

  <body>
    <!-- Real-Time Free Shipping Threshold Bar ($35.00) -->
    {% render 'dynamic-free-shipping-bar' %}

    <!-- Warm Announcement Bar -->
    <div class="announcement-bar" style="text-align: center;">
      <span>🐝 Free Tracked US Shipping on Orders Over $35 • Handpicked Vintage Classics &amp; Curated Cozy Gifts</span>
    </div>

    <!-- Editorial Navigation Header -->
    <header class="editorial-header">
      <div class="editorial-header-inner">
        <a href="/" class="editorial-logo">
          Bizi Bees <span>Boutique &amp; Books</span>
        </a>

        <nav class="editorial-nav">
          <a href="/collections/all" class="editorial-nav-link">All Treasures (350)</a>
          <a href="/#blindDateSection" class="editorial-nav-link">Blind Date with a Book</a>
          <a href="/#biziCrateSection" class="editorial-nav-link">Custom Gift Crates</a>
          <a href="/collections/books" class="editorial-nav-link">Vintage Books</a>
          <a href="/collections/holiday-gifts-stocking-stuffers" class="editorial-nav-link">Holiday Gifts</a>
          <a href="/collections/gifts-25-and-under" class="editorial-nav-link">Under $25</a>
          <a href="/pages/shipping" class="editorial-nav-link">Shipping &amp; Delivery</a>
        </nav>

        <div class="editorial-actions">
          <button type="button" class="editorial-action-btn" data-open-search aria-label="Search catalog">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span style="font-size: 12.5px;">Search</span>
            <span style="font-size: 10px; background: #F5F3EF; padding: 1px 5px; border-radius: 4px; margin-left: 6px; border: 1px solid #E7E5E4;">⌘K</span>
          </button>

          <a href="/cart" class="editorial-cart-btn" data-open-cart aria-label="Open Shopping Bag">
            <span>Bag</span>
            <span class="editorial-cart-count" id="HeaderCartCount">{{ cart.item_count }}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Clean 4-Column Editorial Footer -->
    {% render 'editorial-footer' %}

    <!-- Dynamic Conversion Systems (Slide-Out Cart Drawer, Predictive Search, Sticky Bar) -->
    {% render 'cart-drawer' %}
    {% render 'predictive-search' %}
    {% render 'sticky-buy-bar' %}

    <!-- Self-Hosted Edge Telemetry & Rage-Click Tracker -->
    {% render 'dropper-telemetry' %}

    <!-- Interactive "Break the Wax Seal" VIP Modal -->
    {% render 'wax-seal-popup' %}

    <!-- Native 1-Click Post-Purchase Upsell Ladder -->
    {% render 'post-purchase-upsell-ladder' %}

    <!-- Footer Legal Sanitizer & PROVOTODAY DOM Cleaner -->
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        // Suppress $150,000 legal threat blocks in footer
        document.querySelectorAll("footer p, .footer p, .disclaimer, .footer__content-bottom").forEach(function(el) {
          if (el.innerText && (el.innerText.includes("150,000") || el.innerText.includes("Lanham Act") || el.innerText.includes("STRICT LEGAL WARNING"))) {
            el.style.display = "none";
          }
        });

        // Suppress legacy PROVOTODAY popups & flash sale modals
        document.querySelectorAll("[class*='popup'], [class*='modal'], [id*='popup'], [id*='modal'], div").forEach(function(el) {
          if (el.id === 'waxModal' || el.closest('#waxModal')) return;
          if (el.innerText && (el.innerText.includes("PROVOTODAY") || el.innerText.includes("PROVO TODAY"))) {
            el.style.display = "none";
            if (el.remove) el.remove();
          }
        });
      });
    </script>
  
    <!-- Repo-OS Global Shield & AI Matcher -->
    {% render 'repo-os-global-shield' %}

    <!-- Auto-Binding Variant Resolver & iOS Dynamic Island -->
    {% render 'dynamic-island-resolver' %}
  </body>
</html>
