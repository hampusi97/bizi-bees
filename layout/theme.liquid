    <style>
      .collection-links{display:flex;flex-wrap:wrap;gap:8px 16px;margin:4px 0 22px}
      .collection-links a{text-decoration:underline;text-underline-offset:3px;min-height:44px;display:inline-flex;align-items:center}
      .trust-points{display:flex;flex-wrap:wrap;gap:8px 16px;margin:14px 0 4px;font-size:14px}
      .trust-points span{background:#e5ebdd;border-radius:999px;padding:6px 12px}
      .seo-copy a{text-decoration:underline;text-underline-offset:3px}
    </style>
    {{ content_for_header }}
      {% render 'bizi-bees-schema' %}
  </head>

  <body>
    <a class="skip" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}

    {% if request.page_type == 'index' %}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "OnlineStore",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "description": "Shop pre-loved books, used electronics, pre-owned toys, secondhand clothing, and more curated thrift finds at bizi bees.",
        "email": "kharter15@gmail.com"
      }
      </script>
    {% endif %}

    {% if request.page_type == 'product' %}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ canonical_url | json }},
        {% if product.selected_or_first_available_variant.sku != blank %}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
        {% endif %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | default: shop.name | json }}
        },
        "description": {{ product.description | strip_html | truncate: 5000 | json }}{% if product.featured_image %},
        "image": {{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}{% endif %},
        "offers": {
          "@type": "Offer",
          "url": {{ canonical_url | json }},
          "priceCurrency": {{ shop.currency | json }},
          "price": {{ product.selected_or_first_available_variant.price | money_without_currency | replace: ",", "" | strip | json }},
          "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/{% if product.tags contains 'Shopify Collective' or product.metafields.custom.condition.value == 'New / unused' %}NewCondition{% else %}UsedCondition{% endif %}"
        }
      }
      </script>
    {% endif %}
  {% render 'conversion-booster' %}
  </body>
</html>
