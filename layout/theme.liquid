ry{padding:28px}.section-head{align-items:start}.section-head h2{font-size:30px}.head .search{display:none}.cart-row{grid-template-columns:55px 1fr 65px;gap:10px}.cart-row>span{grid-column:2}.product h1{font-size:36px}}.bee{display:inline-flex;width:38px;height:38px;vertical-align:middle;margin-right:8px;letter-spacing:0}.bee svg{width:100%;height:100%}.logo{display:inline-flex;align-items:center;letter-spacing:-1.8px}.hero-art .object img{width:145px;height:145px}.category span img{width:72px;height:72px}.card-image span{display:flex;align-items:center;justify-content:center;width:100%;height:100%}.card-image span img{width:75%;height:75%;object-fit:contain}.hero{background-image:radial-gradient(#fff6 1px,transparent 1px);background-size:20px 20px}.category{border:1px solid #e2e4d8}.head{flex-wrap:wrap}.head nav{gap:16px}.head .search{margin-left:auto}.trust strong{font-weight:700} @media(max-width:600px){.hero-art .object img{width:105px;height:105px}.category span img{width:65px;height:65px}.hero-art{padding:18px}.bee{width:33px;height:33px}.hero{margin-top:18px}.head nav{scrollbar-width:thin}.head{padding-top:16px;padding-bottom:10px}}
.product>*,.grid>*,.head>*,.story>*{min-width:0}
.product h1,.card h3,.prose{overflow-wrap:anywhere}
.product .gallery{align-content:start}
.product .gallery img{object-fit:contain}
@media(max-width:900px){.head nav{max-width:100%;overscroll-behavior-x:contain}.head nav a{white-space:nowrap;display:inline-flex;align-items:center;min-height:44px;flex-shrink:0}.product{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
.product{display:flex;flex-direction:column;gap:24px}.product h1{font-size:clamp(28px,8vw,36px)}
.product .gallery{display:flex;overflow-x:auto;gap:12px;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;max-width:100%;padding-bottom:10px;scrollbar-width:thin}
.product .gallery img{flex:0 0 100%;width:100%;max-width:100%;height: min(100vw,430px);scroll-snap-align:start;object-fit:contain}

/* Luxury Desktop Two-Column PDP Layout */
@media (min-width: 901px) {
  .product {
    display: grid !important;
    grid-template-columns: 1.15fr 1fr !important;
    gap: 48px !important;
    align-items: start !important;
  }
  .product .gallery {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 16px !important;
    position: sticky !important;
    top: 24px !important;
  }
  .product .gallery img {
    height: auto !important;
    max-height: 560px !important;
    width: 100% !important;
    object-fit: cover !important;
    border-radius: 14px !important;
    border: 1px solid #e5e7eb !important;
    background: #ffffff !important;
  }
}

/* Warm boutique product cards */
.card-wrapper,
.card {
  background: #ffffff !important;
  border-radius: 16px !important;
  border: 1px solid #ebd9c5 !important;
  box-shadow: 0 8px 24px rgba(184, 150, 110, 0.08) !important;
  transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s ease !important;
  overflow: hidden !important;
}

.card-wrapper:hover,
.card:hover {
  transform: translateY(-6px) !important;
  box-shadow: 0 16px 36px rgba(184, 150, 110, 0.18) !important;
}

.card__heading a,
.card h3,
.card h3 a {
  font-family: Georgia, "Times New Roman", serif !important;
  color: #2a241f !important;
}

</style>
