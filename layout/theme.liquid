<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#202B29">

    <title>
      {% if page_title %}
        {{ page_title }}
      {% else %}
        {{ shop.name }}
      {% endif %}
      {% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}
      {% if template.name == 'index' %} — Shop secondhand finds{% endif %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% elsif template == 'index' %}
      <meta name="description" content="Shop pre-loved books, electronics, toys, and more at bizi bees. Curated finds, honest condition notes, and friendly pricing.">
    {% else %}
      <meta name="description" content="{{ shop.name }} offers thoughtfully curated secondhand finds with quality details and easy shopping.">
    {% endif %}

    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
    <meta property="og:description" content="{{ page_description | default: 'Shop pre-loved books, electronics, toys, and more at bizi bees.' | escape }}">
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    {% if request.page_type == 'product' %}
      <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' | strip }}">
      <meta property="product:price:currency" content="{{ shop.currency }}">
      <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' | strip }}">
      <meta property="og:price:currency" content="{{ shop.currency }}">
      <meta property="product:availability" content="{% if product.available %}instock{% else %}outofstock{% endif %}">
      <meta property="product:brand" content="{{ product.vendor | default: shop.name | escape }}">
    {% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
    <meta name="twitter:description" content="{{ page_description | default: 'Shop pre-loved books, electronics, toys, and more at bizi bees.' | escape }}">
    {% if request.page_type == 'product' and product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
      <meta name="twitter:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {% elsif request.page_type == 'collection' and collection.image %}
      <meta property="og:image" content="https:{{ collection.image | image_url: width: 1200 }}">
      <meta name="twitter:image" content="https:{{ collection.image | image_url: width: 1200 }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">

    <style id="inlined-critical-theme-css">
