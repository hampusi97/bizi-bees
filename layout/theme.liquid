<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title><meta name="description" content="{{ page_description | default: shop.description | escape }}"><link rel="canonical" href="{{ canonical_url }}">{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}</head><body><a class="skip" href="#MainContent">Skip to content</a>{% section 'header' %}<main id="MainContent">{{ content_for_layout }}</main>{% section 'footer' %}</body></html>
