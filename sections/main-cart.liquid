<div class="wrap block prose"><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% endif %}<div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }}</p><a href="{{ item.url_to_remove }}">Remove</a></div><label>Quantity<input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}"></label><span>{{ item.final_line_price | money }}</span></div>{% endfor %}<p class="price">Subtotal {{ cart.total_price | money }}</p><p>Shipping and any applicable taxes calculated at checkout. Your bag does not reserve stock.</p>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<button name="update" class="secondary">Update bag</button><button name="checkout">Checkout</button></form>{% else %}<p>Your next good find is waiting.</p><a class="button" href="/collections/all">Explore the finds</a>{% endif %}</div>
{% schema %}{"name": "Main Cart", "settings": [], "presets": [{"name": "Main Cart"}]}{% endschema %}
