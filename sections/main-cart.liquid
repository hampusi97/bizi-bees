{% comment %}
  Modern DTC Cart Section with Automated Free Shipping & Fulfillment Flags
  Repo: bizi-bees /sections/main-cart.liquid
{% endcomment %}

<div class="cart-page-wrapper wrap block">
  <div class="cart-header-box">
    <div class="cart-badge-row">
      <span class="dtc-badge dtc-badge-teal">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        VERIFIED SHOPPING BAG
      </span>
      <span class="dtc-badge dtc-badge-amber">
        🛡️ 60-DAY CLINICAL GUARANTEE ACTIVE
      </span>
    </div>
    <h1 class="cart-main-title">Your Shopping Bag</h1>
  </div>

  {% if cart.item_count > 0 %}
    <!-- Automated Free Shipping Threshold Progress Meter ($50.00) -->
    {% assign free_shipping_threshold = 5000 %}
    {% assign subtotal = cart.total_price %}
    <div class="cart-free-shipping-bar {% if subtotal >= free_shipping_threshold %}unlocked{% endif %}">
      {% if subtotal >= free_shipping_threshold %}
        <div class="shipping-status-msg text-teal">
          <span>🎉</span> <strong>CONGRATULATIONS!</strong> You've unlocked <strong>100% FREE Tracked US Shipping!</strong>
        </div>
        <div class="shipping-meter-track">
          <div class="shipping-meter-fill" style="width: 100%; background: #0D9488;"></div>
        </div>
      {% else %}
        {% assign diff = free_shipping_threshold | minus: subtotal %}
        <div class="shipping-status-msg">
          <span>🚚</span> Add <strong>{{ diff | money }}</strong> more to unlock <strong>FREE US Priority Tracked Shipping</strong>!
        </div>
        {% assign pct = subtotal | times: 100 | divided_by: free_shipping_threshold %}
        <div class="shipping-meter-track">
          <div class="shipping-meter-fill" style="width: {{ pct }}%;"></div>
        </div>
      {% endif %}
    </div>

    <!-- Fulfillment Facility Routing Indicator -->
    {% assign provo_items = 0 %}
    {% assign supplier_items = 0 %}
    {% for item in cart.items %}
      {% assign v = item.product.vendor | default: shop.name %}
      {% if v == 'Bizi Bees' or v == 'Book Outpost' or v == shop.name %}
        {% assign provo_items = provo_items | plus: item.quantity %}
      {% else %}
        {% assign supplier_items = supplier_items | plus: item.quantity %}
      {% endif %}
    {% endfor %}

    <div class="cart-routing-pill-banner">
      <div class="routing-icon">📦</div>
      <div class="routing-text">
        {% if provo_items > 0 and supplier_items > 0 %}
          <strong>Multi-Facility Auto-Routing Active:</strong> {{ provo_items }} item(s) dispatch from Provo Studio + {{ supplier_items }} item(s) from Specialized Clinical Hub.
        {% elsif provo_items > 0 %}
          <strong>Domestic Workshop Dispatch:</strong> In stock in Provo, Utah. Ships in 24 hours via USPS Priority Tracked.
        {% else %}
          <strong>Specialized Clinical Hub Dispatch:</strong> In stock in Utah Logistics Facility. Ships in 24–48h with End-to-End Tracking.
        {% endif %}
      </div>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <!-- Hidden Auto-Fulfillment Attributes for Order Payload -->
      {% if provo_items > 0 and supplier_items > 0 %}
        <input type="hidden" name="attributes[Auto_Fulfillment_Flag]" value="SPLIT-FULFILLMENT-PROVO-SUPPLIER">
        <input type="hidden" name="attributes[Fulfillment_Facility]" value="Split (Provo Studio + Supplier Facility)">
      {% elsif provo_items > 0 %}
        <input type="hidden" name="attributes[Auto_Fulfillment_Flag]" value="PROVO-DOMESTIC-FULFILLMENT">
        <input type="hidden" name="attributes[Fulfillment_Facility]" value="Provo Domestic Studio (Kimberly Harter)">
      {% else %}
        <input type="hidden" name="attributes[Auto_Fulfillment_Flag]" value="SUPPLIER-FACILITY-FULFILLMENT">
        <input type="hidden" name="attributes[Fulfillment_Facility]" value="Specialized Logistics Facility / Utah Hub">
      {% endif %}

      <div class="cart-items-list">
        {% for item in cart.items %}
          <div class="cart-item-row">
            <div class="item-image-col">
              {% if item.image %}
                {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', class: 'item-img' }}
              {% else %}
                <div class="placeholder-img">📦</div>
              {% endif %}
            </div>

            <div class="item-details-col">
              <a href="{{ item.url }}" class="item-title">{{ item.product.title | escape }}</a>
              {% unless item.product.has_only_default_variant %}
                <p class="item-variant">{{ item.variant.title | escape }}</p>
              {% endunless %}

              {% if item.properties.size > 0 %}
                <div class="item-properties">
                  {% for p in item.properties %}
                    {% unless p.first contains '_' or p.last == blank %}
                      <span class="prop-badge"><strong>{{ p.first }}:</strong> {{ p.last }}</span>
                    {% endunless %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="item-vendor-tag">
                {% assign iv = item.product.vendor | default: shop.name %}
                {% if iv == 'Bizi Bees' or iv == 'Book Outpost' %}
                  <span class="hub-tag provo-tag">📍 Ships from Provo, UT</span>
                {% else %}
                  <span class="hub-tag clinical-tag">⚡ Utah Clinical Hub</span>
                {% endif %}
              </div>

              <a href="{{ item.url_to_remove }}" class="item-remove-link">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                Remove item
              </a>
            </div>

            <div class="item-quantity-col">
              <label for="Updates-{{ item.key }}" class="qty-label">Qty</label>
              <input 
                type="number" 
                name="updates[]" 
                id="Updates-{{ item.key }}"
                value="{{ item.quantity }}" 
                min="0" 
                class="qty-input"
                aria-label="Quantity for {{ item.product.title | escape }}"
              >
            </div>

            <div class="item-total-col">
              <span class="item-price">{{ item.final_line_price | money }}</span>
              {% if item.original_line_price > item.final_line_price %}
                <s class="item-compare-price">{{ item.original_line_price | money }}</s>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Cart Summary Footer -->
      <div class="cart-summary-card">
        <div class="summary-breakdown">
          <div class="summary-line">
            <span>Bag Subtotal</span>
            <strong class="subtotal-val">{{ cart.total_price | money }}</strong>
          </div>

          {% for discount in cart.cart_level_discount_applications %}
            <div class="summary-line discount-line">
              <span>Discount ({{ discount.title | escape }})</span>
              <span>−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {% endfor %}

          <div class="summary-line">
            <span>Estimated Shipping</span>
            <span>
              {% if cart.total_price >= 5000 %}
                <strong style="color:#0D9488;">FREE (Unlocked)</strong>
              {% else %}
                <span style="color:#475569;">Calculated at checkout</span>
              {% endif %}
            </span>
          </div>

          <p class="taxes-notice">
            Sales tax and additional shipping options calculated during 256-bit SSL encrypted checkout.
          </p>
        </div>

        <div class="cart-actions-row">
          <button type="submit" name="update" class="button secondary update-btn">
            Update Bag
          </button>
          
          <button type="submit" name="checkout" class="button dtc-btn-amber checkout-btn">
            <span>PROCEED TO SECURE CHECKOUT →</span>
            <small>🔒 Instant 256-Bit SSL Checkout</small>
          </button>
        </div>

        <!-- Trust Badges -->
        <div class="cart-trust-badges">
          <span>🛡️ 60-Day Guarantee</span>
          <span>⚡ Fast 24-48h Dispatch</span>
          <span>🇺🇸 Tracked USPS</span>
          <span>💳 Apple Pay / Shop Pay</span>
        </div>
      </div>
    </form>
  {% else %}
    <div class="cart-empty-state">
      <div class="empty-icon">🐝</div>
      <h2>Your bag is currently empty</h2>
      <p>Discover our clinical-grade LumaGlow 4-in-1 facial sculptors or explore vintage Provo book finds.</p>
      <div class="empty-actions">
        <a class="button dtc-btn-amber" href="/products/lumaglow-4-in-1-facial-wand">Explore LumaGlow 4-in-1 Wand →</a>
        <a class="button secondary" href="/collections/all">Browse All Finds</a>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .cart-page-wrapper {
    max-width: 980px;
    margin: 0 auto;
    padding: 30px 20px 60px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .cart-header-box {
    margin-bottom: 24px;
    text-align: center;
  }
  .cart-badge-row {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .cart-main-title {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 900;
    color: #0F172A;
    margin: 0;
  }

  /* Free shipping progress bar */
  .cart-free-shipping-bar {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px 20px;
    margin-bottom: 20px;
    text-align: center;
  }
  .cart-free-shipping-bar.unlocked {
    background: #F0FDFA;
    border-color: #99F6E4;
  }
  .shipping-status-msg {
    font-size: 13px;
    color: #334155;
    margin-bottom: 8px;
  }
  .shipping-meter-track {
    height: 7px;
    background: #E2E8F0;
    border-radius: 9999px;
    overflow: hidden;
    max-width: 440px;
    margin: 0 auto;
  }
  .shipping-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, #0D9488, #D97706);
    border-radius: 9999px;
    transition: width 0.4s ease;
  }

  /* Routing Banner */
  .cart-routing-pill-banner {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 10px 16px;
    margin-bottom: 24px;
    font-size: 12px;
    color: #475569;
  }
  .routing-icon {
    font-size: 20px;
  }

  /* Items List */
  .cart-items-list {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 28px;
  }
  .cart-item-row {
    display: grid;
    grid-template-columns: 100px 1fr 110px 110px;
    align-items: center;
    gap: 20px;
    padding: 20px;
    border-bottom: 1px solid #F1F5F9;
  }
  .cart-item-row:last-child {
    border-bottom: none;
  }
  .item-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
  }
  .placeholder-img {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F1F5F9;
    font-size: 32px;
    border-radius: 10px;
  }
  .item-title {
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    text-decoration: none;
    line-height: 1.35;
    display: block;
    margin-bottom: 4px;
  }
  .item-title:hover {
    color: #0D9488;
  }
  .item-variant {
    font-size: 12px;
    color: #64748B;
    margin: 0 0 6px 0;
  }
  .item-properties {
    margin: 6px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .prop-badge {
    font-size: 11px;
    background: #F1F5F9;
    color: #334155;
    padding: 2px 8px;
    border-radius: 4px;
  }
  .item-vendor-tag {
    margin: 4px 0 8px;
  }
  .hub-tag {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .provo-tag { background: #FEF3C7; color: #92400E; }
  .clinical-tag { background: #ECFDF5; color: #065F46; }
  .item-remove-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: #DC2626;
    text-decoration: none;
    font-weight: 600;
  }
  .item-remove-link:hover {
    text-decoration: underline;
  }

  .qty-label {
    display: block;
    font-size: 11px;
    color: #64748B;
    margin-bottom: 4px;
  }
  .qty-input {
    width: 65px;
    padding: 8px 10px;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
  }
  .item-price {
    font-size: 16px;
    font-weight: 800;
    color: #0F172A;
    display: block;
  }
  .item-compare-price {
    font-size: 12px;
    color: #94A3B8;
  }

  /* Summary Card */
  .cart-summary-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 28px;
  }
  .summary-line {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: #334155;
    margin-bottom: 12px;
  }
  .subtotal-val {
    font-size: 22px;
    font-weight: 900;
    color: #0F172A;
  }
  .taxes-notice {
    font-size: 12px;
    color: #64748B;
    margin: 16px 0 20px;
    line-height: 1.5;
  }
  .cart-actions-row {
    display: flex;
    gap: 16px;
    justify-content: flex-end;
    align-items: center;
  }
  .update-btn {
    border-radius: 9999px;
    padding: 14px 22px;
    font-size: 13px;
  }
  .checkout-btn {
    border-radius: 9999px;
    padding: 14px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: none;
    cursor: pointer;
  }
  .checkout-btn span {
    font-size: 15px;
    font-weight: 800;
  }
  .checkout-btn small {
    font-size: 10px;
    opacity: 0.9;
  }
  .cart-trust-badges {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 12px;
    color: #64748B;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid #E2E8F0;
  }

  /* Empty State */
  .cart-empty-state {
    background: #F8FAFC;
    border: 1px dashed #CBD5E1;
    border-radius: 16px;
    padding: 60px 24px;
    text-align: center;
  }
  .empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
  }
  .cart-empty-state h2 {
    font-size: 24px;
    color: #0F172A;
    margin: 0 0 8px 0;
  }
  .cart-empty-state p {
    font-size: 14px;
    color: #64748B;
    margin: 0 0 24px 0;
  }
  .empty-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .cart-item-row {
      grid-template-columns: 75px 1fr;
      gap: 14px;
    }
    .item-quantity-col,
    .item-total-col {
      grid-column: span 1;
    }
    .cart-actions-row {
      flex-direction: column;
      width: 100%;
    }
    .cart-actions-row button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Main Cart",
  "settings": [],
  "presets": [
    {
      "name": "Main Cart"
    }
  ]
}
{% endschema %}