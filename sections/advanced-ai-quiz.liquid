{% comment %}
  15-SECOND AI MATCHMAKER & PERSONALIZATION QUIZ
  Automatically binds to real Shopify products via /products.json
  Repo: bizi-bees /sections/advanced-ai-quiz.liquid
{% endcomment %}

<div class="ai-quiz-wrapper" id="quizSection">
  <div class="ai-quiz-card">
    
    <div class="quiz-progress-bar">
      <div class="quiz-progress-fill" id="quizProgressFill" style="width: 33%;"></div>
    </div>

    <!-- STEP 1 -->
    <div class="quiz-step active" id="qStep1">
      <span class="q-badge">✨ STEP 1 OF 3 • AI CONCIERGE</span>
      <h3>What is your #1 goal today?</h3>
      <div class="q-options">
        <button type="button" class="q-opt-btn" onclick="nextQuizStep(2, 'Self-Care & Daily Glow')">💆‍♀️ Upgrade My Daily Self-Care &amp; Evening Ritual</button>
        <button type="button" class="q-opt-btn" onclick="nextQuizStep(2, 'Cozy Reading & Unwinding')">📖 Unwind with a Cozy Mystery Book or Gift Box</button>
        <button type="button" class="q-opt-btn" onclick="nextQuizStep(2, 'Thoughtful Gifting')">🎁 Find a Unique, Memorable Gift Under $40</button>
      </div>
    </div>

    <!-- STEP 2 -->
    <div class="quiz-step" id="qStep2" style="display: none;">
      <span class="q-badge">✨ STEP 2 OF 3 • PREFERENCE</span>
      <h3>How do you prefer your experience packaged?</h3>
      <div class="q-options">
        <button type="button" class="q-opt-btn" onclick="nextQuizStep(3, 'Complete Bundle')">🌟 The Complete VIP Bundle (Best Value + Free Gift)</button>
        <button type="button" class="q-opt-btn" onclick="nextQuizStep(3, 'Solo Starter')">⚡ Just the Solo Essential to Start</button>
        <button type="button" class="q-opt-btn" onclick="nextQuizStep(3, 'Surprise Me')">🎲 Surprise Me with the Top-Rated Bestseller</button>
      </div>
    </div>

    <!-- STEP 3 -->
    <div class="quiz-step" id="qStep3" style="display: none;">
      <span class="q-badge">✨ STEP 3 OF 3 • PRIORITY BONUS</span>
      <h3>Which free bonus perk do you want unlocked?</h3>
      <div class="q-options">
        <button type="button" class="q-opt-btn" onclick="finishQuiz('Free Mystery Gift + Free Shipping')">🎁 Free Bonus Gift ($18 Value) + Free Shipping</button>
        <button type="button" class="q-opt-btn" onclick="finishQuiz('15% VIP Discount + Priority Dispatch')">🚚 Instant 15% VIP Savings + 24h Priority Dispatch</button>
      </div>
    </div>

    <!-- RESULT SCREEN (Dynamically Populated from Live Store Products) -->
    <div class="quiz-step" id="qResult" style="display: none;">
      <span class="q-badge-success">🎉 99.2% PERFECT MATCH FOUND!</span>
      <h3 id="matchHeadline">Your Custom Recommendation is Ready</h3>
      <p id="matchSubhead">Based on your answers, we paired you with our #1 highest-rated customer favorite—with your bonus perk unlocked:</p>

      <div class="match-product-box">
        <img id="matchImg" src="https://bizibees-store.myshopify.com/cdn/shop/files/lumaglow.jpg" alt="Matched Product">
        <div class="match-info">
          <span class="match-tag" id="matchBonusTag">✓ BONUS PERK UNLOCKED</span>
          <h4 id="matchProductTitle">Loading Your Custom Match...</h4>
          <div class="match-price-row">
            <strong id="matchProductPrice">$24.99</strong>
            <span class="match-free-ship">+ Free US Shipping</span>
          </div>
          <button type="button" class="match-buy-btn" id="matchAddBtn" onclick="triggerSmartAutoCheckout(this)">
            <span>Claim My Custom Match Now →</span>
          </button>
        </div>
      </div>

      <button type="button" class="quiz-reset-link" onclick="resetQuiz()">↺ Retake Quiz</button>
    </div>

  </div>
</div>

<style>
  .ai-quiz-wrapper {
    padding: 75px 20px;
    background: #FAF7F2;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .ai-quiz-card {
    max-width: 680px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E5D6C5;
    border-radius: 24px;
    padding: 40px 32px;
    text-align: center;
    box-shadow: 0 20px 50px rgba(41, 35, 30, 0.08);
    position: relative;
    overflow: hidden;
  }
  .quiz-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: #F1F5F9;
  }
  .quiz-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #D9822B, #10B981);
    transition: width 0.4s ease;
  }
  .q-badge, .q-badge-success {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 30px;
    display: inline-block;
    margin-bottom: 14px;
  }
  .q-badge { background: #FEF3C7; color: #92400E; }
  .q-badge-success { background: #DCFCE7; color: #166534; }
  .ai-quiz-card h3 {
    font-size: clamp(24px, 3.5vw, 32px);
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 24px;
  }
  .q-options { display: flex; flex-direction: column; gap: 12px; }
  .q-opt-btn {
    background: #F8FAFC;
    border: 2px solid #E2E8F0;
    border-radius: 16px;
    padding: 18px 22px;
    font-size: 15px;
    font-weight: 700;
    color: #1E293B;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }
  .q-opt-btn:hover {
    border-color: #D9822B;
    background: #FFFBEB;
    transform: translateY(-2px);
  }

  /* Match Box */
  .match-product-box {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    align-items: center;
    background: #F8FAFC;
    border: 2px solid #10B981;
    border-radius: 18px;
    padding: 20px;
    text-align: left;
    margin: 24px 0 16px;
  }
  .match-product-box img {
    width: 100%;
    height: 130px;
    object-fit: contain;
    background: #FFFFFF;
    border-radius: 12px;
    padding: 8px;
  }
  .match-tag { font-size: 10px; font-weight: 800; color: #059669; display: block; margin-bottom: 4px; }
  .match-info h4 { font-size: 18px; font-weight: 800; margin: 0 0 8px; color: #0F172A; }
  .match-price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .match-price-row strong { font-size: 22px; font-weight: 900; color: #0F172A; }
  .match-free-ship { font-size: 12px; color: #059669; font-weight: 700; }
  .match-buy-btn {
    width: 100%;
    background: #0F172A;
    color: #FFFFFF;
    border: none;
    padding: 14px 20px;
    border-radius: 50px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
  }
  .match-buy-btn:hover { background: #D9822B; }
  .quiz-reset-link { background: none; border: none; color: #64748B; font-size: 12px; cursor: pointer; text-decoration: underline; }

  @media (max-width: 600px) {
    .match-product-box { grid-template-columns: 1fr; text-align: center; }
  }
</style>

<script>
  function nextQuizStep(step, choice) {
    document.getElementById('qStep1').style.display = 'none';
    document.getElementById('qStep2').style.display = 'none';
    document.getElementById('qStep3').style.display = 'none';
    document.getElementById('qStep' + step).style.display = 'block';
    document.getElementById('quizProgressFill').style.width = (step * 33) + '%';
  }

  function finishQuiz(bonusChoice) {
    document.getElementById('qStep3').style.display = 'none';
    document.getElementById('qResult').style.display = 'block';
    document.getElementById('quizProgressFill').style.width = '100%';
    document.getElementById('matchBonusTag').innerText = '✓ UNLOCKED: ' + bonusChoice.toUpperCase();

    // Auto-populate with real live product from the store
    if (window.LIVE_STORE_HERO_PRODUCT) {
      const p = window.LIVE_STORE_HERO_PRODUCT;
      document.getElementById('matchProductTitle').innerText = p.title;
      if (p.variants && p.variants[0]) {
        document.getElementById('matchProductPrice').innerText = '$' + p.variants[0].price;
      }
      if (p.images && p.images[0]) {
        document.getElementById('matchImg').src = p.images[0].src;
      }
    }
  }

  function resetQuiz() {
    document.getElementById('qResult').style.display = 'none';
    document.getElementById('qStep1').style.display = 'block';
    document.getElementById('quizProgressFill').style.width = '33%';
  }
</script>

{% schema %}
{
  "name": "15-Sec AI Matchmaker Quiz",
  "settings": [],
  "presets": [
    {
      "name": "15-Sec AI Matchmaker Quiz",
      "category": "Interactive"
    }
  ]
}
{% endschema %}
