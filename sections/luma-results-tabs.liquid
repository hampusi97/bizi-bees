{% comment %}
  Luma Clinical Wellness - Clinically Proven Results & Mechanism Tabs
  File: sections/luma-results-tabs.liquid
{% endcomment %}

<section class="luma-results" id="luma-results-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-results__container">

    <!-- Header Section -->
    <div class="luma-results__header">
      <span class="luma-badge-pill luma-badge-green">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        {{ section.settings.badge_label | default: "Third-Party Clinical Perception Study" }}
      </span>
      <h2 class="luma-results__title">
        {{ section.settings.title | default: "Clinically Proven Results You Can Quantify" }}
      </h2>
      <p class="luma-results__subtitle">
        {{ section.settings.subtitle | default: "Independent 28-day consumer panel testing across 120 subjects aged 25–62 using Luma Clinical phototherapy and thermal protocols." }}
      </p>
    </div>

    <!-- 3 Core Statistics Cards -->
    <div class="luma-results__stats-grid">
      
      <!-- Card 1 -->
      <div class="luma-stat-card">
        <div class="luma-stat-card__metric-wrap">
          <span class="luma-stat-card__percent" data-target="94">94%</span>
          <span class="luma-stat-card__duration">in 21 Days</span>
        </div>
        <div class="luma-stat-card__progress">
          <div class="luma-stat-card__bar" style="width: 94%;"></div>
        </div>
        <h3 class="luma-stat-card__heading">Firmer, More Sculpted Jawline</h3>
        <p class="luma-stat-card__body">
          Subjects reported measurable lift across the mandibular line, reduced jowl laxity, and enhanced cheekbone contour from daily microcurrent stimulation.
        </p>
        <span class="luma-stat-card__tag">LumaGlow 4-in-1 Protocol</span>
      </div>

      <!-- Card 2 -->
      <div class="luma-stat-card">
        <div class="luma-stat-card__metric-wrap">
          <span class="luma-stat-card__percent" data-target="89">89%</span>
          <span class="luma-stat-card__duration">in 14 Days</span>
        </div>
        <div class="luma-stat-card__progress">
          <div class="luma-stat-card__bar" style="width: 89%;"></div>
        </div>
        <h3 class="luma-stat-card__heading">Reduced Puffiness & Fine Lines</h3>
        <p class="luma-stat-card__body">
          Significant reduction in periorbital edema (under-eye bags) and visible smoothing of crow's feet through 630nm photobiomodulation.
        </p>
        <span class="luma-stat-card__tag">LumaGlow + LumaMask™</span>
      </div>

      <!-- Card 3 -->
      <div class="luma-stat-card">
        <div class="luma-stat-card__metric-wrap">
          <span class="luma-stat-card__percent" data-target="91">91%</span>
          <span class="luma-stat-card__duration">Instant / 15 Mins</span>
        </div>
        <div class="luma-stat-card__progress">
          <div class="luma-stat-card__bar" style="width: 91%;"></div>
        </div>
        <h3 class="luma-stat-card__heading">Faster Migraine & Tension Relief</h3>
        <p class="luma-stat-card__body">
          Rapid vasoconstriction and ocular pressure relief utilizing LumaRelief 360° medical-grade cryogenic gel compression during acute headaches.
        </p>
        <span class="luma-stat-card__tag">LumaRelief™ Rotation Pack</span>
      </div>

    </div>

    <!-- Interactive Clinical Timeline & Science Mechanism Tabs -->
    <div class="luma-results__tabs-container">
      
      <div class="luma-results__nav-tabs" role="tablist">
        <button class="luma-tab-btn active" role="tab" aria-selected="true" data-tab="timeline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          28-Day Clinical Progression
        </button>
        <button class="luma-tab-btn" role="tab" aria-selected="false" data-tab="mechanisms">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          Scientific Mechanism of Action
        </button>
      </div>

      <!-- Tab Content 1: 28-Day Timeline -->
      <div class="luma-tab-panel active" id="tab-timeline" role="tabpanel">
        <div class="luma-timeline">
          
          <!-- Day 1 Step -->
          <div class="luma-timeline__step">
            <div class="luma-timeline__marker">
              <span class="luma-timeline__num">01</span>
            </div>
            <div class="luma-timeline__card">
              <span class="luma-timeline__badge">Day 1 — Immediate</span>
              <h4 class="luma-timeline__title">Cellular Awakening & Lymph Drainage</h4>
              <p class="luma-timeline__desc">
                8,000 VPM sonic vibration instantly drains stagnant lymph fluid. 107°F thermal energy increases blood circulation, leaving the epidermis radiant, de-puffed, and primed for topical serums.
              </p>
              <div class="luma-timeline__metric">✓ 96% felt immediate soothing and reduced morning facial stiffness</div>
            </div>
          </div>

          <!-- Day 14 Step -->
          <div class="luma-timeline__step">
            <div class="luma-timeline__marker">
              <span class="luma-timeline__num">14</span>
            </div>
            <div class="luma-timeline__card">
              <span class="luma-timeline__badge">Day 14 — Visible Shift</span>
              <h4 class="luma-timeline__title">Microcurrent Neuromuscular Tone</h4>
              <p class="luma-timeline__desc">
                Low-voltage galvanic microcurrent retrains facial muscles. Early collagen synthesis at 630nm smooths superficial wrinkles around the eyes and nasolabial folds.
              </p>
              <div class="luma-timeline__metric">✓ 89% reported tighter contour around jawline and upper cheekbones</div>
            </div>
          </div>

          <!-- Day 28 Step -->
          <div class="luma-timeline__step">
            <div class="luma-timeline__marker">
              <span class="luma-timeline__num">28</span>
            </div>
            <div class="luma-timeline__card luma-timeline__card--highlight">
              <span class="luma-timeline__badge luma-badge-green">Day 28 — Clinical Dermal Remodeling</span>
              <h4 class="luma-timeline__title">Deep Extracellular Matrix Density</h4>
              <p class="luma-timeline__desc">
                Fibroblast proliferation reaches peak velocity. Measurable improvement in skin elasticity, pore refinement, and long-lasting sculpted facial architecture.
              </p>
              <div class="luma-timeline__metric">✓ 94% noticed firmer skin with permanent reduction in fine lines</div>
            </div>
          </div>

        </div>
      </div>

      <!-- Tab Content 2: Scientific Mechanisms Accordion -->
      <div class="luma-tab-panel" id="tab-mechanisms" role="tabpanel">
        <div class="luma-accordion" id="luma-mechanisms-accordion">
          
          <div class="luma-accordion__item active">
            <button class="luma-accordion__trigger" aria-expanded="true">
              <span class="luma-accordion__label">
                <span class="luma-accordion__code">01 / PHOTOBIOMODULATION</span>
                630nm Red Light & Mitochondrial ATP Synthesis
              </span>
              <span class="luma-accordion__icon">+</span>
            </button>
            <div class="luma-accordion__content">
              <p>
                Photons emitted at exactly 630 nanometers penetrate 8–10 millimeters into the subcutaneous layer. These light particles are absorbed by cytochrome c oxidase within mitochondrial cells, accelerating adenosine triphosphate (ATP) production. This surge of cellular energy powers fibroblasts to synthesize new collagen type I and elastin fibers.
              </p>
            </div>
          </div>

          <div class="luma-accordion__item">
            <button class="luma-accordion__trigger" aria-expanded="false">
              <span class="luma-accordion__label">
                <span class="luma-accordion__code">02 / BIOELECTRIC LIFT</span>
                Low-Voltage Galvanic Microcurrent (0.35mA)
              </span>
              <span class="luma-accordion__icon">+</span>
            </button>
            <div class="luma-accordion__content">
              <p>
                The facial musculature is directly attached to the dermis. Luma’s calibrated microcurrent mimics the body’s endogenous bio-electrical currents, stimulating muscle re-education (Golgi tendon organ response) to lift sagging cheekbones, contour the jawline, and reduce facial tension.
              </p>
            </div>
          </div>

          <div class="luma-accordion__item">
            <button class="luma-accordion__trigger" aria-expanded="false">
              <span class="luma-accordion__label">
                <span class="luma-accordion__code">03 / THERMODYNAMIC INFUSION</span>
                107°F Thermal Hyperthermia & Microcirculation
              </span>
              <span class="luma-accordion__icon">+</span>
            </button>
            <div class="luma-accordion__content">
              <p>
                Gentle controlled warmth of 107°F (41.6°C) dilates localized blood capillaries, causing immediate vasodilation. This floods dermal tissue with oxygenated hemoglobin while softening lipid barriers in the stratum corneum, increasing transdermal absorption of serums by up to 300%.
              </p>
            </div>
          </div>

          <div class="luma-accordion__item">
            <button class="luma-accordion__trigger" aria-expanded="false">
              <span class="luma-accordion__label">
                <span class="luma-accordion__code">04 / CRANIAL VASOCONSTRICTION</span>
                LumaRelief™ 360° Cryogenic Gel Compression
              </span>
              <span class="luma-accordion__icon">+</span>
            </button>
            <div class="luma-accordion__content">
              <p>
                Migraines and tension headaches stem from dilated temporal arteries and trigeminal nerve sensitization. LumaRelief delivers 360-degree anatomical cold compression, inducing rapid vasoconstriction and blocking pain signaling pathways without pharmaceutical side effects.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  #luma-results-{{ section.id }} {
    padding: 72px 0 64px;
    background-color: {{ section.settings.bg_color | default: "#FAFAFC" }};
    font-family: var(--luma-font-body);
  }

  .luma-results__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .luma-results__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .luma-results__title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 800;
    color: var(--luma-text-heading);
    letter-spacing: -0.02em;
    margin: 14px 0 12px;
  }

  .luma-results__subtitle {
    font-size: 1.05rem;
    color: var(--luma-text-body);
    line-height: 1.6;
    margin: 0;
  }

  /* Stats Grid */
  .luma-results__stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  .luma-stat-card {
    background: #FFFFFF;
    border: 1px solid var(--luma-border-card);
    border-radius: var(--luma-radius-lg);
    padding: 32px 28px;
    box-shadow: var(--luma-shadow-sm);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .luma-stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--luma-shadow-md);
  }

  .luma-stat-card__metric-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .luma-stat-card__percent {
    font-size: 3.2rem;
    font-weight: 800;
    color: var(--luma-accent-teal);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .luma-stat-card__duration {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--luma-text-muted);
  }

  .luma-stat-card__progress {
    width: 100%;
    height: 6px;
    background: #E5E7EB;
    border-radius: 3px;
    margin-bottom: 20px;
    overflow: hidden;
  }

  .luma-stat-card__bar {
    height: 100%;
    background: linear-gradient(90deg, var(--luma-accent-teal), #14B8A6);
    border-radius: 3px;
    transition: width 1s ease-in-out;
  }

  .luma-stat-card__heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--luma-text-heading);
    margin: 0 0 10px;
  }

  .luma-stat-card__body {
    font-size: 0.9rem;
    color: var(--luma-text-body);
    line-height: 1.55;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .luma-stat-card__tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--luma-accent-teal-hover);
    background: var(--luma-accent-teal-soft);
    padding: 4px 10px;
    border-radius: 6px;
    align-self: flex-start;
  }

  /* Tab Navigation */
  .luma-results__tabs-container {
    background: #FFFFFF;
    border: 1px solid var(--luma-border-card);
    border-radius: 20px;
    padding: 36px 32px;
    box-shadow: var(--luma-shadow-sm);
  }

  .luma-results__nav-tabs {
    display: flex;
    gap: 12px;
    border-bottom: 1px solid var(--luma-border-light);
    padding-bottom: 16px;
    margin-bottom: 32px;
  }

  .luma-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    padding: 10px 18px;
    border-radius: var(--luma-radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--luma-text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .luma-tab-btn:hover {
    color: var(--luma-text-heading);
    background: #F3F4F6;
  }

  .luma-tab-btn.active {
    background: var(--luma-accent-teal-soft);
    color: var(--luma-accent-teal-hover);
  }

  .luma-tab-panel {
    display: none;
  }

  .luma-tab-panel.active {
    display: block;
    animation: lumaFadeIn 0.3s ease;
  }

  @keyframes lumaFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Timeline Styles */
  .luma-timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    position: relative;
  }

  .luma-timeline__step {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .luma-timeline__marker {
    display: flex;
    align-items: center;
  }

  .luma-timeline__num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #F3F4F6;
    border: 2px solid #E5E7EB;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--luma-text-heading);
  }

  .luma-timeline__card {
    background: #F9FAFB;
    border: 1px solid var(--luma-border-light);
    border-radius: var(--luma-radius-md);
    padding: 24px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .luma-timeline__card--highlight {
    background: #F0FDFA;
    border-color: rgba(13, 148, 136, 0.3);
  }

  .luma-timeline__badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--luma-accent-teal);
    margin-bottom: 8px;
    display: inline-block;
  }

  .luma-timeline__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--luma-text-heading);
    margin: 0 0 10px;
  }

  .luma-timeline__desc {
    font-size: 0.88rem;
    color: var(--luma-text-body);
    line-height: 1.55;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .luma-timeline__metric {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--luma-trust-green);
    background: #FFFFFF;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(5, 150, 105, 0.2);
  }

  /* Accordion Styles */
  .luma-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .luma-accordion__item {
    border: 1px solid var(--luma-border-light);
    border-radius: var(--luma-radius-md);
    background: #FFFFFF;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .luma-accordion__item.active {
    border-color: var(--luma-accent-teal);
  }

  .luma-accordion__trigger {
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .luma-accordion__label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--luma-text-heading);
  }

  .luma-accordion__code {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--luma-accent-teal);
  }

  .luma-accordion__icon {
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--luma-text-muted);
    transition: transform 0.25s ease;
  }

  .luma-accordion__item.active .luma-accordion__icon {
    transform: rotate(45deg);
    color: var(--luma-accent-teal);
  }

  .luma-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0, 1, 0, 1);
    padding: 0 24px;
    background: #F9FAFB;
  }

  .luma-accordion__item.active .luma-accordion__content {
    max-height: 400px;
    padding: 16px 24px 24px;
    transition: max-height 0.35s ease-in-out;
  }

  .luma-accordion__content p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--luma-text-body);
    margin: 0;
  }

  @media (max-width: 900px) {
    .luma-results__stats-grid,
    .luma-timeline {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    #luma-results-{{ section.id }} {
      padding: 44px 0 36px;
    }

    .luma-results__tabs-container {
      padding: 20px 16px;
    }

    .luma-results__nav-tabs {
      flex-direction: column;
    }

    .luma-stat-card {
      padding: 24px 20px;
    }
  }
</style>

<script>
  (function() {
    function initLumaResults(container) {
      if (!container) return;
      
      // Tabs logic
      const tabBtns = container.querySelectorAll('.luma-tab-btn');
      const tabPanels = container.querySelectorAll('.luma-tab-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          tabPanels.forEach(p => p.classList.remove('active'));

          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          const target = container.querySelector('#tab-' + btn.dataset.tab);
          if (target) target.classList.add('active');
        });
      });

      // Accordion logic
      const triggers = container.querySelectorAll('.luma-accordion__trigger');
      triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const item = trigger.closest('.luma-accordion__item');
          const isOpen = item.classList.contains('active');

          container.querySelectorAll('.luma-accordion__item').forEach(i => {
            i.classList.remove('active');
            i.querySelector('.luma-accordion__trigger').setAttribute('aria-expanded', 'false');
          });

          if (!isOpen) {
            item.classList.add('active');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('luma-results-{{ section.id }}');
      initLumaResults(container);
    });

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', (e) => {
        if (e.target.id === 'luma-results-{{ section.id }}') {
          initLumaResults(e.target);
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Luma Proven Results",
  "tag": "section",
  "class": "luma-results-section",
  "settings": [
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge Label",
      "default": "Third-Party Clinical Perception Study"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Clinically Proven Results You Can Quantify"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subheading",
      "default": "Independent 28-day consumer panel testing across 120 subjects aged 25–62 using Luma Clinical phototherapy and thermal protocols."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFC"
    }
  ],
  "presets": [
    {
      "name": "Luma Proven Results"
    }
  ]
}
{% endschema %}
