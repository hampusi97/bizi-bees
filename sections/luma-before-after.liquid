{% comment %}
  Interactive 28-day clinical comparison slider
  Day 1 vs Day 28 with draggable handle
{% endcomment %}

<section class="luma-ba" id="luma-ba-{{ section.id }}">
  <div class="wrap">
    <div class="luma-ba__header">
      <span class="luma-ba__eyebrow">{{ section.settings.eyebrow | default: '28-day protocol' }}</span>
      <h2 class="luma-ba__title">{{ section.settings.title | default: 'Visible change you can drag' }}</h2>
      <p class="luma-ba__sub">{{ section.settings.subtitle | default: 'Drag the slider to compare Day 1 and Day 28. Individual results vary. For cosmetic use only.' }}</p>
    </div>

    <div class="luma-ba__stage" data-ba-stage>
      <div class="luma-ba__img luma-ba__img--after">
        {% if section.settings.after_image != blank %}
          {{ section.settings.after_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'luma-ba__photo', alt: 'Day 28' }}
        {% else %}
          <div class="luma-ba__placeholder">Day 28</div>
        {% endif %}
        <span class="luma-ba__label luma-ba__label--after">Day 28</span>
      </div>
      <div class="luma-ba__img luma-ba__img--before" data-ba-before>
        {% if section.settings.before_image != blank %}
          {{ section.settings.before_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'luma-ba__photo', alt: 'Day 1' }}
        {% else %}
          <div class="luma-ba__placeholder">Day 1</div>
        {% endif %}
        <span class="luma-ba__label luma-ba__label--before">Day 1</span>
      </div>
      <div class="luma-ba__handle" data-ba-handle role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
        <span class="luma-ba__handle-line"></span>
        <span class="luma-ba__handle-knob"></span>
      </div>
    </div>

    <div class="luma-ba__stats">
      <div class="luma-ba__stat">
        <strong>{{ section.settings.stat1_value | default: '94%' }}</strong>
        <span>{{ section.settings.stat1_label | default: 'Reported smoother texture*' }}</span>
      </div>
      <div class="luma-ba__stat">
        <strong>{{ section.settings.stat2_value | default: '28 days' }}</strong>
        <span>{{ section.settings.stat2_label | default: 'Typical protocol length' }}</span>
      </div>
      <div class="luma-ba__stat">
        <strong>{{ section.settings.stat3_value | default: '5 min' }}</strong>
        <span>{{ section.settings.stat3_label | default: 'Daily session target' }}</span>
      </div>
    </div>
    <p class="luma-ba__disclaimer">*Based on internal customer feedback. Not a medical claim. Cosmetic device only. Results vary.</p>
  </div>
</section>

<style>
  .luma-ba { padding: 72px 0; background: #FFFFFF; }
  .luma-ba__header { text-align: center; max-width: 560px; margin: 0 auto 36px; }
  .luma-ba__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #0D9488; }
  .luma-ba__title { font-family: "Playfair Display", Georgia, serif; font-size: clamp(1.7rem, 3vw, 2.3rem); color: #0F172A; margin: 10px 0; }
  .luma-ba__sub { color: #64748B; margin: 0; }
  .luma-ba__stage {
    position: relative;
    max-width: 720px;
    margin: 0 auto 32px;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #E2E8F0;
    user-select: none;
    touch-action: none;
  }
  .luma-ba__img { position: absolute; inset: 0; }
  .luma-ba__img--before { width: 50%; overflow: hidden; border-right: 2px solid #fff; }
  .luma-ba__photo, .luma-ba__placeholder {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .luma-ba__img--before .luma-ba__photo {
    width: 200%; max-width: none;
  }
  .luma-ba__placeholder {
    display: flex; align-items: center; justify-content: center;
    background: #F1F5F9; color: #64748B; font-weight: 700;
  }
  .luma-ba__label {
    position: absolute; bottom: 12px; padding: 4px 10px;
    background: rgba(15,23,42,0.85); color: #fff;
    font-size: 11px; font-weight: 700; border-radius: 6px;
  }
  .luma-ba__label--before { left: 12px; }
  .luma-ba__label--after { right: 12px; }
  .luma-ba__handle {
    position: absolute; top: 0; bottom: 0; left: 50%;
    width: 44px; margin-left: -22px; cursor: ew-resize;
    display: flex; align-items: center; justify-content: center;
  }
  .luma-ba__handle-line {
    position: absolute; top: 0; bottom: 0; width: 2px; background: #fff;
    box-shadow: 0 0 8px rgba(0,0,0,0.25);
  }
  .luma-ba__handle-knob {
    width: 36px; height: 36px; border-radius: 50%;
    background: #fff; border: 2px solid #0D9488;
    box-shadow: 0 4px 12px rgba(15,23,42,0.2);
    position: relative; z-index: 1;
  }
  .luma-ba__stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    max-width: 640px; margin: 0 auto 12px; text-align: center;
  }
  .luma-ba__stat strong { display: block; font-size: 1.4rem; color: #0F172A; }
  .luma-ba__stat span { font-size: 12px; color: #64748B; }
  .luma-ba__disclaimer {
    text-align: center; font-size: 11px; color: #94A3B8; max-width: 520px; margin: 0 auto;
  }
  @media (max-width: 600px) {
    .luma-ba__stats { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

<script>
(function () {
  var stage = document.querySelector('#luma-ba-{{ section.id }} [data-ba-stage]');
  if (!stage) return;
  var before = stage.querySelector('[data-ba-before]');
  var handle = stage.querySelector('[data-ba-handle]');
  var dragging = false;

  function setPos(clientX) {
    var r = stage.getBoundingClientRect();
    var pct = Math.max(5, Math.min(95, ((clientX - r.left) / r.width) * 100));
    before.style.width = pct + '%';
    handle.style.left = pct + '%';
    handle.setAttribute('aria-valuenow', Math.round(pct));
  }

  function onMove(e) {
    if (!dragging) return;
    var x = e.touches ? e.touches[0].clientX : e.clientX;
    setPos(x);
  }
  function stop() { dragging = false; }

  handle.addEventListener('pointerdown', function (e) {
    dragging = true;
    handle.setPointerCapture(e.pointerId);
  });
  handle.addEventListener('pointermove', onMove);
  handle.addEventListener('pointerup', stop);
  handle.addEventListener('pointercancel', stop);
  stage.addEventListener('click', function (e) {
    if (e.target === handle || handle.contains(e.target)) return;
    setPos(e.clientX);
  });
  handle.addEventListener('keydown', function (e) {
    var now = parseFloat(handle.getAttribute('aria-valuenow') || '50');
    if (e.key === 'ArrowLeft') setPos(stage.getBoundingClientRect().left + ((now - 3) / 100) * stage.offsetWidth);
    if (e.key === 'ArrowRight') setPos(stage.getBoundingClientRect().left + ((now + 3) / 100) * stage.offsetWidth);
  });
})();
</script>

{% schema %}
{
  "name": "Luma Before After",
  "tag": "section",
  "class": "section-luma-ba",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "28-day protocol" },
    { "type": "text", "id": "title", "label": "Title", "default": "Visible change you can drag" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "image_picker", "id": "before_image", "label": "Day 1 image" },
    { "type": "image_picker", "id": "after_image", "label": "Day 28 image" },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 value", "default": "94%" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Reported smoother texture*" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 value", "default": "28 days" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Typical protocol length" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 value", "default": "5 min" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Daily session target" }
  ],
  "presets": [{ "name": "Luma Before After" }]
}
{% endschema %}
