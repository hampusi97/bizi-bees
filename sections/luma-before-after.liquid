{% comment %}
  Interactive Before/After Slider
  Repo: bizi-bees /sections/luma-before-after.liquid

  - Images, labels, copy and metrics are editable in the theme editor.
  - Safe to add multiple times per page (no hard-coded IDs).
  - Pointer events (mouse, touch, pen), click-to-position, keyboard
    (arrows / Shift+arrows / PageUp / PageDown / Home / End) and
    screen-reader support via role="slider".
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign heading_id = 'LumaBaHeading-' | append: section.id
  assign before_alt = s.before_image.alt | default: s.before_label
  assign after_alt = s.after_image.alt | default: s.after_label
  assign img_sizes = '(min-width: 700px) 650px, 100vw'
  assign img_widths = '400, 650, 900, 1300'
-%}

<section
  class="luma-ba"
  data-luma-ba
  style="--ba-bg: {{ s.background }}; --ba-accent: {{ s.accent }};"
  {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="luma-ba__container">
    <header class="luma-ba__header">
      {%- if s.pill != blank -%}
        <span class="luma-ba__pill">{{ s.pill | escape }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 id="{{ heading_id }}" class="luma-ba__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="luma-ba__text">{{ s.text }}</div>
      {%- endif -%}
    </header>

    <div
      class="luma-ba__stage"
      data-ba-stage
      data-start="{{ s.start_position }}"
      style="--ba-pos: {{ s.start_position }}%; --ba-ratio: {{ s.aspect_ratio }};"
    >
      {%- comment -%} "After" image: full background layer {%- endcomment -%}
      <div class="luma-ba__layer luma-ba__layer--after">
        {%- if s.after_image != blank -%}
          {{
            s.after_image
            | image_url: width: 1300
            | image_tag: loading: 'lazy', widths: img_widths, sizes: img_sizes, class: 'luma-ba__img', alt: after_alt, draggable: 'false'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'luma-ba__img luma-ba__img--placeholder' }}
        {%- endif -%}
        {%- if s.after_label != blank -%}
          <span class="luma-ba__label luma-ba__label--after" aria-hidden="true">{{ s.after_label | escape }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} "Before" image: same size, revealed with clip-path so it never distorts {%- endcomment -%}
      <div class="luma-ba__layer luma-ba__layer--before">
        {%- if s.before_image != blank -%}
          {{
            s.before_image
            | image_url: width: 1300
            | image_tag: loading: 'lazy', widths: img_widths, sizes: img_sizes, class: 'luma-ba__img', alt: before_alt, draggable: 'false'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'luma-ba__img luma-ba__img--placeholder' }}
        {%- endif -%}
        {%- if s.before_label != blank -%}
          <span class="luma-ba__label luma-ba__label--before" aria-hidden="true">{{ s.before_label | escape }}</span>
        {%- endif -%}
      </div>

      <div
        class="luma-ba__handle"
        data-ba-handle
        role="slider"
        tabindex="0"
        aria-label="{{ s.before_label | default: 'Before' | escape }} / {{ s.after_label | default: 'After' | escape }} comparison"
        aria-orientation="horizontal"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ s.start_position }}"
        aria-valuetext="{{ s.start_position }}% before image shown"
      >
        <span class="luma-ba__knob" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" focusable="false">
            <path d="M9 6l-6 6 6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="luma-ba__metrics" role="list">
        {%- for block in section.blocks -%}
          <li class="luma-ba__metric" {{ block.shopify_attributes }}>
            {%- if block.settings.value != blank -%}
              <strong class="luma-ba__metric-value">{{ block.settings.value | escape }}</strong>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="luma-ba__metric-label">{{ block.settings.label | escape }}</span>
            {%- endif -%}
            {%- if block.settings.source != blank -%}
              <small class="luma-ba__metric-source">{{ block.settings.source | escape }}</small>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.disclaimer != blank -%}
      <p class="luma-ba__disclaimer">{{ s.disclaimer | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .luma-ba {
    --ba-pos: 50%;
    padding: 80px 20px;
    background: var(--ba-bg, #ffffff);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .luma-ba__container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .luma-ba__pill {
    display: inline-block;
    margin-bottom: 12px;
    padding: 6px 14px;
    border-radius: 30px;
    background: #f1f5f9;
    color: #0f172a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .luma-ba__heading {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    letter-spacing: -1px;
  }
  .luma-ba__text {
    max-width: 620px;
    margin: 0 auto 35px;
    color: #64748b;
    font-size: 16px;
  }
  .luma-ba__text > :first-child { margin-top: 0; }
  .luma-ba__text > :last-child { margin-bottom: 0; }

  /* Stage */
  .luma-ba__stage {
    position: relative;
    width: 100%;
    max-width: 650px;
    aspect-ratio: var(--ba-ratio, 3 / 2);
    margin: 0 auto;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.1);
    background: #e2e8f0;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y; /* keep vertical page scroll; horizontal drags move the slider */
  }
  .luma-ba__layer {
    position: absolute;
    inset: 0;
  }
  .luma-ba__layer--before {
    z-index: 2;
    clip-path: inset(0 calc(100% - var(--ba-pos)) 0 0);
  }
  .luma-ba__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .luma-ba__img--placeholder {
    background: #cbd5e1;
    fill: #94a3b8;
  }
  .luma-ba__label {
    position: absolute;
    bottom: 16px;
    padding: 6px 12px;
    border-radius: 20px;
    background: rgba(15, 23, 42, 0.7);
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .luma-ba__label--before { left: 16px; }
  .luma-ba__label--after { right: 16px; }

  /* Handle: 44px-wide hit area with a 2px visible line */
  .luma-ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ba-pos);
    z-index: 3;
    width: 44px;
    transform: translateX(-50%);
    outline: none;
  }
  .luma-ba__handle::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: #ffffff;
    transform: translateX(-50%);
    box-shadow: 0 0 6px rgba(15, 23, 42, 0.25);
  }
  .luma-ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    transform: translate(-50%, -50%);
    transition: transform 0.15s ease;
  }
  .luma-ba__stage.is-dragging .luma-ba__knob,
  .luma-ba__handle:hover .luma-ba__knob {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .luma-ba__handle:focus-visible .luma-ba__knob {
    outline: 3px solid var(--ba-accent, #0d9488);
    outline-offset: 3px;
  }

  /* Metrics */
  .luma-ba__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .luma-ba__metric {
    padding: 20px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #f8fafc;
    text-align: left;
  }
  .luma-ba__metric-value {
    display: block;
    margin-bottom: 4px;
    color: var(--ba-accent, #0d9488);
    font-size: 26px;
    font-weight: 900;
  }
  .luma-ba__metric-label {
    display: block;
    color: #475569;
    font-size: 13px;
    line-height: 1.4;
  }
  .luma-ba__metric-source {
    display: block;
    margin-top: 8px;
    color: #94a3b8;
    font-size: 11px;
  }
  .luma-ba__disclaimer {
    margin: 24px auto 0;
    max-width: 620px;
    color: #94a3b8;
    font-size: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .luma-ba__knob { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function init(root) {
      if (root.dataset.lumaBaReady) return;
      var stage = root.querySelector('[data-ba-stage]');
      var handle = root.querySelector('[data-ba-handle]');
      if (!stage || !handle) return;
      root.dataset.lumaBaReady = 'true';

      var pos = parseFloat(stage.dataset.start);
      var dragging = false;
      if (isNaN(pos)) pos = 50;

      function set(next) {
        pos = Math.min(100, Math.max(0, next));
        var rounded = Math.round(pos);
        stage.style.setProperty('--ba-pos', pos + '%');
        handle.setAttribute('aria-valuenow', rounded);
        handle.setAttribute('aria-valuetext', rounded + '% before image shown');
      }

      function fromPointer(e) {
        var rect = stage.getBoundingClientRect();
        return rect.width ? ((e.clientX - rect.left) / rect.width) * 100 : pos;
      }

      function stop() {
        dragging = false;
        stage.classList.remove('is-dragging');
      }

      stage.addEventListener('pointerdown', function (e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        dragging = true;
        stage.classList.add('is-dragging');
        if (stage.setPointerCapture) stage.setPointerCapture(e.pointerId);
        set(fromPointer(e)); // click / tap anywhere to jump
        handle.focus({ preventScroll: true });
      });
      stage.addEventListener('pointermove', function (e) {
        if (dragging) set(fromPointer(e));
      });
      stage.addEventListener('pointerup', stop);
      stage.addEventListener('pointercancel', stop);
      stage.addEventListener('lostpointercapture', stop);

      handle.addEventListener('keydown', function (e) {
        var step = e.shiftKey ? 10 : 2;
        var next;
        switch (e.key) {
          case 'ArrowLeft':
          case 'ArrowDown': next = pos - step; break;
          case 'ArrowRight':
          case 'ArrowUp': next = pos + step; break;
          case 'PageDown': next = pos - 10; break;
          case 'PageUp': next = pos + 10; break;
          case 'Home': next = 0; break;
          case 'End': next = 100; break;
          default: return;
        }
        e.preventDefault();
        set(next);
      });

      set(pos);
    }

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-luma-ba]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    // Re-initialise when the section is added/edited in the theme editor.
    document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Luma before/after",
  "tag": "div",
  "class": "section-luma-before-after",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "pill", "label": "Eyebrow label", "default": "28-day routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the difference" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Drag the slider to compare skin before and after 28 days of 3-minute daily sessions.</p>"
    },
    { "type": "header", "content": "Images" },
    {
      "type": "paragraph",
      "content": "Use real, unretouched photos of the same person with matching lighting, angle and distance. Add alt text to each image in Files."
    },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Day 1" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "Day 28" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image shape",
      "default": "3 / 2",
      "options": [
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ]
    },
    {
      "type": "range",
      "id": "start_position",
      "label": "Starting position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    { "type": "header", "content": "Disclosure" },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "info": "Recommended whenever results are shown. Say if photos are retouched or the customer was compensated.",
      "default": "Individual results vary. Results shown are from one customer after 28 days of daily use."
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#0d9488" }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric",
      "settings": [
        {
          "type": "paragraph",
          "content": "Only publish efficacy percentages you can substantiate with a study, and cite it in Source."
        },
        { "type": "text", "id": "value", "label": "Value", "default": "3 min" },
        { "type": "text", "id": "label", "label": "Description", "default": "Daily session time" },
        { "type": "text", "id": "source", "label": "Source / footnote" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luma before/after",
      "blocks": [
        { "type": "metric", "settings": { "value": "630nm", "label": "Red light wavelength" } },
        { "type": "metric", "settings": { "value": "3 min", "label": "Daily session time" } },
        { "type": "metric", "settings": { "value": "4-in-1", "label": "Modes in one handheld device" } }
      ]
    }
  ]
}
{% endschema %}
