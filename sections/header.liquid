<div class="announcement">{{ section.settings.announcement | escape }}</div><header class="header"><div class="wrap head"><a class="logo" href="{{ routes.root_url }}" aria-label="bizi bees home"><span class="bee">{% render 'bee' %}</span>bizi bees</a><nav aria-label="Main navigation"><a href="{{ routes.root_url }}#gift-picks">Gift picks</a><a href="{{ routes.all_products_collection_url }}">Shop all</a>{% assign primary_handles = 'christmas-shopping,books,clothing,electronics,games,toys,home-decor,beauty-products,snacks,drink-mixes,more-finds' | split: ',' %}{% for handle in primary_handles %}{% assign nav_collection = collections[handle] %}{% if nav_collection != blank and nav_collection.products_count > 0 %}<a href="{{ nav_collection.url }}">{{ nav_collection.title | escape }}</a>{% endif %}{% endfor %}<a href="{{ routes.collections_url }}">All categories</a><a href="/pages/academic-help">Academic Help</a></nav><form class="search" action="{{ routes.search_url }}" role="search"><input name="q" type="search" placeholder="Find a treasure" aria-label="Search products"><input type="hidden" name="type" value="product"><button aria-label="Search">⌕</button></form><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div></header>
<style>nav a{white-space:nowrap}@media(max-width:600px){.head .search{display:flex;order:4;width:100%;margin-left:0}.head .search input{flex:1;min-width:0;max-width:none}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.category{transition:none}.category:hover{transform:none}}</style>
{% schema %}{"name": "Header", "settings": [{"type": "text", "id": "announcement", "label": "Announcement", "default": "Good finds. Fresh beginnings."}], "presets": [{"name": "Header"}]}{% endschema %}
