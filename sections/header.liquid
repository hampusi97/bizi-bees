{% comment %}
  Bizi Bees - Editorial Header & Minimal Announcement Bar
  Repo: bizi-bees /sections/header.liquid
{% endcomment %}

<!-- Minimal Announcement Bar -->
<div class="announcement-bar">
  <div class="announcement-inner wrap">
    <p class="announcement-text">
      {{ section.settings.announcement | default: "Free standard shipping on orders over $35 · Hand-packed in Utah" }}
    </p>
  </div>
</div>

<!-- Header Navigation -->
<header class="site-header">
  <div class="wrap header-inner">
    
    <!-- Logo -->
    <div class="header-logo-col">
      <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} homepage">
        <span class="bee-mark">{% render 'bee' %}</span>
        <span class="logo-text">bizi bees</span>
      </a>
      <span class="tagline">Curated Pre-Loved &amp; Everyday Finds</span>
    </div>

    <!-- Editorial Navigation -->
    <nav class="header-nav" aria-label="Primary Navigation">
      <a href="/collections/books" class="nav-link">Books</a>
      <a href="/collections/games-puzzles" class="nav-link">Games &amp; Puzzles</a>
      <a href="/collections/stationery" class="nav-link">Stationery</a>
      <a href="/collections/all" class="nav-link">Everyday Finds</a>
      <a href="/pages/about" class="nav-link">About</a>
    </nav>

    <!-- Search & Cart Utilities -->
    <div class="header-utils">
      <form class="header-search-form" action="{{ routes.search_url }}" method="get" role="search">
        <input 
          name="q" 
          type="search" 
          placeholder="Search finds..." 
          aria-label="Search finds"
          class="header-search-input"
          value="{{ search.terms | escape }}"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit" class="header-search-btn" aria-label="Submit search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>

      <a href="{{ routes.cart_url }}" class="header-cart-link" aria-label="Shopping bag with {{ cart.item_count }} items">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="cart-label">Bag</span>
        <span class="cart-count">({{ cart.item_count }})</span>
      </a>
    </div>

  </div>
</header>

<style>
  /* Announcement Bar */
  .announcement-bar {
    background: #1C1917;
    color: #FAF7F2;
    padding: 8px 16px;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    font-weight: 500;
    text-align: center;
  }
  .announcement-text {
    margin: 0;
  }

  /* Site Header */
  .site-header {
    background: #FAF7F2;
    border-bottom: 1px solid #E7E5E4;
    padding: 20px 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    background-color: rgba(250, 247, 242, 0.96);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* Logo */
  .header-logo-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #1C1917;
  }
  .bee-mark {
    display: inline-flex;
    width: 26px;
    height: 26px;
  }
  .bee-mark svg {
    width: 100%;
    height: 100%;
  }
  .logo-text {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1C1917;
  }
  .tagline {
    font-size: 11px;
    color: #78716C;
    letter-spacing: 0.04em;
    margin-top: 1px;
  }

  /* Navigation Links */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .nav-link {
    text-decoration: none;
    color: #1C1917;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    position: relative;
    padding: 6px 0;
    transition: color 0.2s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1.5px;
    background: #2D3B2D;
    transition: width 0.24s ease;
  }
  .nav-link:hover {
    color: #2D3B2D;
  }
  .nav-link:hover::after {
    width: 100%;
  }

  /* Utilities (Search & Cart) */
  .header-utils {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .header-search-form {
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 9999px;
    padding: 4px 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .header-search-form:focus-within {
    border-color: #2D3B2D;
    box-shadow: 0 0 0 2px rgba(45, 59, 45, 0.1);
  }
  .header-search-input {
    border: none;
    background: transparent;
    font-size: 13px;
    color: #1C1917;
    width: 130px;
    padding: 4px 0;
    outline: none;
  }
  .header-search-input::placeholder {
    color: #A8A29E;
  }
  .header-search-btn {
    background: none;
    border: none;
    padding: 0 0 0 6px;
    cursor: pointer;
    color: #78716C;
    display: flex;
    align-items: center;
  }
  .header-search-btn:hover {
    color: #1C1917;
  }

  .header-cart-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #1C1917;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 12px;
    border-radius: 9999px;
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    transition: all 0.2s ease;
  }
  .header-cart-link:hover {
    border-color: #2D3B2D;
    background: #F5F3EF;
  }
  .cart-count {
    color: #78716C;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 16px;
    }
    .header-nav {
      order: 3;
      width: 100%;
      gap: 18px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .header-nav::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .header-search-form {
      display: none;
    }
    .tagline {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement text",
      "default": "Free standard shipping on orders over $35 · Hand-packed in Utah"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
