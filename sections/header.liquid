<div class="brand-bar">
  <div class="wrap brand-bar-inner">
    <span>Curated secondhand finds</span>
    <span>Free shipping over $50</span>
    <span>Fresh arrivals weekly</span>
  </div>
</div>

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="logo" href="{{ routes.root_url }}" aria-label="bizi bees home">
      <span class="logo-mark">b</span>
      <span class="logo-word">bizi bees</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}">Shop all</a>
      <a href="{{ routes.root_url }}">New</a>
      <a href="{{ routes.root_url }}">Books</a>
      <a href="{{ routes.root_url }}">Home</a>
      <a href="{{ routes.root_url }}">About</a>
    </nav>

    <div class="header-actions">
      <a class="text-link" href="{{ routes.root_url }}">Search</a>
      <a class="button button-secondary" href="{{ routes.cart_url }}">Cart</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Good finds. Fresh beginnings."
    }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
