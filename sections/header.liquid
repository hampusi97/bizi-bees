<div class="announcement">{{ section.settings.announcement | escape }}</div><header class="header"><div class="wrap head"><a class="logo" href="{{ routes.root_url }}" aria-label="bizi bees home"><span class="bee">{% render 'bee' %}</span>bizi bees</a><nav aria-label="Main navigation"><a href="{{ routes.all_products_collection_url }}">Shop all</a>{% for nav_collection in collections %}{% unless nav_collection.handle == 'frontpage' or nav_collection.handle == 'all' %}<a href="{{ nav_collection.url }}">{{ nav_collection.title | escape }}</a>{% endunless %}{% endfor %}<a href="/pages/academic-help">Academic Help</a></nav><form class="search" action="{{ routes.search_url }}" role="search"><input name="q" type="search" placeholder="Find a treasure" aria-label="Search products"><input type="hidden" name="type" value="product"><button aria-label="Search">⌕</button></form><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div></header>
{% schema %}{"name": "Header", "settings": [{"type": "text", "id": "announcement", "label": "Announcement", "default": "Good finds. Fresh beginnings."}], "presets": [{"name": "Header"}]}{% endschema %}
