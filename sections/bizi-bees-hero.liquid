<div class="bb-hero-wrapper">
  <div class="bb-hero-inner">
    
    <div class="bb-pill-tag">
      <span>🐝</span>
      CURATED PRE-LOVED FINDS &amp; TIMELESS TREASURES
    </div>

    <h1>Stories That Deserve<br>Another Chapter.</h1>
    
    <p>Handpicked vintage classics, cozy "Blind Date with a Book" mystery boxes, retro family games, and boutique stationery. Packaged with care and shipped directly to your door.</p>

    <div class="bb-cta-row">
      <a href="/collections/all" class="bb-btn-primary">Browse All Treasures →</a>
      <a href="#blindDateSection" class="bb-btn-secondary">Pick a "Blind Date" Book ($14.99)</a>
    </div>

    <!-- 3 Core Trust Pillars -->
    <div class="bb-trust-pillars">
      <div class="bb-pillar">
        <span class="p-icon">📖</span>
        <strong>100% Inspected &amp; Read-Ready</strong>
        <small>Clean pages, intact spines, zero loose leaves</small>
      </div>
      <div class="bb-pillar">
        <span class="p-icon">📦</span>
        <strong>Free Tracked US Shipping</strong>
        <small>Automatically unlocked on orders over $35</small>
      </div>
      <div class="bb-pillar">
        <span class="p-icon">🌿</span>
        <strong>Eco-Conscious Boutique</strong>
        <small>Giving quality goods a second life</small>
      </div>
    </div>

  </div>
</div>

<style>
  .bb-hero-wrapper {
    background: radial-gradient(circle at 50% 20%, #FFFDF9 0%, #FAF7F2 80%);
    padding: 85px 20px 65px;
    text-align: center;
    border-bottom: 1px solid #EADBCE;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .bb-hero-inner { max-width: 780px; margin: 0 auto; }
  .bb-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FEF3C7;
    border: 1px solid #FDE68A;
    color: #92400E;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 6px 16px;
    border-radius: 40px;
    margin-bottom: 22px;
  }
  .bb-hero-inner h1 {
    font-family: Georgia, "Playfair Display", serif;
    font-size: clamp(34px, 5.5vw, 56px);
    font-weight: 900;
    color: #29231E;
    line-height: 1.15;
    letter-spacing: -1px;
    margin: 0 0 18px;
  }
  .bb-hero-inner p {
    font-size: 17px;
    color: #6E6257;
    line-height: 1.6;
    margin: 0 auto 35px;
    max-width: 640px;
  }
  .bb-cta-row {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 50px;
  }
  .bb-btn-primary {
    background: #29231E;
    color: #FFFFFF !important;
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    padding: 16px 32px;
    border-radius: 50px;
    box-shadow: 0 8px 24px rgba(41, 35, 30, 0.2);
    transition: all 0.2s ease;
  }
  .bb-btn-primary:hover { background: #D9822B; transform: translateY(-2px); }
  .bb-btn-secondary {
    background: #FFFFFF;
    color: #29231E !important;
    border: 1px solid #D6C2AF;
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    padding: 16px 28px;
    border-radius: 50px;
    transition: all 0.2s ease;
  }
  .bb-btn-secondary:hover { background: #F5EFEB; border-color: #29231E; }

  .bb-trust-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid #EADBCE;
    padding-top: 35px;
    text-align: left;
  }
  .bb-pillar { display: flex; flex-direction: column; gap: 4px; }
  .p-icon { font-size: 24px; margin-bottom: 4px; }
  .bb-pillar strong { font-size: 13px; color: #29231E; font-weight: 800; }
  .bb-pillar small { font-size: 11px; color: #786C62; line-height: 1.4; }

  @media (max-width: 768px) {
    .bb-trust-pillars { grid-template-columns: 1fr; gap: 16px; }
    .bb-cta-row { flex-direction: column; }
  }
</style>

