<section class="aura-sculpt-hero" id="aura-sculpt-{{ section.id }}">
  <style>
    #aura-sculpt-{{ section.id }} {
      background: #FFFFFF;
      color: #1C1C1E;
      font-family: -apple-system, sans-serif;
      padding: 40px 20px;
    }
    .aura-container { max-width: 1000px; margin: 0 auto; }
    .sticky-banner { background: #5C5D58; color: #FFFFFF; text-align: center; padding: 8px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; position: sticky; top: 0; z-index: 100; }
    .hero-content { text-align: center; margin-bottom: 40px; }
    .hero-content h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin: 10px 0; line-height: 1.1; }
    .rating { color: #5C5D58; font-weight: 600; margin-bottom: 20px; }
    
    .tier-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 30px 0; }
    .tier-card { border: 2px solid #EAEAEA; padding: 20px; border-radius: 12px; cursor: pointer; transition: 0.3s; position: relative; }
    .tier-card.active { border-color: #5C5D58; background: #F9F9F9; }
    .vip-badge { position: absolute; top: -10px; right: 10px; background: #5C5D58; color: #fff; font-size: 10px; padding: 2px 8px; border-radius: 4px; }
    
    .gift-notice { background: #F1F1F1; padding: 15px; border-radius: 8px; margin: 20px 0; font-weight: 600; color: #5C5D58; display: none; }
    .btn-buy { background: #1C1C1E; color: #FFFFFF; width: 100%; padding: 20px; border: none; font-size: 18px; font-weight: 700; border-radius: 8px; cursor: pointer; transition: transform 0.2s; }
    .btn-buy:hover { transform: translateY(-2px); }
    
    .guarantee-strip { display: flex; justify-content: space-around; margin-top: 30px; font-size: 12px; text-transform: uppercase; color: #888; }
    
    @media (max-width: 768px) { .tier-grid { grid-template-columns: 1fr; } }
  </style>

  <div class="sticky-banner">⚡ Ships from Utah | Free US Delivery</div>

  <div class="aura-container">
    <div class="hero-content">
      <div class="rating">★★★★★ 4.9/5 (2,400+ Reviews)</div>
      <h1>CloudSoft™ Seamless Sculpt Set</h1>
      <p>The buttery-soft compression you've been waiting for.</p>
    </div>

    <div class="tier-grid">
      <div class="tier-card" onclick="selectTier('solo', this)">
        <h3>Solo Set</h3>
        <p><strong>$38.00</strong></p>
      </div>
      <div class="tier-card active" onclick="selectTier('vip', this)">
        <span class="vip-badge">BEST VALUE</span>
        <h3>VIP Bundle</h3>
        <p><strong>$54.00</strong></p>
      </div>
    </div>

    <div id="gift-box" class="gift-notice" style="display: block;">
      🎁 VIP BUNDLE UNLOCKED: Includes Free CloudSoft™ Pilates Grip Socks ($16 Value)
    </div>

    <button class="btn-buy" onclick="window.location.href='/collections/all'">Secure Your Sculpt Set</button>

    <div class="guarantee-strip">
      <span>✓ Utah Dispatch</span>
      <span>✓ 60-Day Trial</span>
      <span>✓ Free US Shipping</span>
    </div>
  </div>

  <script>
    function selectTier(type, el) {
      document.querySelectorAll('.tier-card').forEach(c => c.classList.remove('active'));
      el.classList.add('active');
      const giftBox = document.getElementById('gift-box');
      giftBox.style.display = (type === 'vip') ? 'block' : 'none';
    }
  </script>
</section>

{% schema %}
{
  "name": "Aura Sculpt Hero",
  "settings": [],
  "presets": [
    {
      "name": "Aura Sculpt Hero",
      "category": "Conversion"
    }
  ]
}
{% endschema %}