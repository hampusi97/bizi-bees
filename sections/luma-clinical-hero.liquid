{% comment %}
  Luma Clinical Hero Section - Shopify OS 2.0
  Medical-Aesthetic High-Converting Hero with Trust Ribbon & Dual CTAs
  Palette:
    Base: #FAFAFC
    Charcoal: #111827
    Clinical Trust Teal: #0D9488
    Warm Derm Glow: #C08479
{% endcomment %}

<section class="luma-hero-section" id="luma-hero-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-hero-container">
    
    <!-- Left Column: Copy & CTAs -->
    <div class="luma-hero-content">
      <div class="luma-hero-pill">
        <span class="luma-pill-pulse"></span>
        <span class="luma-pill-text">{{ section.settings.pill_text | default: 'CLINICAL GRADE PHOTOTHERAPY • DERM-TESTED' }}</span>
      </div>

      <h1 class="luma-hero-headline">
        {{ section.settings.headline | default: 'Clinical Skin Sculpting & At-Home Phototherapy.' }}
      </h1>

      <p class="luma-hero-subhead">
        {{ section.settings.subhead | default: 'Medical-grade 630nm red light, microcurrent contouring, and therapeutic warmth for 75% less. Shipped fast with tracked dispatch from Utah.' }}
      </p>

      <!-- Key Clinical Clinical Highlights -->
      <div class="luma-hero-features-grid">
        <div class="luma-feat-item">
          <svg class="luma-feat-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>630nm Targeted Red Light</span>
        </div>
        <div class="luma-feat-item">
          <svg class="luma-feat-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>Microcurrent Muscle Contouring</span>
        </div>
        <div class="luma-feat-item">
          <svg class="luma-feat-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>107°F Therapeutic Warmth</span>
        </div>
        <div class="luma-feat-item">
          <svg class="luma-feat-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>Tracked Utah Dispatch (24h)</span>
        </div>
      </div>

      <!-- Dual Action CTAs -->
      <div class="luma-hero-cta-group">
        <a href="{{ section.settings.primary_cta_url | default: '/products/lumaglow-4-in-1-red-light-microcurrent-facial-sculpting-wand' }}" 
           class="luma-btn-primary"
           id="luma-hero-buy-cta"
           onclick="handleLumaHeroPrimaryClick(event, '{{ section.settings.primary_cta_url | default: '/products/lumaglow-4-in-1-red-light-microcurrent-facial-sculpting-wand' }}')">
          <span class="luma-btn-text">{{ section.settings.primary_cta_text | default: 'Get LumaGlow 4-in-1 ($38.99)' }}</span>
          <svg class="luma-arrow-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>

        <a href="{{ section.settings.secondary_cta_url | default: '/pages/skincare-routine-quiz' }}" 
           class="luma-btn-secondary"
           id="luma-hero-quiz-cta"
           onclick="handleLumaQuizClick(event, '{{ section.settings.secondary_cta_url | default: '/pages/skincare-routine-quiz' }}')">
          <svg class="luma-quiz-icon" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" />
          </svg>
          <span>{{ section.settings.secondary_cta_text | default: 'Take 30-Sec Skin Quiz' }}</span>
        </a>
      </div>

      <!-- Trust Badges Micro-Row -->
      <div class="luma-hero-trust-bar">
        <div class="luma-trust-item">
          <span class="luma-stars">★★★★★</span>
          <strong>4.9/5.0</strong>
          <span class="luma-trust-sub">(2,450+ Verified Derm Reviews)</span>
        </div>
        <div class="luma-trust-separator">•</div>
        <div class="luma-trust-item">
          <svg class="luma-shield-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>60-Day Risk-Free Glow Guarantee</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Stage with Medical Aesthetic Glow -->
    <div class="luma-hero-visual">
      <div class="luma-visual-card">
        <div class="luma-badge-floating">
          <span class="luma-badge-tag">SAVE 75%</span>
          <span class="luma-badge-price">$38.99 <del>$169.00</del></span>
        </div>

        <div class="luma-image-wrapper">
          <img 
            src="https://cdn.shopify.com/s/files/1/0778/2465/5527/files/photo-1522337360788-8b13dee7a37e.jpg?v=1793651113"
            alt="LumaGlow 4-in-1 Clinical Skin Sculpting Facial Wand"
            class="luma-hero-img"
            loading="eager"
            width="560"
            height="560"
          >
          <div class="luma-glow-overlay"></div>
        </div>

        <!-- Hotspot Clinical Feature Cards -->
        <div class="luma-feature-pills">
          <div class="luma-pill-chip">
            <span class="chip-dot dot-red"></span>
            <span>630nm Phototherapy</span>
          </div>
          <div class="luma-pill-chip">
            <span class="chip-dot dot-teal"></span>
            <span>Microcurrent Lift</span>
          </div>
          <div class="luma-pill-chip">
            <span class="chip-dot dot-amber"></span>
            <span>107°F Thermal Comfort</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Live Media Trust Ribbon (Vogue, Elle, Allure, Byrdie, Glamour) -->
  <div class="luma-media-ribbon">
    <div class="luma-ribbon-inner">
      <p class="luma-ribbon-title">AS FEATURED IN TOP AESTHETIC &amp; WELLNESS PUBLICATIONS</p>
      <div class="luma-logos-grid">
        
        <!-- Vogue SVG -->
        <div class="luma-media-logo" title="VOGUE">
          <svg viewBox="0 0 140 32" fill="currentColor" class="media-svg">
            <text x="50%" y="65%" text-anchor="middle" font-family="'Didot', 'Bodoni MT', 'Cinzel', serif" font-weight="700" font-size="28" letter-spacing="4">VOGUE</text>
          </svg>
        </div>

        <!-- Elle SVG -->
        <div class="luma-media-logo" title="ELLE">
          <svg viewBox="0 0 100 32" fill="currentColor" class="media-svg">
            <text x="50%" y="65%" text-anchor="middle" font-family="'Didot', 'Bodoni MT', serif" font-weight="700" font-size="28" letter-spacing="3">ELLE</text>
          </svg>
        </div>

        <!-- Allure SVG -->
        <div class="luma-media-logo" title="ALLURE">
          <svg viewBox="0 0 130 32" fill="currentColor" class="media-svg">
            <text x="50%" y="65%" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, 'Futura', sans-serif" font-weight="900" font-size="24" letter-spacing="3">allure</text>
          </svg>
        </div>

        <!-- Byrdie SVG -->
        <div class="luma-media-logo" title="BYRDIE">
          <svg viewBox="0 0 130 32" fill="currentColor" class="media-svg">
            <text x="50%" y="65%" text-anchor="middle" font-family="'Century Gothic', 'Futura', sans-serif" font-weight="700" font-size="23" letter-spacing="5">BYRDIE</text>
          </svg>
        </div>

        <!-- Glamour SVG -->
        <div class="luma-media-logo" title="GLAMOUR">
          <svg viewBox="0 0 145 32" fill="currentColor" class="media-svg">
            <text x="50%" y="65%" text-anchor="middle" font-family="'Helvetica Neue', 'Arial Black', sans-serif" font-weight="800" font-size="22" letter-spacing="3">GLAMOUR</text>
          </svg>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  #luma-hero-{{ section.id }} {
    --luma-base: #FAFAFC;
    --luma-charcoal: #111827;
    --luma-teal: #0D9488;
    --luma-glow: #C08479;
    --luma-amber: #D97706;
    --luma-surface: #FFFFFF;
    --luma-border: #E5E7EB;
    --luma-muted: #4B5563;

    background-color: var(--luma-base);
    color: var(--luma-charcoal);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    padding: 48px 24px 0 24px;
    position: relative;
    overflow: hidden;
  }

  .luma-hero-container {
    max-width: 1240px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding-bottom: 48px;
  }

  .luma-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(13, 148, 136, 0.08);
    border: 1px solid rgba(13, 148, 136, 0.25);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .luma-pill-pulse {
    width: 8px;
    height: 8px;
    background: var(--luma-teal);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.2);
    animation: lumaPulse 2s infinite ease-in-out;
  }

  .luma-pill-text {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--luma-teal);
    text-transform: uppercase;
  }

  .luma-hero-headline {
    font-size: clamp(34px, 4.2vw, 56px);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--luma-charcoal);
    margin: 0 0 18px 0;
  }

  .luma-hero-subhead {
    font-size: clamp(16px, 1.8vw, 18px);
    line-height: 1.55;
    color: var(--luma-muted);
    margin: 0 0 28px 0;
    max-width: 580px;
  }

  .luma-hero-features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 18px;
    margin-bottom: 32px;
  }

  .luma-feat-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: #374151;
  }

  .luma-feat-icon {
    width: 18px;
    height: 18px;
    color: var(--luma-teal);
    flex-shrink: 0;
  }

  .luma-hero-cta-group {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 28px;
  }

  .luma-btn-primary {
    background: var(--luma-charcoal);
    color: #FFFFFF !important;
    text-decoration: none;
    font-size: 16px;
    font-weight: 800;
    padding: 16px 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 10px 25px -4px rgba(17, 24, 39, 0.35);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    border: none;
  }

  .luma-btn-primary:hover {
    transform: translateY(-2px);
    background: #030712;
    box-shadow: 0 14px 30px -4px rgba(17, 24, 39, 0.45);
  }

  .luma-arrow-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .luma-btn-primary:hover .luma-arrow-icon {
    transform: translateX(3px);
  }

  .luma-btn-secondary {
    background: var(--luma-surface);
    color: var(--luma-charcoal) !important;
    border: 1.5px solid var(--luma-border);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    padding: 15px 26px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .luma-btn-secondary:hover {
    border-color: var(--luma-glow);
    background: #FFF5F3;
    color: #9F4D40 !important;
  }

  .luma-quiz-icon {
    width: 18px;
    height: 18px;
    color: var(--luma-glow);
  }

  .luma-hero-trust-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: var(--luma-muted);
    padding-top: 14px;
    border-top: 1px solid var(--luma-border);
  }

  .luma-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .luma-stars {
    color: #F59E0B;
    letter-spacing: 1px;
    font-size: 13px;
  }

  .luma-trust-sub {
    color: #6B7280;
  }

  .luma-trust-separator {
    color: #D1D5DB;
  }

  .luma-shield-icon {
    width: 16px;
    height: 16px;
    color: var(--luma-teal);
  }

  /* Right Visual Stage */
  .luma-hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .luma-visual-card {
    position: relative;
    background: var(--luma-surface);
    border: 1px solid var(--luma-border);
    border-radius: 28px;
    padding: 20px;
    box-shadow: 0 20px 45px -10px rgba(17, 24, 39, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.02);
    max-width: 480px;
    width: 100%;
  }

  .luma-badge-floating {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 10;
    background: #DC2626;
    color: #FFFFFF;
    padding: 6px 14px;
    border-radius: 999px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 8px 18px rgba(220, 38, 38, 0.35);
  }

  .luma-badge-tag {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .luma-badge-price {
    font-size: 13px;
    font-weight: 800;
  }

  .luma-badge-price del {
    font-size: 10.5px;
    opacity: 0.8;
    margin-left: 3px;
  }

  .luma-image-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #F3F4F6;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .luma-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luma-visual-card:hover .luma-hero-img {
    transform: scale(1.03);
  }

  .luma-glow-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 25%, rgba(192, 132, 121, 0.22) 0%, transparent 60%);
    pointer-events: none;
  }

  .luma-feature-pills {
    display: flex;
    justify-content: space-around;
    gap: 8px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid #F3F4F6;
  }

  .luma-pill-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    color: var(--luma-charcoal);
  }

  .chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .dot-red { background: #EF4444; box-shadow: 0 0 6px rgba(239, 68, 68, 0.5); }
  .dot-teal { background: var(--luma-teal); box-shadow: 0 0 6px rgba(13, 148, 136, 0.5); }
  .dot-amber { background: #F59E0B; box-shadow: 0 0 6px rgba(245, 158, 11, 0.5); }

  /* Media Trust Ribbon */
  .luma-media-ribbon {
    border-top: 1px solid var(--luma-border);
    border-bottom: 1px solid var(--luma-border);
    background: #FFFFFF;
    padding: 24px 20px;
    margin-top: 12px;
  }

  .luma-ribbon-inner {
    max-width: 1240px;
    margin: 0 auto;
    text-align: center;
  }

  .luma-ribbon-title {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    color: #9CA3AF;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  .luma-logos-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(24px, 4.5vw, 64px);
    flex-wrap: wrap;
    opacity: 0.72;
    transition: opacity 0.2s ease;
  }

  .luma-logos-grid:hover {
    opacity: 0.95;
  }

  .luma-media-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .media-svg {
    height: 24px;
    width: auto;
    color: #374151;
  }

  @keyframes lumaPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  @media (max-width: 900px) {
    #luma-hero-{{ section.id }} {
      padding: 32px 16px 0 16px;
    }
    .luma-hero-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .luma-hero-visual {
      order: -1;
    }
    .luma-visual-card {
      max-width: 100%;
    }
    .luma-hero-features-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .luma-hero-cta-group {
      flex-direction: column;
      align-items: stretch;
    }
    .luma-btn-primary, .luma-btn-secondary {
      justify-content: center;
      text-align: center;
      width: 100%;
    }
  }
</style>

<script>
  function handleLumaHeroPrimaryClick(event, url) {
    if (window.fbq) {
      fbq('track', 'AddToCart', {
        content_name: 'LumaGlow 4-in-1 Facial Wand',
        content_type: 'product',
        value: 38.99,
        currency: 'USD'
      });
      fbq('track', 'InitiateCheckout', {
        content_name: 'LumaGlow 4-in-1 Facial Wand',
        value: 38.99,
        currency: 'USD'
      });
    }
    if (window.ttq) {
      ttq.track('AddToCart', {
        content_name: 'LumaGlow 4-in-1 Facial Wand',
        content_type: 'product',
        value: 38.99,
        currency: 'USD'
      });
    }
  }

  function handleLumaQuizClick(event, url) {
    if (window.fbq) {
      fbq('trackCustom', 'TakeSkinQuiz', { source: 'hero_secondary_cta' });
    }
  }
</script>

{% schema %}
{
  "name": "Luma Clinical Hero",
  "tag": "section",
  "class": "section-luma-hero",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Eyebrow Badge",
      "default": "CLINICAL GRADE PHOTOTHERAPY • DERM-TESTED"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Clinical Skin Sculpting & At-Home Phototherapy."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Medical-grade 630nm red light, microcurrent contouring, and therapeutic warmth for 75% less. Shipped fast with tracked dispatch from Utah."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Label",
      "default": "Get LumaGlow 4-in-1 ($38.99)"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Label",
      "default": "Take 30-Sec Skin Quiz"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Luma Clinical Hero"
    }
  ]
}
{% endschema %}
