            "spec_note": "Archive Standard • Provo Workshop"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"></path><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"></path></svg>",
            "pill_text": "Binding Verified",
            "title": "Spine & Page Stress-Test",
            "description": "Manual page-by-page spine flex check ensures no detached leaves, split hinges, or crumbling glue. Built to endure many more fireside reads.",
            "spec_note": "100% Intact Leaf Verification"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg>",
            "pill_text": "100% Complete",
            "title": "Inserts & Pieces Counted",
            "description": "Vintage box sets, maps, bookmarks, and retro board game components are inventoried piece-by-piece to guarantee zero missing parts.",
