{% comment %}
  Section: Bizi Bees 4-Point Pre-Loved Inspection & Trust Matrix
  File: sections/bizi-inspection-matrix.liquid
  Aesthetic: Editorial apothecary / vintage archive inspection seal, warm linen & olive.
  Purpose: Demolish pre-owned purchase hesitation and boost customer confidence.
{% endcomment %}

<section 
  id="BiziInspection-{{ section.id }}" 
  class="bizi-matrix-section"
  style="
    --bizi-bg: {{ section.settings.bg_color | default: '#FAF7F2' }};
    --bizi-espresso: {{ section.settings.text_color | default: '#2A241F' }};
    --bizi-honey: {{ section.settings.accent_color | default: '#D9822B' }};
    --bizi-olive: {{ section.settings.secondary_accent | default: '#4B5842' }};
    --bizi-border: #EBD9C5;
  "
>
  <div class="bizi-matrix-container">
    <div class="bizi-matrix-header">
      <div class="bizi-matrix-seal-badge">
        <svg class="bizi-matrix-seal-svg" viewBox="0 0 100 100" width="48" height="48">
          <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 2"/>
          <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-width="1"/>
          <text x="50" y="55" font-family="serif" font-size="18" font-weight="bold" text-anchor="middle" fill="currentColor">UT</text>
        </svg>
        <span class="bizi-matrix-eyebrow">{{ section.settings.eyebrow | default: 'The Provo Quality Standard' }}</span>
      </div>

      <h2 class="bizi-matrix-title">{{ section.settings.heading | default: 'Our 4-Point Pre-Loved Promise' }}</h2>
      <p class="bizi-matrix-sub">{{ section.settings.subheading | default: 'Every pre-owned volume, vintage heirloom, and treasure passes our meticulous hands-on restoration protocol before reaching your doorstep.' }}</p>
    </div>

    <!-- 4-Point Grid -->
    <div class="bizi-matrix-grid">
      {% for block in section.blocks %}
        <div class="bizi-matrix-card" {{ block.shopify_attributes }}>
          <div class="bizi-matrix-card-header">
            <div class="bizi-matrix-step-bubble">0{{ forloop.index }}</div>
            <div class="bizi-matrix-icon-wrap">
              {{ block.settings.icon_svg }}
            </div>
          </div>
          <div class="bizi-matrix-status-pill">
            <span class="bizi-matrix-check">✓</span>
            <span>{{ block.settings.pill_text | escape }}</span>
          </div>
          <h3 class="bizi-matrix-card-title">{{ block.settings.title | escape }}</h3>
          <p class="bizi-matrix-card-desc">{{ block.settings.description | escape }}</p>
          <div class="bizi-matrix-card-footer">
            <span class="bizi-matrix-spec">{{ block.settings.spec_note | escape }}</span>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Trust Summary Bar -->
    <div class="bizi-matrix-banner">
      <div class="bizi-banner-left">
        <span class="bizi-banner-bee">🐝</span>
        <div>
          <strong class="bizi-banner-title">{{ section.settings.banner_title | default: 'Zero Dog-Eared Surprises Guarantee' }}</strong>
          <span class="bizi-banner-desc">{{ section.settings.banner_text | default: 'If a volume arrives below description grade, we replace it or refund instantly — no questions asked.' }}</span>
        </div>
      </div>
      {% if section.settings.cta_url != blank %}
        <a href="{{ section.settings.cta_url }}" class="bizi-matrix-cta">
          <span>{{ section.settings.cta_text | default: 'Explore Inspected Books' }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #BiziInspection-{{ section.id }} {
    background-color: var(--bizi-bg);
    color: var(--bizi-espresso);
    padding: clamp(3.5rem, 6vw, 6.5rem) 1.25rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(2.25rem, 4vw, 3.5rem);
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-seal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--bizi-olive);
    margin-bottom: 1rem;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-seal-svg {
    color: var(--bizi-olive);
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--bizi-olive);
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--bizi-espresso);
    margin: 0 0 0.85rem 0;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-sub {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: rgba(42, 36, 31, 0.75);
    margin: 0;
  }

  /* Grid Layout */
  #BiziInspection-{{ section.id }} .bizi-matrix-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-card {
    background: #FFFFFF;
    border: 1px solid var(--bizi-border);
    border-radius: 18px;
    padding: 1.75rem 1.4rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 20px rgba(42, 36, 31, 0.04);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    position: relative;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-card:hover {
    transform: translateY(-4px);
    border-color: var(--bizi-honey);
    box-shadow: 0 16px 30px rgba(217, 130, 43, 0.1);
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-step-bubble {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--bizi-honey);
    background: rgba(217, 130, 43, 0.1);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-icon-wrap {
    color: var(--bizi-olive);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-icon-wrap svg {
    width: 28px;
    height: 28px;
    stroke: var(--bizi-olive);
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #1e824c;
    background: rgba(39, 174, 96, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    width: fit-content;
    margin-bottom: 0.75rem;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-check {
    font-weight: 900;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-card-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bizi-espresso);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-card-desc {
    font-size: 0.885rem;
    line-height: 1.55;
    color: rgba(42, 36, 31, 0.75);
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-card-footer {
    border-top: 1px dashed var(--bizi-border);
    padding-top: 0.85rem;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-spec {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bizi-olive);
    display: block;
  }

  /* Trust Banner */
  #BiziInspection-{{ section.id }} .bizi-matrix-banner {
    background: #FFFFFF;
    border: 1px solid var(--bizi-border);
    border-radius: 18px;
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-shadow: 0 8px 24px rgba(42, 36, 31, 0.05);
  }

  #BiziInspection-{{ section.id }} .bizi-banner-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  #BiziInspection-{{ section.id }} .bizi-banner-bee {
    font-size: 2rem;
    flex-shrink: 0;
  }

  #BiziInspection-{{ section.id }} .bizi-banner-title {
    display: block;
    font-size: 1.05rem;
    color: var(--bizi-espresso);
    margin-bottom: 2px;
  }

  #BiziInspection-{{ section.id }} .bizi-banner-desc {
    display: block;
    font-size: 0.875rem;
    color: rgba(42, 36, 31, 0.7);
    line-height: 1.45;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-cta {
    appearance: none;
    background: var(--bizi-olive);
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 700;
    padding: 0.85rem 1.65rem;
    border-radius: 999px;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  #BiziInspection-{{ section.id }} .bizi-matrix-cta:hover {
    background: #3a4533;
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    #BiziInspection-{{ section.id }} .bizi-matrix-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    #BiziInspection-{{ section.id }} .bizi-matrix-grid {
      grid-template-columns: 1fr;
    }
    #BiziInspection-{{ section.id }} .bizi-matrix-banner {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    #BiziInspection-{{ section.id }} .bizi-banner-left {
      flex-direction: column;
      text-align: center;
    }
    #BiziInspection-{{ section.id }} .bizi-matrix-cta {
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Bizi Inspection Matrix",
  "tag": "section",
  "class": "bizi-section-matrix",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Badge",
      "default": "The Provo Quality Standard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our 4-Point Pre-Loved Promise"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every pre-owned volume, vintage heirloom, and treasure passes our meticulous hands-on restoration protocol before reaching your doorstep."
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Guarantee Banner Title",
      "default": "Zero Dog-Eared Surprises Guarantee"
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Guarantee Banner Description",
      "default": "If a volume arrives below description grade, we replace it or refund instantly — no questions asked."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Banner CTA Text",
      "default": "Explore Inspected Books"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Banner CTA Link"
    },
    {
      "type": "color",
