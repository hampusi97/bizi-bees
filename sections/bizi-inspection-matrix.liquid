      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2A241F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Honey Accent",
      "default": "#D9822B"
    },
    {
      "type": "color",
      "id": "secondary_accent",
      "label": "Olive Accent",
      "default": "#4B5842"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust Pillar",
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG Icon Code",
          "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>"
        },
        {
          "type": "text",
          "id": "pill_text",
          "label": "Status Pill",
          "default": "Sanitized & Cleaned"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Botanical Dry-Cleaned"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Gentle UV sanitation and archival ozone treatment remove odor and dust while preserving vintage paper integrity."
        },
        {
          "type": "text",
          "id": "spec_note",
          "label": "Protocol Detail",
          "default": "Protocol: 48-Hr Controlled Deodorize"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bizi Inspection Matrix",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>",
            "pill_text": "Sanitized & Cleaned",
