{% comment %}
  BIZI BEES INTERACTIVE COZY GIFT CRATE BUILDER (COMPLETE)
  Repo: bizi-bees /sections/bizi-crate-builder.liquid
{% endcomment %}

<div class="crate-builder-wrap">
  <div class="crate-builder-inner">
    
    <div class="crate-badge">🎁 CURATED GIFTING RITUAL</div>
    <h2>Build Your Custom Cozy Evening Crate</h2>
    <p>Hand-packed in our signature kraft gift crate with wood wool, tied with butcher twine, and sealed with a beeswax stamp. Select 4 items below:</p>

    <!-- Virtual Crate Tray Visualizer -->
    <div class="crate-tray-card">
      <div class="crate-slots">
        <div class="crate-slot empty" id="cSlot1" onclick="clearSlot(1)">
          <span class="slot-icon">📖</span>
          <span class="slot-label">1. Pick a Book</span>
        </div>
        <div class="crate-slot empty" id="cSlot2" onclick="clearSlot(2)">
          <span class="slot-icon">☕</span>
          <span class="slot-label">2. Pick a Tea</span>
        </div>
        <div class="crate-slot empty" id="cSlot3" onclick="clearSlot(3)">
          <span class="slot-icon">🕯️</span>
          <span class="slot-label">3. Pick a Candle</span>
        </div>
        <div class="crate-slot empty" id="cSlot4" onclick="clearSlot(4)">
          <span class="slot-icon">🐝</span>
          <span class="slot-label">4. Pick a Keepsake</span>
        </div>
      </div>

      <div class="crate-action-bar">
        <div class="crate-pricing">
          <span class="crate-total" id="cratePrice">$0.00</span>
          <small class="crate-discount" id="crateDiscount">Select all 4 items to unlock the $38.00 Crate Bundle (Save $14)</small>
        </div>
        <button id="crateCheckoutBtn" class="crate-btn disabled" onclick="checkoutCrate()" disabled>
          Select All 4 Items
        </button>
      </div>
    </div>

    <!-- Step 1: The Book -->
    <div class="crate-step">
      <h3>Step 1: Choose Your Vintage Paperback</h3>
      <div class="crate-items-grid">
        <div class="c-item" data-step="1" onclick="selectCrateItem(1, 'Cozy Mystery Novel', '🔍', this)">
          <span class="ci-emoji">🔍</span>
          <strong>Cozy Mystery Novel</strong>
          <small>Inspected, pre-loved paperback</small>
        </div>
        <div class="c-item" data-step="1" onclick="selectCrateItem(1, 'Classic Literature', '📜', this)">
          <span class="ci-emoji">📜</span>
          <strong>Classic Literature</strong>
          <small>Timeless fiction masterpiece</small>
        </div>
        <div class="c-item" data-step="1" onclick="selectCrateItem(1, 'Retro 1970s Sci-Fi', '🪐', this)">
          <span class="ci-emoji">🪐</span>
          <strong>Retro 1970s Sci-Fi</strong>
          <small>Golden age speculative fiction</small>
        </div>
      </div>
    </div>

    <!-- Step 2: The Sip -->
    <div class="crate-step">
      <h3>Step 2: Choose Your Artisan Tea</h3>
      <div class="crate-items-grid">
        <div class="c-item" data-step="2" onclick="selectCrateItem(2, 'Lavender Chamomile', '🪻', this)">
          <span class="ci-emoji">🪻</span>
          <strong>Lavender Chamomile</strong>
          <small>Calming herbal loose blend</small>
        </div>
        <div class="c-item" data-step="2" onclick="selectCrateItem(2, 'Spiced Mountain Chai', '🍂', this)">
          <span class="ci-emoji">🍂</span>
          <strong>Spiced Mountain Chai</strong>
          <small>Cinnamon, clove &amp; black tea</small>
        </div>
        <div class="c-item" data-step="2" onclick="selectCrateItem(2, 'Bergamot Earl Grey', '🍋', this)">
          <span class="ci-emoji">🍋</span>
          <strong>Bergamot Earl Grey</strong>
          <small>Bright aromatic classic</small>
        </div>
      </div>
    </div>

    <!-- Step 3: The Candle -->
    <div class="crate-step">
      <h3>Step 3: Choose Your 100% Soy Reading Candle</h3>
      <div class="crate-items-grid">
        <div class="c-item" data-step="3" onclick="selectCrateItem(3, 'Old Book Pages Candle', '🕯️', this)">
          <span class="ci-emoji">🕯️</span>
          <strong>Old Book Pages</strong>
          <small>Parchment, leather &amp; cedar</small>
        </div>
        <div class="c-item" data-step="3" onclick="selectCrateItem(3, 'Warm Vanilla Honey', '🍯', this)">
          <span class="ci-emoji">🍯</span>
          <strong>Warm Vanilla Honey</strong>
          <small>Raw honeycomb &amp; sweet cream</small>
        </div>
        <div class="c-item" data-step="3" onclick="selectCrateItem(3, 'Rainy Pine Library', '🌲', this)">
          <span class="ci-emoji">🌲</span>
          <strong>Rainy Pine Library</strong>
          <small>Moss, fir needle &amp; petrichor</small>
        </div>
      </div>
    </div>

    <!-- Step 4: The Keepsake -->
    <div class="crate-step">
      <h3>Step 4: Choose Your Boutique Keepsake</h3>
      <div class="crate-items-grid">
        <div class="c-item" data-step="4" onclick="selectCrateItem(4, 'Brass Honeybee Bookmark', '🐝', this)">
          <span class="ci-emoji">🐝</span>
          <strong>Solid Brass Bee Bookmark</strong>
          <small>Heirloom etched page clip</small>
        </div>
        <div class="c-item" data-step="4" onclick="selectCrateItem(4, 'Raw Honey Lip Balm', '✨', this)">
          <span class="ci-emoji">✨</span>
          <strong>Beeswax Lip Balm Trio</strong>
          <small>Organic peppermint &amp; honey</small>
        </div>
        <div class="c-item" data-step="4" onclick="selectCrateItem(4, 'Magnetic Page Markers', '🔖', this)">
          <span class="ci-emoji">🔖</span>
          <strong>Floral Magnetic Markers</strong>
          <small>Set of 4 botanical clips</small>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .crate-builder-wrap {
    background: #FDFBF7;
    padding: 80px 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #29231E;
    border-bottom: 1px solid #EADBCE;
  }
  .crate-builder-inner { max-width: 920px; margin: 0 auto; text-align: center; }
  .crate-badge {
    background: #FEF3C7;
    color: #92400E;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 30px;
    display: inline-block;
    margin-bottom: 12px;
  }
  .crate-builder-inner h2 {
    font-family: Georgia, serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    margin: 0 0 12px;
  }
  .crate-builder-inner p {
    font-size: 15px;
    color: #6E6257;
    max-width: 620px;
    margin: 0 auto 35px;
    line-height: 1.6;
  }

  /* Virtual Crate Tray */
  .crate-tray-card {
    background: #FFFFFF;
    border: 2px solid #E5D6C5;
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 15px 35px rgba(41, 35, 30, 0.07);
    margin-bottom: 45px;
    position: sticky;
    top: 15px;
    z-index: 20;
  }
  .crate-slots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 22px;
  }
  .crate-slot {
    height: 95px;
    border-radius: 12px;
    border: 2px dashed #D6C2AF;
    background: #FAF7F2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 8px;
  }
  .crate-slot.filled {
    border: 2px solid #D9822B;
    background: #FFFBEB;
  }
  .slot-icon { font-size: 24px; margin-bottom: 4px; }
  .slot-label { font-size: 11px; font-weight: 700; color: #5C4D42; }

  .crate-action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #F1EAE1;
    padding-top: 18px;
  }
  .crate-pricing { text-align: left; }
  .crate-total { font-size: 26px; font-weight: 900; color: #29231E; display: block; }
  .crate-discount { font-size: 12px; color: #D9822B; font-weight: 700; }
  .crate-btn {
    background: #29231E;
    color: #FFFFFF;
    border: none;
    padding: 14px 32px;
    border-radius: 50px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .crate-btn.disabled { background: #C7B9AC; cursor: not-allowed; }
  .crate-btn:not(.disabled):hover { background: #D9822B; transform: translateY(-2px); }

  /* Steps */
  .crate-step { text-align: left; margin-bottom: 35px; }
  .crate-step h3 { font-family: Georgia, serif; font-size: 19px; margin-bottom: 14px; color: #29231E; }
  .crate-items-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .c-item {
    background: #FFFFFF;
    border: 1px solid #EADBCE;
    border-radius: 14px;
    padding: 18px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
  }
  .c-item:hover { transform: translateY(-3px); border-color: #D9822B; }
  .c-item.selected { border: 2px solid #D9822B; background: #FFFBEB; }
  .ci-emoji { font-size: 28px; display: block; margin-bottom: 8px; }
  .c-item strong { display: block; font-size: 14px; color: #29231E; margin-bottom: 4px; }
  .c-item small { font-size: 11px; color: #786C62; }

  @media (max-width: 768px) {
    .crate-slots { grid-template-columns: repeat(2, 1fr); }
    .crate-items-grid { grid-template-columns: 1fr; }
    .crate-action-bar { flex-direction: column; gap: 14px; text-align: center; }
    .crate-pricing { text-align: center; }
  }
</style>

<script>
  const crateSelections = { 1: null, 2: null, 3: null, 4: null };

  function selectCrateItem(step, title, icon, el) {
    crateSelections[step] = { title, icon };
    document.querySelectorAll(`.c-item[data-step="${step}"]`).forEach(card => card.classList.remove('selected'));
    el.classList.add('selected');
    renderCrateState();
  }

  function clearSlot(step) {
    crateSelections[step] = null;
    document.querySelectorAll(`.c-item[data-step="${step}"]`).forEach(card => card.classList.remove('selected'));
    renderCrateState();
  }

  function renderCrateState() {
    const defaultLabels = { 1: '1. Pick a Book', 2: '2. Pick a Tea', 3: '3. Pick a Candle', 4: '4. Pick a Keepsake' };
    const defaultIcons = { 1: '📖', 2: '☕', 3: '🕯️', 4: '🐝' };
    let count = 0;

    for (let s = 1; s <= 4; s++) {
      const slotEl = document.getElementById('cSlot' + s);
      if (crateSelections[s]) {
        count++;
        slotEl.className = 'crate-slot filled';
        slotEl.innerHTML = `<span class="slot-icon">${crateSelections[s].icon}</span><span class="slot-label">${crateSelections[s].title}</span>`;
      } else {
        slotEl.className = 'crate-slot empty';
        slotEl.innerHTML = `<span class="slot-icon">${defaultIcons[s]}</span><span class="slot-label">${defaultLabels[s]}</span>`;
      }
    }

    const priceEl = document.getElementById('cratePrice');
    const discEl = document.getElementById('crateDiscount');
    const btn = document.getElementById('crateCheckoutBtn');

    if (count === 4) {
      priceEl.innerHTML = '$38.00 <span style="font-size:14px;color:#9C8E82;text-decoration:line-through;font-weight:500;">$52.00</span>';
      discEl.innerText = '🎉 Complete Crate Unlocked! ($14.00 Bundle Savings + Free US Shipping)';
      btn.classList.remove('disabled');
      btn.disabled = false;
      btn.innerText = 'Add Custom Crate to Bag ($38.00) →';
    } else {
      priceEl.innerText = `$${(count * 13).toFixed(2)}`;
      discEl.innerText = `Select ${4 - count} more item${4 - count > 1 ? 's' : ''} to unlock the $38.00 Bundle Price`;
      btn.classList.add('disabled');
      btn.disabled = true;
      btn.innerText = `Select ${4 - count} More Item${4 - count > 1 ? 's' : ''}`;
    }
  }

  function checkoutCrate() {
    const summary = Object.values(crateSelections).map(i => i.title).join(' + ');
    window.location.href = `/collections/all?crate_bundle=${encodeURIComponent(summary)}`;
  }
</script>

