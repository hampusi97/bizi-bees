<style>
  .bb-catalog-wrapper {
    background: #FAF7F2;
    padding: 70px 20px 80px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .bb-catalog-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 35px;
  }
  .bb-pill-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FEF3C7;
    border: 1px solid #FDE68A;
    color: #92400E;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 6px 16px;
    border-radius: 40px;
    margin-bottom: 14px;
  }
  .bb-catalog-header h2 {
    font-family: Georgia, "Playfair Display", serif;
    font-size: clamp(28px, 4vw, 42px);
    color: #29231E;
    font-weight: 900;
    margin: 0 0 10px;
  }
  .bb-catalog-header p {
    font-size: 15px;
    color: #6E6257;
    line-height: 1.5;
    margin: 0;
  }

  /* Tabs */
  .bb-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .bb-tabs-track {
    display: inline-flex;
    gap: 8px;
    background: #EFE9DF;
    padding: 6px;
    border-radius: 50px;
    border: 1px solid #E2D7C8;
  }
  .bb-tab-btn {
    background: transparent;
    border: none;
    padding: 9px 20px;
    border-radius: 40px;
    font-size: 13.5px;
    font-weight: 700;
    color: #5E5246;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .bb-tab-btn.active {
    background: #29231E;
    color: #FAF7F2;
    box-shadow: 0 4px 12px rgba(41, 35, 30, 0.25);
  }
  .bb-tab-btn:hover:not(.active) {
    background: #E4DCD0;
    color: #29231E;
  }

  /* Product Grid */
  .bb-product-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 28px;
  }

  /* Product Card */
  .bb-prod-card {
    background: #FFFFFF;
    border: 1px solid #E6DDD1;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(41, 35, 30, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .bb-prod-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(41, 35, 30, 0.12);
    border-color: #D9822B;
  }

  /* Media */
  .bb-card-media {
    position: relative;
    width: 100%;
    height: 260px;
    background: #FDFBF7;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 16px;
    box-sizing: border-box;
  }
  .bb-card-media img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: contain !important;
    display: block !important;
    border-radius: 10px;
    transition: transform 0.3s ease;
  }
  .bb-prod-card:hover .bb-card-media img {
    transform: scale(1.05);
  }
  .bb-badge-gold {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #29231E;
    color: #FAF7F2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
    z-index: 2;
  }

  /* Body */
  .bb-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .bb-card-rating {
    font-size: 12px;
    color: #D9822B;
    margin-bottom: 8px;
  }
  .bb-card-rating span {
    color: #786C62;
    font-size: 11px;
    margin-left: 4px;
  }
  .bb-card-body h3 {
    font-family: Georgia, "Playfair Display", serif;
    font-size: 17px;
    font-weight: 800;
    color: #29231E;
    margin: 0 0 8px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 44px;
  }
  .bb-card-desc {
    font-size: 13px;
    color: #6E6257;
    line-height: 1.45;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 38px;
  }
  .bb-card-pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: auto;
    margin-bottom: 14px;
  }
  .bb-card-pricing strong {
    font-size: 20px;
    color: #29231E;
    font-weight: 800;
  }
  .bb-card-strike {
    font-size: 13px;
    color: #A89F95;
    text-decoration: line-through;
  }

  /* Button */
  .bb-card-btn {
    width: 100%;
    background: #29231E;
    color: #FAF7F2;
    border: none;
    padding: 13px;
    border-radius: 40px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .bb-card-btn:hover {
    background: #D9822B;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(217, 130, 43, 0.3);
  }

  @media (max-width: 640px) {
    .bb-product-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  function filterCatalog(category, btn) {
    document.querySelectorAll('.bb-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const cards = document.querySelectorAll('.bb-prod-card');
    cards.forEach(card => {
      const cats = card.getAttribute('data-category') || '';
      if (category === 'all' || cats.includes(category)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function addShopifyItem(variantId, title, btn) {
    const orig = btn.innerText;
    btn.innerText = 'Adding...';
    btn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(r => r.json())
    .then(data => {
      btn.innerText = '✓ Added to Bag!';
      btn.style.background = '#10B981';

      // Refresh DropperCart slide-out drawer
      if (window.DropperCart && typeof window.DropperCart.refreshCart === 'function') {
        window.DropperCart.refreshCart(true);
      } else {
        // Update cart count
        fetch('/cart.js')
          .then(r => r.json())
          .then(cart => {
            const counts = document.querySelectorAll('#HeaderCartCount, .editorial-cart-count, #DropperCartCount');
            counts.forEach(c => { c.innerText = cart.item_count; });
            
            // Trigger dynamic island if present
            const island = document.getElementById('roDynamicIsland');
            if (island) {
              const msg = document.getElementById('roIslandMsg');
              if (msg) msg.innerText = '✓ ' + title + ' Added to Bag!';
              island.classList.add('active');
              setTimeout(() => island.classList.remove('active'), 4500);
            }
          });
      }

      setTimeout(() => {
        btn.innerText = orig;
        btn.style.background = '';
        btn.disabled = false;
      }, 2000);
    })
    .catch(err => {
      console.error('Cart add error:', err);
      btn.innerText = 'Go to Bag →';
      btn.onclick = function() { window.location.href = '/cart'; };
    });
  }
</script>

