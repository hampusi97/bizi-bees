<!-- ==========================================================
     INTERACTIVE JAVASCRIPT: TABS + 3D TILT + INSTANT BUY
     ========================================================== -->
<script>
  // 1. Interactive Animated Tab Switcher
  function switchCategory(catName, btn) {
    // Switch active tab styling
    document.querySelectorAll('.dyn-tab-btn').forEach(function(b) {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');

    if (catName === 'ai-concierge') {
      var concierge = document.getElementById('dynGeminiConcierge');
      if (concierge) {
        concierge.scrollIntoView({ behavior: 'smooth', block: 'center' });
        var input = document.getElementById('geminiQueryInput');
        if (input) setTimeout(function() { input.focus(); }, 400);
      }
      return;
    }

    // Filter cards with smooth fade
    var cards = document.querySelectorAll('.dyn-card');
    cards.forEach(function(card) {
      var categories = card.getAttribute('data-category') || '';
      if (categories.indexOf(catName) !== -1) {
        card.style.display = 'flex';
        setTimeout(function() {
          card.style.opacity = '1';
          card.style.transform = 'scale(1)';
        }, 10);
      } else {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.96)';
        setTimeout(function() {
          card.style.display = 'none';
        }, 200);
      }
    });
  }

  // 1b. Gemini AI Concierge Query Engine (Dual-Key High Availability)
  function sendGeminiPrompt(text) {
    var input = document.getElementById('geminiQueryInput');
    if (input) {
      input.value = text;
      runGeminiQuery(text);
    }
  }

  function submitGeminiQuery(e) {
    e.preventDefault();
    var input = document.getElementById('geminiQueryInput');
    if (!input || !input.value.trim()) return;
    var query = input.value.trim();
    input.value = '';
    runGeminiQuery(query);
  }

  function runGeminiQuery(query) {
    var stream = document.getElementById('dynAiStream');
    var btn = document.getElementById('geminiSubmitBtn');
    if (stream) {
      var uMsg = document.createElement('div');
      uMsg.className = 'dyn-ai-msg user';
      uMsg.innerText = '👤 You: ' + query;
      stream.appendChild(uMsg);
      stream.scrollTop = stream.scrollHeight;
    }
    if (btn) {
      btn.innerHTML = 'Thinking... ⏳';
      btn.disabled = true;
    }

    fetch('https://bizi-bees.vercel.app/api/ai/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prompt: query,
        systemInstruction: "You are the expert AI concierge for Bizi Bees Curated Vintage and Luma Clinical dermatology tools. Answer concisely (2-3 sentences), warmly, and highlight LumaGlow 4-in-1 ($38.99), LumaRelief migraine cap ($22.74), or Bizi Bees Blind Date with a Book ($14.99) dispatched in 24h from Utah.",
        model: 'gemini-3.5-flash'
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (stream) {
        var bMsg = document.createElement('div');
        bMsg.className = 'dyn-ai-msg bot';
        var replyText = (data.success && data.text) ? data.text : "Our flagship collections feature LumaGlow 4-in-1 QuadWave Pro ($38.99) and Bizi Bees Blind Date with a Book ($14.99), both verified in stock with 24h Utah priority dispatch!";
        bMsg.innerHTML = '<strong>🤖 Concierge:</strong> ' + replyText;
        stream.appendChild(bMsg);
        stream.scrollTop = stream.scrollHeight;
      }
    })
    .catch(function() {
      if (stream) {
        var bMsg = document.createElement('div');
        bMsg.className = 'dyn-ai-msg bot';
        bMsg.innerHTML = '<strong>🤖 Concierge:</strong> Our flagship collections feature LumaGlow 4-in-1 QuadWave Pro ($38.99) and Bizi Bees Blind Date with a Book ($14.99), both verified in stock with 24h Utah priority dispatch!';
        stream.appendChild(bMsg);
        stream.scrollTop = stream.scrollHeight;
      }
    })
    .finally(function() {
      if (btn) {
        btn.innerHTML = '<span>Ask Gemini ⚡</span>';
        btn.disabled = false;
      }
    });
  }

  // 2. Instant 1-Click Buy / Cart Add
  var productUrlMap = {
    'LumaGlow™ 4-in-1 Wand': '/products/lumaglow-4-in-1-facial-wand',
    'LumaRelief™ Migraine Cap': '/products/lumarelief-migraine-cap',
    'LumaRelief™ 2-Cap Bundle': '/products/lumarelief-migraine-cap',
    'LumaMask™ LED Shield': '/products/lumaglow-4-in-1-facial-wand',
    'LumaLift™ V-Face Sculptor': '/products/lumaglow-4-in-1-facial-wand',
    'LumaClean™ Brush Cleaner': '/products/lumaglow-4-in-1-facial-wand',
    'Blind Date with a Book': '/products/blind-date-book-mystery',
    'Luxury Weekly Planner': '/collections/books',
    '10 Frame Fidgets Set': '/collections/games-puzzles',
    'Storm Crystal Whisky Glass': '/products/storm-japanese-crystal-whisky-glass',
    'Bizi Bees Mystery Reader Bundle': '/products/blind-date-book-mystery'
  };

  function instantAddToCart(title, price, btn) {
    var originalText = btn.innerHTML;
    btn.innerHTML = '<span>Adding... ⏳</span>';
    btn.disabled = true;

    var targetUrl = productUrlMap[title] || '/collections/all';

    // Check variant mapping for instant checkout or cart add
    var variantMap = {
      'LumaGlow™ 4-in-1 Wand': 47983637332263,
      'LumaRelief™ Migraine Cap': 47983637365031,
      'LumaRelief™ 2-Cap Bundle': 47983637397799,
      'LumaMask™ LED Shield': 47983637430567,
      'LumaLift™ V-Face Sculptor': 47983637463335
    };
    var variantId = variantMap[title];

    if (variantId && typeof fetch !== 'undefined') {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(function(res) {
        if (!res.ok) {
          window.location.href = targetUrl;
          return null;
        }
        return res.json();
      })
      .then(function(item) {
        if (!item) return;
        btn.innerHTML = '<span>✓ Added to Bag!</span>';
        btn.style.background = '#0D9488';

        // Broadcast cart:updated event and refresh cart state
        fetch('/cart.js')
          .then(function(cRes) { return cRes.json(); })
          .then(function(cart) {
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
            document.dispatchEvent(new CustomEvent('cart:change', { detail: cart }));

            // Open cart drawer if present
            var drawer = document.querySelector('cart-drawer') || document.getElementById('cartDrawer') || document.querySelector('.cart-drawer');
            if (window.openCartDrawer) {
              window.openCartDrawer();
            } else if (drawer && typeof drawer.open === 'function') {
              drawer.open();
            } else if (drawer && drawer.classList) {
              drawer.classList.add('is-open', 'active');
            } else {
              setTimeout(function() {
                window.location.href = '/checkout';
              }, 400);
            }
          })
          .catch(function() {
            window.location.href = '/checkout';
          });
      })
      .catch(function() {
        btn.innerHTML = '<span>✓ Redirecting...</span>';
        btn.style.background = '#0D9488';
        setTimeout(function() {
          window.location.href = targetUrl;
        }, 300);
      });
    } else {
      setTimeout(function() {
        btn.innerHTML = '<span>✓ Redirecting...</span>';
        btn.style.background = '#0D9488';
        window.location.href = targetUrl;
      }, 300);
    }
  }

  // 3. 3D Card Tilt Physics (Mouse Follow)
  (function() {
    var cards = document.querySelectorAll('[data-tilt]');
    cards.forEach(function(card) {
      card.addEventListener('mousemove', function(e) {
        var rect = card.getBoundingClientRect();
        var x = e.clientX - rect.left - rect.width / 2;
        var y = e.clientY - rect.top - rect.height / 2;
        card.style.transform = 'perspective(800px) rotateX(' + (y * -0.04) + 'deg) rotateY(' + (x * 0.04) + 'deg) translateY(-6px)';
      });
      card.addEventListener('mouseleave', function() {
        card.style.transform = 'perspective(800px) rotateX(0deg) rotateY(0deg) translateY(0)';
      });
    });
  })();
</script>

