<!-- ==========================================================
     SCOPED 60 FPS ULTRA-DYNAMIC STYLING
     ========================================================== -->
<style>
  .dyn-catalog-wrapper {
    position: relative;
    padding: 80px 20px 90px;
    background: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #0F172A;
    overflow: hidden;
  }
  .dyn-catalog-glow {
    position: absolute;
    top: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(circle, rgba(13, 148, 136, 0.10) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }
  .dyn-catalog-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 35px;
    position: relative;
    z-index: 2;
  }
  .dyn-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F0FDFA;
    border: 1px solid #99F6E4;
    color: #0F766E;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 6px 16px;
    border-radius: 40px;
    margin-bottom: 16px;
  }
  .dyn-pulse-dot {
    width: 8px;
    height: 8px;
    background: #0D9488;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.25);
    animation: dynPulse 2s infinite;
  }
  @keyframes dynPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }
  .dyn-catalog-header h2 {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 900;
    color: #0F172A;
    letter-spacing: -1px;
    margin: 0 0 12px;
  }
  .dyn-catalog-header p {
    font-size: 16px;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  /* Animated Category Tabs */
  .dyn-tabs-container {
    display: flex;
    justify-content: center;
    margin-bottom: 45px;
    position: relative;
    z-index: 3;
  }
  .dyn-tabs-track {
    display: inline-flex;
    background: #F1F5F9;
    padding: 6px;
    border-radius: 50px;
    gap: 6px;
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dyn-tabs-track::-webkit-scrollbar { display: none; }
  .dyn-tab-btn {
    background: transparent;
    border: none;
    padding: 10px 20px;
    border-radius: 40px;
    font-size: 14px;
    font-weight: 700;
    color: #64748B;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    position: relative;
    z-index: 2;
  }
  .dyn-tab-btn:hover { color: #0F172A; }
  .dyn-tab-btn.active {
    background: #0F172A;
    color: #FFFFFF !important;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.18);
  }

  /* Product Grid */
  .dyn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 1160px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .dyn-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    will-change: transform;
    opacity: 1;
    transform: scale(1);
  }
  .dyn-card.hide {
    display: none !important;
  }
  .dyn-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.10);
    border-color: #CBD5E1;
  }

  /* Card Media & Badges */
  .dyn-card-media {
    position: relative;
