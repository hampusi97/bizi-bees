    color: var(--bizi-espresso);
    padding: clamp(3.5rem, 6vw, 6.5rem) 1.25rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-container {
    max-width: 1160px;
    margin: 0 auto;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(2rem, 3.5vw, 3.25rem);
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bizi-honey);
    background: rgba(217, 130, 43, 0.12);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--bizi-espresso);
    margin: 0 0 0.75rem 0;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-desc {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: rgba(42, 36, 31, 0.75);
    margin: 0;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }

  /* Items Column */
  #BiziBundle-{{ section.id }} .bizi-bundle-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-item-card {
    background: #FFFFFF;
    border: 1px solid var(--bizi-border);
    border-radius: 18px;
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 1.15rem;
    box-shadow: 0 6px 18px rgba(42, 36, 31, 0.04);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-item-card:hover {
    border-color: var(--bizi-honey);
    transform: translateY(-2px);
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-item-num {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--bizi-honey);
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-item-thumb {
    width: 68px;
    height: 68px;
    border-radius: 12px;
    overflow: hidden;
    background: #FAF7F2;
    border: 1px solid var(--bizi-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #BiziBundle-{{ section.id }} .bizi-thumb-placeholder {
    font-size: 1.85rem;
  }

  #BiziBundle-{{ section.id }} .bizi-item-step-tag {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bizi-olive);
    margin-bottom: 2px;
  }

  #BiziBundle-{{ section.id }} .bizi-item-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--bizi-espresso);
    margin: 0 0 2px 0;
    line-height: 1.3;
  }

  #BiziBundle-{{ section.id }} .bizi-item-caption {
    font-size: 0.825rem;
    color: rgba(42, 36, 31, 0.65);
    margin: 0;
    line-height: 1.4;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-item-price-col {
    text-align: right;
  }

  #BiziBundle-{{ section.id }} .bizi-item-price-val {
    display: block;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--bizi-espresso);
  }

  #BiziBundle-{{ section.id }} .bizi-item-status {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--bizi-olive);
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-plus-divider {
    text-align: center;
    color: var(--bizi-honey);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    margin: -0.25rem 0;
  }

  /* Summary Card */
  #BiziBundle-{{ section.id }} .bizi-bundle-summary-card {
    background: #FFFFFF;
    border: 1px solid var(--bizi-border);
    border-radius: 22px;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    position: sticky;
    top: 2rem;
    box-shadow: 0 16px 36px -10px rgba(42, 36, 31, 0.08);
  }

  #BiziBundle-{{ section.id }} .bizi-summary-ribbon {
    display: inline-block;
    background: var(--bizi-honey);
    color: #FFFFFF;
    font-size: 0.725rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  #BiziBundle-{{ section.id }} .bizi-summary-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--bizi-espresso);
    margin: 0 0 0.5rem 0;
  }

  #BiziBundle-{{ section.id }} .bizi-summary-pitch {
    font-size: 0.925rem;
    line-height: 1.55;
    color: rgba(42, 36, 31, 0.75);
    margin: 0 0 1.5rem 0;
  }

  #BiziBundle-{{ section.id }} .bizi-summary-breakdown {
    background: #FAF7F2;
    border-radius: 14px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--bizi-border);
  }

  #BiziBundle-{{ section.id }} .bizi-breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9rem;
    color: rgba(42, 36, 31, 0.75);
    margin-bottom: 0.5rem;
  }

  #BiziBundle-{{ section.id }} .bizi-old-price {
    text-decoration: line-through;
    color: rgba(42, 36, 31, 0.5);
  }

  #BiziBundle-{{ section.id }} .bizi-save-badge {
    background: rgba(39, 174, 96, 0.12);
    color: #1e824c;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }

  #BiziBundle-{{ section.id }} .bizi-breakdown-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 0.75rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--bizi-border);
  }

  #BiziBundle-{{ section.id }} .bizi-total-label {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--bizi-espresso);
  }

  #BiziBundle-{{ section.id }} .bizi-total-price {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--bizi-espresso);
  }

  #BiziBundle-{{ section.id }} .bizi-summary-trust-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  #BiziBundle-{{ section.id }} .bizi-trust-item {
    font-size: 0.85rem;
    color: rgba(42, 36, 31, 0.8);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Add Button */
  #BiziBundle-{{ section.id }} .bizi-add-bundle-btn {
    appearance: none;
    width: 100%;
    background: var(--bizi-honey);
    color: #FFFFFF;
    font-size: 1.05rem;
    font-weight: 700;
    padding: 1.05rem 1.5rem;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    box-shadow: 0 10px 24px -4px rgba(217, 130, 43, 0.45);
    transition: all 0.25s ease;
  }

  #BiziBundle-{{ section.id }} .bizi-add-bundle-btn:hover {
    background: #c37222;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -4px rgba(217, 130, 43, 0.55);
  }

  #BiziBundle-{{ section.id }} .bizi-add-bundle-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  #BiziBundle-{{ section.id }} .bizi-btn-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid #FFFFFF;
    border-top-color: transparent;
    border-radius: 50%;
    animation: biziSpin 0.7s linear infinite;
  }

  @keyframes biziSpin {
    to { transform: rotate(360deg); }
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-feedback {
    margin-top: 0.85rem;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-feedback.success {
    background: rgba(39, 174, 96, 0.12);
    color: #1e824c;
    border: 1px solid rgba(39, 174, 96, 0.25);
  }

  #BiziBundle-{{ section.id }} .bizi-bundle-feedback.error {
    background: rgba(231, 76, 60, 0.12);
    color: #c0392b;
    border: 1px solid rgba(231, 76, 60, 0.25);
  }

  #BiziBundle-{{ section.id }} .bizi-summary-guarantee {
    text-align: center;
    font-size: 0.775rem;
    color: rgba(42, 36, 31, 0.6);
    margin-top: 1rem;
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    #BiziBundle-{{ section.id }} .bizi-bundle-grid {
      grid-template-columns: 1fr;
    }
    #BiziBundle-{{ section.id }} .bizi-bundle-item-card {
      grid-template-columns: auto 1fr auto;
      gap: 0.85rem;
      padding: 1rem;
    }
    #BiziBundle-{{ section.id }} .bizi-bundle-item-num {
      display: none;
    }
    #BiziBundle-{{ section.id }} .bizi-bundle-summary-card {
      position: static;
    }
  }
</style>

<script>
  (function() {
    const sectionEl = document.getElementById('BiziBundle-{{ section.id }}');
    if (!sectionEl) return;

    const addBtn = sectionEl.querySelector('#BiziAddBundleBtn-{{ section.id }}');
    const feedbackEl = sectionEl.querySelector('#BiziBundleFeedback-{{ section.id }}');
    const spinner = addBtn ? addBtn.querySelector('.bizi-btn-spinner') : null;
    const btnText = addBtn ? addBtn.querySelector('.bizi-btn-text') : null;
    const itemCards = Array.from(sectionEl.querySelectorAll('.bizi-bundle-item-card'));

    if (!addBtn) return;

    addBtn.addEventListener('click', async function(e) {
      e.preventDefault();

      // Collect variant IDs from the blocks
      const itemsToAdd = [];
      itemCards.forEach(card => {
        const variantId = card.getAttribute('data-variant-id');
        if (variantId && !isNaN(parseInt(variantId, 10)) && parseInt(variantId, 10) > 0) {
          itemsToAdd.push({
            id: parseInt(variantId, 10),
            quantity: 1
          });
        }
      });

      // UI Loading state
      addBtn.disabled = true;
      if (spinner) spinner.style.display = 'inline-block';
      if (btnText) btnText.textContent = 'Adding Bundle Items...';
      if (feedbackEl) feedbackEl.style.display = 'none';

      try {
        if (itemsToAdd.length === 0) {
          // Fallback simulation or direct redirect to demo collection/cart
          await new Promise(res => setTimeout(res, 600));
          if (feedbackEl) {
            feedbackEl.className = 'bizi-bundle-feedback success';
            feedbackEl.innerHTML = '✨ Bundle selected! Select products in Shopify Theme Editor to activate direct cart injection.';
            feedbackEl.style.display = 'block';
          }
          if (btnText) btnText.textContent = '✓ Bundle Added!';
          setTimeout(() => {
            if (btnText) btnText.textContent = 'Add Complete Bundle to Cart';
            addBtn.disabled = false;
            if (spinner) spinner.style.display = 'none';
          }, 2500);
          return;
        }

        // Shopify AJAX Cart API call
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ items: itemsToAdd })
        });

        if (response.ok) {
          const cartData = await response.json();
          if (btnText) btnText.textContent = '✓ Added to Cart!';
          if (feedbackEl) {
            feedbackEl.className = 'bizi-bundle-feedback success';
            feedbackEl.innerHTML = '🎉 3 items added to your cart! <a href="/cart" style="color: inherit; text-decoration: underline; font-weight: 700;">Proceed to Checkout →</a>';
            feedbackEl.style.display = 'block';
          }

          // Trigger theme cart drawer if theme supports pub/sub
          if (window.Shopify && Shopify.theme && typeof Shopify.theme.cartDrawerOpen === 'function') {
            Shopify.theme.cartDrawerOpen();
          } else if (document.querySelector('cart-drawer')) {
            // Dawn / OS 2.0 default cart-drawer trigger
            document.querySelector('cart-drawer').classList.add('active');
          }
        } else {
          const err = await response.json();
          throw new Error(err.description || 'Could not add items to cart.');
        }
      } catch (err) {
        if (feedbackEl) {
          feedbackEl.className = 'bizi-bundle-feedback error';
          feedbackEl.textContent = err.message || 'Something went wrong. Please try again.';
          feedbackEl.style.display = 'block';
        }
      } finally {
        addBtn.disabled = false;
        if (spinner) spinner.style.display = 'none';
        setTimeout(() => {
          if (btnText) btnText.textContent = 'Add Complete Bundle to Cart';
        }, 3000);
      }
    });
  })();
</script>

{% schema %}
