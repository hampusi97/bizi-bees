{% comment %}
  Section: Bizi Bees Holiday Bundle Builder
  File: sections/bizi-holiday-bundle-builder.liquid
  Aesthetic: Warm boutique curated gift set with 1-click multi-item AJAX bundle checkout.
{% endcomment %}

<section 
  id="BiziBundle-{{ section.id }}" 
  class="bizi-bundle-section"
  style="
    --bizi-bg: {{ section.settings.bg_color | default: '#FAF7F2' }};
    --bizi-espresso: {{ section.settings.text_color | default: '#2A241F' }};
    --bizi-honey: {{ section.settings.accent_color | default: '#D9822B' }};
    --bizi-olive: {{ section.settings.secondary_accent | default: '#4B5842' }};
    --bizi-border: #EBD9C5;
  "
>
  <div class="bizi-bundle-container">
    <div class="bizi-bundle-header">
      {% if section.settings.badge != blank %}
        <span class="bizi-bundle-pill">{{ section.settings.badge | escape }}</span>
      {% endif %}
      <h2 class="bizi-bundle-title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="bizi-bundle-desc">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    <div class="bizi-bundle-grid">
      <!-- Left Column: The 3 Bundled Items Showcase -->
      <div class="bizi-bundle-items-col">
        <div class="bizi-bundle-items-list">
          {% for block in section.blocks %}
            {% assign prod = block.settings.product %}
            <div 
              class="bizi-bundle-item-card" 
              data-item-index="{{ forloop.index }}"
              data-variant-id="{% if prod != blank and prod.available %}{{ prod.selected_or_first_available_variant.id }}{% else %}{{ block.settings.fallback_variant_id }}{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="bizi-bundle-item-num">0{{ forloop.index }}</div>
              
              <div class="bizi-bundle-item-thumb">
                {% if prod != blank and prod.featured_image != blank %}
                  <img 
                    src="{{ prod.featured_image | image_url: width: 200 }}" 
                    alt="{{ prod.title | escape }}" 
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                {% else %}
                  <div class="bizi-thumb-placeholder">
                    <span>{{ block.settings.fallback_emoji | default: '🎁' }}</span>
                  </div>
                {% endif %}
              </div>

              <div class="bizi-bundle-item-info">
                <span class="bizi-item-step-tag">{{ block.settings.step_tag | escape }}</span>
                <h4 class="bizi-item-title">
                  {% if prod != blank %}
                    {{ prod.title | escape }}
                  {% else %}
                    {{ block.settings.fallback_title | escape }}
                  {% endif %}
                </h4>
                <p class="bizi-item-caption">{{ block.settings.caption | escape }}</p>
              </div>

              <div class="bizi-bundle-item-price-col">
                <span class="bizi-item-price-val">
                  {% if prod != blank %}
                    {{ prod.price | money }}
                  {% else %}
                    {{ block.settings.fallback_price | default: '$12.00' }}
                  {% endif %}
                </span>
                <span class="bizi-item-status">✓ Included</span>
              </div>
            </div>

            {% unless forloop.last %}
              <div class="bizi-bundle-plus-divider">
                <span>+</span>
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      </div>

      <!-- Right Column: Bundle Pricing Card & Instant Add to Cart -->
      <div class="bizi-bundle-checkout-col">
        <div class="bizi-bundle-summary-card">
          <div class="bizi-summary-ribbon">
            <span>{{ section.settings.discount_callout | default: 'Holiday Gift Set Special' }}</span>
          </div>

          <h3 class="bizi-summary-title">{{ section.settings.bundle_name | default: 'The Cozy Reader Holiday Trio' }}</h3>
          <p class="bizi-summary-pitch">{{ section.settings.bundle_summary | default: 'Everything needed for fireside reading evenings. Packaged together in our custom Bizi Bees holiday gift box.' }}</p>

          <div class="bizi-summary-breakdown">
            <div class="bizi-breakdown-row">
              <span>Combined Value:</span>
              <span class="bizi-old-price">{{ section.settings.total_original_price | default: '$38.00' }}</span>
            </div>
            <div class="bizi-breakdown-row bizi-save-row">
              <span>Bundle Savings:</span>
              <span class="bizi-save-badge">{{ section.settings.savings_text | default: 'Save 34% ($13.01 Off)' }}</span>
            </div>
            <div class="bizi-breakdown-total">
              <span class="bizi-total-label">Special Bundle Price:</span>
              <span class="bizi-total-price">{{ section.settings.bundle_price | default: '$24.99' }}</span>
            </div>
          </div>

          <div class="bizi-summary-trust-bullets">
            <div class="bizi-trust-item">
              <span>🎁</span> Free Bizi Bees Gold Foil Holiday Gift Box
            </div>
            <div class="bizi-trust-item">
              <span>🐝</span> Hand-packed & Inspected in Provo, UT
            </div>
            <div class="bizi-trust-item">
              <span>🚚</span> Ships within 24 hours of ordering
            </div>
          </div>

          <!-- 1-Click Multi-Item AJAX Add to Cart Button -->
          <div class="bizi-bundle-action-wrap">
            <button 
              type="button" 
              id="BiziAddBundleBtn-{{ section.id }}" 
              class="bizi-add-bundle-btn"
            >
              <span class="bizi-btn-spinner" style="display: none;"></span>
              <span class="bizi-btn-icon">🛍️</span>
              <span class="bizi-btn-text">{{ section.settings.cta_text | default: 'Add Complete Bundle to Cart' }}</span>
            </button>
            <div id="BiziBundleFeedback-{{ section.id }}" class="bizi-bundle-feedback" style="display: none;"></div>
          </div>

          <div class="bizi-summary-guarantee">
            <span>🛡️ 30-Day Delight Guarantee — Free returns if not completely loved</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
