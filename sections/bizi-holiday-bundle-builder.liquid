        },
        {
          "type": "text",
          "id": "fallback_title",
          "label": "Fallback Title (if no product chosen)",
          "default": "Curated Mystery Pre-Loved Paperback"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Short Description",
          "default": "Hand-inspected, tight spine, UV cleaned"
        },
        {
          "type": "text",
          "id": "fallback_price",
          "label": "Fallback Price",
          "default": "$15.00"
