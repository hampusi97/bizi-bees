{% comment %}
  Luma Clinical - Mobile-Responsive Shoppable UGC Grid
  File: sections/shoppable-instagram-feed.liquid
{% endcomment %}

<section class="luma-ugc-section" id="luma-ugc-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-ugc-container">
    <div class="luma-ugc-header">
      <span class="luma-ugc-pill">VERIFIED CREATOR PROTOCOLS</span>
      <h2 class="luma-ugc-title">{{ section.settings.heading | default: "Clinical Routines. Real Results." }}</h2>
      <p class="luma-ugc-subtitle">{{ section.settings.subheading | default: "See how dermatology enthusiasts and verified creators incorporate the QuadWave™ Protocol into their daily home rituals." }}</p>
    </div>

    <div class="luma-ugc-grid">
      <!-- Item 1 -->
      <div class="luma-ugc-card">
        <div class="luma-ugc-media">
          <div class="luma-ugc-overlay">
            <span class="luma-ugc-handle">@dr.emily_derm</span>
            <span class="luma-ugc-protocol">Red Light + Thermal</span>
          </div>
          <div class="luma-ugc-badge-pill">★ Verified Creator</div>
          <div class="luma-ugc-simulated-image img-1">
            <div class="luma-glow-halo"></div>
            <span class="ugc-icon">▶</span>
          </div>
        </div>
        <div class="luma-ugc-details">
          <p class="luma-ugc-quote">“The 630nm wavelength and 330µA microcurrent match what I recommend in-office, at 1/4 the cost.”</p>
          <div class="luma-ugc-product-tag">
            <span class="tag-title">Featured: LumaGlow™ QuadWave Pro</span>
            <a href="{{ section.settings.product_url | default: '/products/lumaglow-4-in-1-facial-wand' }}" class="tag-btn">Shop $39.99 →</a>
          </div>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="luma-ugc-card">
        <div class="luma-ugc-media">
          <div class="luma-ugc-overlay">
            <span class="luma-ugc-handle">@sarahglows</span>
            <span class="luma-ugc-protocol">Day 21 Jawline Sculpt</span>
          </div>
          <div class="luma-ugc-badge-pill">★ Verified Creator</div>
          <div class="luma-ugc-simulated-image img-2">
            <div class="luma-glow-halo"></div>
            <span class="ugc-icon">▶</span>
          </div>
        </div>
        <div class="luma-ugc-details">
          <p class="luma-ugc-quote">“Replaced my $169 Solawave and haven't looked back. 3 minutes morning and night is all it takes.”</p>
          <div class="luma-ugc-product-tag">
            <span class="tag-title">Featured: 30-Day Glow System</span>
            <a href="{{ section.settings.product_url | default: '/products/lumaglow-4-in-1-facial-wand' }}" class="tag-btn">Shop $59.99 →</a>
          </div>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="luma-ugc-card">
        <div class="luma-ugc-media">
          <div class="luma-ugc-overlay">
            <span class="luma-ugc-handle">@migraine_relief_chronicles</span>
            <span class="luma-ugc-protocol">360° Compression</span>
          </div>
          <div class="luma-ugc-badge-pill">★ Verified Creator</div>
          <div class="luma-ugc-simulated-image img-3">
            <div class="luma-glow-halo"></div>
            <span class="ugc-icon">▶</span>
          </div>
        </div>
        <div class="luma-ugc-details">
          <p class="luma-ugc-quote">“The dual-cold cap blocks 100% of light and stays ice cold for 45+ minutes. An absolute lifesaver.”</p>
          <div class="luma-ugc-product-tag">
            <span class="tag-title">Featured: LumaRelief™ 360° Cap</span>
            <a href="{{ section.settings.cap_url | default: '/products/lumarelief-migraine-cap' }}" class="tag-btn">Shop $24.99 →</a>
          </div>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="luma-ugc-card">
        <div class="luma-ugc-media">
          <div class="luma-ugc-overlay">
            <span class="luma-ugc-handle">@aesthetician_claire</span>
            <span class="luma-ugc-protocol">Lymphatic Drainage</span>
          </div>
          <div class="luma-ugc-badge-pill">★ Verified Creator</div>
          <div class="luma-ugc-simulated-image img-4">
            <div class="luma-glow-halo"></div>
            <span class="ugc-icon">▶</span>
          </div>
        </div>
        <div class="luma-ugc-details">
          <p class="luma-ugc-quote">“The sonic pulse + 107°F thermal massage dramatically increases serum penetration. Unbeatable value.”</p>
          <div class="luma-ugc-product-tag">
            <span class="tag-title">Featured: LumaGlow™ QuadWave Pro</span>
            <a href="{{ section.settings.product_url | default: '/products/lumaglow-4-in-1-facial-wand' }}" class="tag-btn">Shop $39.99 →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="luma-ugc-footer-cta">
      <span>Join over 12,000+ ritual users across the USA</span>
      <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="luma-ugc-cta-btn">Explore All Clinical Protocols</a>
    </div>
  </div>
</section>

<style>
  .luma-ugc-section { background: #FFFFFF; padding: 75px 20px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .luma-ugc-container { max-width: 1140px; margin: 0 auto; }
  .luma-ugc-header { text-align: center; max-width: 680px; margin: 0 auto 40px; }
  .luma-ugc-pill { display: inline-block; background: #F0FDFA; color: #0D9488; border: 1px solid #99F6E4; padding: 5px 14px; border-radius: 30px; font-size: 11px; font-weight: 800; letter-spacing: 0.05em; margin-bottom: 12px; }
  .luma-ugc-title { font-size: clamp(26px, 3.5vw, 38px); font-weight: 900; color: #0F172A; margin: 0 0 12px; }
  .luma-ugc-subtitle { font-size: 15px; color: #64748B; line-height: 1.6; margin: 0; }
  
  .luma-ugc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .luma-ugc-card { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .luma-ugc-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px -10px rgba(15, 23, 42, 0.1); border-color: #CBD5E1; }
  
  .luma-ugc-media { position: relative; height: 260px; background: #0F172A; overflow: hidden; }
  .luma-ugc-simulated-image { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
  .img-1 { background: linear-gradient(135deg, #0F172A 0%, #134E4A 100%); }
  .img-2 { background: linear-gradient(135deg, #1E293B 0%, #0F766E 100%); }
  .img-3 { background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%); }
  .img-4 { background: linear-gradient(135deg, #1E293B 0%, #115E59 100%); }
  
  .luma-glow-halo { width: 120px; height: 120px; border-radius: 50%; background: radial-gradient(circle, rgba(13, 148, 136, 0.4) 0%, transparent 70%); }
  .ugc-icon { position: absolute; color: #FFFFFF; font-size: 24px; opacity: 0.8; width: 44px; height: 44px; background: rgba(255,255,255,0.15); backdrop-filter: blur(4px); border-radius: 50%; display: flex; align-items: center; justify-content: center; padding-left: 3px; }
  
  .luma-ugc-badge-pill { position: absolute; top: 12px; left: 12px; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(6px); color: #FFFFFF; font-size: 10px; font-weight: 700; padding: 4px 10px; border-radius: 20px; }
  .luma-ugc-overlay { position: absolute; bottom: 12px; left: 12px; right: 12px; display: flex; justify-content: space-between; align-items: flex-end; color: #FFFFFF; font-size: 11px; z-index: 2; }
  .luma-ugc-handle { font-weight: 800; background: rgba(0,0,0,0.5); padding: 3px 8px; border-radius: 12px; }
  .luma-ugc-protocol { font-size: 10px; color: #99F6E4; background: rgba(0,0,0,0.5); padding: 3px 8px; border-radius: 12px; }
  
  .luma-ugc-details { padding: 16px; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; }
  .luma-ugc-quote { font-size: 12.5px; color: #334155; line-height: 1.5; margin: 0 0 14px; font-style: italic; }
  .luma-ugc-product-tag { border-top: 1px solid #E2E8F0; padding-top: 12px; display: flex; flex-direction: column; gap: 6px; }
  .tag-title { font-size: 11px; font-weight: 700; color: #0F172A; }
  .tag-btn { display: inline-block; font-size: 11px; font-weight: 800; color: #0D9488; text-decoration: none; }
  .tag-btn:hover { color: #0F766E; }
  
  .luma-ugc-footer-cta { text-align: center; margin-top: 45px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .luma-ugc-footer-cta span { font-size: 13px; color: #64748B; font-weight: 600; }
  .luma-ugc-cta-btn { background: #0F172A; color: #FFFFFF; text-decoration: none; font-size: 13px; font-weight: 700; padding: 12px 28px; border-radius: 50px; transition: background 0.2s ease; }
  .luma-ugc-cta-btn:hover { background: #0D9488; }
  
  @media(max-width: 900px) {
    .luma-ugc-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media(max-width: 520px) {
    .luma-ugc-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Shoppable UGC Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical Routines. Real Results."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how dermatology enthusiasts and verified creators incorporate the QuadWave™ Protocol into their daily home rituals."
    },
    {
      "type": "url",
      "id": "product_url",
      "label": "Wand Product URL"
    },
    {
      "type": "url",
      "id": "cap_url",
      "label": "Cap Product URL"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Catalog Button URL"
    }
  ],
  "presets": [
    {
      "name": "Shoppable UGC Grid"
    }
  ]
}
{% endschema %}
