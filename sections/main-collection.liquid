{% comment %}
  Bizi Bees - Editorial Boutique Collection Template
  Repo: bizi-bees /sections/main-collection.liquid
  Design System: Kinfolk / Toast / Aesop inspired warm tactile lifestyle boutique.
{% endcomment %}

<div class="wrap boutique-collection-wrap">
  <!-- Minimal Header / Curation Banner -->
  <header class="collection-editorial-header">
    <div class="collection-header-meta">
      <span class="collection-eyebrow">Curated Collection · Hand-Inspected in Utah</span>
      <h1 class="collection-title-serif">{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="collection-desc-prose">{{ collection.description }}</div>
      {% else %}
        <p class="collection-desc-prose">
          A thoughtful, hand-picked selection of pre-loved items, vintage volumes, and everyday treasures. Cleaned, graded, and carefully packaged in Provo, Utah.
        </p>
      {% endif %}
    </div>

    <!-- Category Filter Navigation Pills -->
    <nav class="collection-quick-nav" aria-label="Department Links">
      <a href="/collections/all" class="quick-nav-pill{% if collection.handle == 'all' %} active{% endif %}">All Finds</a>
      <a href="/collections/books" class="quick-nav-pill{% if collection.handle == 'books' %} active{% endif %}">Books</a>
      <a href="/collections/games-puzzles" class="quick-nav-pill{% if collection.handle == 'games-puzzles' %} active{% endif %}">Games &amp; Puzzles</a>
      <a href="/collections/stationery" class="quick-nav-pill{% if collection.handle == 'stationery' %} active{% endif %}">Stationery</a>
      <a href="/collections/everyday-finds" class="quick-nav-pill{% if collection.handle == 'everyday-finds' %} active{% endif %}">Everyday Finds</a>
      <a href="/pages/condition-guide" class="quick-nav-pill secondary">Condition Guide</a>
    </nav>
  </header>

  <!-- Collection Stats & Filter Bar -->
  <div class="collection-toolbar">
    <div class="collection-count">
      <span>{{ collection.products_count }}</span> finds in this collection
    </div>
    {% render 'filters', results: collection %}
  </div>

  <!-- Product Grid -->
  {% paginate collection.products by 36 %}
    <div class="boutique-collection-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <div class="empty-collection-state">
          <p class="empty-title">No finds match your filter criteria.</p>
          <p class="empty-sub">Try resetting your filters or exploring our entire catalog.</p>
          <a href="/collections/all" class="boutique-btn-primary">Browse All Finds</a>
        </div>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div class="boutique-pagination">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  {% endpaginate %}
</div>

<style>
  .boutique-collection-wrap {
    padding-top: 36px;
    padding-bottom: 80px;
  }

  .collection-editorial-header {
    margin-bottom: 36px;
    border-bottom: 1px solid #E7E5E4;
    padding-bottom: 28px;
  }
  .collection-header-meta {
    max-width: 720px;
    margin-bottom: 24px;
  }
  .collection-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2D3B2D;
    margin-bottom: 8px;
  }
  .collection-title-serif {
    font-family: "Playfair Display", "Cormorant Garamond", Georgia, serif;
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 600;
    color: #1C1917;
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .collection-desc-prose {
    font-size: 15px;
    line-height: 1.6;
    color: #57534E;
    margin: 0;
  }

  /* Quick Nav Pills */
  .collection-quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .quick-nav-pill {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 999px;
    font-size: 13px;
    color: #44403C;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .quick-nav-pill:hover {
    border-color: #2D3B2D;
    color: #1C1917;
  }
  .quick-nav-pill.active {
    background: #2D3B2D;
    color: #FFFFFF;
    border-color: #2D3B2D;
    font-weight: 600;
  }
  .quick-nav-pill.secondary {
    border-style: dashed;
    color: #78716C;
  }

  /* Toolbar */
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .collection-count {
    font-size: 13px;
    color: #78716C;
  }
  .collection-count span {
    font-weight: 600;
    color: #1C1917;
  }

  /* Grid layout matching 4-column desktop */
  .boutique-collection-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .boutique-collection-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 768px) {
    .boutique-collection-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .boutique-collection-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty-collection-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 12px;
  }
  .empty-title {
    font-size: 18px;
    font-weight: 600;
    color: #1C1917;
    margin-bottom: 6px;
  }
  .empty-sub {
    font-size: 14px;
    color: #78716C;
    margin-bottom: 20px;
  }

  .boutique-pagination {
    display: flex;
    justify-content: center;
    margin-top: 48px;
    gap: 8px;
  }
  .boutique-pagination span,
  .boutique-pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid #E7E5E4;
    border-radius: 6px;
    font-size: 13px;
    text-decoration: none;
    color: #44403C;
  }
  .boutique-pagination .current {
    background: #2D3B2D;
    color: #FFFFFF;
    border-color: #2D3B2D;
    font-weight: 600;
  }
</style>

{% schema %}
{
  "name": "Main Collection",
  "settings": [],
  "presets": [
    {
      "name": "Main Collection"
    }
  ]
}
{% endschema %}
