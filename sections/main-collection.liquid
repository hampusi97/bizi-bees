<div class="wrap block"><p class="eyebrow">The good-find department</p><h1>{{ collection.title | escape }}</h1><div>{{ collection.description }}</div><p class="muted">{{ collection.products_count }} finds</p>{% render 'filters', results: collection %}{% paginate collection.products by 24 %}<div class="grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p class="empty">No finds match yet. Try clearing your filters or <a href="/collections/all">browse all finds</a>.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>
{% schema %}{"name": "Main Collection", "settings": [], "presets": [{"name": "Main Collection"}]}{% endschema %}
