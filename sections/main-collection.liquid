<div class="wrap block"><p class="eyebrow">The good-find department</p><h1>{{ collection.title | escape }}</h1><div>{{ collection.description }}</div>{% if collection.handle == 'christmas-gifts' %}<p class="notice">Code <a href="/discount/GIFT15?redirect=%2Fcollections%2Fchristmas-gifts">GIFT15</a> takes 15% off this collection through Sunday, November 1. It does not stack with FIRST15. Shipping and taxes are extra.</p>{% endif %}<p class="muted">{{ collection.products_count }} finds</p>{% render 'filters', results: collection %}{% paginate collection.products by 48 %}<div class="grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p class="empty">No finds match yet. Try clearing your filters or <a href="/collections/all">browse all finds</a>.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>
{% schema %}{"name": "Main Collection", "settings": [], "presets": [{"name": "Main Collection"}]}{% endschema %}
