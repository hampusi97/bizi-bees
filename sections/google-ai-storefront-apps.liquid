          type="text" 
          id="gaiaInput" 
          placeholder="Ask Bizi Bees™ AI anything about genres, gift crates, or rituals..."
          autocomplete="off"
          required
        />
        <button type="submit" id="gaiaSendBtn" class="gaia-send-btn">
