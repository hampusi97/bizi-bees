<section class="aura-hero-section" id="aura-posture-hero">
  <style>
    .aura-hero-section { background: #FFFFFF; color: #0F172A; font-family: -apple-system, sans-serif; padding: 40px 20px; max-width: 1200px; margin: 0 auto; }
    .sticky-banner { background: #10B981; color: white; padding: 8px; text-align: center; font-size: 12px; font-weight: 700; position: sticky; top: 0; z-index: 100; border-radius: 4px; margin-bottom: 20px; }
    .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
    @media (max-width: 768px) { .hero-grid { grid-template-columns: 1fr; } }
    .headline { font-size: 3rem; line-height: 1.1; margin-bottom: 16px; font-weight: 800; }
    .rating { color: #10B981; font-weight: 600; margin-bottom: 20px; }
    .tier-container { display: flex; flex-direction: column; gap: 12px; margin: 24px 0; }
    .tier-card { border: 2px solid #E2E8F0; padding: 16px; border-radius: 12px; cursor: pointer; transition: 0.3s; display: flex; justify-content: space-between; align-items: center; }
    .tier-card.active { border-color: #10B981; background: #F0FDF4; }
    .gift-badge { background: #10B981; color: white; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; }
    .cta-btn { background: #0F172A; color: white; width: 100%; padding: 18px; border-radius: 8px; font-weight: 700; font-size: 1.1rem; border: none; cursor: pointer; transition: background 0.2s; }
    .cta-btn:hover { background: #1E293B; }
    .guarantee-strip { display: flex; justify-content: space-between; margin-top: 30px; font-size: 0.85rem; color: #64748B; }
  </style>

  <div class="sticky-banner">⚡️ FAST DISPATCH FROM UTAH — ORDER NOW FOR FREE US DELIVERY</div>

  <div class="hero-grid">
    <div class="hero-content">
      <div class="rating">★★★★★ 15,000+ Happy Customers</div>
      <h1 class="headline">Correct Your Spine <br>With Smart Haptics.</h1>
      <p style="font-size: 1.2rem; color: #475569; margin-bottom: 24px;">The Aura Posture™ Sensor gently vibrates when you slouch, training your muscles for permanent alignment.</p>
      
      <div class="tier-container" id="tier-selector">
        <div class="tier-card active" data-price="38.00" onclick="selectTier(this)">
          <div><strong>Solo Sensor</strong><br><small>$38.00</small></div>
        </div>
        <div class="tier-card" data-price="54.00" onclick="selectTier(this)">
          <div><strong>VIP Bundle</strong> <span class="gift-badge">BEST VALUE</span><br><small>$54.00</small></div>
          <div style="font-size: 0.8rem;">+ FREE Gel Wrist Rest ($18)</div>
        </div>
      </div>

      <button class="cta-btn" onclick="window.location.href='/collections/all'">Add to Cart - $<span id="price-display">38.00</span></button>
      
      <div class="guarantee-strip">
        <span>✓ Utah Dispatch</span>
        <span>✓ 60-Day Trial</span>
        <span>✓ Free US Delivery</span>
      </div>
    </div>
    <div class="hero-visual" style="background: #F8FAFC; height: 400px; border-radius: 20px; display: flex; align-items: center; justify-content: center;">
      [Aura Posture™ Product Imagery]
    </div>
  </div>

  <script>
    function selectTier(el) {
      document.querySelectorAll('.tier-card').forEach(c => c.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('price-display').innerText = el.getAttribute('data-price');
    }
  </script>
</section>

{% schema %}
{
  "name": "Aura Hero Section",
  "settings": [],
  "presets": [
    {
      "name": "Aura Posture Hero",
      "category": "Conversion"
    }
  ]
}
{% endschema %}