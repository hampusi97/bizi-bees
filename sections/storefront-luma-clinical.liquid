<section class="luma-hero-section" id="luma-clinical-hero">
  <style>
    .luma-hero-section { font-family: -apple-system, Inter, sans-serif; color: #0F172A; background: #FFFFFF; padding: 40px 20px; overflow: hidden; }
    .luma-container { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
    .luma-badge { background: #0D9488; color: #fff; padding: 4px 12px; border-radius: 50px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
    .luma-headline { font-size: 48px; line-height: 1.1; margin: 20px 0; letter-spacing: -1px; }
    .luma-rating { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; font-weight: 600; }
    
    .luma-selector-card { border: 2px solid #E2E8F0; border-radius: 16px; padding: 20px; margin-bottom: 15px; cursor: pointer; transition: 0.3s; position: relative; }
    .luma-selector-card.active { border-color: #0D9488; background: #F0FDFA; }
    .luma-gift-tag { display: none; background: #0D9488; color: white; padding: 4px 8px; font-size: 10px; border-radius: 4px; position: absolute; right: 20px; }
    .luma-selector-card.active .luma-gift-tag { display: block; }
    
    .luma-btn { display: block; width: 100%; background: #0D9488; color: white; padding: 18px; border: none; border-radius: 8px; font-weight: 700; font-size: 18px; cursor: pointer; text-align: center; text-decoration: none; }
    .luma-guarantee { display: flex; justify-content: space-between; margin-top: 30px; font-size: 12px; font-weight: 600; }
    
    @media (max-width: 768px) { .luma-container { grid-template-columns: 1fr; } .luma-headline { font-size: 32px; } }
  </style>

  <div class="luma-container">
    <div class="luma-content">
      <span class="luma-badge">#1 Clinical Derm-Tech 2024</span>
      <h1 class="luma-headline">LumaGlow™ QuadWave Pro 4-in-1 Wand</h1>
      <div class="luma-rating">★★★★★ 4.9/5 (12.4k Reviews)</div>
      <p>Experience professional-grade skin rejuvenation at home. Clinical results, 4 therapies, 1 device.</p>

      <div id="luma-solo" class="luma-selector-card active" onclick="selectTier('solo')">
        <strong>LumaGlow™ Solo</strong> - $39.99
      </div>
      
      <div id="luma-vip" class="luma-selector-card" onclick="selectTier('vip')">
        <span class="luma-gift-tag">FREE GIFT UNLOCKED</span>
        <strong>VIP Bundle</strong> - $59.99 
        <div style="font-size: 13px; color: #64748B;">Includes: Full-Size Activating Peptide Serum ($24 Value)</div>
      </div>

      <a href="/collections/all" class="luma-btn" id="luma-cta">Add to Cart - $39.99</a>
      
      <div class="luma-guarantee">
        <span>✓ Utah Dispatch</span>
        <span>✓ 60-Day Trial</span>
        <span>✓ Free US Delivery</span>
      </div>
    </div>
    <div class="luma-visual">
      <div style="background: #F8FAFC; height: 400px; border-radius: 20px; display: flex; align-items: center; justify-content: center; color: #94A3B8;">[LumaGlow Product Image]</div>
    </div>
  </div>
</section>

<script>
  function selectTier(tier) {
    const solo = document.getElementById('luma-solo');
    const vip = document.getElementById('luma-vip');
    const cta = document.getElementById('luma-cta');
    
    if(tier === 'solo') {
      solo.classList.add('active');
      vip.classList.remove('active');
      cta.innerText = "Add to Cart - $39.99";
    } else {
      vip.classList.add('active');
      solo.classList.remove('active');
      cta.innerText = "Add Bundle to Cart - $59.99";
    }
  }
</script>

{% schema %}
{
  "name": "Luma Clinical Hero",
  "settings": [],
  "presets": [
    {
      "name": "Luma Hero Section",
      "category": "Conversion"
    }
  ]
}
{% endschema %}