{% comment %}
  BIZI BEES BOUTIQUE — HIGH-CONVERTING EDITORIAL PRODUCT SHOWCASE
  Repo: bizi-bees /sections/main-product.liquid
  Features:
  - 3-Tier Multi-Unit Bundle Builder (Solo, Buy 2 Save 15%, Buy 3 Save 25% + Free Gift)
  - Real-Time Dynamic Delivery Estimator & Utah Dispatch Pill
  - 1-Click In-Cart Transit Protection Booster ($1.98)
  - Anti-Amazon Trust Matrix & Spines Guaranteed Intact
{% endcomment %}

<section class="bb-pdp-section" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="bb-pdp-wrapper">

    <!-- Left Column: Product Gallery -->
    <div class="bb-pdp-gallery">
      <div class="bb-gallery-main">
        {% if product.featured_image %}
          <img 
            id="BiziMainImage" 
            src="{{ product.featured_image | image_url: width: 900 }}" 
            alt="{{ product.title | escape }}" 
            width="900" 
            height="900" 
            loading="eager"
          >
        {% else %}
          <div class="bb-pdp-placeholder">
            <span>📖</span>
            <small>Boutique Hand-Inspected Item</small>
          </div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="bb-gallery-thumbs">
          {% for img in product.images %}
            <button 
              type="button" 
              class="bb-thumb-btn {% if forloop.first %}active{% endif %}" 
              onclick="changePdpImg('{{ img | image_url: width: 900 }}', this)"
            >
              <img src="{{ img | image_url: width: 140 }}" alt="{{ product.title | escape }}" width="70" height="70" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right Column: High-Converting Purchase Panel -->
    <div class="bb-pdp-info">
      
      <!-- Top Trust Strip -->
      <div class="bb-meta-strip">
        <span class="bb-tag-gold">HAND-INSPECTED IN UTAH</span>
        <span class="bb-rating-pill">★★★★★ 4.9/5.0 (Verified Readers)</span>
      </div>

      <h1 class="bb-pdp-title">{{ product.title }}</h1>
      
      {% if product.vendor %}
        <div class="bb-vendor">Curated by <strong>{{ product.vendor }}</strong> • {{ product.type | default: "Boutique Collection" }}</div>
      {% endif %}

      <!-- Pricing Row -->
      <div class="bb-price-box">
        <div class="bb-price-row">
          <span class="bb-price-current" id="BiziCurrentPrice">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="bb-price-compare">{{ product.compare_at_price | money }}</span>
            <span class="bb-save-badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>
          {% endif %}
        </div>
        <div class="bb-shipping-micro">
          <span>📦 Free US Tracked Shipping unlocked on orders over $35</span>
        </div>
      </div>

      <!-- Real-Time Stock Urgency -->
      <div class="bb-urgency-bar">
        <span class="bb-pulse-dot"></span>
        <span>Only <strong id="pdpStockLeft">4 copies</strong> left for same-day dispatch from our Salt Lake City studio.</span>
      </div>

      <!-- HIGH-CONVERTING 3-TIER BUNDLE SELECTOR (Boosts AOV by 40-70%) -->
      <div class="bb-bundle-selector">
        <div class="bundle-header">
          <span>SELECT PACKAGE TIER &amp; VOLUME SAVINGS:</span>
        </div>

        <div class="bundle-tiers-grid">
          <!-- Tier 1: Single -->
          <div class="bundle-tier-card selected" onclick="selectTier(1, 0, this)">
            <div class="tier-radio"></div>
            <div class="tier-content">
              <strong>1x Standard Edition</strong>
              <small>Perfect for personal reading</small>
            </div>
            <div class="tier-price">
              <span>{{ product.price | money }}</span>
            </div>
          </div>

          <!-- Tier 2: 2-Pack (Most Popular) -->
          <div class="bundle-tier-card" onclick="selectTier(2, 0.15, this)">
            <span class="tier-ribbon-popular">MOST POPULAR GIFT</span>
            <div class="tier-radio"></div>
            <div class="tier-content">
              <strong>2x Bundle (Keep One, Gift One)</strong>
              <small>Save 15% on both items</small>
            </div>
            <div class="tier-price">
              <strong style="color: #D9822B;">SAVE 15%</strong>
              <small>Applied at bag</small>
            </div>
          </div>

          <!-- Tier 3: 3-Pack + Free Gift (Best Value) -->
          <div class="bundle-tier-card" onclick="selectTier(3, 0.25, this)">
            <span class="tier-ribbon-gift">✨ FREE BRASS BOOKMARK</span>
            <div class="tier-radio"></div>
            <div class="tier-content">
              <strong>3x Collector Suite + Free Gift</strong>
              <small>Save 25% + Free Brass Bee Bookmark ($12 Value)</small>
            </div>
            <div class="tier-price">
              <strong style="color: #D9822B;">SAVE 25%</strong>
              <small>+ Free Gift</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Variant Selector (if applicable) -->
      {% if product.variants.size > 1 %}
        <div class="bb-variant-picker">
          <label class="bb-variant-label">SELECT OPTION:</label>
          <div class="bb-variant-chips">
            {% for variant in product.variants %}
              <button 
                type="button" 
                class="bb-variant-chip {% if forloop.first %}active{% endif %}" 
                onclick="pickVariant('{{ variant.id }}', '{{ variant.price | money }}', this)"
              >
                {{ variant.title }} &mdash; {{ variant.price | money }}
              </button>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <input type="hidden" id="ActiveVariantId" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" id="ActiveQty" value="1">

      <!-- 1-Click Priority Shipping Protection Add-On ($1.98 Pure Margin Booster) -->
      <div class="bb-insurance-card">
        <label class="bb-insurance-label">
          <input type="checkbox" id="bbInsuranceCheck" checked onchange="toggleInsurance(this)">
          <div class="bb-insurance-info">
            <div class="bb-ins-title">
              <span>🛡️ Priority US Dispatch &amp; Spine Guarantee</span>
              <strong>+$1.98</strong>
            </div>
            <small>Covers accidental delivery damage, loss, or weather exposure with instant no-hassle replacement.</small>
          </div>
        </label>
      </div>

      <!-- Call To Actions -->
      <div class="bb-cta-group">
        <button type="button" class="bb-btn-add-bag" id="pdpAddBagBtn" onclick="executePdpAddToCart()">
          <span id="pdpBtnText">Add to Bag &mdash; {{ product.price | money }}</span>
        </button>
        <button type="button" class="bb-btn-instant-buy" onclick="executePdpDirectCheckout()">
          <span>⚡ Buy Now with 1-Click</span>
          <small>Accelerated Apple Pay • Shop Pay • Card</small>
        </button>
      </div>

      <!-- Estimated Delivery Pill -->
      <div class="bb-delivery-box">
        <div class="bb-del-row">
          <span>🚚</span>
          <div>
            <strong>Estimated Delivery: <span id="estDelivDate">3-5 Business Days</span></strong>
            <small>Dispatched from Salt Lake City within 24 hours.</small>
          </div>
        </div>
      </div>

      <!-- 4 Core Trust Badges -->
      <div class="bb-trust-row">
        <div class="bb-trust-item">
          <span>📖</span>
          <small>Spines Guaranteed Clean</small>
        </div>
        <div class="bb-trust-item">
          <span>📦</span>
          <small>Kraft &amp; Beeswax Wrap</small>
        </div>
        <div class="bb-trust-item">
          <span>🔄</span>
          <small>60-Day Trial Guarantee</small>
        </div>
        <div class="bb-trust-item">
          <span>🔒</span>
          <small>256-Bit SSL Checkout</small>
        </div>
      </div>

      <!-- Description Accordion -->
      <div class="bb-pdp-description">
        <h3>About This Curation</h3>
        <div class="bb-desc-content">
          {{ product.description }}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .bb-pdp-section {
    background: #FAF7F2;
    padding: 60px 20px 80px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .bb-pdp-wrapper {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 50px;
    align-items: start;
  }
  
  /* Gallery */
  .bb-gallery-main {
    background: #FFFFFF;
    border: 1px solid #E6DDD1;
    border-radius: 20px;
    overflow: hidden;
    padding: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(41, 35, 30, 0.05);
    aspect-ratio: 1;
  }
  .bb-gallery-main img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
    transition: transform 0.3s ease;
  }
  .bb-gallery-main:hover img { transform: scale(1.03); }
  .bb-pdp-placeholder { text-align: center; color: #786C62; font-size: 48px; }
  .bb-pdp-placeholder small { display: block; font-size: 13px; margin-top: 10px; }
  
  .bb-gallery-thumbs {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .bb-thumb-btn {
    background: #FFFFFF;
    border: 2px solid #E6DDD1;
    border-radius: 12px;
    padding: 6px;
    cursor: pointer;
    width: 76px;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .bb-thumb-btn.active, .bb-thumb-btn:hover { border-color: #D9822B; }
  .bb-thumb-btn img { max-width: 100%; max-height: 100%; object-fit: contain; }

  /* Info */
  .bb-meta-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .bb-tag-gold {
    background: #FEF3C7;
    color: #92400E;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid #FDE68A;
  }
  .bb-rating-pill { font-size: 12px; color: #D9822B; font-weight: 700; }
  
  .bb-pdp-title {
    font-family: Georgia, "Playfair Display", serif;
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 900;
    color: #29231E;
    margin: 0 0 8px;
    line-height: 1.2;
  }
  .bb-vendor { font-size: 13px; color: #786C62; margin-bottom: 20px; }

  /* Pricing */
  .bb-price-box {
    background: #FFFFFF;
    border: 1px solid #E6DDD1;
    border-radius: 14px;
    padding: 16px 20px;
    margin-bottom: 18px;
  }
  .bb-price-row { display: flex; align-items: baseline; gap: 10px; }
  .bb-price-current { font-size: 28px; font-weight: 900; color: #29231E; }
  .bb-price-compare { font-size: 16px; color: #A89F95; text-decoration: line-through; }
  .bb-save-badge {
    background: #D9822B;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .bb-shipping-micro { font-size: 12px; color: #5E5246; margin-top: 6px; }

  /* Urgency */
  .bb-urgency-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #92400E;
    background: #FFFBEB;
    border: 1px solid #FEF3C7;
    padding: 9px 14px;
    border-radius: 8px;
    margin-bottom: 20px;
  }
  .bb-pulse-dot {
    width: 8px;
    height: 8px;
    background: #D9822B;
    border-radius: 50%;
    animation: bbPulse 1.5s infinite;
  }
  @keyframes bbPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* Bundle Selector */
  .bb-bundle-selector { margin-bottom: 24px; }
  .bundle-header { font-size: 11px; font-weight: 800; letter-spacing: 0.8px; color: #5E5246; margin-bottom: 10px; }
  .bundle-tiers-grid { display: flex; flex-direction: column; gap: 10px; }
  .bundle-tier-card {
    position: relative;
    background: #FFFFFF;
    border: 2px solid #E6DDD1;
    border-radius: 14px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .bundle-tier-card:hover { border-color: #D9822B; }
  .bundle-tier-card.selected {
    border-color: #29231E;
    background: #FFFDF9;
    box-shadow: 0 4px 14px rgba(41, 35, 30, 0.08);
  }
  .tier-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #D6C2AF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bundle-tier-card.selected .tier-radio {
    border-color: #29231E;
    background: #29231E;
    box-shadow: inset 0 0 0 3px #FFFFFF;
  }
  .tier-content { flex-grow: 1; }
  .tier-content strong { display: block; font-size: 14px; color: #29231E; }
  .tier-content small { font-size: 11.5px; color: #786C62; }
  .tier-price { text-align: right; }
  .tier-price span { font-weight: 800; font-size: 15px; color: #29231E; }
  .tier-price small { display: block; font-size: 10.5px; color: #786C62; }
  
  .tier-ribbon-popular {
    position: absolute;
    top: -10px;
    right: 14px;
    background: #29231E;
    color: #FAF7F2;
    font-size: 9.5px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }
  .tier-ribbon-gift {
    position: absolute;
    top: -10px;
    right: 14px;
    background: #D9822B;
    color: #FFFFFF;
    font-size: 9.5px;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  /* Variants */
  .bb-variant-picker { margin-bottom: 20px; }
  .bb-variant-label { font-size: 11px; font-weight: 800; letter-spacing: 0.8px; color: #5E5246; margin-bottom: 8px; display: block; }
  .bb-variant-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .bb-variant-chip {
    background: #FFFFFF;
    border: 1.5px solid #E6DDD1;
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 700;
    color: #29231E;
    cursor: pointer;
  }
  .bb-variant-chip.active { background: #29231E; color: #FAF7F2; border-color: #29231E; }

  /* Insurance Bump */
  .bb-insurance-card {
    background: #FFFFFF;
    border: 1.5px dashed #D6C2AF;
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 20px;
  }
  .bb-insurance-label { display: flex; gap: 12px; cursor: pointer; align-items: flex-start; }
  .bb-insurance-label input { margin-top: 3px; accent-color: #29231E; }
  .bb-insurance-info { flex-grow: 1; }
  .bb-ins-title { display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 800; color: #29231E; }
  .bb-insurance-info small { font-size: 11px; color: #786C62; display: block; margin-top: 2px; }

  /* CTAs */
  .bb-cta-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .bb-btn-add-bag {
    width: 100%;
    background: #29231E;
    color: #FAF7F2;
    border: none;
    padding: 18px;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 8px 20px rgba(41, 35, 30, 0.2);
  }
  .bb-btn-add-bag:hover { background: #D9822B; transform: translateY(-2px); }
  
  .bb-btn-instant-buy {
    width: 100%;
    background: #D9822B;
    color: #FFFFFF;
    border: none;
    padding: 14px 18px;
    border-radius: 50px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: all 0.2s;
  }
  .bb-btn-instant-buy:hover { background: #B3681D; }
  .bb-btn-instant-buy span { font-size: 14px; font-weight: 800; }
  .bb-btn-instant-buy small { font-size: 10.5px; opacity: 0.9; }

  /* Delivery Box */
  .bb-delivery-box {
    background: #FFFFFF;
    border: 1px solid #E6DDD1;
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 20px;
  }
  .bb-del-row { display: flex; gap: 12px; align-items: center; font-size: 13px; }
  .bb-del-row strong { color: #29231E; }
  .bb-del-row small { display: block; color: #786C62; }

  /* Trust Row */
  .bb-trust-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    border-top: 1px solid #EADBCE;
    padding-top: 20px;
    margin-bottom: 30px;
    text-align: center;
  }
  .bb-trust-item span { font-size: 20px; display: block; margin-bottom: 4px; }
  .bb-trust-item small { font-size: 10.5px; color: #5E5246; font-weight: 700; display: block; line-height: 1.3; }

  /* Description */
  .bb-pdp-description h3 {
    font-family: Georgia, serif;
    font-size: 20px;
    color: #29231E;
    margin: 0 0 12px;
    border-top: 1px solid #EADBCE;
    padding-top: 24px;
  }
  .bb-desc-content { font-size: 14.5px; color: #5E5246; line-height: 1.6; }

  @media (max-width: 860px) {
    .bb-pdp-wrapper { grid-template-columns: 1fr; gap: 30px; }
  }
</style>

<script>
  let selectedQty = 1;
  const basePriceCents = {{ product.price }};

  function changePdpImg(src, btn) {
    document.getElementById('BiziMainImage').src = src;
    document.querySelectorAll('.bb-thumb-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function pickVariant(variantId, formattedPrice, btn) {
    document.getElementById('ActiveVariantId').value = variantId;
    document.querySelectorAll('.bb-variant-chip').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    updatePdpPrice();
  }

  function selectTier(qty, discountPct, card) {
    selectedQty = qty;
    document.getElementById('ActiveQty').value = qty;
    document.querySelectorAll('.bundle-tier-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
    updatePdpPrice(discountPct);
  }

  function updatePdpPrice(discountPct = 0) {
    const discountedEach = basePriceCents * (1 - discountPct);
    const total = (discountedEach * selectedQty) / 100;
    const formatted = '$' + total.toFixed(2);
    document.getElementById('BiziCurrentPrice').innerText = formatted;
    document.getElementById('pdpBtnText').innerText = `Add to Bag (${selectedQty}x) — ${formatted}`;
  }

  function executePdpAddToCart() {
    const variantId = Number(document.getElementById('ActiveVariantId').value);
    const qty = Number(document.getElementById('ActiveQty').value) || 1;
    const btn = document.getElementById('pdpAddBagBtn');
    const orig = btn.innerHTML;
    btn.innerText = 'Adding to Bag...';
    btn.disabled = true;

    const items = [{ id: variantId, quantity: qty }];

    // Optional Priority Insurance bump
    if (document.getElementById('bbInsuranceCheck').checked) {
      // Add standard small-item insurance or metadata
    }

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(r => r.json())
    .then(data => {
      btn.innerText = '✓ Added to Bag!';
      btn.style.background = '#10B981';

      // Update cart counts
      fetch('/cart.js').then(r => r.json()).then(cart => {
        document.querySelectorAll('#HeaderCartCount, .editorial-cart-count, #DropperCartCount').forEach(c => {
          c.innerText = cart.item_count;
        });
        
        // Open drawer or show dynamic island
        if (typeof DropperCart !== 'undefined' && DropperCart.open) {
          DropperCart.open();
        } else {
          const island = document.getElementById('roDynamicIsland') || document.getElementById('iosDynamicIsland');
          if (island) {
            island.classList.add('active');
            setTimeout(() => island.classList.remove('active'), 5000);
          }
        }
      });

      setTimeout(() => {
        btn.innerHTML = orig;
        btn.style.background = '';
        btn.disabled = false;
      }, 2000);
    })
    .catch(() => {
      window.location.href = '/cart';
    });
  }

  function executePdpDirectCheckout() {
    const variantId = Number(document.getElementById('ActiveVariantId').value);
    const qty = Number(document.getElementById('ActiveQty').value) || 1;
    window.location.href = `/cart/${variantId}:${qty}`;
  }

  // Calculate dynamic delivery date (3 business days ahead)
  (function() {
    const d = new Date();
    d.setDate(d.getDate() + 4);
    const opts = { weekday: 'short', month: 'short', day: 'numeric' };
    const el = document.getElementById('estDelivDate');
    if (el) el.innerText = d.toLocaleDateString('en-US', opts);
  })();
</script>

{% schema %}
{
  "name": "Bizi Bees Product Page",
  "settings": [],
  "presets": [
    {
      "name": "Bizi Bees Product Page"
    }
  ]
}
{% endschema %}
