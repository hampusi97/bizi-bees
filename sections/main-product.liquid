{% comment %}
  Luma Clinical - High-Converting DTC Flagship Product Showcase
  File: sections/main-product.liquid
{% endcomment %}

<section class="luma-product-page" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-product-wrap">
    
    <!-- Left: Clinical Gallery -->
    <div class="luma-product-gallery">
      <div class="luma-gallery-main">
        {% if product.featured_image %}
          <img id="LumaMainImage" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900" loading="eager">
        {% else %}
          <div class="luma-placeholder-img">
            <span class="luma-prism-icon">✦</span>
            <span>Clinical Tech Imaging</span>
          </div>
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="luma-gallery-thumbs">
          {% for img in product.images %}
            <button type="button" class="thumb-btn {% if forloop.first %}active{% endif %}" onclick="changeLumaImg('{{ img | image_url: width: 900 }}', this)">
              <img src="{{ img | image_url: width: 140 }}" alt="{{ product.title | escape }}" width="70" height="70" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Right: Clinical Purchase Panel -->
    <div class="luma-product-info">
      
      <!-- Top Clinical Badges -->
      <div class="luma-product-meta-pills">
        <span class="luma-pill-teal">PROPRIETARY QUADWAVE™ PROTOCOL</span>
        <span class="luma-pill-gold">★ 4.9/5.0 (184 Verified Reviews)</span>
      </div>

      <h1 class="luma-product-title">{{ product.title | default: "LumaGlow™ QuadWave Pro 4-in-1 Facial Wand" }}</h1>
      <p class="luma-product-tagline">Dermatology-Grade 630nm Phototherapy, 330µA Galvanic Wave, 107°F Thermal Massage & Sonic Drainage.</p>

      <!-- Pricing Box -->
      <div class="luma-price-container">
        <div class="price-row">
          <span class="luma-current-price" id="LumaPrice">{{ product.price | default: 3999 | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="luma-compare-price">{{ product.compare_at_price | money }}</span>
            <span class="luma-save-tag">SAVE 50%</span>
          {% else %}
            <span class="luma-compare-price">$79.99</span>
            <span class="luma-save-tag">LAB PRICING</span>
          {% endif %}
        </div>
        <!-- Shop Pay Installments -->
        <div class="luma-installments-text">
          <span class="shop-pay-badge">Shop Pay</span> Pay in 4 interest-free installments of <strong>$9.99</strong>
        </div>
      </div>

      <!-- Variant Selector -->
      {% if product.variants.size > 1 %}
        <div class="luma-variant-selector">
          <label class="variant-label">SELECT PROTOCOL TIER:</label>
          <div class="variant-options-grid">
            {% for variant in product.variants %}
              <div class="variant-option-card {% if forloop.first %}selected{% endif %}" onclick="selectLumaVariant('{{ variant.id }}', '{{ variant.price | money }}', this)">
                <div class="opt-radio"></div>
                <div class="opt-details">
                  <strong>{{ variant.title }}</strong>
                  <span>{{ variant.price | money }}</span>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <input type="hidden" id="SelectedVariantId" value="{{ product.selected_or_first_available_variant.id }}">

      <!-- Pure Profit Cart Protection Micro-Insurance ($1.98 Add-On) -->
      {% render 'cart-insurance-booster' %}

      <!-- 1-Click Buy Now Button (Direct Checkout Bypass) -->
      <div class="luma-cta-actions">
        <button type="button" class="luma-instant-checkout-btn" onclick="executeLumaOneTapCheckout()">
          <span class="btn-primary-text">CLAIM PROTOCOL &mdash; 1-TAP CHECKOUT</span>
          <span class="btn-subtext">Accelerated Apple Pay / Shop Pay / Google Pay / Card</span>
        </button>
      </div>

      <!-- Anti-Amazon Direct Purchase Advantage Matrix -->
      {% render 'anti-amazon-badges' %}

      <!-- Real-Time Dynamic Delivery Estimator -->
      {% render 'delivery-estimator' %}

      <!-- Trust Bar & HSA/FSA Eligibility -->
      <div class="luma-trust-checklist">
        <div class="trust-check-item">
          <span class="check-icon">✓</span>
          <span><strong>HSA / FSA Eligible:</strong> Qualifies for health savings account reimbursement.</span>
        </div>
        <div class="trust-check-item">
          <span class="check-icon">✓</span>
          <span><strong>60-Day Trial Guarantee:</strong> 100% money-back if not fully satisfied.</span>
        </div>
        <div class="trust-check-item">
          <span class="check-icon">✓</span>
          <span><strong>USPS Tracked Dispatch:</strong> Ships in 24h directly from our Utah logistics hub.</span>
        </div>
      </div>

      <!-- Universal Policies Tabs -->
      {% render 'universal-policies' %}

    </div>
  </div>
</section>

<style>
  .luma-product-page { background: #FFFFFF; padding: 50px 20px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #0F172A; }
  .luma-product-wrap { max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  
  .luma-product-gallery { display: flex; flex-direction: column; gap: 14px; }
  .luma-gallery-main { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 20px; overflow: hidden; display: flex; align-items: center; justify-content: center; min-height: 440px; }
  .luma-gallery-main img { width: 100%; height: auto; object-fit: contain; }
  .luma-placeholder-img { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #94A3B8; font-size: 14px; font-weight: 700; gap: 8px; }
  .luma-prism-icon { font-size: 32px; color: #0D9488; }
  
  .luma-gallery-thumbs { display: flex; gap: 10px; }
  .thumb-btn { background: #F8FAFC; border: 1.5px solid #E2E8F0; border-radius: 10px; padding: 4px; cursor: pointer; transition: border-color 0.2s ease; }
  .thumb-btn.active, .thumb-btn:hover { border-color: #0D9488; }
  .thumb-btn img { border-radius: 6px; display: block; }
  
  .luma-product-info { display: flex; flex-direction: column; }
  .luma-product-meta-pills { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .luma-pill-teal { background: #F0FDFA; color: #0F766E; border: 1px solid #99F6E4; padding: 4px 12px; border-radius: 30px; font-size: 11px; font-weight: 800; }
  .luma-pill-gold { background: #FEFCE8; color: #854D0E; border: 1px solid #FEF08A; padding: 4px 12px; border-radius: 30px; font-size: 11px; font-weight: 800; }
  
  .luma-product-title { font-size: clamp(28px, 3.2vw, 36px); font-weight: 900; margin: 0 0 8px; line-height: 1.15; }
  .luma-product-tagline { font-size: 14.5px; color: #64748B; margin: 0 0 20px; line-height: 1.5; }
  
  .luma-price-container { background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px; padding: 16px 20px; margin-bottom: 22px; }
  .price-row { display: flex; align-items: baseline; gap: 12px; }
  .luma-current-price { font-size: 32px; font-weight: 900; color: #0F172A; }
  .luma-compare-price { font-size: 17px; color: #94A3B8; text-decoration: line-through; }
  .luma-save-tag { background: #0F172A; color: #FFFFFF; font-size: 10px; font-weight: 800; padding: 4px 8px; border-radius: 6px; letter-spacing: 0.05em; }
  .luma-installments-text { margin-top: 8px; font-size: 12px; color: #475569; display: flex; align-items: center; gap: 6px; }
  .shop-pay-badge { background: #5A31F4; color: #FFFFFF; font-weight: 900; font-size: 10px; padding: 2px 6px; border-radius: 4px; }
  
  .luma-variant-selector { margin-bottom: 22px; }
  .variant-label { font-size: 11px; font-weight: 800; letter-spacing: 0.06em; color: #64748B; margin-bottom: 8px; display: block; }
  .variant-options-grid { display: flex; flex-direction: column; gap: 8px; }
  .variant-option-card { background: #FFFFFF; border: 1.5px solid #E2E8F0; border-radius: 12px; padding: 12px 16px; display: flex; align-items: center; gap: 12px; cursor: pointer; transition: all 0.2s ease; }
  .variant-option-card.selected { border-color: #0D9488; background: #F0FDFA; }
  .opt-radio { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #CBD5E1; }
  .variant-option-card.selected .opt-radio { border-color: #0D9488; background: #0D9488; }
  .opt-details { display: flex; justify-content: space-between; width: 100%; font-size: 13.5px; }
  .opt-details strong { color: #0F172A; }
  .opt-details span { color: #0D9488; font-weight: 800; }
  
  .luma-cta-actions { margin-bottom: 18px; }
  .luma-instant-checkout-btn { width: 100%; background: #0F172A; color: #FFFFFF; border: none; padding: 16px 24px; border-radius: 50px; cursor: pointer; display: flex; flex-direction: column; align-items: center; transition: all 0.2s ease; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.2); }
  .luma-instant-checkout-btn:hover { background: #0D9488; transform: translateY(-2px); box-shadow: 0 10px 28px rgba(13, 148, 136, 0.3); }
  .btn-primary-text { font-size: 15px; font-weight: 800; letter-spacing: 0.03em; }
  .btn-subtext { font-size: 11px; opacity: 0.85; margin-top: 2px; }
  
  .luma-trust-checklist { border-top: 1px solid #E2E8F0; padding-top: 18px; margin: 18px 0; display: flex; flex-direction: column; gap: 10px; }
  .trust-check-item { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; color: #334155; line-height: 1.4; }
  .check-icon { color: #0D9488; font-weight: 900; }

  @media(max-width: 820px) {
    .luma-product-wrap { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

<script>
  function changeLumaImg(src, btn) {
    document.getElementById('LumaMainImage').src = src;
    document.querySelectorAll('.thumb-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }

  function selectLumaVariant(id, price, card) {
    document.getElementById('SelectedVariantId').value = id;
    document.getElementById('LumaPrice').innerText = price;
    document.querySelectorAll('.variant-option-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');
  }

  function executeLumaOneTapCheckout() {
    const variantId = document.getElementById('SelectedVariantId').value;
    if (variantId) {
      window.location.href = '/cart/' + variantId + ':1';
    } else {
      window.location.href = '/checkout';
    }
  }
</script>

{% schema %}
{
  "name": "Luma Main Product",
  "settings": [],
  "presets": [
    {
      "name": "Luma Main Product"
    }
  ]
}
{% endschema %}
