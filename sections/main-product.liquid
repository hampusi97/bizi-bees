{% comment %}
  Bizi Bees - Editorial Boutique Product Details
  Repo: bizi-bees /sections/main-product.liquid
  Design System: Kinfolk / Toast / Aesop inspired warm tactile lifestyle boutique.
{% endcomment %}

<div class="wrap boutique-pdp-wrap">
  <!-- Minimal Editorial Breadcrumbs -->
  <nav class="boutique-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span class="sep">/</span>
    <a href="/collections/all">Catalog</a>
    <span class="sep">/</span>
    {% if product.collections.first %}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
      <span class="sep">/</span>
    {% endif %}
    <span class="current">{{ product.title | escape }}</span>
  </nav>

  <div class="boutique-product-layout">
    <!-- Gallery Column (Sticky on Desktop) -->
    <div class="boutique-product-gallery">
      <div class="gallery-main-frame">
        {% if product.featured_image %}
          <div class="gallery-primary-img-wrap">
            {{ product.featured_image | image_url: width: 1000 | image_tag: 
              id: 'ProductMainImage',
              loading: 'eager', 
              widths: '400, 600, 800, 1000', 
              sizes: '(max-width: 900px) 92vw, 48vw',
              alt: product.title | escape,
              class: 'gallery-primary-img'
            }}
          </div>
        {% else %}
          <div class="gallery-placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="gallery-thumbnails">
          {% for image in product.images %}
            <button 
              type="button" 
              class="gallery-thumb-btn{% if forloop.first %} active{% endif %}" 
              onclick="selectProductImage('{{ image | image_url: width: 1000 }}', this)"
              aria-label="View product image {{ forloop.index }}"
            >
              {{ image | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title | escape, class: 'gallery-thumb-img' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Summary & Action Column -->
    <div class="boutique-product-summary">
      {% comment %} Subtle condition / category eyebrow {% endcomment %}
      {% assign condition_val = product.metafields.custom.condition.value %}
      {% if condition_val == blank %}
        {% if product.tags contains 'vintage' or product.tags contains 'Vintage' %}
          {% assign condition_val = 'Vintage Find' %}
        {% elsif product.tags contains 'rare' or product.tags contains 'Rare' %}
          {% assign condition_val = "Collector's Edition" %}
        {% elsif product.tags contains 'Shopify Collective' or product.vendor == 'Luma Wellness' %}
          {% assign condition_val = 'Curated Edition' %}
        {% else %}
          {% assign condition_val = 'Pre-Loved & Graded' %}
        {% endif %}
      {% endif %}

      <div class="product-eyebrow-row">
        <span class="product-condition-tag">{{ condition_val }}</span>
        {% if product.vendor and product.vendor != shop.name %}
          <span class="product-vendor">{{ product.vendor }}</span>
        {% endif %}
      </div>

      <h1 class="boutique-product-title">{{ product.title | escape }}</h1>

      <!-- Pricing Row -->
      <div class="boutique-pricing-row">
        <span class="current-price" id="ProductCurrentPrice">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="compare-price" id="ProductComparePrice">{{ product.compare_at_price | money }}</span>
          {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
          <span class="savings-tag">-{{ savings }}%</span>
        {% endif %}
      </div>

      <!-- Provenance / Sourcing Note -->
      <div class="product-provenance-bar">
        <span class="prov-dot"></span>
        <span class="prov-text">Hand-inspected, cleaned, and dispatched from our Provo, Utah studio.</span>
      </div>

      <!-- Product Form -->
      {% form 'product', product, id: 'main-product-form', class: 'boutique-form' %}
        {% if product.variants.size > 1 %}
          <div class="variant-selection-group">
            <label for="VariantSelect" class="form-label">Select Option</label>
            <select name="id" id="VariantSelect" class="boutique-select" onchange="updateVariantSelection(this)">
              {% for variant in product.variants %}
                <option 
                  value="{{ variant.id }}" 
                  data-price="{{ variant.price | money }}"
                  data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                  data-available="{{ variant.available }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title | escape }} — {{ variant.price | money }} {% unless variant.available %}(Sold out){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" id="VariantSelect" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}

        <!-- Quantity Stepper & Add to Bag Action -->
        <div class="purchase-actions-grid">
          <div class="quantity-stepper">
            <label for="QuantityInput" class="visually-hidden">Quantity</label>
            <button type="button" class="stepper-btn minus" onclick="adjustQty(-1)" aria-label="Decrease quantity">&minus;</button>
            <input type="number" id="QuantityInput" name="quantity" value="1" min="1" max="99" class="stepper-input">
            <button type="button" class="stepper-btn plus" onclick="adjustQty(1)" aria-label="Increase quantity">&plus;</button>
          </div>

          <button 
            type="submit" 
            id="ProductAddToCartBtn"
            class="boutique-add-btn" 
            {% unless product.available %}disabled{% endunless %}
          >
            {% if product.available %}
              Add to Bag
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>

        {{ form.errors | default_errors }}
      {% endform %}

      <!-- Minimal Trust Pillars -->
      <div class="boutique-trust-checklist">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          <span>Curated &amp; spine-inspected for authentic quality</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
          <span>Plastic-conscious, recyclable unbleached packaging</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
          <span>30-day quiet returns if not completely satisfied</span>
        </div>
      </div>

      <!-- Collapsible Accordion Details -->
      <div class="boutique-accordion">
        <details class="accordion-item" open>
          <summary class="accordion-title">
            <span>Description &amp; Story</span>
            <span class="accordion-arrow">&plus;</span>
          </summary>
          <div class="accordion-content">
            <div class="prose-description">{{ product.description }}</div>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-title">
            <span>Inspection &amp; Grading Standards</span>
            <span class="accordion-arrow">&plus;</span>
          </summary>
          <div class="accordion-content">
            <p>Every piece in our shop is personally evaluated in Provo, Utah:</p>
            <ul>
              <li><strong>Books:</strong> Clean pages, verified bindings, covers sanitized and jacket flaws honestly noted.</li>
              <li><strong>Games &amp; Puzzles:</strong> Piece count verified complete, boards cleaned, box wear documented.</li>
              <li><strong>Finds &amp; Stationery:</strong> Functional, authentic, and safely prepped for immediate use.</li>
            </ul>
          </div>
        </details>

        <details class="accordion-item">
          <summary class="accordion-title">
            <span>Shipping &amp; Delivery</span>
            <span class="accordion-arrow">&plus;</span>
          </summary>
          <div class="accordion-content">
            <p>We hand-pack and dispatch all orders within 1–2 business days via USPS. Standard delivery arrives within 2–4 business days. Free standard shipping applies to all US orders over $35.</p>
          </div>
        </details>
      </div>

    </div>
  </div>
</div>

<style>
  .boutique-pdp-wrap {
    padding-top: 24px;
    padding-bottom: 72px;
  }

  .boutique-breadcrumb {
    font-size: 13px;
    color: #78716C;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .boutique-breadcrumb a {
    color: #78716C;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .boutique-breadcrumb a:hover {
    color: #1C1917;
    text-decoration: underline;
  }
  .boutique-breadcrumb .sep {
    color: #D6D3D1;
  }
  .boutique-breadcrumb .current {
    color: #1C1917;
    font-weight: 500;
  }

  .boutique-product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  @media (min-width: 900px) {
    .boutique-product-layout {
      grid-template-columns: 1.15fr 1fr;
      gap: 56px;
      align-items: start;
    }
    .boutique-product-gallery {
      position: sticky;
      top: 32px;
    }
  }

  /* Gallery Styling */
  .gallery-main-frame {
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(28, 25, 23, 0.04);
  }
  .gallery-primary-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #FAF7F2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gallery-primary-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }
  .gallery-placeholder {
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FAF7F2;
  }

  .gallery-thumbnails {
    display: flex;
    gap: 12px;
    margin-top: 14px;
    overflow-x: auto;
    padding-bottom: 6px;
  }
  .gallery-thumb-btn {
    border: 1px solid #E7E5E4;
    border-radius: 8px;
    padding: 0;
    background: #FFFFFF;
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.15s ease;
  }
  .gallery-thumb-btn.active {
    border-color: #2D3B2D;
    outline: 2px solid #2D3B2D;
  }
  .gallery-thumb-btn:hover {
    transform: translateY(-2px);
  }
  .gallery-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Product Summary */
  .product-eyebrow-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .product-condition-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2D3B2D;
    background: #EEF2ED;
    padding: 3px 9px;
    border-radius: 4px;
  }
  .product-vendor {
    font-size: 12px;
    color: #78716C;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .boutique-product-title {
    font-family: "Playfair Display", "Cormorant Garamond", Georgia, serif;
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 600;
    color: #1C1917;
    line-height: 1.25;
    margin: 0 0 16px;
  }

  .boutique-pricing-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .current-price {
    font-size: 26px;
    font-weight: 700;
    color: #1C1917;
  }
  .compare-price {
    font-size: 16px;
    color: #78716C;
    text-decoration: line-through;
  }
  .savings-tag {
    font-size: 11px;
    font-weight: 700;
    color: #9A4C2E;
    background: #FAF0E8;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .product-provenance-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #FAF7F2;
    border: 1px solid #E7E5E4;
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 24px;
  }
  .prov-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #2D3B2D;
    flex-shrink: 0;
  }
  .prov-text {
    font-size: 12px;
    color: #57534E;
    line-height: 1.4;
  }

  /* Form & Actions */
  .boutique-form {
    margin-bottom: 28px;
  }
  .variant-selection-group {
    margin-bottom: 18px;
  }
  .form-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #44403C;
    margin-bottom: 6px;
  }
  .boutique-select {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #E7E5E4;
    border-radius: 8px;
    background: #FFFFFF;
    color: #1C1917;
    font-size: 14px;
    cursor: pointer;
  }

  .purchase-actions-grid {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }
  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid #E7E5E4;
    border-radius: 8px;
    background: #FFFFFF;
    overflow: hidden;
  }
  .stepper-btn {
    background: transparent;
    border: none;
    padding: 0 14px;
    font-size: 18px;
    color: #44403C;
    cursor: pointer;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }
  .stepper-btn:hover {
    background: #F5F5F4;
  }
  .stepper-input {
    width: 44px;
    text-align: center;
    border: none;
    font-size: 15px;
    font-weight: 600;
    color: #1C1917;
    -moz-appearance: textfield;
  }
  .stepper-input::-webkit-outer-spin-button,
  .stepper-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .boutique-add-btn {
    flex: 1;
    background: #2D3B2D;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 14px 24px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .boutique-add-btn:hover:not(:disabled) {
    background: #1F291F;
    transform: translateY(-1px);
  }
  .boutique-add-btn:disabled {
    background: #A8A29E;
    cursor: not-allowed;
    transform: none;
  }

  /* Trust checklist */
  .boutique-trust-checklist {
    border-top: 1px solid #E7E5E4;
    border-bottom: 1px solid #E7E5E4;
    padding: 16px 0;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #44403C;
  }

  /* Accordion */
  .boutique-accordion {
    display: flex;
    flex-direction: column;
  }
  .accordion-item {
    border-bottom: 1px solid #E7E5E4;
  }
  .accordion-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    font-size: 14px;
    font-weight: 600;
    color: #1C1917;
    cursor: pointer;
    list-style: none;
  }
  .accordion-title::-webkit-details-marker {
    display: none;
  }
  .accordion-arrow {
    font-size: 16px;
    color: #78716C;
    transition: transform 0.2s ease;
  }
  details[open] .accordion-arrow {
    transform: rotate(45deg);
  }
  .accordion-content {
    padding-bottom: 16px;
    font-size: 14px;
    line-height: 1.65;
    color: #57534E;
  }
  .accordion-content p {
    margin-bottom: 10px;
  }
  .accordion-content ul {
    padding-left: 20px;
    margin: 8px 0;
  }
  .accordion-content li {
    margin-bottom: 6px;
  }
  .prose-description {
    line-height: 1.7;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  function selectProductImage(src, btn) {
    var mainImg = document.getElementById('ProductMainImage');
    if (mainImg) {
      mainImg.style.opacity = '0.5';
      mainImg.src = src;
      setTimeout(function() { mainImg.style.opacity = '1'; }, 150);
    }
    var buttons = document.querySelectorAll('.gallery-thumb-btn');
    buttons.forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
  }

  function adjustQty(amount) {
    var input = document.getElementById('QuantityInput');
    if (!input) return;
    var current = parseInt(input.value, 10) || 1;
    var next = current + amount;
    if (next < 1) next = 1;
    if (next > 99) next = 99;
    input.value = next;
  }

  function updateVariantSelection(select) {
    var option = select.options[select.selectedIndex];
    if (!option) return;
    var price = option.getAttribute('data-price');
    var compare = option.getAttribute('data-compare');
    var available = option.getAttribute('data-available') === 'true';

    var priceEl = document.getElementById('ProductCurrentPrice');
    if (priceEl && price) priceEl.textContent = price;

    var compareEl = document.getElementById('ProductComparePrice');
    if (compareEl) {
      if (compare) {
        compareEl.textContent = compare;
        compareEl.style.display = 'inline';
      } else {
        compareEl.style.display = 'none';
      }
    }

    var atcBtn = document.getElementById('ProductAddToCartBtn');
    if (atcBtn) {
      if (available) {
        atcBtn.removeAttribute('disabled');
        atcBtn.textContent = 'Add to Bag';
      } else {
        atcBtn.setAttribute('disabled', 'disabled');
        atcBtn.textContent = 'Sold Out';
      }
    }
  }
</script>

{% schema %}
{
  "name": "Main Product",
  "settings": [],
  "presets": [
    {
      "name": "Main Product"
    }
  ]
}
{% endschema %}
