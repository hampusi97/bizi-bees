<div class="wrap block prose"><h1>{{ page.title | default: 'Say hello' | escape }}</h1>{{ page.content }}{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">Thanks for your message. We’ll be in touch.</p>{% else %}{{ form.errors | default_errors }}<label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" required><label for="ContactEmail">Email</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required><label for="ContactBody">How can we help?</label><textarea id="ContactBody" name="contact[body]" placeholder="For an item question, include its name or link. For an order question, include your order number." required></textarea><button>Send message</button>{% endif %}{% endform %}</div>
{% schema %}{"name": "Contact", "settings": [], "presets": [{"name": "Contact"}]}{% endschema %}
