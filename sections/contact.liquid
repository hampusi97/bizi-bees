<div class="wrap block prose"><div style="background:#fff0b6;border-radius:20px;padding:24px;margin-bottom:28px"><span class="bee" aria-hidden="true">{% render 'bee' %}</span><p class="eyebrow">A little hello goes a long way</p><h1>Give us a buzz.</h1><p>Kimberly is here to help with your finds, orders and questions.</p><p>Email <a href="mailto:kharter15@gmail.com">kharter15@gmail.com</a> or send a note below.</p></div>{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">Thanks for buzzing by! Your message has been submitted. Kimberly will be in touch.</p>{% else %}{{ form.errors | default_errors }}<label for="ContactName">Your name</label><input id="ContactName" name="contact[name]" autocomplete="name" required><label for="ContactEmail">Your email</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required><label for="ContactOrder">Order number (optional)</label><input id="ContactOrder" name="contact[order_number]" placeholder="If you’re asking about a purchase"><label for="ContactBody">How can Kimberly help?</label><textarea id="ContactBody" name="contact[body]" rows="6" placeholder="Tell us what’s on your mind. For an item question, include its name or link." required></textarea><button type="submit">Send Kimberly a message ↗</button><p class="muted">Please don’t include payment card details or passwords.</p>{% endif %}{% endform %}</div>
{% schema %}{"name": "Contact", "settings": [], "presets": [{"name": "Contact"}]}{% endschema %}
