{% comment %}
  BIZI BEES™ INTERACTIVE BLIND DATE WITH A BOOK & VINTAGE BOX BUILDER
  Repo: bizi-bees /sections/bizi-mystery-builder.liquid
  Flagship Brand: Bizi Bees™ Curated Vintage & Books ($24.00)
{% endcomment %}

<div class="bizi-builder-wrap">
  <div class="bizi-inner">
    
    <div class="bizi-header">
      <span class="bizi-badge">🐝 BIZI BEES™ CURATED VINTAGE LAB</span>
      <h2>Handcraft Your Blind Date with a Book Gift Box</h2>
      <p>Every book is pre-loved, hand-inspected, wrapped in recycled kraft paper, and sealed with traditional wax. Personalize your literary escape below:</p>
    </div>

    <!-- Live Box Visualizer -->
    <div class="bizi-box-display">
      <div class="bizi-box-graphic">
        <div class="bizi-ribbon" id="biziRibbon">WAX SEALED</div>
        <div class="bizi-parcel">
          <div class="bizi-stamp">🐝 BIZI BEES VINTAGE</div>
          <div class="bizi-genre-tag" id="biziGenreTag">Select Your Genre</div>
          <div class="bizi-accents-tag" id="biziAccentsTag">+ Handcrafted Accents</div>
        </div>
      </div>

      <div class="bizi-selection-summary">
        <h4>Your Handcrafted Crate:</h4>
        <div class="bizi-summary-line"><strong>Genre:</strong> <span id="summaryGenre">None Selected</span></div>
        <div class="bizi-summary-line"><strong>Accents:</strong> <span id="summaryAccents">Wax Seal &amp; Kraft Wrap</span></div>
        <div class="bizi-summary-line"><strong>Dispatch:</strong> <span>Utah Workshop • 24h USPS Priority</span></div>
        <div class="bizi-price-line">
          <div class="bizi-price">
            <strong>$24.00</strong>
            <span class="bizi-strike">$38.00</span>
          </div>
          <span class="bizi-save">SAVE $14</span>
        </div>
        <button id="biziCheckoutBtn" class="bizi-btn" onclick="checkoutBiziBox(this)">
          Claim My Custom Book Crate — $24.00
        </button>
      </div>
    </div>

    <!-- Step 1: Choose Genre -->
    <div class="bizi-step">
      <h3>Step 1: Choose Your Story Atmosphere</h3>
      <div class="bizi-pill-group">
        <button type="button" class="b-pill active" onclick="setGenre('Cozy Mystery & Thriller', this)">
          Cozy Mystery &amp; Thriller
        </button>
        <button type="button" class="b-pill" onclick="setGenre('Historical Vintage Fiction', this)">
          Historical Vintage Fiction
        </button>
        <button type="button" class="b-pill" onclick="setGenre('Retro Sci-Fi & Speculative', this)">
          Retro Sci-Fi &amp; Speculative
        </button>
        <button type="button" class="b-pill" onclick="setGenre('Botanical Essays & Poetry', this)">
          Botanical Essays &amp; Poetry
        </button>
      </div>
    </div>

    <!-- Step 2: Choose Accents -->
    <div class="bizi-step">
      <h3>Step 2: Choose Handcrafted Vintage Accents</h3>
      <div class="bizi-accent-cards">
        <div class="b-card active" onclick="toggleAccent('Solid Brass Bookmark Clip', this)">
          <strong>Solid Brass Bookmark Clip</strong>
          <small>Antiqued patina finish</small>
        </div>
        <div class="b-card" onclick="toggleAccent('Lavender & Chamomile Tea', this)">
          <strong>Organic Herbal Tea Sachet</strong>
          <small>Cozy reading companion</small>
        </div>
        <div class="b-card active" onclick="toggleAccent('Gold Wax Seal & Twine', this)">
          <strong>Gold Metallic Wax Seal</strong>
          <small>Hand-poured bee crest</small>
        </div>
        <div class="b-card" onclick="toggleAccent('Calligraphy Clue Note', this)">
          <strong>Hand-Penned Plot Clues</strong>
          <small>Teaser clues on parcel</small>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .bizi-builder-wrap {
    padding: 70px 20px 85px;
    background: #090D16;
    color: #F8FAFC;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .bizi-inner {
    max-width: 980px;
    margin: 0 auto;
  }
  .bizi-header {
    text-align: center;
    margin-bottom: 35px;
  }
  .bizi-badge {
    display: inline-block;
    background: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 5px 14px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }
  .bizi-header h2 {
    font-size: 32px;
    font-weight: 900;
    color: #FFFFFF;
    margin: 0 0 10px;
    letter-spacing: -0.5px;
  }
  .bizi-header p {
    color: #94A3B8;
    font-size: 14px;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Box Display */
  .bizi-box-display {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 35px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    align-items: center;
  }
  .bizi-box-graphic {
    position: relative;
    height: 220px;
    background: linear-gradient(135deg, #2D1B12 0%, #1A100B 100%);
    border-radius: 16px;
    border: 2px dashed rgba(245, 158, 11, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-align: center;
    overflow: hidden;
  }
  .bizi-ribbon {
    position: absolute;
    top: 14px;
    right: -32px;
    background: #F59E0B;
    color: #090D16;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    padding: 4px 35px;
    transform: rotate(45deg);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  .bizi-stamp {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #F59E0B;
    margin-bottom: 12px;
  }
  .bizi-genre-tag {
    font-size: 16px;
    font-weight: 800;
    color: #FFFFFF;
    background: rgba(255,255,255,0.08);
    padding: 8px 16px;
    border-radius: 8px;
    margin-bottom: 8px;
  }
  .bizi-accents-tag {
    font-size: 11px;
    color: #94A3B8;
  }

  .bizi-selection-summary h4 {
    margin: 0 0 14px;
    font-size: 18px;
    color: #FFFFFF;
  }
  .bizi-summary-line {
    font-size: 13px;
    color: #94A3B8;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
  }
  .bizi-summary-line strong {
    color: #E2E8F0;
  }
  .bizi-price-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 18px 0 16px;
    padding-top: 12px;
    border-top: 1px solid #1E293B;
  }
  .bizi-price strong {
    font-size: 26px;
    font-weight: 900;
    color: #F59E0B;
  }
  .bizi-strike {
    font-size: 14px;
    color: #64748B;
    text-decoration: line-through;
    margin-left: 8px;
  }
  .bizi-save {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .bizi-btn {
    width: 100%;
    background: #F59E0B;
    color: #090D16;
    border: none;
    padding: 14px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.35);
    transition: all 0.2s ease;
  }
  .bizi-btn:hover {
    background: #D97706;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(245, 158, 11, 0.5);
  }

  /* Steps */
  .bizi-step {
    margin-bottom: 30px;
  }
  .bizi-step h3 {
    font-size: 15px;
    font-weight: 800;
    color: #E2E8F0;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .bizi-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .b-pill {
    background: #0F172A;
    border: 1px solid #1E293B;
    color: #94A3B8;
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .b-pill:hover,
  .b-pill.active {
    background: rgba(245, 158, 11, 0.12);
    border-color: #F59E0B;
    color: #F59E0B;
  }

  .bizi-accent-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .b-card {
    background: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 12px;
    padding: 14px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }
  .b-card:hover {
    border-color: #F59E0B;
  }
  .b-card.active {
    border-color: #F59E0B;
    background: rgba(245, 158, 11, 0.08);
  }
  .b-icon {
    font-size: 24px;
    display: block;
    margin-bottom: 6px;
  }
  .b-card strong {
    display: block;
    font-size: 12px;
    color: #FFFFFF;
    margin-bottom: 4px;
  }
  .b-card small {
    display: block;
    font-size: 10px;
    color: #64748B;
  }

  @media(max-width: 768px) {
    .bizi-box-display { grid-template-columns: 1fr; }
    .bizi-accent-cards { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  var currentGenre = '🕵️ Cozy Mystery & Thriller';
  var selectedAccents = ['Solid Brass Bookmark Clip', 'Gold Wax Seal & Twine'];

  function setGenre(genre, btn) {
    currentGenre = genre;
    document.querySelectorAll('.b-pill').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');

    var tag = document.getElementById('biziGenreTag');
    if (tag) tag.innerText = genre;
    var sum = document.getElementById('summaryGenre');
    if (sum) sum.innerText = genre;
  }

  function toggleAccent(accent, card) {
    card.classList.toggle('active');
    var index = selectedAccents.indexOf(accent);
    if (index > -1) {
      selectedAccents.splice(index, 1);
    } else {
      selectedAccents.push(accent);
    }
    var sumAccents = document.getElementById('summaryAccents');
    if (sumAccents) {
      sumAccents.innerText = selectedAccents.length > 0 ? selectedAccents.join(', ') : 'Kraft Wrap Only';
    }
    var tagAccents = document.getElementById('biziAccentsTag');
    if (tagAccents) {
      tagAccents.innerText = '+ ' + selectedAccents.length + ' Handcrafted Accents';
    }
  }

  function checkoutBiziBox(btn) {
    btn.innerHTML = 'Adding to Bag... ⏳';
    btn.disabled = true;

    // Use instantAddToCart fallback with product handle
    if (typeof instantAddToCart === 'function') {
      instantAddToCart('Blind Date with a Book', '24.00', btn);
    } else {
      window.location.href = '/products/blind-date-book-mystery';
    }
  }

  // Set default initial state
  document.addEventListener('DOMContentLoaded', function() {
    var genreSum = document.getElementById('summaryGenre');
    if (genreSum) genreSum.innerText = currentGenre;
    var genreTag = document.getElementById('biziGenreTag');
    if (genreTag) genreTag.innerText = currentGenre;
  });
</script>

{% schema %}
{
  "name": "Bizi Bees Mystery Builder",
  "tag": "section",
  "class": "section-bizi-mystery-builder",
  "settings": [],
  "presets": [
    {
      "name": "Bizi Bees Mystery Builder"
    }
  ]
}
{% endschema %}
