{% comment %}
  Luma Clinical Wellness - The Clinical Comparison Matrix
  File: sections/luma-comparison-matrix.liquid
{% endcomment %}

<section class="luma-matrix" id="luma-matrix-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-matrix__container">
    
    <!-- Header Area -->
    <div class="luma-matrix__header">
      <span class="luma-badge-pill luma-badge-teal">
        {{ section.settings.badge_label | default: "Dermatological Benchmark" }}
      </span>
      <h2 class="luma-matrix__title">
        {{ section.settings.title | default: "The Clinical Comparison Matrix" }}
      </h2>
      <p class="luma-matrix__subtitle">
        {{ section.settings.subtitle | default: "Why thousands of patients and beauty-tech purists are replacing $1,500 clinical visits and overpriced $169 wands with LumaGlow." }}
      </p>
    </div>

    <!-- Comparison Table / Card Container -->
    <div class="luma-matrix__table-wrap">
      <div class="luma-matrix__table" role="table" aria-label="Clinical Comparison Matrix">
        
        <!-- Table Column Headers -->
        <div class="luma-matrix__row luma-matrix__row--head" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature-head" role="columnheader">
            <span class="luma-matrix__head-label">CLINICAL SPECIFICATION</span>
          </div>

          <!-- Column: In-Office -->
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="columnheader">
            <div class="luma-matrix__col-header">
              <span class="luma-matrix__entity">In-Office Clinic</span>
              <span class="luma-matrix__price-tag">$1,500+</span>
              <span class="luma-matrix__subnote">Recurring visits required</span>
            </div>
          </div>

          <!-- Column: Solawave -->
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="columnheader">
            <div class="luma-matrix__col-header">
              <span class="luma-matrix__entity">Solawave™ Wand</span>
              <span class="luma-matrix__price-tag">$169.00</span>
              <span class="luma-matrix__subnote">Overpriced DTC markup</span>
            </div>
          </div>

          <!-- Column: LumaGlow (HIGHLIGHTED) -->
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="columnheader">
            <div class="luma-matrix__badge-winner">
              <span>★ BEST CLINICAL VALUE</span>
            </div>
            <div class="luma-matrix__col-header">
              <span class="luma-matrix__entity luma-text-teal">LumaGlow™ 4-in-1</span>
              <span class="luma-matrix__price-tag luma-text-teal">$38.99</span>
              <span class="luma-matrix__subnote">Direct-from-lab pricing</span>
            </div>
          </div>
        </div>

        <!-- Table Row 1: Target Wavelength -->
        <div class="luma-matrix__row" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature" role="rowheader">
            <strong>630nm Medical Red Light</strong>
            <span class="luma-matrix__tooltip">Optimal depth for collagen synthesis and cellular ATP energy</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-check" title="Included">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">In-office only</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-check" title="Included">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">660nm fixed</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="cell">
            <div class="luma-icon-check luma-icon-check--teal" title="Included">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-bold-pill">True 630nm Precision</span>
          </div>
        </div>

        <!-- Table Row 2: Microcurrent Sculpting -->
        <div class="luma-matrix__row" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature" role="rowheader">
            <strong>Galvanic Microcurrent</strong>
            <span class="luma-matrix__tooltip">Low-voltage electrical current that tones facial muscles & contours jawline</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-check">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">High intensity (requires numbing)</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-cross">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">Weak galvanic current (0.2mA)</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="cell">
            <div class="luma-icon-check luma-icon-check--teal">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-bold-pill">Optimized 0.35mA Sculpt</span>
          </div>
        </div>

        <!-- Table Row 3: 107°F Thermal Therapy -->
        <div class="luma-matrix__row" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature" role="rowheader">
            <strong>Therapeutic Dermal Warmth</strong>
            <span class="luma-matrix__tooltip">Dilates blood vessels to increase serum penetration by 300%</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-cross">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">Separate charge ($250+)</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-check">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">Slow warming (98°F)</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="cell">
            <div class="luma-icon-check luma-icon-check--teal">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-bold-pill">Instant 107°F Thermal Boost</span>
          </div>
        </div>

        <!-- Table Row 4: Facial Lymphatic Massage -->
        <div class="luma-matrix__row" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature" role="rowheader">
            <strong>Sonic Lymphatic Vibration</strong>
            <span class="luma-matrix__tooltip">8,000 VPM for instant drainage of under-eye fluid & puffiness</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-cross">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">Manual massage only</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <div class="luma-icon-check">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-mobile-text">Basic vibration</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="cell">
            <div class="luma-icon-check luma-icon-check--teal">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>
            <span class="luma-bold-pill">High-Frequency 8,000 VPM</span>
          </div>
        </div>

        <!-- Table Row 5: Risk-Free Trial -->
        <div class="luma-matrix__row" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature" role="rowheader">
            <strong>Clinical Guarantee</strong>
            <span class="luma-matrix__tooltip">Money-back trial period to observe visible dermal remodeling</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <span class="luma-matrix__text-red">No Refunds</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <span class="luma-matrix__text-neutral">30 Days (Restocking Fee)</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="cell">
            <span class="luma-matrix__text-green"><strong>60-Day 100% Glow Guarantee</strong></span>
          </div>
        </div>

        <!-- Table Row 6: Fulfillment & Dispatch -->
        <div class="luma-matrix__row" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature" role="rowheader">
            <strong>Shipping & Origin</strong>
            <span class="luma-matrix__tooltip">Dispatch location, fulfillment speed, and customs guarantee</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <span class="luma-matrix__text-neutral">In-person commute</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor" role="cell">
            <span class="luma-matrix__text-neutral">3–7 Business Days</span>
          </div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight" role="cell">
            <span class="luma-matrix__text-green"><strong>Utah Warehouse — Dispatches in 24h</strong></span>
          </div>
        </div>

        <!-- Table Bottom CTA Row -->
        <div class="luma-matrix__row luma-matrix__row--footer" role="row">
          <div class="luma-matrix__cell luma-matrix__cell--feature"></div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor"></div>
          <div class="luma-matrix__cell luma-matrix__cell--competitor"></div>
          <div class="luma-matrix__cell luma-matrix__cell--luma luma-matrix__cell--highlight">
            <a href="{{ section.settings.cta_url | default: '/products/lumaglow-4-in-1-facial-wand' }}" class="luma-btn-primary luma-matrix__cta-btn">
              <span>Claim LumaGlow for $38.99</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <span class="luma-matrix__cta-sub">Free Tracked Delivery Over $50 • 60-Day Trial</span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  #luma-matrix-{{ section.id }} {
    padding: 72px 0 60px;
    background-color: {{ section.settings.bg_color | default: "#FFFFFF" }};
    font-family: var(--luma-font-body);
  }

  .luma-matrix__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .luma-matrix__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .luma-matrix__title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 800;
    color: var(--luma-text-heading);
    letter-spacing: -0.02em;
    margin: 14px 0 12px;
  }

  .luma-matrix__subtitle {
    font-size: 1.05rem;
    color: var(--luma-text-body);
    line-height: 1.6;
    margin: 0;
  }

  .luma-matrix__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }

  .luma-matrix__table {
    display: flex;
    flex-direction: column;
    min-width: 760px;
    border-radius: var(--luma-radius-lg);
    background: #FFFFFF;
    border: 1px solid var(--luma-border-light);
  }

  .luma-matrix__row {
    display: grid;
    grid-template-columns: 2.2fr 1.6fr 1.6fr 2.2fr;
    border-bottom: 1px solid var(--luma-border-light);
    align-items: center;
  }

  .luma-matrix__row:last-child {
    border-bottom: none;
  }

  .luma-matrix__row--head {
    background-color: #F9FAFB;
    border-top-left-radius: var(--luma-radius-lg);
    border-top-right-radius: var(--luma-radius-lg);
    align-items: stretch;
  }

  .luma-matrix__cell {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    align-items: center;
  }

  .luma-matrix__cell--feature-head {
    text-align: left;
    align-items: flex-start;
  }

  .luma-matrix__head-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #6B7280;
    letter-spacing: 0.1em;
  }

  .luma-matrix__cell--feature {
    text-align: left;
    align-items: flex-start;
    padding-left: 24px;
  }

  .luma-matrix__cell--feature strong {
    font-size: 0.95rem;
    color: var(--luma-text-heading);
    margin-bottom: 2px;
  }

  .luma-matrix__tooltip {
    font-size: 0.78rem;
    color: var(--luma-text-muted);
    line-height: 1.35;
  }

  /* Highlight Column (LumaGlow) */
  .luma-matrix__cell--highlight {
    background-color: rgba(13, 148, 136, 0.04);
    border-left: 2px solid var(--luma-accent-teal);
    border-right: 2px solid var(--luma-accent-teal);
    position: relative;
  }

  .luma-matrix__row--head .luma-matrix__cell--highlight {
    border-top: 2px solid var(--luma-accent-teal);
    border-top-right-radius: 14px;
    background-color: #F0FDFA;
    padding-top: 28px;
  }

  .luma-matrix__row--footer .luma-matrix__cell--highlight {
    border-bottom: 2px solid var(--luma-accent-teal);
    border-bottom-right-radius: 14px;
    padding-bottom: 28px;
  }

  .luma-matrix__badge-winner {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--luma-accent-teal);
    color: #FFFFFF;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: var(--luma-radius-full);
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(13, 148, 136, 0.3);
  }

  .luma-matrix__col-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .luma-matrix__entity {
    font-size: 1rem;
    font-weight: 700;
    color: var(--luma-text-heading);
  }

  .luma-text-teal {
    color: var(--luma-accent-teal) !important;
  }

  .luma-matrix__price-tag {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .luma-matrix__subnote {
    font-size: 0.75rem;
    color: var(--luma-text-muted);
  }

  /* Icons & Indicators */
  .luma-icon-check {
    color: #10B981;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .luma-icon-check--teal {
    color: var(--luma-accent-teal);
  }

  .luma-icon-cross {
    color: #9CA3AF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .luma-bold-pill {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--luma-accent-teal-hover);
    background-color: var(--luma-accent-teal-soft);
    padding: 4px 10px;
    border-radius: var(--luma-radius-full);
    margin-top: 4px;
  }

  .luma-mobile-text {
    font-size: 0.78rem;
    color: #6B7280;
    margin-top: 4px;
  }

  .luma-matrix__text-green {
    font-size: 0.88rem;
    color: var(--luma-trust-green);
  }

  .luma-matrix__text-red {
    font-size: 0.85rem;
    color: #EF4444;
    font-weight: 600;
  }

  .luma-matrix__text-neutral {
    font-size: 0.85rem;
    color: #6B7280;
  }

  .luma-matrix__cta-btn {
    width: 100%;
    padding: 12px 18px;
    font-size: 0.9rem;
    text-align: center;
  }

  .luma-matrix__cta-sub {
    font-size: 0.72rem;
    color: var(--luma-text-muted);
    margin-top: 8px;
    text-align: center;
  }

  @media (max-width: 768px) {
    #luma-matrix-{{ section.id }} {
      padding: 44px 0 36px;
    }
  }
</style>

{% schema %}
{
  "name": "Luma Comparison Matrix",
  "tag": "section",
  "class": "luma-matrix-section",
  "settings": [
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge Pill Text",
      "default": "Dermatological Benchmark"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Clinical Comparison Matrix"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Why thousands of patients and beauty-tech purists are replacing $1,500 clinical visits and overpriced $169 wands with LumaGlow."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "LumaGlow Buy URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Luma Comparison Matrix"
    }
  ]
}
{% endschema %}
