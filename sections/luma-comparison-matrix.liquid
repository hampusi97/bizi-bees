{% comment %}
  Luma Clinical Comparison Matrix
  Repo: bizi-bees /sections/luma-comparison-matrix.liquid
{% endcomment %}

<div class="luma-matrix-wrapper">
  <div class="luma-matrix-container">
    <div class="luma-matrix-header">
      <span class="luma-badge">CLINICAL VALUE COMPARISON</span>
      <h2>The Smarter Way to Rejuvenate</h2>
      <p>Why pay 4x more for a brand name? See how LumaGlow compares to clinical visits and the leading $169 wand.</p>
    </div>

    <div class="luma-table-wrapper">
      <table class="luma-table">
        <thead>
          <tr>
            <th>Features & Results</th>
            <th class="col-dim">In-Office Clinic</th>
            <th class="col-dim">Famous Wand ($169)</th>
            <th class="col-highlight">LumaGlow 4-in-1</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Medical-Grade 630nm Red Light</strong></td>
            <td><span class="check">✓</span></td>
            <td><span class="check">✓</span></td>
            <td class="col-highlight"><span class="check-gold">✓</span></td>
          </tr>
          <tr>
            <td><strong>Microcurrent Jawline Sculpting</strong></td>
            <td><span class="check">✓</span></td>
            <td><span class="check">✓</span></td>
            <td class="col-highlight"><span class="check-gold">✓</span></td>
          </tr>
          <tr>
            <td><strong>Therapeutic 107°F Warmth</strong></td>
            <td><span class="check">✓</span></td>
            <td><span class="check">✓</span></td>
            <td class="col-highlight"><span class="check-gold">✓</span></td>
          </tr>
          <tr>
            <td><strong>Fast Dispatch from Utah, USA</strong></td>
            <td><span class="cross">✕</span></td>
            <td><span class="cross">✕</span> (Standard)</td>
            <td class="col-highlight"><span class="check-gold">✓ (24-48h)</span></td>
          </tr>
          <tr>
            <td><strong>60-Day Risk-Free Guarantee</strong></td>
            <td><span class="cross">✕</span></td>
            <td><span class="cross">✕</span> (30 Days)</td>
            <td class="col-highlight"><span class="check-gold">✓ (60 Days)</span></td>
          </tr>
          <tr class="price-row">
            <td><strong>Total Investment</strong></td>
            <td class="col-dim price-clinic">$1,500+ / yr</td>
            <td class="col-dim price-competitor">$169.00</td>
            <td class="col-highlight price-luma">
              <span class="deal-tag">TODAY ONLY</span>
              <div class="price-now">$38.99</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="luma-matrix-cta">
      <a href="/products/lumaglow-4-in-1-facial-wand" class="luma-btn-primary">
        Get LumaGlow for $38.99 — Save $130 Today →
      </a>
      <span class="luma-subtext">🔒 Fast 1-Click Checkout | 60-Day Money-Back Guarantee</span>
    </div>
  </div>
</div>

<style>
  .luma-matrix-wrapper {
    background: #fafafc;
    padding: 70px 20px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .luma-matrix-container {
    max-width: 950px;
    margin: 0 auto;
    text-align: center;
  }
  .luma-badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 6px 14px;
    border-radius: 50px;
    display: inline-block;
    margin-bottom: 12px;
  }
  .luma-matrix-header h2 {
    font-size: clamp(26px, 3.5vw, 38px);
    color: #0f172a;
    font-weight: 800;
    margin: 0 0 10px;
  }
  .luma-matrix-header p {
    color: #64748b;
    font-size: 15px;
    margin-bottom: 35px;
  }
  .luma-table-wrapper {
    overflow-x: auto;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
  }
  .luma-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .luma-table th, .luma-table td {
    padding: 16px 20px;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
  }
  .luma-table th {
    background: #f8fafc;
    color: #334155;
    font-weight: 700;
  }
  .col-highlight {
    background: #fffdf5;
    text-align: center;
    border-left: 2px solid #f59e0b;
    border-right: 2px solid #f59e0b;
  }
  .col-dim {
    text-align: center;
    color: #64748b;
  }
  .check-gold { color: #d97706; font-weight: 900; font-size: 18px; }
  .check { color: #10b981; font-weight: 900; font-size: 18px; }
  .cross { color: #94a3b8; font-weight: 900; font-size: 16px; }
  .price-row td { padding: 22px 20px; }
  .price-clinic { font-weight: 600; text-decoration: line-through; }
  .price-competitor { font-weight: 700; color: #ef4444; }
  .price-luma .price-now { font-size: 24px; font-weight: 900; color: #b45309; }
  .deal-tag { font-size: 10px; background: #fef3c7; color: #92400e; padding: 3px 8px; border-radius: 4px; font-weight: 800; display: inline-block; }
  .luma-matrix-cta { margin-top: 35px; }
  .luma-btn-primary {
    background: #d97706;
    color: #ffffff !important;
    text-decoration: none;
    font-weight: 800;
    font-size: 16px;
    padding: 16px 36px;
    border-radius: 50px;
    display: inline-block;
    box-shadow: 0 8px 25px rgba(217, 119, 6, 0.35);
    transition: transform 0.15s ease;
  }
  .luma-btn-primary:hover { transform: scale(1.03); }
  .luma-subtext { display: block; margin-top: 10px; font-size: 12px; color: #64748b; font-weight: 500; }
</style>

{% schema %}
{
  "name": "Luma Comparison Matrix",
  "settings": [],
  "presets": [
    {
      "name": "Luma Comparison Matrix"
    }
  ]
}
{% endschema %}
