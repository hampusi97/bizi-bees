<div class="wrap block"><p class="eyebrow">Find your next favorite</p><h1>Shop by category</h1><p>Books, cozy finds, useful tech and a little everyday joy. Pick a department to explore.</p><div class="grid">{% assign department_handles = 'books,clothing,electronics,games,toys,home-decor,beauty-products,snacks,drink-mixes,more-finds' | split: ',' %}{% for handle in department_handles %}{% assign collection = collections[handle] %}{% if collection != blank and collection.products_count > 0 %}<a class="category" href="{{ collection.url }}"><h2>{{ collection.title | escape }}</h2><p>{{ collection.products_count }} finds →</p></a>{% endif %}{% endfor %}</div><p style="margin-top:2rem"><a class="button" href="{{ routes.all_products_collection_url }}">Browse all finds</a></p></div>
{% schema %}{"name":"Main List Collections","settings":[],"presets":[{"name":"Main List Collections"}]}{% endschema %}
