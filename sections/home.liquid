  <script>
    (function() {
      const arena = document.getElementById('gravityArena-home');
      if (!arena) return;

      const items = arena.querySelectorAll('.float-item');
      let mouseX = 0, mouseY = 0;
      let targetX = 0, targetY = 0;
      let time = 0;
      let isVisible = true;
      let animationFrameId = null;

      function animate() {
        if (!isVisible) return;
        time += 0.02;

        targetX += (mouseX - targetX) * 0.05;
        targetY += (mouseY - targetY) * 0.05;

        items.forEach((item, index) => {
          const speed = parseFloat(item.dataset.speed) || 1.8;
          const floatY = Math.sin(time * speed + index) * 12;
          const floatX = Math.cos(time * (speed * 0.8) + index) * 9;
          const shiftX = targetX * speed * 8;
          const shiftY = targetY * speed * 8;

          item.style.transform = `translate3d(${floatX + shiftX}px, ${floatY + shiftY}px, 0px) rotate(${floatX * 0.2}deg)`;
        });

        animationFrameId = requestAnimationFrame(animate);
      }

      window.addEventListener('mousemove', (e) => {
        const rect = arena.getBoundingClientRect();
        const arenaCenterX = rect.left + rect.width / 2;
        const arenaCenterY = rect.top + rect.height / 2;
        mouseX = (e.clientX - arenaCenterX) / (window.innerWidth / 2);
        mouseY = (e.clientY - arenaCenterY) / (window.innerHeight / 2);
      });

      window.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          const touch = e.touches[0];
          const rect = arena.getBoundingClientRect();
          mouseX = (touch.clientX - (rect.left + rect.width / 2)) / (window.innerWidth / 2);
          mouseY = (touch.clientY - (rect.top + rect.height / 2)) / (window.innerHeight / 2);
        }
      }, { passive: true });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isVisible = entry.isIntersecting;
          if (isVisible && !animationFrameId) {
            animate();
          } else if (!isVisible && animationFrameId) {
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
          }
        });
      }, { threshold: 0.1 });

      observer.observe(arena);
      animate();
    })();
  </script>

