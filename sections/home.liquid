<section class="hero-wrap">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">A little browsing. A lovely find.</p>
      <h1>Good finds.<br>Fresh beginnings.</h1>
      <p class="lede">
        Pre-loved treasures meet fresh gifts: books, cozy comforts, practical finds,
        and small joys that make home feel beautifully lived in.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="{{ collections['all'].url | default: routes.all_products_collection_url }}">Shop the collection</a>
        <a class="button button-secondary" href="{{ routes.root_url }}">Browse stories</a>
      </div>
      <ul class="stat-row" aria-label="Shop highlights">
        <li><strong>1,200+</strong><span>Curated finds</span></li>
        <li><strong>4.9/5</strong><span>Happy shoppers</span></li>
        <li><strong>48h</strong><span>Fast dispatch</span></li>
      </ul>
    </div>

    <div class="hero-visual" aria-label="Featured products preview">
      <div class="feature-card feature-card-large">
        <div class="feature-image image-one"></div>
        <div class="feature-meta">
          <span>Featured</span>
          <strong>Books &amp; home</strong>
          <small>Thoughtful pieces for everyday rituals</small>
        </div>
      </div>
      <div class="feature-card feature-card-small">
        <div class="feature-image image-two"></div>
        <div class="feature-meta">
          <span>New arrival</span>
          <strong>Giftable finds</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="benefits wrap">
  <article>
    <span class="benefit-icon">✦</span>
    <h3>Thoughtfully curated</h3>
    <p>Each item chosen for quality, charm, and everyday usefulness.</p>
  </article>
  <article>
    <span class="benefit-icon">✓</span>
    <h3>Honest condition</h3>
    <p>Transparent notes so you know exactly what you’re getting.</p>
  </article>
  <article>
    <span class="benefit-icon">♡</span>
    <h3>Designed to delight</h3>
    <p>Beautiful objects and useful essentials that feel personal.</p>
  </article>
</section>

<section class="featured-section wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow eyebrow-dark">Curated edits</p>
      <h2>Shop the good stuff</h2>
    </div>
    <a href="{{ collections['all'].url | default: routes.all_products_collection_url }}" class="text-link">View all finds</a>
  </div>

  <div class="product-grid">
    <article class="product-card">
      <div class="product-art art-one"></div>
      <div class="product-body">
        <span class="tag">Books</span>
        <h3>Well-loved stories</h3>
        <p>Hardcovers, favorites, and paperbacks with character.</p>
        <div class="product-row"><strong>$18</strong><span>From</span></div>
      </div>
    </article>

    <article class="product-card">
      <div class="product-art art-two"></div>
      <div class="product-body">
        <span class="tag">Home</span>
        <h3>Cozy rituals</h3>
        <p>Warm, functional pieces for a calmer everyday routine.</p>
        <div class="product-row"><strong>$24</strong><span>From</span></div>
      </div>
    </article>

    <article class="product-card">
      <div class="product-art art-three"></div>
      <div class="product-body">
        <span class="tag">Lifestyle</span>
        <h3>Fresh little joys</h3>
        <p>Objects that bring charm, ease, and personality home.</p>
        <div class="product-row"><strong>$32</strong><span>From</span></div>
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Home",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    }
  ],
  "presets": [{ "name": "Home" }]
}
{% endschema %}
