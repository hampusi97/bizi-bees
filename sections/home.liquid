{% comment %}
  Bizi Bees - Editorial Boutique Homepage
  Repo: bizi-bees /sections/home.liquid
  Design System: Kinfolk / Toast / Aesop inspired warm tactile lifestyle boutique.
{% endcomment %}

<div class="boutique-home">
  
  <!-- Section B: Editorial Hero -->
  <section class="editorial-hero">
    <div class="wrap hero-container">
      <div class="hero-content">
        <span class="hero-eyebrow">A Thoughtful Curation · Hand-Inspected in Utah</span>
        <h1 class="hero-headline">Good things deserve another chapter.</h1>
        <p class="hero-subheading">
          A thoughtful collection of hand-inspected pre-loved books, timeless board games, and everyday finds. Shipped with care from Utah.
        </p>

        <div class="hero-actions">
          <a class="boutique-btn-primary" href="/collections/all">
            Explore Collection
          </a>
          <a class="boutique-btn-secondary" href="/pages/about">
            About Our Sourcing &rarr;
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-image-frame">
          <img 
            src="https://cdn.shopify.com/s/files/1/0778/2465/5527/files/photo-1524995997946-a1c2e315a42f.jpg?v=1792881350" 
            alt="Curated vintage books and quiet lifestyle finds"
            class="hero-featured-image"
            width="640"
            height="520"
            loading="eager"
            onerror="this.src='https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=800&q=80'"
          >
          <div class="hero-badge-stamp">
            <span class="stamp-leaf">❦</span>
            <span class="stamp-text">Certified Provo Archive</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section C: Value Proposition Banner (Trust Bar) -->
  <section class="trust-pillars-section">
    <div class="wrap">
      <div class="trust-pillars-grid">
        
        <div class="trust-pillar-card">
          <div class="pillar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <div class="pillar-text">
            <h3 class="pillar-title">Curated &amp; Hand-Inspected</h3>
            <p class="pillar-desc">Every single book, game, and treasure is UV-cleaned, spine-verified, and honestly graded.</p>
          </div>
        </div>

        <div class="trust-pillar-card">
          <div class="pillar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
            </svg>
          </div>
          <div class="pillar-text">
            <h3 class="pillar-title">Plastic-Conscious Packaging</h3>
            <p class="pillar-desc">Shipped in recyclable unbleached paper and paper tape to tread gently on our earth.</p>
          </div>
        </div>

        <div class="trust-pillar-card">
          <div class="pillar-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2D3B2D" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div class="pillar-text">
            <h3 class="pillar-title">Independent &amp; Utah-Based</h3>
            <p class="pillar-desc">Direct from Kimberly's studio in Provo. We support thoughtful, small-scale circular commerce.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Department Highlights -->
  <section class="departments-section wrap">
    <div class="section-header-editorial">
      <span class="sub-label">Browse by Department</span>
      <h2 class="section-title-serif">Thoughtful Categories</h2>
    </div>

    <div class="departments-grid">
      <a class="department-card" href="/collections/books">
        <div class="dept-media">
          <span class="dept-icon">📖</span>
        </div>
        <div class="dept-info">
          <h4>Curated Books</h4>
          <p>Rare vintage editions, forgotten classics &amp; sound volumes</p>
          <span class="dept-link-text">Browse Books &rarr;</span>
        </div>
      </a>

      <a class="department-card" href="/collections/games-puzzles">
        <div class="dept-media">
          <span class="dept-icon">🎲</span>
        </div>
        <div class="dept-info">
          <h4>Games &amp; Puzzles</h4>
          <p>Complete vintage board games, retro puzzles &amp; family classics</p>
          <span class="dept-link-text">Browse Tabletop &rarr;</span>
        </div>
      </a>

      <a class="department-card" href="/collections/stationery">
        <div class="dept-media">
          <span class="dept-icon">🖋️</span>
        </div>
        <div class="dept-info">
          <h4>Stationery &amp; Desk</h4>
          <p>Tactile paper folios, brass accessories &amp; archival journals</p>
          <span class="dept-link-text">Browse Stationery &rarr;</span>
        </div>
      </a>

      <a class="department-card" href="/collections/all">
        <div class="dept-media">
          <span class="dept-icon">🏺</span>
        </div>
        <div class="dept-info">
          <h4>Everyday Finds</h4>
          <p>Hand-picked home decor, audio treasures &amp; curiosity objects</p>
          <span class="dept-link-text">Explore All Finds &rarr;</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Curated Product Showcase -->
  <section class="curated-finds-section wrap">
    <div class="section-header-editorial flex-header">
      <div>
        <span class="sub-label">Fresh From the Shelf</span>
        <h2 class="section-title-serif">Recent Additions to the Archive</h2>
      </div>
      <a class="view-all-link" href="/collections/all">
        View Entire Catalog ({{ collections.all.products_count | default: "350+" }} items) &rarr;
      </a>
    </div>

    <div class="curated-grid">
      {% assign featured_collection = collections['frontpage'] | default: collections['all'] %}
      {% for product in featured_collection.products limit: 8 %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for product in collections.all.products limit: 8 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endfor %}
    </div>
  </section>

  <!-- Sourcing & Studio Philosophy -->
  <section class="studio-philosophy-section">
    <div class="wrap philosophy-container">
      <div class="philosophy-visual">
        <img 
          src="https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=700&q=80" 
          alt="Hands inspecting an archival book"
          class="philosophy-img"
          loading="lazy"
          width="500"
          height="400"
        >
      </div>

      <div class="philosophy-content">
        <span class="sub-label">Our Quiet Philosophy</span>
        <h2 class="philosophy-heading">A second home for meaningful goods.</h2>
        <p class="philosophy-text">
          In a world overflowing with mass-produced disposables, we choose the warmth of things that have already proven their value. Each book, board game, and curiosity on our shelves was salvaged with care in Utah County, cleaned by hand, and certified ready for many more years of enjoyment.
        </p>
        <p class="philosophy-text">
          Whether you are adding a vintage hardcover to your personal library or seeking a screen-free family game night, you can trust our honest condition notes and meticulous packing.
        </p>

        <div class="founder-signoff">
          <strong>Kimberly Harter</strong>
          <span>Founder &amp; Curator · Provo, Utah</span>
        </div>
      </div>
    </div>
  </section>

</div>

<style>
  /* Editorial Palette: Warm Linen, Espresso, Forest/Olive */
  .boutique-home {
    background-color: #FAF7F2;
    color: #1C1917;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* Editorial Hero */
  .editorial-hero {
    padding: 72px 0 60px;
    border-bottom: 1px solid #E7E5E4;
  }
  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2D3B2D;
    margin-bottom: 18px;
  }
  .hero-headline {
    font-family: "Playfair Display", "Cormorant Garamond", Georgia, serif;
    font-size: clamp(38px, 5.5vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #1C1917;
    margin: 0 0 20px 0;
  }
  .hero-subheading {
    font-size: 16.5px;
    line-height: 1.65;
    color: #78716C;
    max-width: 500px;
    margin: 0 0 32px 0;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .boutique-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #2D3B2D;
    color: #FFFFFF;
    font-size: 14.5px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .boutique-btn-primary:hover {
    background: #1E281E;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(45, 59, 45, 0.18);
  }
  .boutique-btn-secondary {
    display: inline-flex;
    align-items: center;
    color: #1C1917;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .boutique-btn-secondary:hover {
    color: #2D3B2D;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Hero Visual */
  .hero-image-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #F5F3EF;
    border: 1px solid #E7E5E4;
    box-shadow: 0 16px 36px rgba(28, 25, 23, 0.06);
  }
  .hero-featured-image {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }
  .hero-badge-stamp {
    position: absolute;
    bottom: 18px;
    right: 18px;
    background: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(8px);
    border: 1px solid #E7E5E4;
    padding: 8px 14px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    color: #2D3B2D;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .stamp-leaf {
    color: #2D3B2D;
    font-size: 14px;
  }

  /* Value Proposition Banner (Trust Bar) */
  .trust-pillars-section {
    padding: 36px 0;
    border-bottom: 1px solid #E7E5E4;
    background: #FAF7F2;
  }
  .trust-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .trust-pillar-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .pillar-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .pillar-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14.5px;
    font-weight: 700;
    color: #1C1917;
    margin: 0 0 4px 0;
  }
  .pillar-desc {
    font-size: 13px;
    color: #78716C;
    line-height: 1.5;
    margin: 0;
  }

  /* Departments Section */
  .departments-section {
    padding: 72px 0 48px;
  }
  .section-header-editorial {
    margin-bottom: 36px;
  }
  .section-header-editorial.flex-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
  }
  .sub-label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #78716C;
    margin-bottom: 6px;
  }
  .section-title-serif {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    color: #1C1917;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .view-all-link {
    font-size: 13.5px;
    font-weight: 600;
    color: #2D3B2D;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .view-all-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .departments-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .department-card {
    background: #FFFFFF;
    border: 1px solid #E7E5E4;
    border-radius: 16px;
    padding: 24px 20px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease, border-color 0.2s ease;
  }
  .department-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(28, 25, 23, 0.06);
    border-color: #D6D3D1;
  }
  .dept-media {
    margin-bottom: 16px;
  }
  .dept-icon {
    font-size: 32px;
  }
  .dept-info h4 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 18px;
    font-weight: 700;
    color: #1C1917;
    margin: 0 0 6px 0;
  }
  .dept-info p {
    font-size: 13px;
    color: #78716C;
    line-height: 1.5;
    margin: 0 0 14px 0;
    min-height: 38px;
  }
  .dept-link-text {
    font-size: 12.5px;
    font-weight: 600;
    color: #2D3B2D;
  }

  /* Curated Product Grid */
  .curated-finds-section {
    padding: 32px 0 72px;
  }
  .curated-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  /* Studio Philosophy Section */
  .studio-philosophy-section {
    background: #FFFFFF;
    border-top: 1px solid #E7E5E4;
    border-bottom: 1px solid #E7E5E4;
    padding: 80px 0;
  }
  .philosophy-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  .philosophy-img {
    width: 100%;
    border-radius: 18px;
    object-fit: cover;
    border: 1px solid #E7E5E4;
    display: block;
  }
  .philosophy-heading {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    line-height: 1.2;
    color: #1C1917;
    margin: 0 0 20px 0;
  }
  .philosophy-text {
    font-size: 15px;
    line-height: 1.7;
    color: #78716C;
    margin: 0 0 18px 0;
  }
  .founder-signoff {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #E7E5E4;
    display: flex;
    flex-direction: column;
  }
  .founder-signoff strong {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 17px;
    color: #1C1917;
  }
  .founder-signoff span {
    font-size: 12.5px;
    color: #78716C;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .departments-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .curated-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .trust-pillars-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .curated-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .philosophy-container {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .editorial-hero {
      padding: 44px 0 36px;
    }
    .studio-philosophy-section {
      padding: 48px 0;
    }
  }

  @media (max-width: 480px) {
    .departments-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Boutique Home",
  "settings": [],
  "presets": [
    {
      "name": "Boutique Home"
    }
  ]
}
{% endschema %}
