{% comment %}
  Bizi Bees - Editorial 4-Column Footer
  Repo: bizi-bees /sections/footer.liquid
{% endcomment %}

{% render "newsletter" %}

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid-4col">
      
      <!-- Col 1: Brand Story -->
      <div class="footer-col col-story">
        <a class="footer-logo" href="{{ routes.root_url }}">
          <span class="bee-mark">{% render "bee" %}</span>
          <span class="logo-name">bizi bees</span>
        </a>
        <p class="footer-mission">
          Thoughtfully curated pre-loved books, timeless tabletop games, and vintage everyday treasures. We inspect, clean, and give good things another chapter right from our studio in Provo, Utah.
        </p>
        <p class="footer-origin">
          Independent &amp; Utah-Based · Plastic-Conscious Packaging
        </p>
      </div>

      <!-- Col 2: Shop -->
      <div class="footer-col col-links">
        <h4 class="footer-col-title">Shop Collection</h4>
        <ul class="footer-link-list">
          <li><a href="/collections/books">Curated Books</a></li>
          <li><a href="/collections/games-puzzles">Games &amp; Puzzles</a></li>
          <li><a href="/collections/stationery">Stationery &amp; Desk</a></li>
          <li><a href="/collections/all">All Everyday Finds</a></li>
          <li><a href="/pages/on-the-shelf">Provo Shelf Archive</a></li>
        </ul>
      </div>

      <!-- Col 3: Help & Info -->
      <div class="footer-col col-links">
        <h4 class="footer-col-title">Help &amp; Info</h4>
        <ul class="footer-link-list">
          <li><a href="/pages/shipping">Shipping SLAs</a></li>
          <li><a href="/pages/returns">Returns &amp; Exchanges</a></li>
          <li><a href="/pages/condition-guide">Condition &amp; Grading Guide</a></li>
          <li><a href="/pages/faq">Frequently Asked Questions</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Col 4: Policies -->
      <div class="footer-col col-links">
        <h4 class="footer-col-title">Policies &amp; Trust</h4>
        <ul class="footer-link-list">
          <li><a href="/pages/policies">Universal Store Policies</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/refund-policy">Refund &amp; 60-Day Guarantee</a></li>
          <li><a href="/pages/about">About Our Sourcing</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Copyright & Payment Badges -->
    <div class="footer-bottom-bar">
      <p class="footer-copyright">
        &copy; {{ "now" | date: "%Y" }} Bizi Bees. All rights reserved. Shipped with care from Utah.
      </p>

      <div class="footer-payment-icons" aria-label="Accepted payment methods">
        <!-- SVG Payment Icons -->
        <span class="pay-icon" title="Visa">
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#FFFFFF" stroke="#E7E5E4"/><path d="M15.5 16.5L17.5 7.5H20L18 16.5H15.5ZM13.8 7.5L11.5 13.8L11.2 12.3L12.3 8.3C12.4 7.8 12.1 7.5 11.6 7.5H8L8 7.7C9.3 8 10.3 8.7 10.7 9.8L12.6 16.5H15.2L18.8 7.5H13.8Z" fill="#1A1F71"/></svg>
        </span>
        <span class="pay-icon" title="Mastercard">
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#FFFFFF" stroke="#E7E5E4"/><circle cx="15" cy="12" r="6" fill="#EB001B"/><circle cx="23" cy="12" r="6" fill="#F79E1B" fill-opacity="0.88"/></svg>
        </span>
        <span class="pay-icon" title="American Express">
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0077A6"/><text x="50%" y="60%" text-anchor="middle" fill="#FFFFFF" font-family="sans-serif" font-size="7" font-weight="bold">AMEX</text></svg>
        </span>
        <span class="pay-icon" title="Apple Pay">
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#FFFFFF" stroke="#E7E5E4"/><text x="50%" y="62%" text-anchor="middle" fill="#1C1917" font-family="sans-serif" font-size="8" font-weight="bold">Pay</text></svg>
        </span>
        <span class="pay-icon" title="Shop Pay">
          <svg width="34" height="22" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#5A31F4"/><text x="50%" y="62%" text-anchor="middle" fill="#FFFFFF" font-family="sans-serif" font-size="8" font-weight="bold">Shop</text></svg>
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #FAF7F2;
    border-top: 1px solid #E7E5E4;
    color: #1C1917;
    padding: 64px 0 36px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .footer-grid-4col {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid #E7E5E4;
  }
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #1C1917;
    margin-bottom: 14px;
  }
  .footer-logo .bee-mark {
    width: 24px;
    height: 24px;
  }
  .footer-logo .logo-name {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 22px;
    font-weight: 700;
    color: #1C1917;
  }
  .footer-mission {
    font-size: 13.5px;
    line-height: 1.65;
    color: #78716C;
    margin: 0 0 16px 0;
    max-width: 380px;
  }
  .footer-origin {
    font-size: 12px;
    font-weight: 600;
    color: #2D3B2D;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .footer-col-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1C1917;
    margin: 0 0 18px 0;
  }
  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-link-list li {
    margin-bottom: 10px;
  }
  .footer-link-list a {
    text-decoration: none;
    color: #78716C;
    font-size: 13.5px;
    transition: color 0.2s ease;
  }
  .footer-link-list a:hover {
    color: #2D3B2D;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-copyright {
    font-size: 12.5px;
    color: #A8A29E;
    margin: 0;
  }
  .footer-payment-icons {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pay-icon svg {
    display: block;
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .footer-grid-4col {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .col-story {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid-4col {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .col-story {
      grid-column: span 1;
    }
    .footer-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
