{% render "newsletter" %}
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/"><span class="bee">{% render "bee" %}</span>bizi bees</a>
        <p>Good things deserve another go.</p>
        <p class="muted" style="color:#c6cec4">Everyday finds with a little more story.</p>
      </div>
      <div>
        <strong>Explore</strong>
        <a href="/collections/luma-wellness" style="color:#ffd166;font-weight:700;">✨ Luma Wellness Tech</a>
        <a href="/collections/all">Shop all finds</a>
        <a href="/blogs/news">Gift guides</a>
        <a href="/pages/about">Our story</a>
        <a href="/pages/condition-guide">Condition guide</a>
      </div>
      <div>
        <strong>Here to help</strong>
        <a href="/pages/policies" style="color:#2dd4bf;font-weight:700;">🛡️ Universal Policies &amp; Compliance</a>
        <a href="/pages/the-science-of-red-light">The Science of Red Light</a>
        <a href="/pages/glow-guarantee">60-Day Guarantee</a>
        <a href="/pages/track-order">Track Your Order</a>
        <a href="/pages/shipping">Shipping</a>
        <a href="/pages/returns">Returns</a>
        <a href="/pages/faq">FAQs</a>
        <a href="/pages/contact">Contact</a>
        {% for policy in shop.policies %}
          {% if policy.body != blank %}
            <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- High-Trust FDA Cosmetic Device Compliance Statement & Guarantee -->
    <div style="border-top:1px solid rgba(255,255,255,0.12);margin-top:28px;padding-top:20px;font-size:12px;line-height:1.6;color:#9ca3af;text-align:left;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
        <span style="font-size:15px;">🛡️</span>
        <strong style="color:#f3f4f6;text-transform:uppercase;letter-spacing:0.06em;font-size:11px;">FDA COSMETIC DEVICE COMPLIANCE DISCLOSURE</strong>
      </div>
      <p style="margin:0 0 10px;color:#d1d5db;font-size:11.5px;">
        These statements and products have not been evaluated by the Food and Drug Administration (FDA). This product is a non-invasive cosmetic device intended for facial beautification, aesthetic skin tone improvement, and personal aesthetic care. It is not intended to diagnose, treat, cure, or prevent any medical condition or disease. Consult your physician or dermatologist prior to use if you have preexisting conditions.
      </p>
      <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:11.5px;">
        <a href="/pages/glow-guarantee" style="color:#ffd166;text-decoration:underline;font-weight:700;">60-Day Risk-Free Glow Guarantee &rarr;</a>
        <a href="/policies/shipping-policy" style="color:#e5e7eb;text-decoration:underline;">Tracked Shipping from Utah</a>
        <a href="/pages/contact" style="color:#e5e7eb;text-decoration:underline;">Contact US Support</a>
      </div>
    </div>

    <small style="display:block;margin-top:18px;color:#6b7280;font-size:11px;">
      &copy; {{ "now" | date: "%Y" }} {{ shop.name | escape }} &amp; Luma Wellness. All rights reserved. Powered by Shopify.
    </small>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
