# ==============================================================================
# MACHINE-TO-MACHINE (M2M) ENVIRONMENT SECRETS TEMPLATE
# DO NOT COMMIT ACTUAL API SECRETS OR PERSONAL PASSWORDS TO VERSION CONTROL
# Store production values exclusively in GitHub Secrets or Vercel Environment Variables.
# ==============================================================================

# --- SHOPIFY ADMIN API (Scoped Custom App Token — NEVER Master Account Passwords) ---
# Required scopes: write_products, read_products, read_inventory, write_themes, read_orders
SHOPIFY_SHOP_URL=bizibees-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CRON & VERIFICATION SECURITY ---
# Prevents unauthorized execution of edge serverless cron routes
CRON_SECRET=sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- EVENT-DRIVEN ORDER WEBHOOK VERIFICATION ---
# Secret key used to compute and verify X-Shopify-Hmac-Sha256 signatures
SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MACHINE EMAIL INBOX (Resend / SendGrid / Postmark) ---
# Strictly firewalled from personal Gmail / iCloud / banking inboxes
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MACHINE_SUPPORT_EMAIL=support@lumaclinical.com
MACHINE_OPS_EMAIL=ops@lumaclinical.com

# --- MOBILE COMMAND CENTER ALERTS ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx
TELEGRAM_BOT_TOKEN=xxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxx

# --- EXECUTIVE EMAIL ALERT DISPATCHER (Management by Exception) ---
# FOUNDER_EMAIL: Your personal inbox where you receive alerts and the 8:00 AM coffee digest
FOUNDER_EMAIL=founder@yourdomain.com
ALERT_SENDER_EMAIL=bot@lumaclinical.internal
ALERT_SENDER_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- SOCIAL AUTO-PUBLISHING APIS (Official Content Posting Tokens) ---
TIKTOK_OPEN_API_TOKEN=act.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_GRAPH_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_ACCOUNT_ID=178xxxxxxxxxxxxxx
