// assets/dropper-cart.js
const DropperCart = {
  formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  },
  async refresh() {
    const res = await fetch('/cart.js');
    const cart = await res.json();
    this.render(cart);
  },
  async addItem(variantId, quantity = 1) {
    await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity }] })
    });
    await this.refresh();
    this.open();
    if (window.DropperTelemetry) window.DropperTelemetry.track('add_to_cart', { variantId });
  },
  async updateQuantity(key, quantity) {
    await fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity })
    });
    await this.refresh();
  },
  render(cart) {
    const drawer = document.getElementById('dropper-cart-drawer');
    if (!drawer) return;
    const threshold = parseInt(drawer.dataset.freeShipping || '3500', 10);
    const remaining = Math.max(0, threshold - cart.total_price);
    const percent = Math.min(100, (cart.total_price / threshold) * 100);

    document.getElementById('cart-drawer-count').textContent = cart.item_count;
    document.getElementById('cart-drawer-subtotal').textContent = this.formatMoney(cart.total_price);
    document.getElementById('cart-checkout-price').textContent = this.formatMoney(cart.total_price);
    document.getElementById('cart-shipping-fill').style.width = `${percent}%`;

    const msgEl = document.getElementById('cart-shipping-msg');
    msgEl.textContent = remaining === 0
      ? "You've unlocked Free Standard Shipping!"
      : `Add ${this.formatMoney(remaining)} more for Free Shipping`;

    const itemsContainer = document.getElementById('cart-drawer-items');
    if (cart.items.length === 0) {
      itemsContainer.innerHTML = `<p class="cart-empty">Your bag is currently empty.</p>`;
      return;
    }
    itemsContainer.innerHTML = cart.items.map(item => `
      <div class="cart-item">
        <img src="${item.image}" alt="${item.title}" class="cart-item__img" loading="lazy" />
        <div class="cart-item__info">
          <a href="${item.url}" class="cart-item__title">${item.product_title}</a>
          <span class="cart-item__price">${this.formatMoney(item.final_line_price)}</span>
          <div class="cart-item__qty">
            <button onclick="DropperCart.updateQuantity('${item.key}', ${item.quantity - 1})">&minus;</button>
            <span>${item.quantity}</span>
            <button onclick="DropperCart.updateQuantity('${item.key}', ${item.quantity + 1})">&plus;</button>
          </div>
        </div>
      </div>
    `).join('');
  },
  open() {
    document.getElementById('dropper-cart-drawer')?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  },
  close() {
    document.getElementById('dropper-cart-drawer')?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
};
