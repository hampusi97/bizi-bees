window.DropperTelemetry = (() => {
  const endpoint = 'https://dropper-os.yourdomain.com/api/telemetry/ingest';
  const sessionId = sessionStorage.getItem('dropper_sid') || crypto.randomUUID();
  sessionStorage.setItem('dropper_sid', sessionId);
  let clickHistory = [];

  function track(event, payload = {}) {
    const data = JSON.stringify({
      store: window.Shopify?.shop || location.hostname,
      sessionId,
      event,
      path: location.pathname,
      timestamp: Date.now(),
      ...payload
    });
    navigator.sendBeacon ? navigator.sendBeacon(endpoint, data) : fetch(endpoint, { method: 'POST', body: data, keepalive: true });
  }

  // Rage-Click Detector (>= 3 clicks on same element within 800ms)
  document.addEventListener('click', (e) => {
    const now = Date.now();
    const target = e.target.tagName + (e.target.id ? `#${e.target.id}` : '');
    clickHistory = clickHistory.filter(c => now - c.time < 800);
    clickHistory.push({ target, time: now });
    if (clickHistory.filter(c => c.target === target).length >= 3) {
      track('rage_click', { element: target });
      clickHistory = [];
    }
  });

  return { track };
})();
