5.1 Daily Report Generator (scripts/generate-daily-report.mjs)
Queries every store in config/stores.config.json, builds visual SVG badges, compiles metrics, writes reports/YYYY-MM-DD.md and reports/LATEST.md, updates root README.md, and optionally notifies Discord/Slack:
JavaScript
import fs from 'fs';
import path from 'path';

const stores = JSON.parse(fs.readFileSync('./config/stores.config.json', 'utf8'));

async function fetchStoreReport(store) {
  const token = process.env[`${store.envPrefix}_ADMIN_TOKEN`];
  const since = new Date(Date.now() - 86400000).toISOString();

  // Ping Storefront Latency & Uptime
  const startPing = Date.now();
  let status = '🟢 OPERATIONAL';
  try {
    const ping = await fetch(`https://${store.domain}`, { method: 'HEAD' });
    if (!ping.ok) status = `🟠 HTTP ${ping.status}`;
  } catch {
    status = '🔴 DOWN';
  }
  const latencyMs = Date.now() - startPing;

  if (!token) {
    return { ...store, status, latencyMs, revenue: 0, ordersCount: 0, aov: 0, unfulfilled: 0, topItems: [], lowStock: [] };
  }

  const headers = { 'X-Shopify-Access-Token': token, 'Content-Type': 'application/json' };
  const ordersRes = await fetch(`https://${store.domain}/admin/api/2025-10/orders.json?created_at_min=${since}&status=any`, { headers });
  const { orders = [] } = await ordersRes.json();

  const revenue = orders.reduce((sum, o) => sum + parseFloat(o.total_price || 0), 0);
  const ordersCount = orders.length;
  const aov = ordersCount > 0 ? revenue / ordersCount : 0;
  const unfulfilled = orders.filter(o => !o.fulfillment_status).length;

  // Top 3 Products Sold
  const itemMap = {};
  orders.forEach(o => (o.line_items || []).forEach(li => {
    itemMap[li.title] = (itemMap[li.title] || 0) + li.quantity;
  }));
  const topItems = Object.entries(itemMap).sort((a, b) => b[1] - a[1]).slice(0, 3);

  // Low Stock Check (< 5 units)
  const prodRes = await fetch(`https://${store.domain}/admin/api/2025-10/products.json?limit=100`, { headers });
  const { products = [] } = await prodRes.json();
  const lowStock = [];
  products.forEach(p => (p.variants || []).forEach(v => {
    if (v.inventory_quantity !== null && v.inventory_quantity < 5) {
      lowStock.push(`${p.title} (${v.inventory_quantity} left)`);
    }
  }));

  return { ...store, status, latencyMs, revenue, ordersCount, aov, unfulfilled, topItems, lowStock: lowStock.slice(0, 5) };
}

async function main() {
  const dateStr = new Date().toISOString().split('T')[0];
  const results = await Promise.all(stores.filter(s => s.active).map(fetchStoreReport));

  const totalRev = results.reduce((s, r) => s + r.revenue, 0);
  const totalOrd = results.reduce((s, r) => s + r.ordersCount, 0);
  const netAov = totalOrd > 0 ? totalRev / totalOrd : 0;
  const totalUnfulfilled = results.reduce((s, r) => s + r.unfulfilled, 0);

  let md = `# 🐝 Dropper OS: Daily Fleet Intelligence Briefing (${dateStr})\n\n`;
  md += `![Fleet Revenue](https://img.shields.io/badge/24h_Revenue-$${totalRev.toFixed(2)}-10B981?style=for-the-badge) `;
  md += `![Fleet Orders](https://img.shields.io/badge/24h_Orders-${totalOrd}-3B82F6?style=for-the-badge) `;
  md += `![Fleet AOV](https://img.shields.io/badge/Network_AOV-$${netAov.toFixed(2)}-8B5CF6?style=for-the-badge) `;
  md += `![Unfulfilled](https://img.shields.io/badge/Pending_Dispatch-${totalUnfulfilled}-F59E0B?style=for-the-badge)\n\n`;

  md += `## 📊 Network Executive Summary\n`;
  md += `| Store Name | Status | Latency | 24h Revenue | Orders | AOV | Unfulfilled |\n`;
  md += `| :--- | :--- | :--- | :--- | :--- | :--- | :--- |\n`;
  results.forEach(r => {
    md += `| **${r.name}** (\`${r.domain}\`) | ${r.status} | \`${r.latencyMs}ms\` | **$${r.revenue.toFixed(2)}** | ${r.ordersCount} | $${r.aov.toFixed(2)} | ${r.unfulfilled} |\n`;
  });

  md += `\n---\n## 🏬 Store-by-Store Deep Dive\n\n`;
  results.forEach(r => {
    md += `### ${r.name} (\`${r.customDomain || r.domain}\`)\n`;
    md += `- **Top Selling Items (24h):** ${r.topItems.length ? r.topItems.map(([t, q]) => `${t} (${q})`).join(', ') : 'No sales recorded in window'}\n`;
    md += `- **Low Stock Watchlist (< 5 units):** ${r.lowStock.length ? r.lowStock.join(' · ') : 'All items healthy'}\n`;
    md += `- **Utah Fulfillment Queue:** ${r.unfulfilled} orders awaiting dispatch\n\n`;
  });

  fs.mkdirSync('./reports', { recursive: true });
  fs.writeFileSync(path.join('./reports', `${dateStr}.md`), md);
  fs.writeFileSync(path.join('./reports', 'LATEST.md'), md);
  console.log(`[DROPPER OS]: Daily report written to reports/${dateStr}.md`);
}

main();
