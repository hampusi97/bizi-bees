export interface BanditVariant {
  id: string;
  label: string;
  impressions: number;
  conversions: number;
}

export interface BanditExperiment {
  id: string;
  storeId: string;
  epsilon: number; // 0.10 = 10% explore, 90% exploit winner
  variants: BanditVariant[];
}

export function chooseBanditVariant(exp: BanditExperiment): BanditVariant {
  if (Math.random() < exp.epsilon) {
    return exp.variants[Math.floor(Math.random() * exp.variants.length)];
  }
  return exp.variants.reduce((best, curr) => {
    const currCR = curr.impressions > 0 ? curr.conversions / curr.impressions : 0;
    const bestCR = best.impressions > 0 ? best.conversions / best.impressions : 0;
    return currCR > bestCR ? curr : best;
  });
}
