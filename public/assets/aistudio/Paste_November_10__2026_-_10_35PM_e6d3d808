import stores from '../../config/stores.config.json';
import { shopifyAdminFetch } from '../shopify-client';

export async function enforceCatalogSeparation(storeId: string, domain: string, token: string) {
  const storeConfig = stores.find(s => s.id === storeId);
  if (!storeConfig) throw new Error(`Unknown store: ${storeId}`);

  const { products } = await shopifyAdminFetch(domain, token, 'products.json?limit=250');
  const actions = [];

  for (const product of products) {
    const text = `${product.title} ${product.body_html} ${product.tags}`.toLowerCase();
    const belongsToOtherStore = stores
      .filter(s => s.id !== storeId)
      .some(other => other.keywords.some(kw => text.includes(kw.toLowerCase())));

    if (belongsToOtherStore && product.status === 'active') {
      await shopifyAdminFetch(domain, token, `products/${product.id}.json`, {
        method: 'PUT',
        body: JSON.stringify({ product: { id: product.id, status: 'draft' } })
      });
      actions.push({ id: product.id, title: product.title, action: 'ARCHIVED_TO_DRAFT_MISMATCH' });
    }
  }
  return actions;
}
