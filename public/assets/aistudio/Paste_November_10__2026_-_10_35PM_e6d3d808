import { Octokit } from '@octokit/rest';

export interface InventoryForecast {
  productId: number;
  title: string;
  currentStock: number;
  unitsSold14d: number;
  dailyBurnRate: number;
  daysRemaining: number;
  recommendedReorderQty: number;
}

export function forecastInventory(productId: number, title: string, currentStock: number, unitsSold14d: number): InventoryForecast {
  const dailyBurnRate = Math.max(0.1, unitsSold14d / 14);
  const daysRemaining = Math.round(currentStock / dailyBurnRate);
  const recommendedReorderQty = Math.ceil(dailyBurnRate * 30); // 30-day supply
  return { productId, title, currentStock, unitsSold14d, dailyBurnRate, daysRemaining, recommendedReorderQty };
}

export async function triggerRestockIssueIfNeeded(storeName: string, forecast: InventoryForecast) {
  if (forecast.daysRemaining >= 7) return null;
  const octokit = new Octokit({ auth: process.env.GITHUB_TOKEN });
  const [owner, repo] = (process.env.GITHUB_REPO || 'bizi-bees/ecosystem').split('/');

  const issueTitle = `[RESTOCK CRITICAL][${storeName}]: ${forecast.title} (${forecast.daysRemaining}d left)`;
  const { data: existing } = await octokit.issues.listForRepo({ owner, repo, state: 'open', labels: 'inventory-alert' });
  if (existing.some(i => i.title.includes(forecast.title))) return null;

  return octokit.issues.create({
    owner,
    repo,
    title: issueTitle,
