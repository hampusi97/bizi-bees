{
  "id": "luma-clinical",
  "name": "Luma Clinical Wellness",
  "brand": "Luma Clinical",
  "primary_domain": "https://lumaclinical.com",
  "default_shop_url": "luma-clinical.myshopify.com",
  "currency": "USD",
  "niche": "Clinical Beauty, Phototherapy & At-Home Recovery",
  "target_aov": "$39 - $119",
  "channels": [
    "tiktok_shop",
    "meta_ads",
    "google_shopping",
    "youtube_shopping"
  ],
  "env_prefix": "LUMA",
  "env_vars": {
    "shop_url": "SHOPIFY_STORE_LUMA_URL",
    "admin_token": "SHOPIFY_ADMIN_ACCESS_TOKEN_LUMA",
    "theme_token": "SHOPIFY_CLI_THEME_TOKEN_LUMA",
    "custom_domain": "LUMA_PRIMARY_DOMAIN"
  },
  "theme_path": "stores/luma-clinical/theme",
  "catalog_path": "stores/luma-clinical/catalog/products.json",
  "meta": {
    "support_email": "care@lumaclinical.com",
    "dispatch_location": "Utah, USA",
    "guarantee_days": 60,
    "theme_color": "#0d9488"
  }
}
