{% layout none %}<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
  <channel>
    <title>{{ shop.name | escape }}</title>
    <link>{{ shop.url }}</link>
    <description>{{ shop.description | default: "Curated secondhand treasures and Luma clinical wellness tech." | escape }}</description>
    
    {% for product in collections['luma-wellness'].products %}
      {% if product.available %}
        <item>
          <g:id>{{ product.id }}</g:id>
          <g:title>{{ product.title | strip_html | truncate: 150 | escape }}</g:title>
          <g:description>{{ product.description | strip_html | truncate: 5000 | escape }}</g:description>
          <g:link>{{ shop.url }}{{ product.url }}</g:link>
          {% if product.featured_image %}
            <g:image_link>https:{{ product.featured_image | image_url: width: 1200 }}</g:image_link>
          {% endif %}
          <g:price>{{ product.selected_or_first_available_variant.price | money_without_currency | remove: "," }} USD</g:price>
          <g:availability>in_stock</g:availability>
          <g:brand>{{ product.vendor | default: shop.name | escape }}</g:brand>
          <g:condition>new</g:condition>
          <g:google_product_category>5499</g:google_product_category>
          <g:identifier_exists>false</g:identifier_exists>
        </item>
      {% endif %}
    {% endfor %}

    {% paginate collections.all.products by 250 %}
      {% for product in collections.all.products %}
        {% unless product.vendor == "Luma Wellness" %}
          {% if product.available %}
            <item>
              <g:id>{{ product.id }}</g:id>
              <g:title>{{ product.title | strip_html | truncate: 150 | escape }}</g:title>
              <g:description>{{ product.description | strip_html | truncate: 5000 | escape }}</g:description>
              <g:link>{{ shop.url }}{{ product.url }}</g:link>
              {% if product.featured_image %}
                <g:image_link>https:{{ product.featured_image | image_url: width: 1200 }}</g:image_link>
              {% endif %}
              <g:price>{{ product.selected_or_first_available_variant.price | money_without_currency | remove: "," }} USD</g:price>
              <g:availability>in_stock</g:availability>
              <g:brand>{{ product.vendor | default: shop.name | escape }}</g:brand>
              <g:condition>used</g:condition>
              <g:google_product_category>{% if product.type == 'Book' or product.tags contains 'Books' or product.tags contains 'book' %}784{% else %}536{% endif %}</g:google_product_category>
              <g:identifier_exists>false</g:identifier_exists>
            </item>
          {% endif %}
        {% endunless %}
      {% endfor %}
    {% endpaginate %}
  </channel>
</rss>
