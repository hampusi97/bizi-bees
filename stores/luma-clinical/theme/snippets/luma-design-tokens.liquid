{% comment %}
  Luma Clinical Wellness - Design System Variables & Utilities
  File: snippets/luma-design-tokens.liquid
{% endcomment %}

<style>
  :root {
    --luma-bg-base: #FAFAFC;
    --luma-bg-card: #FFFFFF;
    --luma-bg-surface: #F3F4F8;
    --luma-text-heading: #111827;
    --luma-text-body: #374151;
    --luma-text-muted: #6B7280;
    --luma-accent-teal: #0D9488;
    --luma-accent-teal-hover: #0F766E;
    --luma-accent-teal-soft: #CCFBF1;
    --luma-accent-rose: #C08479;
    --luma-accent-rose-soft: #FDF2F0;
    --luma-trust-green: #059669;
    --luma-trust-green-soft: #ECFDF5;
    --luma-border-light: #E5E7EB;
    --luma-border-card: rgba(229, 231, 235, 0.85);
    --luma-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --luma-shadow-md: 0 4px 16px -2px rgba(17, 24, 39, 0.06), 0 2px 6px -1px rgba(17, 24, 39, 0.03);
    --luma-shadow-lg: 0 12px 32px -4px rgba(17, 24, 39, 0.08), 0 4px 12px -2px rgba(17, 24, 39, 0.03);
    --luma-radius-sm: 8px;
    --luma-radius-md: 12px;
    --luma-radius-lg: 16px;
    --luma-radius-full: 9999px;
    --luma-font-heading: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --luma-font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .luma-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--luma-radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .luma-badge-teal {
    background-color: var(--luma-accent-teal-soft);
    color: var(--luma-accent-teal-hover);
    border: 1px solid rgba(13, 148, 136, 0.2);
  }

  .luma-badge-green {
    background-color: var(--luma-trust-green-soft);
    color: var(--luma-trust-green);
    border: 1px solid rgba(5, 150, 105, 0.2);
  }

  .luma-badge-rose {
    background-color: var(--luma-accent-rose-soft);
    color: var(--luma-accent-rose);
    border: 1px solid rgba(192, 132, 121, 0.2);
  }

  .luma-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--luma-accent-teal);
    color: #FFFFFF !important;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 14px 28px;
    border-radius: var(--luma-radius-full);
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.25);
    border: 1px solid transparent;
    cursor: pointer;
  }

  .luma-btn-primary:hover {
    background-color: var(--luma-accent-teal-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(13, 148, 136, 0.35);
  }

  .luma-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #FFFFFF;
    color: var(--luma-text-heading) !important;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 14px 26px;
    border-radius: var(--luma-radius-full);
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid var(--luma-border-light);
    box-shadow: var(--luma-shadow-sm);
    cursor: pointer;
  }

  .luma-btn-secondary:hover {
    background-color: #F9FAFB;
    border-color: #D1D5DB;
    transform: translateY(-1px);
  }
</style>
