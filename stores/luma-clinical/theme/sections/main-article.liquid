<div class="wrap block article"><p class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</p><h1>{{ article.title | escape }}</h1>{% if article.image %}<img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" width="1200" style="max-width:100%;border-radius:14px">{% endif %}<div class="prose">{{ article.content }}</div><p class="muted">Good finds, clearly described. <a href="{{ blog.url }}">More from the hive →</a></p></div>
{% schema %}{"name": "Main Article", "settings": [], "presets": [{"name": "Main Article"}]}{% endschema %}
