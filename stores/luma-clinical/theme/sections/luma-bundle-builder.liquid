<script>
  /**
   * Shopify AJAX Cart API Bundle Engine
   * Dispatches instantaneous 1-click cart addition via /cart/add.js
   * and updates free shipping threshold progress triggers.
   */
  function addLumaBundleTier(event, tierNumber, wandVariantId, bundlePrice, serumVariantId, maskVariantId) {
    event.preventDefault();
    var btn = event.currentTarget;
    if (btn.disabled) return;

    var originalHTML = btn.innerHTML;
    var loadingText = btn.getAttribute('data-loading-text') || 'Adding Bundle...';
    btn.disabled = true;
    btn.innerHTML = '<span>⚡ ' + loadingText + '</span><small>Connecting to Shopify Bag...</small>';

    // Build payload items
    var itemsToAdd = [];
    var tierTitles = {
      1: 'Solo Wand',
      2: 'Glow Ritual Bundle [Featured / Best Value]',
      3: 'Clinical Spa System'
    };

    var tierName = tierTitles[tierNumber] || ('Luma Bundle Tier ' + tierNumber);

    // Primary Wand
    itemsToAdd.push({
      id: parseInt(wandVariantId, 10),
      quantity: 1,
      properties: {
        'Bundle Package': tierName,
        'Auto Fulfillment Flag': 'SUPPLIER-FACILITY-FULFILLMENT',
        'Fulfillment Facility': 'Specialized Logistics Facility / Utah Hub',
        'Shipping SLA': '2-4 Business Days Priority Tracked',
        '_bundle_tier': 'tier-' + tierNumber,
        '_bundle_price': '$' + bundlePrice
      }
    });

    // Addon 1 (Serum) for Tiers 2 & 3
    if (serumVariantId && (tierNumber === 2 || tierNumber === 3)) {
      itemsToAdd.push({
        id: parseInt(serumVariantId, 10),
        quantity: 1,
        properties: {
          'Bundle Package': tierName,
          'Included Item': 'Conductive Hydration Activating Serum (50ml)',
          'Auto Fulfillment Flag': 'SUPPLIER-FACILITY-FULFILLMENT',
          '_bundled_with': String(wandVariantId)
        }
      });
    }

    // Addon 2 (LED Mask) for Tier 3
    if (maskVariantId && tierNumber === 3) {
      itemsToAdd.push({
        id: parseInt(maskVariantId, 10),
        quantity: 1,
        properties: {
          'Bundle Package': tierName,
          'Included Item': 'LumaMask 7-Color Clinical LED Therapy Mask',
          'Auto Fulfillment Flag': 'SUPPLIER-FACILITY-FULFILLMENT',
          '_bundled_with': String(wandVariantId)
        }
      });
    }

    // Execute AJAX addition
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ items: itemsToAdd })
    })
    .then(function(response) {
      if (!response.ok) {
        throw new Error('Network response was not ok: ' + response.statusText);
      }
      return response.json();
    })
    .then(function(cartData) {
      // Also ensure order-level cart attributes are assigned
      var cartAttributes = {
        'Auto_Fulfillment_Flag': 'SUPPLIER-FACILITY-FULFILLMENT',
        'Fulfillment_Facility': 'Specialized Logistics Facility / Utah Hub',
        'Vendor_Routing': 'Luma Wellness / Clinical Logistics',
        'Bundle_Selected': tierName
      };

      if (bundlePrice >= 50.00) {
        cartAttributes['Free_Shipping_Unlocked'] = 'true';
      }

      return fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: cartAttributes })
      });
    })
    .then(function() {
      // Trigger free shipping celebrations
      updateBundleShippingMeter(bundlePrice);

      btn.innerHTML = '<span>✓ ADDED TO BAG!</span><small>🎉 Free Shipping Unlocked! Redirecting...</small>';
      btn.style.background = '#059669';

      // Dispatch custom store event for mini-carts and sticky bars
      document.dispatchEvent(new CustomEvent('bizi:cart:refresh', { detail: { tier: tierNumber, price: bundlePrice } }));
      document.dispatchEvent(new CustomEvent('cart:updated'));

      setTimeout(function() {
        window.location.href = '/cart';
      }, 700);
    })
    .catch(function(err) {
      console.warn('AJAX bundle error, fallbacking to direct cart addition:', err);
      // Fallback
      window.location.href = '/cart/' + wandVariantId + ':1';
    });
  }

  function updateBundleShippingMeter(amount) {
    var meter = document.getElementById('bundle-free-shipping-meter');
    var icon = document.getElementById('shipping-meter-icon');
    var text = document.getElementById('shipping-meter-status');
    var fill = document.getElementById('shipping-meter-fill');

    if (!meter || !text || !fill) return;

    if (amount >= 50.00) {
      meter.classList.add('unlocked');
      if (icon) icon.textContent = '🎉';
      text.innerHTML = '<strong>CONGRATULATIONS!</strong> You have unlocked <strong>FREE Tracked US Shipping!</strong>';
      fill.style.width = '100%';
      fill.style.background = '#059669';
    } else {
      var remaining = (50.00 - amount).toFixed(2);
      text.innerHTML = 'Add <strong>$' + remaining + '</strong> more to unlock <strong>FREE US Priority Tracked Shipping</strong>!';
      var pct = Math.min(100, Math.round((amount / 50.00) * 100));
      fill.style.width = pct + '%';
    }
  }
</script>

