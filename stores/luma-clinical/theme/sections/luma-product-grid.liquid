<style>
  #luma-grid-{{ section.id }} {
    padding: 72px 0 64px;
    background-color: #FAFAFC;
    font-family: var(--luma-font-body);
  }

  .luma-grid__container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .luma-grid__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }

  .luma-grid__title {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 800;
    color: var(--luma-text-heading);
    letter-spacing: -0.02em;
    margin: 14px 0 10px;
  }

  .luma-grid__subtitle {
    font-size: 1.05rem;
    color: var(--luma-text-body);
    line-height: 1.6;
    margin: 0;
  }

  /* 3-column desktop, 2-col tablet, 1-col mobile */
  .luma-product-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .luma-card {
    background: #FFFFFF;
    border: 1px solid var(--luma-border-card);
    border-radius: var(--luma-radius-lg);
    box-shadow: var(--luma-shadow-sm);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luma-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--luma-shadow-lg);
  }

  .luma-card__badge-wrap {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
  }

  .luma-card__image-wrap {
    position: relative;
    background: linear-gradient(180deg, #F9FAFB 0%, #FFFFFF 100%);
    padding: 40px 24px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 220px;
    border-bottom: 1px solid rgba(229, 231, 235, 0.5);
  }

  .luma-card__glow-bg {
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(13, 148, 136, 0.08) 0%, transparent 70%);
  }

  .luma-card__svg-mock {
    width: 130px;
    height: 150px;
    position: relative;
    z-index: 1;
  }

  .luma-card__content {
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .luma-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .luma-rating__count {
    font-size: 0.78rem;
    color: var(--luma-text-muted);
    font-weight: 600;
  }

  .luma-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 8px;
  }

  .luma-card__title a {
    color: var(--luma-text-heading);
    text-decoration: none;
    transition: color 0.2s;
  }

  .luma-card__title a:hover {
    color: var(--luma-accent-teal);
  }

  .luma-card__benefit {
    font-size: 0.85rem;
    color: var(--luma-text-muted);
    line-height: 1.45;
    margin: 0 0 20px;
    flex-grow: 1;
  }

  .luma-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--luma-border-light);
    margin-bottom: 12px;
  }

  .luma-card__pricing {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .luma-card__price {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--luma-accent-teal);
  }

  .luma-card__compare {
    font-size: 0.88rem;
    color: #9CA3AF;
    text-decoration: line-through;
  }

  .luma-card__btn {
    padding: 10px 18px;
    font-size: 0.88rem;
  }

  .luma-card__stock-strip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--luma-trust-green);
  }

  @media (max-width: 991px) {
    .luma-product-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    #luma-grid-{{ section.id }} {
      padding: 44px 0 36px;
    }

    .luma-product-cards-grid {
      grid-template-columns: 1fr;
    }

    .luma-card__content {
      padding: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Luma Clinical Device Grid",
  "tag": "section",
  "class": "luma-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge Label",
      "default": "Engineered For Daily Clinical Protocols"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "The Luma Clinical Device Suite"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subheading",
      "default": "Targeted 630nm phototherapy, microcurrent sculpting, and cryogenic vasoconstriction. Shipped with tracked Utah dispatch."
    }
  ],
  "presets": [
    {
      "name": "Luma Clinical Device Grid"
    }
  ]
}
{% endschema %}
