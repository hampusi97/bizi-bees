{% comment %}
  Luma Clinical Wellness - High-Trust Restructured Footer
  File: sections/luma-clinical-footer.liquid
{% endcomment %}

<footer class="luma-footer" id="luma-footer-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-footer__container">
    
    <!-- Top Medical Trust Seals Strip -->
    <div class="luma-footer__trust-strip">
      <div class="luma-trust-item">
        <div class="luma-trust-item__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="luma-trust-item__text">
          <strong>60-Day Risk-Free Glow Guarantee</strong>
          <span>Full refund if not completely transformed</span>
        </div>
      </div>

      <div class="luma-trust-item">
        <div class="luma-trust-item__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <div class="luma-trust-item__text">
          <strong>Tracked Utah Dispatch</strong>
          <span>Fast USPS 2–4 day fulfillment from Salt Lake City</span>
        </div>
      </div>

      <div class="luma-trust-item">
        <div class="luma-trust-item__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div class="luma-trust-item__text">
          <strong>Dermatologist Verified</strong>
          <span>Tested wavelengths & medical-grade silicone</span>
        </div>
      </div>

      <div class="luma-trust-item">
        <div class="luma-trust-item__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <div class="luma-trust-item__text">
          <strong>256-Bit Encrypted Checkout</strong>
          <span>PCI compliant with Shop Pay & Apple Pay</span>
        </div>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="luma-footer__main-grid">
      
      <!-- Brand & Mission Column -->
      <div class="luma-footer__col luma-footer__col--brand">
        <div class="luma-footer__brand-title">
          <span class="luma-footer__brand-dot"></span>
          LUMA CLINICAL WELLNESS
        </div>
        <p class="luma-footer__brand-desc">
          Engineering medical-grade photobiomodulation, microcurrent sculpting, and thermal therapy into ergonomic home devices. Bringing clinical dermatological efficacy directly to your routine without the 10x clinic markup.
        </p>

        <!-- Newsletter Sign-up -->
        <div class="luma-footer__newsletter">
          <span class="luma-footer__news-label">Receive the 28-Day Protocol Guide & 10% Off</span>
          {% form 'customer', class: 'luma-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,luma_protocol">
            <div class="luma-footer__input-wrap">
              <input 
                type="email" 
                name="contact[email]" 
                class="luma-footer__input" 
                placeholder="Enter your email" 
                required
                aria-label="Email address"
              >
              <button type="submit" class="luma-footer__submit-btn" aria-label="Subscribe">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
          {% endform %}
        </div>
      </div>

      <!-- Navigation Column 1: Clinical Line -->
      <div class="luma-footer__col">
        <h4 class="luma-footer__col-title">Clinical Devices</h4>
        <ul class="luma-footer__links">
          <li><a href="/products/lumaglow-4-in-1-facial-wand">LumaGlow™ 4-in-1 Wand ($38.99)</a></li>
          <li><a href="/products/lumarelief-migraine-2-cap-rotation-pack">LumaRelief™ Migraine 2-Cap ($22.74)</a></li>
          <li><a href="/products/lumalift-v-face-microcurrent-sculptor">LumaLift™ V-Face Sculptor ($42.24)</a></li>
          <li><a href="/products/lumamask-7-color-led-shield">LumaMask™ 7-Color LED ($84.49)</a></li>
          <li><a href="/products/lumaclean-sonic-brush-cleaner">LumaClean™ Sonic Cleaner ($19.49)</a></li>
          <li><a href="/products/lumasculpt-ultrasonic-body-contouring">LumaSculpt™ Body Contouring ($58.49)</a></li>
        </ul>
      </div>

      <!-- Navigation Column 2: Science & Education -->
      <div class="luma-footer__col">
        <h4 class="luma-footer__col-title">The Science</h4>
        <ul class="luma-footer__links">
          <li><a href="/pages/clinical-studies">Clinical Perception Studies</a></li>
          <li><a href="/pages/phototherapy-wavelengths">630nm Wavelength Science</a></li>
          <li><a href="/pages/microcurrent-protocol">Microcurrent Treatment Guide</a></li>
          <li><a href="/pages/dermatologist-reviews">Dermatologist Advisory Board</a></li>
          <li><a href="/pages/skincare-quiz">30-Second Skin Diagnostic</a></li>
        </ul>
      </div>

      <!-- Navigation Column 3: Trust & Patient Care -->
      <div class="luma-footer__col">
        <h4 class="luma-footer__col-title">Patient Care</h4>
        <ul class="luma-footer__links">
          <li><a href="/pages/track-order">Track Utah Dispatch</a></li>
          <li><a href="/pages/60-day-guarantee">60-Day Glow Guarantee</a></li>
          <li><a href="/pages/returns-warranty">Returns & 1-Year Warranty</a></li>
          <li><a href="/pages/faq">Device FAQ & Usage Rules</a></li>
          <li><a href="/pages/contact">Contact Medical Support</a></li>
        </ul>
      </div>

    </div>

    <!-- Regulatory Compliance & FDA Disclaimer Section -->
    <div class="luma-footer__compliance">
      <div class="luma-footer__fda-box">
        <p class="luma-footer__fda-text">
          <strong>FDA COMPLIANCE & COSMETIC DEVICE NOTICE:</strong> Statements made regarding these cosmetic wellness devices have not been evaluated by the Food and Drug Administration. Luma Clinical Wellness devices and accessories are designed solely for cosmetic beautification, lymphatic drainage, and facial muscle relaxation. These products are not intended to diagnose, treat, cure, or prevent any medical condition or disease. Always consult a licensed dermatologist or medical physician before beginning any new dermal regimen.
        </p>
      </div>

      <div class="luma-footer__dispatch-notice">
        <span>📍 <strong>Operations & Logistics:</strong> Designed in California. Inspected, quality-tested, and dispatched directly from our fulfillment center in Salt Lake City, Utah, USA.</span>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="luma-footer__bottom">
      <div class="luma-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} Luma Clinical Wellness Inc. All rights reserved.
      </div>
      <div class="luma-footer__legal-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <a href="/policies/terms-of-service">Terms of Service</a>
        <a href="/policies/refund-policy">60-Day Guarantee Policy</a>
        <a href="/policies/shipping-policy">Shipping & Dispatch</a>
      </div>
    </div>

  </div>
</footer>

<style>
  #luma-footer-{{ section.id }} {
    background-color: #111827;
    color: #F3F4F6;
    padding: 64px 0 32px;
    font-family: var(--luma-font-body);
    font-size: 0.9rem;
    border-top: 1px solid #1F2937;
  }

  .luma-footer__container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Trust Strip */
  .luma-footer__trust-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-bottom: 48px;
    margin-bottom: 48px;
    border-bottom: 1px solid #1F2937;
  }

  .luma-trust-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .luma-trust-item__icon {
    color: var(--luma-accent-teal);
    flex-shrink: 0;
  }

  .luma-trust-item__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .luma-trust-item__text strong {
    font-size: 0.88rem;
    color: #FFFFFF;
  }

  .luma-trust-item__text span {
    font-size: 0.78rem;
    color: #9CA3AF;
    line-height: 1.4;
  }

  /* Main Grid */
  .luma-footer__main-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .luma-footer__brand-title {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .luma-footer__brand-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--luma-accent-teal);
  }

  .luma-footer__brand-desc {
    color: #9CA3AF;
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 360px;
  }

  .luma-footer__news-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: #D1D5DB;
    margin-bottom: 8px;
  }

  .luma-footer__input-wrap {
    display: flex;
    align-items: center;
    background: #1F2937;
    border: 1px solid #374151;
    border-radius: var(--luma-radius-full);
    padding: 4px;
    max-width: 340px;
    transition: border-color 0.2s ease;
  }

  .luma-footer__input-wrap:focus-within {
    border-color: var(--luma-accent-teal);
  }

  .luma-footer__input {
    background: transparent;
    border: none;
    padding: 10px 16px;
    color: #FFFFFF;
    font-size: 0.88rem;
    width: 100%;
    outline: none;
  }

  .luma-footer__input::placeholder {
    color: #6B7280;
  }

  .luma-footer__submit-btn {
    background: var(--luma-accent-teal);
    color: #FFFFFF;
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .luma-footer__submit-btn:hover {
    background: var(--luma-accent-teal-hover);
  }

  .luma-footer__col-title {
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #FFFFFF;
    margin: 0 0 20px;
  }

  .luma-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .luma-footer__links a {
    color: #9CA3AF;
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .luma-footer__links a:hover {
    color: var(--luma-accent-teal);
  }

  /* Compliance & Disclaimers */
  .luma-footer__compliance {
    padding-top: 32px;
    border-top: 1px solid #1F2937;
    margin-bottom: 32px;
  }

  .luma-footer__fda-box {
    background: #161F30;
    border: 1px solid #1F2E47;
    border-radius: var(--luma-radius-md);
    padding: 16px 20px;
    margin-bottom: 16px;
  }

  .luma-footer__fda-text {
    font-size: 0.76rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .luma-footer__dispatch-notice {
    font-size: 0.8rem;
    color: #9CA3AF;
    display: flex;
    align-items: center;
  }

  /* Bottom Bar */
  .luma-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid #1F2937;
    font-size: 0.8rem;
    color: #6B7280;
  }

  .luma-footer__legal-links {
    display: flex;
    gap: 20px;
  }

  .luma-footer__legal-links a {
    color: #6B7280;
    text-decoration: none;
    transition: color 0.2s;
  }

  .luma-footer__legal-links a:hover {
    color: #9CA3AF;
  }

  @media (max-width: 991px) {
    .luma-footer__trust-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .luma-footer__main-grid {
      grid-template-columns: 1fr 1fr;
    }

    .luma-footer__col--brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .luma-footer__trust-strip {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .luma-footer__main-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .luma-footer__col--brand {
      grid-column: span 1;
    }

    .luma-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .luma-footer__legal-links {
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Luma High-Trust Footer",
  "tag": "footer",
  "class": "luma-footer-section",
  "settings": [],
  "presets": [
    {
      "name": "Luma High-Trust Footer"
    }
  ]
}
{% endschema %}
