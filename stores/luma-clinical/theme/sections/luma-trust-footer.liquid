{% comment %}
  Luma High-Trust Compliance Footer - Shopify OS 2.0
  Purges all aggressive legal threats and replaces with high-trust compliance architecture:
    - 60-Day Risk-Free Glow Guarantee Badge
    - Official FDA Cosmetic Device Statement
    - Clean Navigation Links: Track Order, 60-Day Guarantee, Shipping Policy, Contact Us, Terms of Service
    - Secure Payment Method Icons (Shop Pay, Apple Pay, PayPal, Visa, Mastercard, Amex)
{% endcomment %}

<footer class="luma-trust-footer" id="luma-footer-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="luma-footer-container">
    
    <!-- Top Trust Pillars Ribbon -->
    <div class="luma-footer-pillars">
      <div class="pillar-item">
        <div class="pillar-icon-box">🛡️</div>
        <div class="pillar-content">
          <strong>60-Day Glow Guarantee</strong>
          <span>100% money-back if not fully satisfied</span>
        </div>
      </div>

      <div class="pillar-item">
        <div class="pillar-icon-box">📦</div>
        <div class="pillar-content">
          <strong>Fast Utah Dispatch</strong>
          <span>Orders ship in 24h via tracked USPS</span>
        </div>
      </div>

      <div class="pillar-item">
        <div class="pillar-icon-box">🔒</div>
        <div class="pillar-content">
          <strong>Safe &amp; Secure Checkout</strong>
          <span>Encrypted with 256-bit bank security</span>
        </div>
      </div>

      <div class="pillar-item">
        <div class="pillar-icon-box">💬</div>
        <div class="pillar-content">
          <strong>Dedicated Support</strong>
          <span>Friendly assistance based in the USA</span>
        </div>
      </div>
    </div>

    <!-- Main Navigation & Brand Grid -->
    <div class="luma-footer-main">
      <!-- Col 1: Brand & Mission -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">
          <span class="logo-text">Luma Wellness &amp; Bizi Bees</span>
        </a>
        <p class="brand-bio">
          Empowering your everyday skincare routine with clinical-grade at-home phototherapy and curated lifestyle finds. Thoughtfully inspected and dispatched directly from Provo, Utah.
        </p>
        <div class="social-links-row">
          <a href="https://instagram.com/shoplumawellness" target="_blank" rel="noopener" aria-label="Instagram">
            <svg class="social-svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@shoplumawellness</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Customer Care -->
      <div class="footer-col">
        <h4 class="col-title">Customer Care</h4>
        <ul class="footer-nav-list">
          <li><a href="/pages/track-order">Track Order</a></li>
          <li><a href="/pages/glow-guarantee">60-Day Guarantee</a></li>
          <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Col 3: Collections & Discover -->
      <div class="footer-col">
        <h4 class="col-title">Discover</h4>
        <ul class="footer-nav-list">
          <li><a href="/collections/luma-wellness">Luma Wellness Devices</a></li>
          <li><a href="/products/lumaglow-4-in-1-red-light-microcurrent-facial-sculpting-wand">LumaGlow 4-in-1 Wand</a></li>
          <li><a href="/pages/skincare-routine-quiz">Take 30-Sec Skin Quiz</a></li>
          <li><a href="/pages/about">About Our Mission</a></li>
          <li><a href="/policies/refund-policy">Refund &amp; Return Policy</a></li>
        </ul>
      </div>

      <!-- Col 4: Guarantee Badge & Verified Safe -->
      <div class="footer-col badge-col">
        <div class="guarantee-card">
          <div class="guarantee-header">
            <span class="guarantee-icon">🛡️</span>
            <div>
              <strong>60-Day Glow Guarantee</strong>
              <small>100% Risk-Free Trial</small>
            </div>
          </div>
          <p class="guarantee-copy">
            Try LumaGlow in your daily skincare routine for a full 60 days. If you don't experience visible facial contouring and a radiant skin glow, email us for a hassle-free return and full refund.
          </p>
          <div class="dispatch-tag">📍 Shipped Fast From Utah, USA</div>
        </div>
      </div>
    </div>

    <!-- Official FDA Cosmetic Device Compliance Statement -->
    <div class="luma-fda-box">
      <div class="fda-header">
        <span class="fda-badge">COMPLIANCE DISCLOSURE</span>
        <strong>FDA Cosmetic Device Statement</strong>
      </div>
      <p class="fda-text">
        These statements and products have not been evaluated by the Food and Drug Administration (FDA). This product is a non-invasive cosmetic device intended for facial beautification, aesthetic skin tone improvement, and personal aesthetic care. It is not intended to diagnose, treat, cure, or prevent any medical condition or disease. Consult your healthcare professional or dermatologist prior to use if you have any preexisting skin conditions or medical concerns.
      </p>
    </div>

    <!-- Bottom Bar: Copyright & Payment Badges -->
    <div class="luma-footer-bottom">
      <div class="bottom-copy">
        &copy; {{ "now" | date: "%Y" }} <strong>{{ shop.name | escape }}</strong> &amp; <strong>Luma Wellness</strong>. All rights reserved.
      </div>

      <div class="payment-methods-strip">
        <span class="pay-icon" title="Shop Pay">Shop Pay</span>
        <span class="pay-icon" title="Apple Pay">Apple Pay</span>
        <span class="pay-icon" title="PayPal">PayPal</span>
        <span class="pay-icon" title="Visa">Visa</span>
        <span class="pay-icon" title="Mastercard">Mastercard</span>
        <span class="pay-icon" title="American Express">Amex</span>
      </div>
    </div>

  </div>
</footer>

<style>
  #luma-footer-{{ section.id }} {
    background: #111827;
    color: #F3F4F6;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    padding: 56px 24px 32px 24px;
    border-top: 1px solid #1F2937;
  }

  .luma-footer-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Pillars Ribbon */
  .luma-footer-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding-bottom: 40px;
    border-bottom: 1px solid #1F2937;
    margin-bottom: 44px;
  }

  .pillar-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pillar-icon-box {
    font-size: 24px;
    background: #1F2937;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pillar-content strong {
    display: block;
    font-size: 13.5px;
    color: #FFFFFF;
    font-weight: 700;
  }

  .pillar-content span {
    font-size: 11.5px;
    color: #9CA3AF;
  }

  /* Main Columns */
  .luma-footer-main {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 40px;
    margin-bottom: 44px;
  }

  .brand-col .footer-logo {
    display: inline-block;
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-decoration: none;
    margin-bottom: 12px;
  }

  .brand-bio {
    font-size: 13px;
    line-height: 1.6;
    color: #9CA3AF;
    margin: 0 0 16px 0;
    max-width: 320px;
  }

  .social-links-row a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #D1D5DB;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .social-links-row a:hover {
    color: #0D9488;
  }

  .social-svg {
    width: 15px;
    height: 15px;
  }

  .col-title {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin: 0 0 16px 0;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-nav-list li {
    margin-bottom: 10px;
  }

  .footer-nav-list a {
    color: #9CA3AF;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.15s ease;
  }

  .footer-nav-list a:hover {
    color: #FFFFFF;
  }

  /* Guarantee Card */
  .guarantee-card {
    background: #1F2937;
    border: 1px solid #374151;
    border-radius: 16px;
    padding: 18px;
  }

  .guarantee-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .guarantee-icon {
    font-size: 22px;
  }

  .guarantee-header strong {
    display: block;
    font-size: 13.5px;
    color: #FFFFFF;
  }

  .guarantee-header small {
    color: #10B981;
    font-weight: 700;
    font-size: 11px;
  }

  .guarantee-copy {
    font-size: 12px;
    line-height: 1.5;
    color: #D1D5DB;
    margin: 0 0 12px 0;
  }

  .dispatch-tag {
    font-size: 11px;
    font-weight: 700;
    color: #FBBF24;
    background: rgba(251, 191, 36, 0.1);
    padding: 4px 8px;
    border-radius: 6px;
    display: inline-block;
  }

  /* FDA Compliance Box */
  .luma-fda-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid #1F2937;
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 32px;
  }

  .fda-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .fda-badge {
    background: #374151;
    color: #E5E7EB;
    font-size: 9px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .fda-header strong {
    font-size: 11.5px;
    color: #D1D5DB;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .fda-text {
    font-size: 11px;
    line-height: 1.55;
    color: #9CA3AF;
    margin: 0;
  }

  /* Bottom Bar */
  .luma-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 24px;
    border-top: 1px solid #1F2937;
  }

  .bottom-copy {
    font-size: 11.5px;
    color: #6B7280;
  }

  .payment-methods-strip {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pay-icon {
    background: #1F2937;
    color: #D1D5DB;
    font-size: 10px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid #374151;
  }

  @media (max-width: 900px) {
    .luma-footer-pillars {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .luma-footer-main {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Luma Trust Footer",
  "tag": "footer",
  "class": "section-luma-footer",
  "settings": [],
  "presets": [
    {
      "name": "Luma Trust Footer"
    }
  ]
}
{% endschema %}
