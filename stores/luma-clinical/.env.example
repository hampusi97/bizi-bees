# Shopify Admin API Credentials for Luma Clinical
# (Set in GitHub Secrets as SHOPIFY_STORE_LUMA_URL and SHOPIFY_ADMIN_ACCESS_TOKEN_LUMA)
SHOPIFY_STORE_LUMA_URL="luma-clinical.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN_LUMA="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shopify Theme Deployment CLI Token (optional, for automated theme pushes)
SHOPIFY_CLI_THEME_TOKEN_LUMA="shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public Branding & Custom Domain
LUMA_PRIMARY_DOMAIN="https://lumaclinical.com"
LUMA_SUPPORT_EMAIL="care@lumaclinical.com"
