# ==============================================================================
# Environment Configuration: Store 2 — Bizi Bees Vintage
# Domain: https://shopbizibees.com
# ==============================================================================

# Shopify Admin API Credentials for Bizi Bees Vintage
# (Set in GitHub Secrets as SHOPIFY_STORE_BIZIBEES_URL and SHOPIFY_ADMIN_ACCESS_TOKEN_BIZIBEES)
SHOPIFY_STORE_BIZIBEES_URL="bizibees-store.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN_BIZIBEES="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Shopify Theme Deployment CLI Token (optional)
SHOPIFY_CLI_THEME_TOKEN_BIZIBEES="shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public Branding & Custom Domain
BIZIBEES_PRIMARY_DOMAIN="https://shopbizibees.com"
BIZIBEES_SUPPORT_EMAIL="hello@shopbizibees.com"
