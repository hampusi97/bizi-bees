{% comment %}
  Multi-Channel Metafields & Auto-Fulfillment Automation Engine
  Repo: bizi-bees /snippets/fulfillment-automation-tags.liquid
  Injects automated meta tags and cart attributes ensuring all orders include
  auto-fulfillment flags based on product vendor (Provo vs. Supplier Facility).
{% endcomment %}

<!-- Product-Level Automated Multi-Channel Fulfillment Meta Tags -->
{% if request.page_type == 'product' %}
  {% assign current_vendor = product.vendor | default: shop.name | strip %}
  {% if current_vendor == 'Bizi Bees' or current_vendor == 'Book Outpost' or current_vendor == shop.name %}
    <meta name="order:fulfillment_facility" content="Provo Workshop, UT">
    <meta name="order:auto_fulfillment_flag" content="PROVO-DOMESTIC-FULFILLMENT">
    <meta name="order:vendor_routing" content="Provo Studio (Kimberly Harter)">
    <meta name="order:dispatch_origin" content="Provo, Utah, United States">
    <meta name="order:fulfillment_sla" content="Same-Day / 24-Hour Dispatch">
    <meta property="business:contact_data:locality" content="Provo">
    <meta property="business:contact_data:region" content="Utah">
    <meta property="business:contact_data:country_name" content="United States">
  {% else %}
    <meta name="order:fulfillment_facility" content="Specialized Logistics Facility / Utah Hub">
    <meta name="order:auto_fulfillment_flag" content="SUPPLIER-FACILITY-FULFILLMENT">
    <meta name="order:vendor_routing" content="{{ current_vendor }} / Clinical Supplier Logistics">
    <meta name="order:dispatch_origin" content="Utah Domestic Clinical Hub">
    <meta name="order:fulfillment_sla" content="24-48 Hour Priority Dispatch">
  {% endif %}
  <meta name="order:inventory_policy" content="Auto-Routed Fulfillment">
{% endif %}

<!-- Cart & Order Level Automated Routing Tags -->
{% assign provo_count = 0 %}
{% assign supplier_count = 0 %}

{% for item in cart.items %}
  {% assign item_vendor = item.product.vendor | default: shop.name | strip %}
  {% if item_vendor == 'Bizi Bees' or item_vendor == 'Book Outpost' or item_vendor == shop.name %}
    {% assign provo_count = provo_count | plus: item.quantity %}
  {% else %}
    {% assign supplier_count = supplier_count | plus: item.quantity %}
  {% endif %}
{% endfor %}

{% if provo_count > 0 and supplier_count > 0 %}
  {% assign global_fulfillment_flag = 'SPLIT-FULFILLMENT-PROVO-SUPPLIER' %}
  {% assign global_facility_name = 'Split (Provo Studio + Supplier Facility)' %}
{% elsif provo_count > 0 %}
  {% assign global_fulfillment_flag = 'PROVO-DOMESTIC-FULFILLMENT' %}
  {% assign global_facility_name = 'Provo Domestic Studio (Kimberly Harter)' %}
{% elsif supplier_count > 0 %}
  {% assign global_fulfillment_flag = 'SUPPLIER-FACILITY-FULFILLMENT' %}
  {% assign global_facility_name = 'Specialized Logistics Facility / Utah Hub' %}
{% else %}
  {% assign global_fulfillment_flag = 'DEFAULT-DOMESTIC-FULFILLMENT' %}
  {% assign global_facility_name = 'Provo Domestic Studio' %}
{% endif %}

<meta name="order:cart_fulfillment_flag" content="{{ global_fulfillment_flag }}">
<meta name="order:cart_fulfillment_facility" content="{{ global_facility_name }}">
<meta name="order:provo_item_count" content="{{ provo_count }}">
<meta name="order:supplier_item_count" content="{{ supplier_count }}">

<!-- Client-Side Automated Order Injection Script -->
<script>
  (function() {
    var CURRENT_FLAG = {{ global_fulfillment_flag | json }};
    var CURRENT_FACILITY = {{ global_facility_name | json }};
    var PROVO_ITEMS = {{ provo_count | json }};
    var SUPPLIER_ITEMS = {{ supplier_count | json }};

    function injectFormAttributes() {
      // Find all cart and checkout forms
      var forms = document.querySelectorAll('form[action*="/cart"], form[action*="/checkout"]');
      forms.forEach(function(form) {
        setOrUpdateHiddenInput(form, 'attributes[Auto_Fulfillment_Flag]', CURRENT_FLAG);
        setOrUpdateHiddenInput(form, 'attributes[Fulfillment_Facility]', CURRENT_FACILITY);
        setOrUpdateHiddenInput(form, 'attributes[Provo_Item_Count]', String(PROVO_ITEMS));
        setOrUpdateHiddenInput(form, 'attributes[Supplier_Item_Count]', String(SUPPLIER_ITEMS));
      });
    }

    function setOrUpdateHiddenInput(form, name, value) {
      var input = form.querySelector('input[name="' + name + '"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        form.appendChild(input);
      }
      input.value = value;
    }

    function syncCartAttributesWithShopify() {
      // Fetch live cart to inspect items and update attributes if necessary
      fetch('/cart.js')
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          if (!cart || !cart.items) return;
          var pCount = 0;
          var sCount = 0;
          var vendors = [];

          cart.items.forEach(function(item) {
            var v = (item.vendor || '').trim();
            if (vendors.indexOf(v) === -1 && v.length > 0) vendors.push(v);
            if (v === 'Bizi Bees' || v === 'Book Outpost' || v === '') {
              pCount += item.quantity;
            } else {
              sCount += item.quantity;
            }
          });

          var calculatedFlag = 'PROVO-DOMESTIC-FULFILLMENT';
          var calculatedFacility = 'Provo Domestic Studio (Kimberly Harter)';

          if (pCount > 0 && sCount > 0) {
            calculatedFlag = 'SPLIT-FULFILLMENT-PROVO-SUPPLIER';
            calculatedFacility = 'Split (Provo Studio + Supplier Facility)';
          } else if (sCount > 0) {
            calculatedFlag = 'SUPPLIER-FACILITY-FULFILLMENT';
            calculatedFacility = 'Specialized Logistics Facility / Utah Hub';
          }

          var attrs = cart.attributes || {};
          if (attrs['Auto_Fulfillment_Flag'] !== calculatedFlag || attrs['Fulfillment_Facility'] !== calculatedFacility) {
            fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                attributes: {
                  'Auto_Fulfillment_Flag': calculatedFlag,
                  'Fulfillment_Facility': calculatedFacility,
                  'Vendor_Routing': vendors.join(', '),
                  'Fulfillment_Sync_Timestamp': new Date().toISOString()
                }
              })
            }).catch(function(err) {
              console.warn('Auto-fulfillment sync notice:', err);
            });
          }
        })
        .catch(function(err) {
          // Silent fallback
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        injectFormAttributes();
        syncCartAttributesWithShopify();
      });
    } else {
      injectFormAttributes();
      syncCartAttributesWithShopify();
    }

    // Re-sync on custom cart refresh events
    document.addEventListener('cart:updated', syncCartAttributesWithShopify);
    document.addEventListener('bizi:cart:refresh', syncCartAttributesWithShopify);
  })();
</script>
