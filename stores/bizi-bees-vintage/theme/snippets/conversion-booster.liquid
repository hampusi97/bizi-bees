{% comment %}
  Bizi Bees - Minimal Product Utilities
  Repo: bizi-bees /snippets/conversion-booster.liquid
  Clean, high-trust mobile sticky bar without artificial urgency or popups.
{% endcomment %}

{% if template.name == 'product' %}
  <!-- Mobile Sticky Add to Bag Bar -->
  <div id="mobile-sticky-atc" class="mobile-sticky-bar" aria-hidden="true">
    <div class="sticky-product-info">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 80 | image_tag: width: 42, height: 42, class: 'sticky-thumb', alt: product.title | escape }}
      {% endif %}
      <div class="sticky-meta">
        <div class="sticky-title">{{ product.title | escape }}</div>
        <div class="sticky-price">
          {{ product.price | money }}
          {% if product.compare_at_price > product.price %}
            <span class="sticky-was">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>
      </div>
    </div>
    
    <button type="button" id="sticky-atc-submit-btn" class="sticky-action-btn">
      Add to Bag
    </button>
  </div>

  <style>
    .mobile-sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 9999;
      background: #FFFFFF;
      border-top: 1px solid #E7E5E4;
      box-shadow: 0 -4px 16px rgba(28, 25, 23, 0.08);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      transform: translateY(100%);
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .mobile-sticky-bar.visible {
      transform: translateY(0);
    }
    .sticky-product-info {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      flex: 1;
    }
    .sticky-thumb {
      width: 42px;
      height: 42px;
      border-radius: 6px;
      object-fit: cover;
      background: #FAF7F2;
      border: 1px solid #E7E5E4;
      flex-shrink: 0;
    }
    .sticky-meta {
      min-width: 0;
      flex: 1;
    }
    .sticky-title {
      font-size: 12.5px;
      font-weight: 600;
      color: #1C1917;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sticky-price {
      font-size: 13px;
      font-weight: 700;
      color: #1C1917;
    }
    .sticky-was {
      font-size: 11px;
      color: #A8A29E;
      text-decoration: line-through;
      margin-left: 4px;
      font-weight: 400;
    }
    .sticky-action-btn {
      background: #2D3B2D;
      color: #FFFFFF;
      font-size: 13px;
      font-weight: 600;
      padding: 10px 20px;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .sticky-action-btn:hover {
      background: #1E281E;
    }
    .sticky-action-btn:active {
      transform: scale(0.97);
    }
    @media (min-width: 769px) {
      .mobile-sticky-bar {
        display: none !important;
      }
    }
  </style>

  <script>
    (function() {
      var productForm = document.querySelector('form[action*="/cart/add"]');
      if (!productForm) return;

      var stickyBar = document.getElementById('mobile-sticky-atc');
      var stickyBtn = document.getElementById('sticky-atc-submit-btn');
      var mainSubmitBtn = productForm.querySelector('button[type="submit"]');

      if (stickyBar && mainSubmitBtn && window.innerWidth <= 768) {
        window.addEventListener('scroll', function() {
          var rect = mainSubmitBtn.getBoundingClientRect();
          if (rect.bottom < 0) {
            stickyBar.classList.add('visible');
            stickyBar.setAttribute('aria-hidden', 'false');
          } else {
            stickyBar.classList.remove('visible');
            stickyBar.setAttribute('aria-hidden', 'true');
          }
        }, { passive: true });

        if (stickyBtn) {
          stickyBtn.addEventListener('click', function() {
            mainSubmitBtn.click();
          });
        }
      }
    })();
  </script>
{% endif %}
