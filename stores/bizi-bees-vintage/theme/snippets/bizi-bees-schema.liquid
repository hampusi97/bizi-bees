<!-- Master Rich Snippets & Golden Review Stars Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": "Bizi Bees & Luma Wellness",
      "description": "Nationwide curated everyday finds, secondhand treasures, and clinical-grade at-home red light therapy devices.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": "Bizi Bees",
      "url": "{{ shop.url }}",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Provo",
        "addressRegion": "UT",
        "postalCode": "84601",
        "addressCountry": "US"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "{{ shop.url }}/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Luma Glow 4-in-1 Skincare Wand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Luma Glow 4-in-1 Wand is an at-home clinical skincare tool combining medical-grade 630nm red light phototherapy, low-voltage microcurrent toning, therapeutic 107°F warmth, and sonic facial massage."
          }
        },
        {
          "@type": "Question",
          "name": "How fast does Bizi Bees dispatch orders?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All in-stock items dispatch within 24 hours from our Utah location via USPS Priority Mail with real-time tracking, delivering nationwide across all 50 US states in 2 to 4 business days."
          }
        },
        {
          "@type": "Question",
          "name": "What is the 60-Day Glow Guarantee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide a 100% risk-free 60-day money-back guarantee on all Luma Wellness devices. If you are not satisfied with your visible results after 60 days, return it for a full refund."
          }
        },
        {
          "@type": "Question",
          "name": "How do I claim 35% off my order today?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use promo code PROVOTODAY at checkout or visit bizibees-store.myshopify.com/discount/PROVOTODAY to auto-apply 35% off sitewide with free express shipping on orders over $50."
          }
        }
      ]
    }

    {% if template.name == "article" %}
    ,
    {
      "@type": "BlogPosting",
      "@id": "{{ canonical_url }}#article",
      "headline": {{ article.title | json }},
      "description": {{ article.excerpt_or_content | strip_html | truncate: 250 | json }},
      "datePublished": "{{ article.published_at | date: "%Y-%m-%dT%H:%M:%SZ" }}",
      "dateModified": "{{ article.updated_at | date: "%Y-%m-%dT%H:%M:%SZ" }}",
      "author": {
        "@type": "Person",
        "name": {{ article.author | default: "Kimberly Harter" | json }},
        "jobTitle": "Founder & Wellness Curator"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Bizi Bees & Luma Wellness",
        "url": "{{ shop.url }}"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ canonical_url }}"
      }
    }
    {% endif %}

    {% if template.name == 'product' %}
    ,
    {
      "@type": "Product",
      "@id": "{{ shop.url }}{{ product.url }}#product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 300 | json }},
      "image": [
        {% for image in product.images %}
          {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: "Luma Wellness" | json }}
      },
      "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
      {% if product.vendor == 'Luma Wellness' %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "184",
        "bestRating": "5",
        "worstRating": "1"
      },
      {% endif %}
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}",
        "priceCurrency": "USD",
        "price": {{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' | json }},
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "name": {{ product.vendor | json }}
        }
      }
    }
    {% endif %}
  ]
}
</script>
