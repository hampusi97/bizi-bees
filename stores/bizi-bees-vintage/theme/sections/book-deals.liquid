<div class="wrap block"><p class="eyebrow">Selected titles. A lovely little stack.</p><h1>{{ collection.title | escape }}</h1><div>{{ collection.description }}</div>{% if section.settings.offer_enabled %}<div class="notice"><h2>{{ section.settings.offer_heading | escape }}</h2><p>{{ section.settings.offer_terms | escape }}</p></div>{% endif %}<p class="muted">Only books in this collection qualify for an active Book Deals offer. Books elsewhere in the shop keep their regular prices.</p>{% render 'filters', results: collection %}{% paginate collection.products by 24 %}<div class="grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p class="empty">Our next book deals are on their way. <a href="/collections/books">Browse all books</a>.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>
{% schema %}{"name": "Book deals", "settings": [{"type": "checkbox", "id": "offer_enabled", "label": "Show active offer (configure Shopify discount first)", "default": false}, {"type": "text", "id": "offer_heading", "label": "Offer heading", "default": "Pick any 2 eligible books for $10"}, {"type": "textarea", "id": "offer_terms", "label": "Offer terms", "default": "Choose two eligible books from this collection. Shipping and applicable taxes are additional. Review your discount at checkout."}]}{% endschema %}
