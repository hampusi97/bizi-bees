<div class="wrap block"><p class="muted"><a href="/collections/all">All finds</a> / {{ product.title | escape }}</p><div class="product"><div class="gallery">{% for image in product.images %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,800,1200', sizes: '(max-width:600px) 90vw, 50vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endfor %}</div><div><p class="eyebrow">A bizi bees find</p><h1>{{ product.title | escape }}</h1><p class="price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</p>{% if product.metafields.custom.condition != blank %}<span class="badge">{{ product.metafields.custom.condition.value | escape }}</span>{% endif %}<dl class="facts"><dt>Package condition</dt><dd>{{ product.metafields.custom.condition_notes.value | default: 'Please contact us for item-specific condition details before ordering.' | escape | newline_to_br }}</dd><dt>Pack size and contents</dt><dd>{{ product.metafields.custom.included.value | default: 'Please confirm included parts and accessories with us before ordering.' | escape | newline_to_br }}</dd>{% if product.metafields.custom.testing != blank %}<dt>Testing & functionality</dt><dd>{{ product.metafields.custom.testing.value | escape | newline_to_br }}</dd>{% endif %}{% if product.metafields.custom.measurements != blank %}<dt>Measurements</dt><dd>{{ product.metafields.custom.measurements.value | escape | newline_to_br }}</dd>{% endif %}</dl>{% form 'product', product %}<label for="Variant-{{ section.id }}">Choose an option</label><select name="id" id="Variant-{{ section.id }}">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><input type="hidden" name="quantity" value="1"><button type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{{ form.errors | default_errors }}{% endform %}<p class="muted">Shipping and any applicable taxes are calculated at checkout. Items in your bag aren’t reserved.</p><details open><summary>About this find</summary><div>{{ product.description }}</div></details><details><summary>Condition guide</summary><p>For this packaged item, read the package condition, label details, and best-by date in the item description.</p></details><details><summary>Shipping & returns</summary><p>Review our <a href="/pages/shipping">shipping information</a> and <a href="/pages/returns">return policy</a> before ordering.</p></details><p><a href="/pages/contact">Have a question about this item?</a> Please include its name or link.</p></div></div></div>
