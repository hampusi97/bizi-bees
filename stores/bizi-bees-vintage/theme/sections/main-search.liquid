<div class="wrap block"><h1>Find a little something.</h1><form action="{{ routes.search_url }}" role="search"><label for="SearchPage">Search the shop</label><input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" required><input type="hidden" name="type" value="product"><button>Search</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% render 'filters', results: search %}{% paginate search.results by 24 %}<div class="grid">{% for product in search.results %}{% if product.object_type == 'product' %}{% render 'product-card', product: product %}{% endif %}{% else %}<p>No finds yet. Try another word.</p>{% endfor %}</div><div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</div>
{% schema %}{"name": "Main Search", "settings": [], "presets": [{"name": "Main Search"}]}{% endschema %}
