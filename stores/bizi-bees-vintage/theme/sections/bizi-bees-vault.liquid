{% comment %}
  BIZI BEES ZERO-GRAVITY INTERACTIVE SHOWCASE
  Shopify Section: sections/bizi-bees-vault.liquid
{% endcomment %}

<div class="bb-gravity-wrapper" id="bb-gravity-{{ section.id }}">
  <div class="bb-gravity-header">
    {% if section.settings.pill_text != blank %}
      <span class="bb-gravity-pill">{{ section.settings.pill_text }}</span>
    {% endif %}
    <h2>{{ section.settings.heading | default: 'Treasures Floating into New Hands' }}</h2>
    <p>{{ section.settings.subheading | default: 'Hand-picked vintage books, retro games, and curated finds from Provo, Utah. Catch a treasure below:' }}</p>
  </div>

  <div class="bb-gravity-arena" id="gravityArena-{{ section.id }}">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a 
          href="{{ block.settings.link | default: '/collections/all' }}" 
          class="float-item badge-pos-{{ forloop.index }}"
          data-speed="{{ block.settings.speed | default: 2.0 }}" 
          data-offset="{{ block.settings.offset | default: 0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="float-content">
            <span class="emoji">{{ block.settings.emoji }}</span>
            <div class="float-text">
              <strong>{{ block.settings.title }}</strong>
              <small>{{ block.settings.subtitle }}</small>
            </div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      <!-- Default Badges if no blocks added yet -->
      <a href="/collections/all" class="float-item badge-pos-1" data-speed="2.2" data-offset="15">
        <div class="float-content">
          <span class="emoji">📖</span>
          <div class="float-text">
            <strong>Pre-Loved Novels</strong>
            <small>Inspected & read-ready</small>
          </div>
        </div>
      </a>
      <a href="/collections/all" class="float-item badge-pos-2" data-speed="1.8" data-offset="-20">
        <div class="float-content">
          <span class="emoji">🎲</span>
          <div class="float-text">
            <strong>Family Game Nights</strong>
            <small>Board games & puzzles</small>
          </div>
        </div>
      </a>
      <a href="/collections/all" class="float-item badge-pos-3" data-speed="2.5" data-offset="25">
        <div class="float-content">
          <span class="emoji">🐝</span>
          <div class="float-text">
            <strong>Curated in Provo</strong>
            <small>Shipped with love by Kimberly</small>
          </div>
        </div>
      </a>
      <a href="/collections/all" class="float-item badge-pos-4" data-speed="1.5" data-offset="-10">
        <div class="float-content">
          <span class="emoji">🎁</span>
          <div class="float-text">
            <strong>Gifts Under $20</strong>
            <small>Unique & sustainable</small>
          </div>
        </div>
      </a>
      <a href="/collections/all" class="float-item badge-pos-5" data-speed="2.8" data-offset="30">
        <div class="float-content">
          <span class="emoji">📦</span>
          <div class="float-text">
            <strong>Free Tracked Shipping</strong>
            <small>On all orders over $35</small>
          </div>
        </div>
      </a>
      <a href="/collections/all" class="float-item badge-pos-6" data-speed="2.0" data-offset="-15">
        <div class="float-content">
          <span class="emoji">🌿</span>
          <div class="float-text">
            <strong>100% Eco-Boutique</strong>
            <small>Giving good things a 2nd life</small>
          </div>
        </div>
      </a>
    {% endif %}
  </div>
</div>

<style>
  #bb-gravity-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 520px;
    padding: 60px 20px;
    background: radial-gradient(circle at 50% 30%, #fffdfa 0%, #f7f2e9 100%);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    border-radius: 24px;
    margin: 36px 0;
    box-shadow: 0 10px 30px rgba(184, 150, 110, 0.08);
    border: 1px solid #ebd9c5;
  }

  #bb-gravity-{{ section.id }} .bb-gravity-header {
    text-align: center;
    max-width: 650px;
    z-index: 5;
    pointer-events: none;
    margin-bottom: 25px;
  }

  #bb-gravity-{{ section.id }} .bb-gravity-pill {
    display: inline-block;
    background: #ffecb3;
    color: #8c5b00;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 30px;
    margin-bottom: 14px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  #bb-gravity-{{ section.id }} .bb-gravity-header h2 {
    font-size: clamp(28px, 4vw, 42px);
    color: #2b2520;
    margin: 0 0 12px 0;
    font-weight: 800;
    letter-spacing: -0.5px;
    font-family: Georgia, serif;
  }

  #bb-gravity-{{ section.id }} .bb-gravity-header p {
    font-size: 16px;
    color: #6d635b;
    margin: 0;
    line-height: 1.5;
  }

  #bb-gravity-{{ section.id }} .bb-gravity-arena {
    position: relative;
    width: 100%;
    max-width: 1050px;
    height: 340px;
  }

  /* Physics element - transformed by JS */
  #bb-gravity-{{ section.id }} .float-item {
    position: absolute;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    z-index: 2;
    will-change: transform;
  }

  /* Inner visual container - handles hover without snapping physics */
  #bb-gravity-{{ section.id }} .float-content {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.90);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 12px 20px;
    border-radius: 50px;
    box-shadow: 0 14px 30px rgba(184, 150, 110, 0.16), 0 2px 6px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.95);
    transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.25s ease, background 0.25s ease;
  }

  #bb-gravity-{{ section.id }} .float-item:hover {
    z-index: 10;
  }

  #bb-gravity-{{ section.id }} .float-item:hover .float-content {
    transform: scale(1.08) translateY(-4px);
    box-shadow: 0 20px 42px rgba(184, 150, 110, 0.28);
    background: #ffffff;
  }

  #bb-gravity-{{ section.id }} .emoji {
    font-size: 26px;
    line-height: 1;
  }

  #bb-gravity-{{ section.id }} .float-text strong {
    display: block;
    font-size: 14px;
    color: #2c2520;
    font-weight: 700;
  }

  #bb-gravity-{{ section.id }} .float-text small {
    display: block;
    font-size: 11px;
    color: #8c7f74;
    font-weight: 500;
  }

  /* Initial Scatter Coordinates */
  #bb-gravity-{{ section.id }} .badge-pos-1 { top: 8%;  left: 6%; }
  #bb-gravity-{{ section.id }} .badge-pos-2 { top: 62%; left: 10%; }
  #bb-gravity-{{ section.id }} .badge-pos-3 { top: 16%; right: 8%; }
  #bb-gravity-{{ section.id }} .badge-pos-4 { top: 64%; right: 12%; }
  #bb-gravity-{{ section.id }} .badge-pos-5 { top: 4%;  left: 44%; }
  #bb-gravity-{{ section.id }} .badge-pos-6 { top: 68%; left: 40%; }

  @media (max-width: 768px) {
    #bb-gravity-{{ section.id }} .bb-gravity-arena {
      height: 380px;
    }
    #bb-gravity-{{ section.id }} .badge-pos-1 { top: 5%;  left: 4%; }
    #bb-gravity-{{ section.id }} .badge-pos-2 { top: 34%; left: 6%; }
    #bb-gravity-{{ section.id }} .badge-pos-3 { top: 16%; right: 4%; }
    #bb-gravity-{{ section.id }} .badge-pos-4 { top: 56%; right: 4%; }
    #bb-gravity-{{ section.id }} .badge-pos-5 { top: 76%; left: 8%; }
    #bb-gravity-{{ section.id }} .badge-pos-6 { display: none; }
  }
</style>

<script>
  (function() {
    const arena = document.getElementById('gravityArena-{{ section.id }}');
    if (!arena) return;

    const items = arena.querySelectorAll('.float-item');
    let mouseX = 0, mouseY = 0;
    let targetX = 0, targetY = 0;
    let time = 0;
    let isVisible = true;
    let animationFrameId = null;

    function animate() {
      if (!isVisible) return;
      time += 0.02;

      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;

      items.forEach((item, index) => {
        const speed = parseFloat(item.dataset.speed) || 1.8;
        const floatY = Math.sin(time * speed + index) * 12;
        const floatX = Math.cos(time * (speed * 0.8) + index) * 9;
        const shiftX = targetX * speed * 8;
        const shiftY = targetY * speed * 8;

        item.style.transform = `translate3d(${floatX + shiftX}px, ${floatY + shiftY}px, 0px) rotate(${floatX * 0.2}deg)`;
      });

      animationFrameId = requestAnimationFrame(animate);
    }

    window.addEventListener('mousemove', (e) => {
      const rect = arena.getBoundingClientRect();
      const arenaCenterX = rect.left + rect.width / 2;
      const arenaCenterY = rect.top + rect.height / 2;
      mouseX = (e.clientX - arenaCenterX) / (window.innerWidth / 2);
      mouseY = (e.clientY - arenaCenterY) / (window.innerHeight / 2);
    });

    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        const rect = arena.getBoundingClientRect();
        mouseX = (touch.clientX - (rect.left + rect.width / 2)) / (window.innerWidth / 2);
        mouseY = (touch.clientY - (rect.top + rect.height / 2)) / (window.innerHeight / 2);
      }
    }, { passive: true });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isVisible = entry.isIntersecting;
        if (isVisible && !animationFrameId) {
          animate();
        } else if (!isVisible && animationFrameId) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      });
    }, { threshold: 0.1 });

    observer.observe(arena);
    animate();
  })();
</script>

{% schema %}
{
  "name": "Bizi Bees Gravity Vault",
  "settings": [
    {
      "type": "text",
      "id": "pill_text",
      "label": "Pill Tagline",
      "default": "✨ The Bizi Bees Curiosity Vault"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Treasures Floating into New Hands"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hand-picked vintage books, retro games, and curated finds from Provo, Utah. Catch a treasure below:"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Floating Item",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "📖" },
        { "type": "text", "id": "title", "label": "Title", "default": "Pre-Loved Novels" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Inspected & read-ready" },
        { "type": "url", "id": "link", "label": "Destination Link" },
        { "type": "range", "id": "speed", "label": "Float Speed", "min": 1.0, "max": 3.5, "step": 0.1, "default": 2.0 },
        { "type": "range", "id": "offset", "label": "Tilt / Phase Offset", "min": -30, "max": 30, "step": 5, "default": 10 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bizi Bees Gravity Vault",
      "blocks": [
        { "type": "badge", "settings": { "emoji": "📖", "title": "Pre-Loved Novels", "subtitle": "Inspected & read-ready" } },
        { "type": "badge", "settings": { "emoji": "🎲", "title": "Family Game Nights", "subtitle": "Board games & puzzles" } },
        { "type": "badge", "settings": { "emoji": "🐝", "title": "Curated in Provo", "subtitle": "Shipped with love by Kimberly" } },
        { "type": "badge", "settings": { "emoji": "🎁", "title": "Gifts Under $20", "subtitle": "Unique & sustainable" } },
        { "type": "badge", "settings": { "emoji": "📦", "title": "Free Tracked Shipping", "subtitle": "On all orders over $35" } },
        { "type": "badge", "settings": { "emoji": "🌿", "title": "100% Eco-Boutique", "subtitle": "Giving good things a 2nd life" } }
      ]
    }
  ]
}
{% endschema %}